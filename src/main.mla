/// mlacker: terminal tracker with optional native VST3 hosting.
mod mlacker_ui::app;
use mlacker_ui::app::run;
mod std::env::detail;
use std::env::detail::__env_args;
extern fn mlacker_install_vst3_host() -> void;
extern fn mlacker_version() -> str8;
fn main() -> i32 {
    let arguments: list<str8> = __env_args();
    if arguments.len() > 2 { println!("Usage: mlacker [session.mlack | project.mlaproj | --version]"); return 2; }
    if arguments.len() == 2 {
        if arguments[1] == "--help" || arguments[1] == "-h" {
            println!("Usage: mlacker [session.mlack | project.mlaproj | --version] | No path starts an empty editor."); return 0;
        }
        if arguments[1] == "--version" {
            let version: str8 = mlacker_version();
            println!("mlacker {}", version); return 0;
        }
    }
    mlacker_install_vst3_host();
    return run();
}
