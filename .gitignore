# Build output (mlacker, plugins, fetched deps such as vst3sdk)
build*/
*.vst3/
*.o
*.a
*_bin
mlang_test_bin
*.out

# Generated tooling files
*_commands.json
.cache/
CMakeUserPresets.json
Testing/

# Plugin lockfiles are regenerated; the root mlang.lock is committed
plugins/*/mlang.lock

# Python
__pycache__/
*.pyc
.venv/

# Editors / OS
.DS_Store
.vscode/
.idea/
*.swp

# Local build configuration and the MLang development checkout (bootstrap.sh)
mlacker.conf
subprojects/

# Scratch sessions, patterns and presets saved while testing (see demos/README.md)
demos/**/*.mla*

# Local AI agent notes written by bootstrap.sh (--agent-notes)
CLAUDE.local.md
AGENTS.override.md
