@@ -5,6 +5,20 @@
 #include <stdlib.h>
 #include <string.h>

+/* Optional host asset callbacks. Registration and queries run on the control
+ * thread. Standalone stdlib users have no plugin assets. Returned text is owned. */
+static char* (*audio_asset_load)(int64_t, const char*) = NULL;
+static char* (*audio_asset_path)(int64_t) = NULL;
+void mlang_audio_register_asset_loader(char* (*load)(int64_t, const char*), char* (*path)(int64_t)) {
+    audio_asset_load = load; audio_asset_path = path;
+}
+char* __mlang_std_audio_processor_asset_load(int64_t instance, const char* path) {
+    return audio_asset_load ? audio_asset_load(instance, path) : strdup("Plugin assets unavailable");
+}
+char* __mlang_std_audio_processor_asset_path(int64_t instance) {
+    return audio_asset_path ? audio_asset_path(instance) : strdup("");
+}
