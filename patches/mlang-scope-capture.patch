 /* Single UI consumer: Hann-windowed FFT of the newest `size` post-master
  * samples (power of two, 256..8192). Returns the bin count, or -1. */
+/* Single UI consumer. Capture the newest stereo post-master frames without
+ * disturbing FFT capture or consuming audio. Allocation is UI-thread only. */
+int32_t __mlacker_audio_scope_capture(int64_t handle, int64_t frames) {
+    ac_controller *c = (ac_controller*)(intptr_t)handle;
+    if(!c || frames < 1 || frames > AC_SPECTRUM_MAX) return -1;
+    if(!c->scope_snapshot) {
+        c->scope_snapshot = calloc(AC_SPECTRUM_MAX * 2, sizeof(float));
+        if(!c->scope_snapshot) return -1;
+    }
+    uint64_t end = atomic_load_explicit(&c->spectrum_write, memory_order_acquire);
+    for(int64_t i = 0; i < frames; ++i) {
+        uint64_t at = end - (uint64_t)frames + (uint64_t)i;
+        for(int ch = 0; ch < 2; ++ch) {
+            uint32_t bits = end >= (uint64_t)(frames - i)
+                ? atomic_load_explicit(&c->scope_ring[(at & (AC_SPECTRUM_RING - 1u)) * 2u + ch], memory_order_relaxed) : 0;
+            float value; memcpy(&value, &bits, sizeof(value));
+            c->scope_snapshot[i * 2 + ch] = isfinite(value) ? value : 0.f;
+        }
+    }
+    c->scope_frames = (int)frames;
+    return (int32_t)frames;
+}
+double __mlacker_audio_scope_sample(int64_t handle, int64_t frame, int64_t channel) {
+    ac_controller *c = (ac_controller*)(intptr_t)handle;
+    if(!c || !c->scope_snapshot || frame < 0 || frame >= c->scope_frames || channel < 0 || channel > 1) return 0;
+    return c->scope_snapshot[frame * 2 + channel];
+}
