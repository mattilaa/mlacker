/// Builds examples/turbo_outrun_loading.mlaproj: the C64 loading music,
/// HVSC Turbo_Outrun.sid subtune 1, Magical Sound Shower (C64 arrangement).
/// Composition: Hiroshi Kawaguchi; C64 arrangement: Jeroen Tel.
/// First 48 melodic bars, following the sampled-only lead-in, at 125 BPM.
mod mlacker_ui::app;
mod tui::table;
use tui::table::*;
mod std::env::detail;
use std::env::detail::__env_get_var;
use mlacker_ui::patterns::PatternLibrary;
use mlacker_ui::sequence::SequenceTable;
use mlacker_ui::session::SessionCodec;
use mlacker_ui::session::SessionView;
use mlacker_ui::audio_controller::AudioSystem;
use tui::geometry::*;
use std::strbuf::clone;
use std::strbuf::free;
extern fn mlacker_install_vst3_host() -> void;

