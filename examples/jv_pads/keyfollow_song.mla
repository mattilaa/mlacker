/// Builds examples/mla8000_keyfollow.mlaproj: Mla 8000's filter Key Follow,
/// heard by comparison. Three Mla 8000s play the same patch, a resonant saw
/// through the 24 dB low-pass at 800 Hz, and differ only in Key Follow (how
/// far the cutoff moves with the key, measured from C-4):
///
/// - 0 %: the cutoff stays at 800 Hz. Low notes are bright and buzzy, high
///   notes lose their harmonics and turn dull and quiet.
/// - 50 %: the cutoff moves half an octave per octave played.
/// - 100 %: the cutoff moves with the key, so every note keeps the same tone
///   (about three harmonics) from A-1 to G-5.
///
/// Each of the first three patterns plays an Am7 arpeggio rising four
/// octaves and falling back on one of them; "Groove" then uses the 100 %
/// patch for an arpeggio over a bass (also key-followed) and drums. 120 BPM.
/// Needs Mla 8000 installed in ~/.local/plugins/VST3.
mod mlacker_ui::app;
mod tui::table;
use tui::table::*;
use mlacker_ui::patterns::PatternLibrary;
use mlacker_ui::sequence::SequenceTable;
use mlacker_ui::session::SessionCodec;
use mlacker_ui::session::SessionView;
use mlacker_ui::audio_controller::AudioSystem;
use tui::geometry::*;
use std::strbuf::clone;
use std::strbuf::free;
mod std::env::detail;
use std::env::detail::__env_get_var;
extern fn mlacker_install_vst3_host() -> void;

/// Tracks, in order; instruments are numbered the same plus one.
fn drums() -> i32 { return 0; }
fn follow0() -> i32 { return 1; }
fn follow50() -> i32 { return 2; }
fn follow100() -> i32 { return 3; }
fn bass() -> i32 { return 4; }

fn song_area() -> Rect { return Rect::new(0, 0, 200, 40); }

fn note_at(table: &mut SequenceTable, track: i32, line: i32, row: i32, note: str8, velocity: i32, length: str8) -> void {
    var t: SequenceTable = SequenceTable {}; t = table;
    let column: i32 = t.track_start(track) + line * 4;
    t.set_cell(row, column, clone(note));
    t.set_cell(row, column + 1, format!("{}", velocity));
    t.set_cell(row, column + 2, clone(length));
    t.set_cell(row, column + 3, clone("0.00"));
    table = t;
}

/// Set parameter `name` of the processor in `slot`: integer steps for a
/// stepped parameter, otherwise normalized 0-1. False when it is missing.
fn set_named(system: &AudioSystem, slot: i64, name: str8, value: f64) -> bool {
    var audio: AudioSystem = AudioSystem {}; audio = system;
    let count: i64 = wide(i32(audio.output.parameter_info(slot, 0, 0)));
    for i in 0..count {
        // (A call compared directly with == trips the compiler.)
        let found: str8 = audio.output.parameter_name(slot, i);
        if found == name { return audio.output.set_parameter(slot, i, value) == 0; }
    }
    println!("Missing parameter {} on slot {}", name, slot);
    return false;
}

/// The arpeggio patch: a saw through the 24 dB low-pass at 800 Hz
/// (20 Hz x 1000^0.534) with 13 dB of resonance, `follow` 0-1 Key Follow,
/// a short pluck (1 ms attack, 300 ms decay to half, 150 ms release; times
/// are 1 ms x 10000^n), a quiet dotted-eighth echo, no chorus, so the filter
/// is all you hear change.
fn arp_patch(system: &AudioSystem, slot: i64, follow: f64) -> bool {
    var ok: bool = set_named(system, slot, "OSC 1 Wave", 5.0) && set_named(system, slot, "Filter Slope", 1.0);
    ok = ok && set_named(system, slot, "Cutoff", 0.534) && set_named(system, slot, "Resonance", 0.45);
    ok = ok && set_named(system, slot, "Key Follow", follow) && set_named(system, slot, "Filter Env Depth", 0.5);
    ok = ok && set_named(system, slot, "Amp Attack", 0.0) && set_named(system, slot, "Amp Decay", 0.6193);
    ok = ok && set_named(system, slot, "Amp Sustain", 0.5) && set_named(system, slot, "Amp Release", 0.544);
    ok = ok && set_named(system, slot, "Velocity > Amp", 0.0) && set_named(system, slot, "Chorus", 0.0);
    ok = ok && set_named(system, slot, "Delay", 2.0) && set_named(system, slot, "Delay Sync", 3.0);
    ok = ok && set_named(system, slot, "Delay Feedback", 0.25) && set_named(system, slot, "Delay Level", 0.15);
    ok = ok && set_named(system, slot, "Output", 1.0) && set_named(system, slot, "Level", 1.0);
    return ok;
}

/// Five tracks, the 100 % arpeggio selected.
fn song_pattern() -> SequenceTable {
    var table: SequenceTable = SequenceTable::empty();
    table.set_length(64, song_area());
    let names: list<str8> = ["Drums", "Key Follow 0%", "Key Follow 50%", "Key Follow 100%", "Bass"];
    for t in 0..5 {
        table.create_instrument_track(i32(t) + 1, song_area()); table.rename_track(names[t]);
    }
    table.ensure_note_lines(drums(), 3);
    table.rebuild_columns();
    table.selected_row = 0; table.selected_column = table.track_start(follow100());
    return table;
}

/// Am7 (A, C, E, G) in 16ths from A-1 up four octaves to G-5 and back down,
/// twice: the same notes on every track, so only Key Follow differs.
fn arpeggio(table: &mut SequenceTable, track: i32) -> void {
    let up: list<str8> = ["A-1", "C-2", "E-2", "G-2", "A-2", "C-3", "E-3", "G-3",
        "A-3", "C-4", "E-4", "G-4", "A-4", "C-5", "E-5", "G-5"];
    for row in 0..64 {
        let step: i32 = i32(row) % 32;
        let index: i32 = step < 16 ? step : 31 - step;
        note_at(&mut table, track, 0, i32(row), up[index], row % 4 == 0 ? 110 : 92, "0.80");
    }
}

/// The groove's arpeggio: the chord tones of Am7, Fmaj7, Cmaj7, G (one per
/// bar), leaping between low and high octaves so Key Follow keeps them even.
fn groove_arpeggio(table: &mut SequenceTable) -> void {
    let tones: list<str8> = ["A-2", "E-3", "C-4", "G-4", "E-5", "A-4", "C-4", "E-3",
        "F-2", "C-3", "A-3", "E-4", "C-5", "A-4", "E-4", "C-3",
        "C-3", "G-3", "E-4", "B-4", "G-5", "E-5", "B-4", "G-3",
        "G-2", "D-3", "B-3", "F#4", "D-5", "B-4", "G-4", "D-3"];
    for row in 0..64 {
        let bar: i32 = i32(row) / 16;
        let step: i32 = i32(row) % 8;
        note_at(&mut table, follow100(), 0, i32(row), tones[bar * 8 + step], step == 0 ? 112 : 90, "0.80");
    }
}

/// Offbeat eighths on each bar's root, an octave apart on the last 16th.
fn bass_part(table: &mut SequenceTable) -> void {
    let roots: list<str8> = ["A-1", "F-1", "C-2", "G-1"];
    let highs: list<str8> = ["A-2", "F-2", "C-3", "G-2"];
    for bar in 0..4 {
        for beat in 0..4 {
            let row: i32 = i32(bar) * 16 + i32(beat) * 4;
            note_at(&mut table, bass(), 0, row + 2, roots[bar], 110, "1.50");
            if beat == 3 { note_at(&mut table, bass(), 0, row + 3, highs[bar], 100, "0.90"); }
        }
    }
}

/// Kick on every beat, claps on 2 and 4, offbeat open hats, 16th hats.
fn drum_part(table: &mut SequenceTable) -> void {
    for bar in 0..4 {
        let b: i32 = i32(bar) * 16;
        for beat in 0..4 {
            let row: i32 = b + i32(beat) * 4;
            note_at(&mut table, drums(), 0, row, "C-2", 118, "1.00");
            note_at(&mut table, drums(), 1, row + 2, "A#2", 76, "1.00");
            note_at(&mut table, drums(), 2, row + 1, "F#2", 48, "1.00");
            note_at(&mut table, drums(), 2, row + 3, "F#2", 58, "1.00");
        }
        note_at(&mut table, drums(), 1, b + 4, "D#2", 96, "1.00"); note_at(&mut table, drums(), 1, b + 12, "D#2", 100, "1.00");
    }
}

fn main() -> i32 {
    mlacker_install_vst3_host();
    let home: str8 = __env_get_var("HOME");
    let plugins: str8 = format!("{}/.local/plugins/VST3", home);
    var audio: AudioSystem = AudioSystem::start(false);
    var library: PatternLibrary = PatternLibrary::empty();
    let names: list<str8> = ["Mla08", "Mla8000", "Mla8000", "Mla8000", "Mla8000"];
    let labels: list<str8> = ["Mla 08", "Mla 8000", "Mla 8000", "Mla 8000", "Mla 8000"];
    for i in 0..5 {
        let path: str8 = format!("{}/{}.vst3", plugins, names[i]);
        let status: str8 = audio.add_instrument(path);
        if status != "" { println!("Instrument {}: {}", i + 1, status); return 1; }
        library.add_instrument(i32(i) + 1, labels[i]);
        free(path);
    }
    var ok: bool = arp_patch(audio, 2, 0.0) && arp_patch(audio, 3, 0.5) && arp_patch(audio, 4, 1.0);
    // Bass: mono, a saw with a square an octave down, the low-pass at 300 Hz
    // (n 0.392) following the key fully, so the low A and the high octave
    // jump sound alike; a plucky filter envelope (+2 octaves, 150 ms).
    ok = ok && set_named(audio, 5, "Key Mode", 1.0) && set_named(audio, 5, "OSC 1 Wave", 5.0);
    ok = ok && set_named(audio, 5, "OSC 2 Wave", 0.0) && set_named(audio, 5, "OSC 2 Range", 12.0);
    ok = ok && set_named(audio, 5, "OSC Balance", 0.4) && set_named(audio, 5, "Cutoff", 0.392);
    ok = ok && set_named(audio, 5, "Resonance", 0.2) && set_named(audio, 5, "Key Follow", 1.0);
    ok = ok && set_named(audio, 5, "Filter Env Depth", 0.5 + 2.0 / 16.0) && set_named(audio, 5, "Filter Decay", 0.544);
    ok = ok && set_named(audio, 5, "Filter Sustain", 0.1) && set_named(audio, 5, "Amp Release", 0.4247);
    ok = ok && set_named(audio, 5, "Chorus", 0.0) && set_named(audio, 5, "Delay", 0.0);
    ok = ok && set_named(audio, 5, "Output", 1.0) && set_named(audio, 5, "Level", 1.0);
    // The drums at -4 dB (Output: -60 .. +6 dB).
    ok = ok && set_named(audio, 1, "Output", 56.0 / 66.0);
    if !ok { return 1; }

    var fixed: SequenceTable = song_pattern(); arpeggio(&mut fixed, follow0());
    var half: SequenceTable = song_pattern(); arpeggio(&mut half, follow50());
    var full: SequenceTable = song_pattern(); arpeggio(&mut full, follow100());
    var groove: SequenceTable = song_pattern(); drum_part(&mut groove); bass_part(&mut groove); groove_arpeggio(&mut groove);

    library.table.release(); library.table = fixed; library.rename("Key Follow 0%");
    library.import_pattern("Key Follow 50%", half, []);
    library.import_pattern("Key Follow 100%", full, []);
    library.import_pattern("Groove", groove, []);
    // 0 %, 50 %, 100 %, then the groove twice.
    let order: list<i32> = [1, 2, 3, 4, 4];
    library.song = order;
    library.select(1); library.refresh();

    let view: SessionView = SessionView { bpm: 120, sidebar: 1 };
    var codec: SessionCodec = SessionCodec {};
    let saved: result<str8, str8> = codec.save_project("examples/mla8000_keyfollow.mlaproj", library, view, audio);
    if saved.is_err() { println!("Save failed: {}", saved.unwrap_err()); return 1; }
    println!("Saved {}", saved.unwrap());
    audio.release();
    return 0;
}
