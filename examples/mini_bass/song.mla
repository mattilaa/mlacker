/// Timing and pitch estimate of the bass part in moog.wav. The original
/// exploratory riffs remain as optional patterns.
/// No sample files or other plugins are needed. Regenerate with build.sh.
mod mlacker_ui::app;
mod tui::table;
use tui::table::*;
use mlacker_ui::patterns::PatternLibrary;
use mlacker_ui::patterns::SongLane;
use mlacker_ui::sequence::SequenceTable;
use mlacker_ui::session::SessionCodec;
use mlacker_ui::session::SessionView;
use mlacker_ui::audio_controller::AudioSystem;
use mlacker_ui::audio_clip::AudioClip;
use mlacker_ui::bounce::Bounce;
use tui::geometry::*;
use std::strbuf::clone;
use std::strbuf::free;
mod std::env::detail;
use std::env::detail::__env_get_var;
extern fn mlacker_install_vst3_host() -> void;
extern fn getpid() -> i32;
extern fn rename(from: str8, to: str8) -> i32;
extern fn log(value: f64) -> f64;

fn area() -> Rect { return Rect::new(0, 0, 160, 40); }
fn note_at(table: &mut SequenceTable, track: i32, row: i32, note: str8, velocity: i32, length: str8) -> void {
    var t: SequenceTable = SequenceTable {}; t = table;
    let c: i32 = t.track_start(track);
    t.set_cell(row, c, clone(note)); t.set_cell(row, c + 1, format!("{}", velocity));
    t.set_cell(row, c + 2, clone(length)); t.set_cell(row, c + 3, clone("0.00"));
    table = t;
}
fn set_named(system: &AudioSystem, slot: i64, name: str8, value: f64) -> bool {
    var a: AudioSystem = AudioSystem {}; a = system;
    let count: i64 = wide(i32(a.output.parameter_info(slot, 0, 0)));
    for i in 0..count {
        let found: str8 = a.output.parameter_name(slot, i);
        if found == name {
            // Offline owner: apply immediately. bounce_begin's panic clears
            // the pending realtime queue, including unprocessed knob changes.
            let steps: f64 = a.output.parameter_info(slot, i, 1);
            let normalized: f64 = steps > 0.0 ? value / steps : value;
            let status: i32 = a.output.restore_parameter(slot, i, normalized);
            if status != 0 { println!("Cannot set {} to {}: {}", name, value, status); }
            return status == 0;
        }
    }
    println!("Missing parameter: {}", name); return false;
}
fn pattern(slot: i32, label: str8) -> SequenceTable {
    var t: SequenceTable = SequenceTable::empty(); t.set_length(64, area());
    t.create_instrument_track(slot, area()); t.rename_track(label);
    if slot == 1 { t.add_automation(0, "cc:74"); t.add_automation(0, "cc:71"); }
    t.selected_column = t.track_start(0); t.selected_row = 0;
    return t;
}
fn riff(t: &mut SequenceTable) -> void {
    let notes: list<str8> = ["F-2", "F-2", "C-3", "F-2", "G#2", "F-2", "D#2", "C-2",
        "F-2", "F-3", "C-3", "G#2", "D#2", "C-2", "D#2", "E-2"];
    for i in 0..32 {
        note_at(&mut t, 0, i32(i) * 2, notes[i % 16], i % 4 == 0 ? 118 : 96, "1.25");
    }
}
/// The recording's pulse is approximately 121 BPM. The main oscillator
/// alternates F2/F3 for eight bars, then C#2/C#3 and D#2/D#3 for a bar each.
/// OSC 3 supplies the sub-octave. The first onset is about 112 ms into the
/// cropped recording: 0.90 of a tracker row at this tempo.
fn reference_bass(ending: bool) -> SequenceTable {
    var t: SequenceTable = pattern(1, "Mini bass"); t.set_length(32, area());
    for i in 0..16 {
        let high: bool = i % 2 == 1;
        let note: str8 = ending ? (i < 8 ? (high ? "C#3" : "C#2") : (high ? "D#3" : "D#2")) : (high ? "F-3" : "F-2");
        note_at(&mut t, 0, i32(i) * 2, note, high ? 100 : 110, "0.75");
        t.set_cell(i32(i) * 2, t.track_start(0) + 3, clone("0.90"));
    }
    return t;
}
fn reference_upper(phrase: i32, pickup: bool) -> SequenceTable {
    var t: SequenceTable = pattern(3, "Mini upper 16ths"); t.set_length(32, area());
    // Short upper phrases begin one sixteenth before alternate bar lines.
    // F is the pickup in the preceding pattern; the remaining notes follow
    // on consecutive rows. Pitches are estimates from the mixed recording.
    if phrase > 0 {
        let fast: list<str8> = phrase == 1 ? ["G#4", "F-4", "A#4", "F-4", "C-5"] : ["G#4", "F-4", "F-5", "F-4", "D#5"];
        for i in 0..5 {
            note_at(&mut t, 0, i32(i), fast[i], 100, i == 4 ? "1.65" : "0.65");
            t.set_cell(i32(i), t.track_start(0) + 3, clone("0.90"));
        }
    }
    if pickup {
        note_at(&mut t, 0, 31, "F-4", 108, "0.65");
        t.set_cell(31, t.track_start(0) + 3, clone("0.90"));
    }
    return t;
}
/// One note per row: exactly sixteenth notes. Detached gates retrigger the
/// envelopes, while all three oscillator phases keep running between notes.
fn free_sixteenths() -> SequenceTable {
    var t: SequenceTable = pattern(1, "Mini bass"); t.set_length(32, area());
    let riff: list<str8> = ["F-2", "F-2", "F-3", "F-2", "G#2", "F-2", "C-3", "F-2",
        "F-2", "F-3", "D#2", "F-2", "C#2", "F-2", "D#2", "E-2"];
    for row in 0..32 {
        note_at(&mut t, 0, i32(row), row < 16 ? "F-2" : riff[row - 16], row % 4 == 0 ? 112 : 100, "0.60");
    }
    return t;
}
fn controls(t: &mut SequenceTable, sweep: bool) -> void {
    var table: SequenceTable = SequenceTable {}; table = t;
    let c: i32 = table.automation_column(0, 2);
    let r: i32 = table.automation_column(0, 3);
    // Default CC1 occupies slot 1. CC74 and CC71 are added after it.
    for row in 0..64 {
        var values: str8 = clone("");
        for step in 0..4 {
            let tick: i32 = i32(row) * 4 + i32(step);
            let v: i32 = sweep ? (tick < 128 ? 40 + tick * 70 / 128 : 110 - (tick - 128) * 70 / 128) : 63;
            let next: str8 = step == 0 ? format!("{}", v) : format!("{} {}", values, v);
            free(values); values = next;
        }
        table.set_cell(i32(row), c, values);
    }
    table.set_cell(0, r, clone(sweep ? "64" : "28"));
    t = table;
}
/// Render the actual parallel song matrix, or a dedicated mono audition.
/// `part` selects the bass/upper mixer channel for independent solo renders.
fn render(system: &mut AudioSystem, patterns: &PatternLibrary, audition: &SequenceTable, path: str8, solo: bool, part: i32) -> bool {
    var a: AudioSystem = AudioSystem {}; a = system;
    var library: PatternLibrary = PatternLibrary {}; library = patterns;
    var source: SequenceTable = SequenceTable {}; source = audition;
    var job: Bounce = a.bounce_begin(121);
    if !job.ok() { println!("Bounce failed: {}", job.error); return false; }
    if solo {
        for repeat in 0..4 { a.bounce_segment(&mut job, source, 0, 32, []); }
    } else {
        for row in 0..5 {
            source = library.merge_song_row(i32(row), area(), false);
            if part == 0 { a.bounce_segment(&mut job, source, 0, 32, [0]); }
            else if part == 1 { a.bounce_segment(&mut job, source, 0, 32, [1]); }
            else { a.bounce_segment(&mut job, source, 0, 32, []); }
        }
    }
    let pcm: list<f32> = a.bounce_finish(job, source, 2);
    let temporary: str8 = format!("build/mini_bass/preview-{}.wav", getpid());
    let made: result<AudioClip, str8> = AudioClip::from_pcm(temporary, pcm, 2, a.output.sample_rate(), 121);
    system = a;
    if made.is_err() { println!("Render failed: {}", made.unwrap_err()); return false; }
    let clip: AudioClip = made.unwrap();
    let ok: bool = clip.write_wav(temporary) && rename(temporary, path) == 0;
    if !ok { println!("Cannot write preview WAV"); }
    clip.release(); free(temporary); return ok;
}
fn main() -> i32 {
    mlacker_install_vst3_host();
    var audio: AudioSystem = AudioSystem::start(false);
    let plugin: str8 = __env_get_var("MINI_VST3");
    var library: PatternLibrary = PatternLibrary::empty();
    let labels: list<str8> = ["Mini bass", "Mini glide", "Mini upper 16ths"];
    for i in 0..3 {
        let status: str8 = audio.add_instrument(plugin);
        if status != "" { println!("Mla Mini: {}", status); return 1; }
        library.add_instrument(i32(i) + 1, labels[i]);
    }
    // Slot 1 uses the startup bass patch. Slot 2 demonstrates overlapping
    // notes and oscillator-3 LFO modulation with the mod wheel raised.
    var ok: bool = set_named(audio, 2, "Glide", 0.18);
    ok = ok && set_named(audio, 2, "OSC 3 Low", 1.0) && set_named(audio, 2, "OSC 3 Keyboard", 0.0);
    ok = ok && set_named(audio, 2, "OSC 3 Range", 4.0) && set_named(audio, 2, "Mod Wheel", 0.3);
    ok = ok && set_named(audio, 2, "Filter Sustain", 0.25);
    // Separate monophonic instance for the higher line in its own channel.
    ok = ok && set_named(audio, 3, "Cutoff", log(1000.0 / 20.0) / log(1000.0));
    ok = ok && set_named(audio, 3, "Key Follow", 0.35);
    ok = ok && set_named(audio, 3, "Filter Env Depth", 2.0 / 8.0);
    ok = ok && set_named(audio, 3, "Output", 54.0 / 66.0);
    ok = ok && set_named(audio, 3, "Amp Release", log(0.28 / 0.005) / log(2000.0));
    if !ok { return 1; }
    var classic: SequenceTable = pattern(1, "Mini bass"); riff(&mut classic); controls(&mut classic, false);
    var sweep: SequenceTable = pattern(1, "Mini bass"); riff(&mut sweep); controls(&mut sweep, true);
    var glide: SequenceTable = pattern(2, "Mini glide");
    glide.set_cell(0, glide.automation_column(0, 1), clone("38"));
    let notes: list<str8> = ["F-2", "C-3", "G#2", "D#2", "C-2", "F-2", "D#2", "E-2"];
    for i in 0..16 { note_at(&mut glide, 0, i32(i) * 4, notes[i % 8], 110, i == 15 ? "3.50" : "4.50"); }
    var bass: SequenceTable = reference_bass(false);
    var ending: SequenceTable = reference_bass(true);
    var pickup: SequenceTable = reference_upper(0, true);
    var phrase_a: SequenceTable = reference_upper(1, true);
    var phrase_b: SequenceTable = reference_upper(2, true);
    var upper_ending: SequenceTable = reference_upper(2, false);
    var sixteenths: SequenceTable = free_sixteenths();
    library.table.release(); library.table = bass; library.rename("Bass - F");
    library.import_pattern("Bass - ending", ending, []);
    library.import_pattern("Upper - pickup", pickup, []);
    library.import_pattern("Upper - 16ths A", phrase_a, []);
    library.import_pattern("Upper - 16ths B", phrase_b, []);
    library.import_pattern("Upper - ending", upper_ending, []);
    library.import_pattern("Free OSC 16ths", sixteenths, []);
    library.import_pattern("Classic bass", classic, []);
    library.import_pattern("Ladder sweep", sweep, []);
    library.import_pattern("Legato glide", glide, []);
    library.song = [1, 1, 1, 1, 2];
    library.extra_lanes = [SongLane { slots: [3, 4, 5, 4, 6] }];
    library.matrix_steps = 32; library.select(7); library.refresh();
    // Compare against the previous dark filter on the very same arrangement.
    ok = set_named(audio, 1, "Cutoff", log(130.0 / 20.0) / log(1000.0));
    ok = ok && set_named(audio, 1, "Filter Env Depth", 1.8 / 8.0) && set_named(audio, 1, "Key Follow", 0.2);
    if !ok || !render(&mut audio, library, library.table, "build/mini_bass/baseline.wav", false, -1) { return 1; }
    ok = set_named(audio, 1, "Cutoff", log(600.0 / 20.0) / log(1000.0));
    ok = ok && set_named(audio, 1, "Filter Env Depth", 3.0 / 8.0) && set_named(audio, 1, "Key Follow", 0.35);
    if !ok || !render(&mut audio, library, library.table, "build/mini_bass/preview.wav", false, -1) { return 1; }
    if !render(&mut audio, library, library.table, "build/mini_bass/bass.wav", false, 0) { return 1; }
    if !render(&mut audio, library, library.table, "build/mini_bass/upper_sixteenths.wav", false, 1) { return 1; }
    if !render(&mut audio, library, library.table, "build/mini_bass/sixteenths.wav", true, -1) { return 1; }
    var codec: SessionCodec = SessionCodec {};
    let saved: result<str8, str8> = codec.save_project("examples/mini_bass.mlaproj", library, SessionView { bpm: 121, sidebar: 1 }, audio);
    if saved.is_err() { println!("Save failed: {}", saved.unwrap_err()); return 1; }
    println!("Saved {}", saved.unwrap());
    println!("Rendered build/mini_bass/preview.wav"); audio.release(); return 0;
}
