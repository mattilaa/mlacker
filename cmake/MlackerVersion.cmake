# Public version; editing it also reconfigures an existing build tree.
set(_mlacker_version_file "${CMAKE_CURRENT_LIST_DIR}/../version.txt")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_mlacker_version_file}")
file(READ "${_mlacker_version_file}" MLACKER_BASE_VERSION)
string(STRIP "${MLACKER_BASE_VERSION}" MLACKER_BASE_VERSION)
set(_mlacker_number "(0|[1-9][0-9]*)")
if(NOT MLACKER_BASE_VERSION MATCHES "^${_mlacker_number}\\.${_mlacker_number}\\.${_mlacker_number}$")
    message(FATAL_ERROR "version.txt must contain MAJOR.MINOR.PATCH (no leading zeros)")
endif()

option(MLACKER_AUTO_INCREMENT_BUILD "Increment the build number on each CMake configure" ON)
set(MLACKER_VERSION_BUILD 0 CACHE STRING "Build number seed when no persisted counter exists")
set(MLACKER_BUILD_NUMBER_FILE "${CMAKE_BINARY_DIR}/.mlacker_build_number" CACHE FILEPATH
    "Persisted local build counter")
set(MLACKER_BUILD_NUMBER "$ENV{MLACKER_BUILD_NUMBER}" CACHE STRING
    "Explicit fourth version part; empty uses the local counter")
set(MLACKER_RELEASE_VERSION "$ENV{MLACKER_RELEASE_VERSION}" CACHE STRING
    "Exact MAJOR.MINOR.PATCH[.BUILD] release version; disables automatic numbering")

set(MLACKER_VERSION "${MLACKER_BASE_VERSION}")
if(NOT MLACKER_BUILD_NUMBER STREQUAL "" AND NOT MLACKER_BUILD_NUMBER MATCHES "^${_mlacker_number}$")
    message(FATAL_ERROR "MLACKER_BUILD_NUMBER must be a nonnegative integer without leading zeros")
endif()
if(NOT MLACKER_RELEASE_VERSION STREQUAL "")
    if(NOT MLACKER_RELEASE_VERSION MATCHES "^${_mlacker_number}\\.${_mlacker_number}\\.${_mlacker_number}(\\.${_mlacker_number})?$")
        message(FATAL_ERROR "MLACKER_RELEASE_VERSION must use MAJOR.MINOR.PATCH[.BUILD] (no leading zeros)")
    endif()
    string(REGEX REPLACE "^([^.]+\\.[^.]+\\.[^.]+).*" "\\1" _mlacker_release_base "${MLACKER_RELEASE_VERSION}")
    if(NOT _mlacker_release_base STREQUAL MLACKER_BASE_VERSION)
        message(FATAL_ERROR "MLACKER_RELEASE_VERSION must match version.txt (${MLACKER_BASE_VERSION})")
    endif()
    if(NOT MLACKER_BUILD_NUMBER STREQUAL "" AND
       NOT MLACKER_RELEASE_VERSION STREQUAL "${MLACKER_BASE_VERSION}.${MLACKER_BUILD_NUMBER}")
        message(FATAL_ERROR "MLACKER_BUILD_NUMBER conflicts with MLACKER_RELEASE_VERSION")
    endif()
    set(MLACKER_VERSION "${MLACKER_RELEASE_VERSION}")
elseif(NOT MLACKER_BUILD_NUMBER STREQUAL "")
    set(MLACKER_VERSION "${MLACKER_BASE_VERSION}.${MLACKER_BUILD_NUMBER}")
else()
    if(MLACKER_AUTO_INCREMENT_BUILD)
        set(_mlacker_seed "${MLACKER_VERSION_BUILD}")
        if(EXISTS "${MLACKER_BUILD_NUMBER_FILE}")
            file(READ "${MLACKER_BUILD_NUMBER_FILE}" _mlacker_seed)
            string(STRIP "${_mlacker_seed}" _mlacker_seed)
        endif()
        if(NOT _mlacker_seed MATCHES "^${_mlacker_number}$")
            set(_mlacker_seed 0)
        endif()
        math(EXPR MLACKER_VERSION_BUILD "${_mlacker_seed} + 1")
        set(MLACKER_VERSION_BUILD "${MLACKER_VERSION_BUILD}" CACHE STRING "Build number" FORCE)
        file(WRITE "${MLACKER_BUILD_NUMBER_FILE}" "${MLACKER_VERSION_BUILD}\n")
    endif()
    if(NOT MLACKER_VERSION_BUILD MATCHES "^${_mlacker_number}$")
        message(FATAL_ERROR "MLACKER_VERSION_BUILD must be a nonnegative integer without leading zeros")
    endif()
    string(APPEND MLACKER_VERSION ".${MLACKER_VERSION_BUILD}")
endif()
