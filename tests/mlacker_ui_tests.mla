#[test]
fn tui_instrument_editor_navigation() {
    var editor: InstrumentEditor = InstrumentEditor { active: true };
    for i in 0..40 { editor.sliders.push(Slider::new("Parameter", 0.0, 1.0, 0.5, "f64")); }
    let area: Rect = Rect::new(0, 0, 54, 20);
    let output: AudioController = AudioController {};
    editor.on_event(decode_input("L"), output, area); verify(editor.selected == 0); verify(!editor.learning);
    editor.on_event(decode_input("\x1b[108;2u"), output, area); verify(editor.selected == 0); verify(!editor.learning);
    editor.on_event(decode_input("l"), output, area); verify(editor.selected == 4);
    editor.on_event(decode_input("j"), output, area); verify(editor.selected == 5);
    editor.on_event(decode_input("k"), output, area); verify(editor.selected == 4);
    editor.on_event(decode_input("h"), output, area); verify(editor.selected == 0);
    editor.selected = 39;
    let surface: Surface = Surface::new(54, 20);
    editor.paint(surface, area, Theme::dark_blue()); verify(editor.scroll > 0);
    editor.on_event(decode_input("\r"), output, area);
    editor.on_event(decode_input("h"), output, area); verify(editor.selected == 39);
    // Entered text stays in the slider, never reaching the pattern navigator.
    let selected: Slider = editor.sliders[39]; verify(selected.editing);
    surface.release(); editor.release();
}

#[test]
fn tui_midi_learn_filename() {
    let suggested: str8 = SessionCodec::learn_suggestion("Synth/A:B\\C\n");
    verify(suggested == "Synth_A_B_C_ - "); free(suggested);
}

#[test]
fn tui_aux_send_pattern_independence() {
    var library: PatternLibrary = PatternLibrary::new();
    let initial: SequenceTrack = library.table.tracks[0]; verify(initial.send_level(0) == 0);
    verify(!library.table.set_send(-1, 0, 50));
    verify(!library.table.set_send(0, 8, 50));
    verify(!library.table.set_send(0, 0, 101));
    verify(!library.table.set_send(0, 0, -1));
    verify(library.table.set_send(0, 0, 50));
    verify(library.table.set_send(0, 7, 100));
    library.add(true);
    let copied: SequenceTrack = library.table.tracks[0];
    verify(copied.send_level(0) == 50 && copied.send_level(7) == 100);
    verify(library.table.set_send(0, 0, 25));
    library.select(1);
    let original: SequenceTrack = library.table.tracks[0];
    verify(original.send_level(0) == 50 && original.send_level(7) == 100);
    library.select(2);
    let other: SequenceTrack = library.table.tracks[0]; verify(other.send_level(0) == 0);
    library.release();
}

#[test]
fn tui_pattern_insert_ctrl_jk_moves_effects() {
    var table: SequenceTable = SequenceTable::new(); let area: Rect = Rect::new(0, 0, 80, 16);
    table.insert_event(decode_input("f"), area);
    table.set_insert(0, 0, 5); table.set_insert(0, 2, 9);
    // Ctrl+J (kitty) moves slot 1 into the empty slot 2.
    table.insert_event(decode_input("\x1b[106;5u"), area);
    var track: SequenceTrack = table.tracks[0];
    verify(track.insert_id(0) == 0 && track.insert_id(1) == 5 && table.selected_group_detail == 1);
    // Ctrl+J as raw LF swaps it with the effect in slot 3.
    table.insert_event(decode_input("\n"), area);
    track = table.tracks[0];
    verify(track.insert_id(1) == 9 && track.insert_id(2) == 5 && table.selected_group_detail == 2);
    // Ctrl+K (raw VT, then kitty) moves it back up to the top.
    table.insert_event(decode_input("\x0b"), area);
    table.insert_event(decode_input("\x1b[107;5u"), area);
    track = table.tracks[0];
    verify(track.insert_id(0) == 5 && track.insert_id(1) == 0 && track.insert_id(2) == 9 && table.selected_group_detail == 0);
    // No move past the ends, and an empty slot stays put.
    table.insert_event(decode_input("\x1b[107;5u"), area);
    verify(table.selected_group_detail == 0);
    table.insert_event(decode_input("j"), area);
    table.insert_event(decode_input("\x1b[106;5u"), area);
    track = table.tracks[0];
    verify(table.selected_group_detail == 1 && track.insert_id(1) == 0 && track.insert_id(2) == 9);
    table.release();
}

#[test]
fn tui_pattern_insert_header() {
    var table: SequenceTable = SequenceTable::new(); let area: Rect = Rect::new(0, 0, 80, 16);
    let row: i32 = table.selected_row;
    table.insert_event(decode_input("f"), area); verify(table.header_height() == 6);
    verify(table.selected_group_detail == 0);
    table.insert_event(decode_input("j"), area); table.insert_event(decode_input("j"), area);
    table.insert_event(decode_input("j"), area); table.insert_event(decode_input("j"), area);
    verify(table.selected_group_detail == 3 && table.selected_row == row);
    table.insert_event(decode_input("l"), area); verify(table.active_track() == 1);
    verify(table.insert_event(decode_input("\r"), area) == Action::LoadInsert);
    verify(table.insert_event(decode_input("\x7f"), area) == Action::RemoveInsert);
    table.set_insert(1, 3, 7);
    var copy: SequenceTable = table.copy_pattern();
    table.set_insert(1, 3, 0);
    let copied: SequenceTrack = copy.tracks[1]; verify(copied.insert_id(3) == 7);
    table.insert_labels(AudioController {});
    let surface: Surface = Surface::new(80, 16); table.paint(surface, area, Theme::dark_blue());
    let column: Cell = surface.cell(0, 5); verify(column.glyph == 82); // ROW below four inserts
    table.insert_event(decode_input("f"), area); verify(table.header_height() == 2 && table.selected_group_detail == -1);
    surface.release(); copy.release(); table.release();
}

#[test]
fn tui_mixer_fx_zoom() {
    var table: SequenceTable = SequenceTable::new();
    var mixer: Mixer = Mixer { effect_volumes: [100, 100, 100, 100] };
    verify(mixer.send_navigation(decode_input("z"), 0)); verify(mixer.expanded_track(0));
    verify_eq_i32(28, mixer.track_width(false, 0)); verify_eq_i32(8, mixer.track_width(false, 1));
    verify(mixer.send_navigation(decode_input("l"), 0)); verify(mixer.selected_send == 0);
    let track: SequenceTrack = table.tracks[0];
    verify_eq_i32(1, mixer.send_value(decode_input("K"), track));
    verify(table.set_send(0, 0, 100));
    let full: SequenceTrack = table.tracks[0]; verify_eq_i32(-1, mixer.send_value(decode_input("K"), full));
    let lower: SequenceTrack = table.tracks[0]; verify_eq_i32(99, mixer.send_value(decode_input("J"), lower));
    verify(mixer.send_navigation(decode_input("l"), 0));
    verify(mixer.send_navigation(decode_input("l"), 0));
    verify(mixer.send_navigation(decode_input("l"), 0)); verify(mixer.selected_send == 3);
    let surface: Surface = Surface::new(40, 12);
    mixer.paint(surface, Rect::new(0, 0, 40, 12), Theme::dark_blue(), table.tracks, 0);
    // Narrow track bank scrolls FX controls without displacing Master.
    let label: Cell = surface.cell(10, 0); verify_eq_i32(52, label.glyph); // FX4
    // The send value sits one row above the OUT row that closes every strip.
    let percent: Cell = surface.cell(9, 10); verify_eq_i32(37, percent.glyph);
    let master: Cell = surface.cell(34, 0); verify_eq_i32(77, master.glyph);
    verify(!mixer.send_navigation(decode_input("l"), 0)); verify(mixer.selected_send == -1);
    verify(mixer.send_navigation(decode_input("z"), 1));
    verify(mixer.expanded_track(0) && mixer.expanded_track(1));
    verify(mixer.send_navigation(decode_input("z"), 0)); verify(!mixer.expanded_track(0));
    verify(mixer.expanded_track(1));
    mixer.bus_focus = true; verify(!mixer.send_navigation(decode_input("z"), 1));
    surface.release(); table.release();
}

#[test]
fn tui_mixer_faders_and_recording() {
    let area: Rect = Rect::new(0, 0, 120, 20);
    var table: SequenceTable = SequenceTable::new();
    table.clear_row();
    verify(!table.record_note(60, 87));
    verify(table.mixer_event(decode_input("J"), area));
    let quieter: SequenceTrack = table.tracks[0]; verify(quieter.volume == 99);
    verify(table.mixer_event(decode_input("\x1b[107;2u"), area));
    verify(!table.mixer_event(decode_input("K"), area));
    verify(table.mixer_event(decode_input("R"), area));
    verify(table.record_note(60, 87));
    let first: TableRow = table.rows[0];
    verify(first.cells[1] == "C-4" && first.cells[2] == "87" && first.cells[3] == "1.00" && first.cells[4] == "0.00");
    verify(!table.record_note(61, 0));
    table.note_line_action(80, area); // A new selected note line, still same track.
    verify(table.record_note(67, 113));
    let chord: TableRow = table.rows[0]; verify(chord.cells[1] == "C-4" && chord.cells[5] == "G-4" && chord.cells[6] == "113");
    verify(table.mixer_event(decode_input("\x1b[114;2u"), area));
    verify(!table.record_note(69, 100));
    verify(table.mixer_event(decode_input("l"), area)); verify(table.active_track() == 1);
    let surface: Surface = Surface::new(12, 12);
    var slider: Slider = Slider { minimum: 0.0, maximum: 100.0, value: 100.0, value_type: "i32" };
    slider.paint_vertical(surface, Rect::new(0, 0, 3, 10), Theme::dark_blue(), false);
    let top: Cell = surface.cell(1, 0); let value: Cell = surface.cell(0, 9);
    verify(top.glyph == 0x2501 && value.glyph == 49);
    slider.value = 0.0; slider.paint_vertical(surface, Rect::new(0, 0, 3, 10), Theme::dark_blue(), false);
    let bottom: Cell = surface.cell(1, 8); verify(bottom.glyph == 0x2501);
    table.selected_column = 1; table.mixer_event(decode_input("R"), area);
    let mixer: Mixer = Mixer {};
    mixer.paint(surface, Rect::new(0, 0, 12, 12), Theme::dark_blue(), table.tracks, 0);
    let armed: Cell = surface.cell(4, 0); verify(armed.glyph == 82 && armed.foreground == 0xFFFFFF && armed.background == 0xC02030);
    table.release(); surface.release();
}

#[test]
fn tui_remove_instrument_detaches_patterns() {
    var library: PatternLibrary = PatternLibrary::new();
    let area: Rect = Rect::new(0, 0, 100, 20);
    library.table.create_instrument_track(7, area);
    library.add_instrument(7, "Test"); library.add_instrument(8, "Other");
    library.table.assign_instrument(7); library.add(true);
    library.remove_instrument(7, area);
    let tracks: list<SequenceTrack> = library.table.tracks;
    for track in tracks { verify(track.instrument_id != 7); }
    let patterns: list<PatternEntry> = library.patterns;
    for pattern in patterns {
        let saved: list<SequenceTrack> = pattern.data.tracks;
        for track in saved { verify(track.instrument_id != 7); }
    }
    verify(library.instruments.items.len() == 1);
    let kept: ListItem = library.instruments.items[0]; verify(kept.id == 8);
    library.release();
}

#[test]
fn tui_instrument_stereo_meters() {
    var table: SequenceTable = SequenceTable::new();
    table.create_instrument_track(1, Rect::new(0, 0, 80, 20));
    var mixer: Mixer = Mixer { grainy: false };
    for i in 0..4 { mixer.levels.push(MeterLevel { left: 1000, right: 1000 }); }
    mixer.instrument_levels.push(MeterLevel { left: 1000, right: 250 });
    let surface: Surface = Surface::new(14, 12);
    mixer.paint(surface, Rect::new(0, 0, 14, 12), Theme::dark_blue(), table.tracks, 3);
    let midi: Cell = surface.cell(3, 2); let left: Cell = surface.cell(5, 2); let right: Cell = surface.cell(6, 2);
    verify(midi.glyph == 77 && left.glyph == 76 && right.glyph == 82);
    let midi_bar: Cell = surface.cell(3, 3); let left_bar: Cell = surface.cell(5, 3); let right_bar: Cell = surface.cell(6, 3);
    verify(midi_bar.glyph == left_bar.glyph && left_bar.glyph != right_bar.glyph);
    let master: Cell = surface.cell(8, 0); verify(master.glyph == 77);
    verify(mixer.update_instruments(AudioController {}, 16));
    let cleared: MeterLevel = mixer.instrument_levels[0]; verify(cleared.left == 0 && cleared.right == 0);
    surface.release(); table.release();
}

#[test]
fn tui_samples_reach_master() {
    var table: SequenceTable = SequenceTable::new();
    let area: Rect = Rect::new(0, 0, 120, 20);
    table.create_track_kind(false, true, area);
    var clip: AudioClip = AudioClip { source: clone("embedded.wav"), channels: 2, sample_rate: 8000, frames: 4000, frames_per_row: 1000 };
    for _i in 0..4000 { clip.samples.push(0.5f); clip.samples.push(0.25f); }
    for _i in 0..4 { clip.peaks.push(WavePeak { left: 500, right: 250 }); }
    table.selected_row = 1; verify_eq(true, table.insert_audio(clip, area));
    let opened: result<AudioController, str8> = AudioController::new(8000, 128);
    var audio: AudioSystem = AudioSystem {}; audio.output = opened.unwrap();
    let allocated: result<PcmBlock, str8> = PcmBlock::new(1024); let block: PcmBlock = allocated.unwrap();
    audio.sync_volumes(table);
    verify_eq(true, audio.sample_playback(table, 0, true, 120));
    verify(audio.output.process(block, 1024) == 0); verify(audio.output.master_peak(0) == 0);
    verify(audio.sample_playback(table, 15000, true, 120));
    verify(audio.output.process(block, 1024) == 0);
    verify_eq_i32(125, audio.output.master_peak(0)); verify_eq_i32(63, audio.output.master_peak(1));
    verify(audio.sample_playback(table, 16000, false, 120));
    audio.output.process(block, 1024); verify_eq(0.0f, block.left(1023));
    // Starting inside a placed sample seeks into embedded PCM, without reading its path.
    verify(audio.sample_playback(table, 45000, true, 120));
    audio.output.process(block, 1024); verify_eq(0.125f, block.left(100));
    audio.output.process(block, 1024); verify_eq(0.0f, block.left(1023));
    verify(audio.sample_playback(table, 45000, false, 120));
    // Explicit source-frame offset and duration are enforced by the audio renderer.
    verify(audio.output.play_sample(0, 3, 3990, 5) == 0);
    audio.output.process(block, 1024); verify_eq(true, block.left(1) > 0.0f); verify_eq(0.0f, block.left(5));
    // Every audio track contributes, not just the selected one.
    table.create_track_kind(false, true, area);
    table.selected_row = 1; verify(table.insert_audio(clip, area));
    audio.sync_volumes(table);
    verify(audio.sample_playback(table, 15000, true, 120));
    audio.output.process(block, 1024);
    verify_eq_i32(250, audio.output.master_peak(0)); verify_eq_i32(125, audio.output.master_peak(1));
    verify(audio.sample_playback(table, 16000, false, 120));
    block.close(); audio.release(); table.release(); clip.release();
}

#[test]
fn tui_master_headroom_sets_the_output_level() {
    // A track at full level reaches the output the master headroom down:
    // -12 dB by default, none at 0 dB. Master volume trims on top.
    var table: SequenceTable = SequenceTable::new();
    let area: Rect = Rect::new(0, 0, 120, 20);
    table.create_track_kind(false, true, area);
    var clip: AudioClip = AudioClip { source: clone("embedded.wav"), channels: 2, sample_rate: 8000, frames: 4000, frames_per_row: 1000 };
    for _i in 0..4000 { clip.samples.push(0.5f); clip.samples.push(0.25f); }
    for _i in 0..4 { clip.peaks.push(WavePeak { left: 500, right: 250 }); }
    table.selected_row = 1; verify_eq(true, table.insert_audio(clip, area));
    let opened: result<AudioController, str8> = AudioController::new(8000, 128);
    var audio: AudioSystem = AudioSystem {}; audio.output = opened.unwrap();
    let allocated: result<PcmBlock, str8> = PcmBlock::new(1024); let block: PcmBlock = allocated.unwrap();
    audio.sync_volumes(table);
    // The high-pass off: the test signal is DC.
    var bus: MasterBus = MasterBus { hp_hz: 0 };
    bus.apply(audio.output); apply_headroom(audio.output, default_headroom_db());
    verify(audio.sample_playback(table, 15000, true, 120));
    // The clip lasts 4000 frames: stay inside it.
    verify(audio.output.process(block, 1024) == 0);
    // -12 dB is x0.251: 0.5 reads 0.126.
    verify_eq_i32(126, audio.output.master_peak(0)); verify_eq_i32(63, audio.output.master_peak(1));
    apply_headroom(audio.output, 0);
    verify(audio.output.process(block, 1024) == 0);
    verify_eq_i32(500, audio.output.master_peak(0)); verify_eq_i32(250, audio.output.master_peak(1));
    // -6 dB headroom and Master volume 50 %: a quarter, after the volume's 30 ms glide.
    apply_headroom(audio.output, -6); bus.volume = 50; bus.apply(audio.output);
    verify(audio.output.process(block, 1024) == 0);
    audio.output.master_peak(0);
    verify(audio.output.process(block, 1024) == 0);
    verify_eq_i32(125, audio.output.master_peak(0));
    verify(audio.sample_playback(table, 16000, false, 120));
    block.close(); audio.release(); table.release(); clip.release();
}

#[test]
fn tui_mixer_meters_the_routed_channel_output() {
    var table: SequenceTable = SequenceTable::new();
    let area: Rect = Rect::new(0, 0, 120, 20);
    table.create_track_kind(false, true, area);            // destination channel
    table.create_track_kind(false, true, area);            // the track routed into it
    let source: i32 = i32(table.tracks.len()) - 1;
    let destination: i32 = source - 1;
    var clip: AudioClip = AudioClip { source: clone("embedded.wav"), channels: 2, sample_rate: 8000, frames: 4000, frames_per_row: 1000 };
    for _i in 0..4000 { clip.samples.push(0.5f); clip.samples.push(0.25f); }
    for _i in 0..4 { clip.peaks.push(WavePeak { left: 500, right: 250 }); }
    table.selected_row = 1; verify(table.insert_audio(clip, area));
    verify(table.set_track_output(source, destination + 1));
    let opened: result<AudioController, str8> = AudioController::new(8000, 128);
    var audio: AudioSystem = AudioSystem {}; audio.output = opened.unwrap();
    let allocated: result<PcmBlock, str8> = PcmBlock::new(1024); let block: PcmBlock = allocated.unwrap();
    audio.sync_volumes(table);
    verify(audio.sample_playback(table, 15000, true, 120));
    verify(audio.output.process(block, 1024) == 0);
    var mixer: Mixer = Mixer { visible: true };
    verify(mixer.update_channels(audio.output, 1000));
    // The destination holds no clip of its own, yet meters what feeds it.
    verify(mixer.level(destination, 100, 0, false, false) == 0);
    verify(mixer.channel_level(destination, 100, 0, false, false) > 0);
    verify(mixer.channel_level(destination, 100, 0, true, false) > 0);
    // Muting still reads silent, and a channel the engine does not buffer
    // keeps the simulated meter of its own notes and clips.
    verify(mixer.channel_level(destination, 100, 0, false, true) == 0);
    verify(mixer.channel_level(63, 100, 0, false, false) == mixer.level(63, 100, 0, false, false));
    block.close(); audio.release(); table.release(); clip.release();
}

extern fn mkdtemp(path: str8) -> str8;
extern fn rename(from: str8, to: str8) -> i32;

#[test]
fn tui_session_roundtrip() {
    let directory: str8 = clone("/private/tmp/mlacker-session-test-XXXXXX"); mkdtemp(directory);
    let path: str8 = format!("{}/roundtrip.mlack", directory);
    var library: PatternLibrary = PatternLibrary::new();
    var audio: AudioSystem = AudioSystem {}; var codec: SessionCodec = SessionCodec {};
    let area: Rect = Rect::new(0, 0, 120, 20);
    library.table.track_action(Action::AddNoteLine, area);
    verify(library.table.add_automation(0, "pitchbend") == 2);
    library.table.set_cell(3, library.table.automation_column(0, 2), clone("-5 . 7 ."));
    library.table.create_track_kind(false, true, area);
    var clip: AudioClip = AudioClip { source: clone("embedded-test.wav"), channels: 1, sample_rate: 8000, frames: 80, frames_per_row: 10 };
    for _i in 0..80 { clip.samples.push(0.5f); }
    for _i in 0..8 { clip.peaks.push(WavePeak { left: 500, right: 500, left_body: 500, right_body: 500 }); }
    for _i in 0..32 { clip.detail_peaks.push(WavePeak { left: 500, right: 500 }); }
    library.audio.samples.push(clip); library.table.selected_row = 7;
    verify(library.table.insert_audio(clip, area));
    library.table.selected_column = library.table.audio_offset_column(3);
    library.table.edit_event(decode_input("\r"), area); library.table.editor.set_text("-0.25"); library.table.edit_event(decode_input("\r"), area);
    library.table.group_detail_rows = 4; library.table.selected_group_detail = 2;
    let view: SessionView = SessionView { bpm: 147, beats: 7, unit: 8, pane: 1, sidebar: 1, mixer: true, meter_fps: 120, sample_zoom: 4, row: 7 };
    verify(codec.save(path, library, view, audio));
    let loaded: result<SessionData, str8> = SessionCodec::load(path); verify(loaded.is_ok());
    var restored: SessionData = loaded.unwrap();
    verify(restored.library.table.group_detail_rows == 4 && restored.library.table.selected_group_detail == 2);
    verify(restored.view.bpm == 147 && restored.view.beats == 7 && restored.view.sample_zoom == 4 && restored.view.meter_fps == 120);
    verify(restored.library.patterns.len() == 3 && restored.library.song.len() == 4);
    verify(restored.library.table.tracks.len() == 4 && restored.library.table.selected_row == 7);
    let track: SequenceTrack = restored.library.table.tracks[3];
    let placement: AudioInstance = track.instances[0]; verify(placement.start_row == 7 && placement.clip.frames == 80);
    verify(restored.library.table.audio_timing_offset(3, 7) == -3750);
    verify(placement.clip.samples[20] == 0.5f && restored.library.audio.samples.len() == 1);
    let midi: SequenceTrack = restored.library.table.tracks[0]; verify(midi.note_lines == 2 && midi.automation.len() == 2);
    let bend: AutomationSlot = midi.automation[1]; verify(bend.parameter == "pitchbend" && bend.minimum == -8192 && bend.maximum == 8191);
    let automated: TableRow = restored.library.table.rows[3];
    verify(automated.cells[restored.library.table.automation_column(0, 2)] == "-5 . 7 ." && track.automation.len() == 0);
    restored.release();
    // A rejected save must not truncate the previous valid session.
    verify(!codec.save(path, library, SessionView { bpm: 0 }, audio));
    let retained: result<SessionData, str8> = SessionCodec::load(path); verify(retained.is_ok());
    var valid: SessionData = retained.unwrap(); valid.release();
    library.release();
    let removed: result<i32, str8> = std::fs::remove_tree(directory); verify(removed.is_ok()); free(path); free(directory);
}

fn test_clip(source: str8, channels: i64, frames: i64) -> AudioClip {
    var clip: AudioClip = AudioClip { source: clone(source), channels: channels, sample_rate: 8000, frames: frames, frames_per_row: 10 };
    let count: i64 = frames * channels; let rows: i64 = frames / 10; let details: i64 = rows * 4;
    for i in 0..count { clip.samples.push(f32(i % 7) * 0.125f - 0.375f); }
    for _i in 0..rows { clip.peaks.push(WavePeak { left: 375, right: 375, left_body: 200, right_body: 200 }); }
    for _i in 0..details { clip.detail_peaks.push(WavePeak { left: 375, right: 375 }); }
    return clip;
}

#[test]
fn tui_sampler_slot_preset_keys_and_file() {
    // Keys name a field independently of the slot, so a preset loads into any slot.
    verify(SamplerView::slot_key(200, 0) == 200 * 64 && SamplerView::slot_key(207 + 6, 1) == 200 * 64 + 6);
    verify(SamplerView::slot_key(1512, 3) == 1500 * 64 && SamplerView::slot_key(2000 + 32 * 5 + 13, 5) == 2000 * 64 + 13);
    verify(SamplerView::slot_key(1512, 2) < 0 && SamplerView::slot_key(950, 0) < 0 && SamplerView::slot_key(1415, 3) < 0);
    verify(SamplerView::slot_id(1500 * 64 + 1, 3) == 1513 && SamplerView::slot_id(4000 * 64 + 7, 15) == 4000 + 32 * 15 + 7);
    verify(SamplerView::slot_id(1400 * 64 + 3, 0) < 0 && SamplerView::slot_id(950 * 64, 0) < 0);
    for s in 0..16 {
        for id in 200..4600 {
            let key: i64 = SamplerView::slot_key(wide(id), i32(s));
            if key >= 0 { verify(SamplerView::slot_id(key, i32(s)) == wide(id)); }
        }
    }
    let directory: str8 = clone("/private/tmp/mlacker-slot-test-XXXXXX"); mkdtemp(directory);
    let path: str8 = format!("{}/kick", directory);
    let clip: AudioClip = test_clip("/samples/kick.wav", 2, 40);
    let saved: PresetResult = SessionCodec::sampler_slot_file(path, "Mla Sampler", true, [1500 * 64, 200 * 64 + 1], [0.25, 0.75], clip, true);
    verify(saved.ok);
    let file: str8 = format!("{}.mlaslot", path);
    let loaded: PresetResult = SessionCodec::sampler_slot_file(file, "Mla Sampler", false, [], [], AudioClip {}, false);
    verify(loaded.ok && loaded.keys.len() == 2 && loaded.keys[1] == 200 * 64 + 1 && loaded.values[0] == 0.25);
    verify(loaded.clips.len() == 1 && loaded.clips[0].frames == 40 && loaded.clips[0].channels == 2 && loaded.clips[0].samples[5] == 0.25f);
    let foreign: PresetResult = SessionCodec::sampler_slot_file(file, "Mla Drum", false, [], [], AudioClip {}, false);
    verify(!foreign.ok && foreign.clips.len() == 0);
    // An empty slot saves without a sample.
    let empty: PresetResult = SessionCodec::sampler_slot_file(path, "Mla Sampler", true, [], [], AudioClip {}, false);
    verify(empty.ok);
    let reread: PresetResult = SessionCodec::sampler_slot_file(file, "Mla Sampler", false, [], [], AudioClip {}, false);
    verify(reread.ok && reread.keys.len() == 0 && reread.clips.len() == 0);
    let removed: result<i32, str8> = std::fs::remove_tree(directory); verify(removed.is_ok()); free(path); free(file); free(directory);
}

#[test]
fn tui_sampler_note_names_and_auto_map_plan() {
    verify(SamplerView::note_in_name("Piano_C4.wav") == 60 && SamplerView::note_in_name("Strings F#2.aif") == 42);
    verify(SamplerView::note_in_name("PianoEb3.wav") == 51 && SamplerView::note_in_name("Bass C-1.wav") == 0);
    verify(SamplerView::note_in_name("vox_a3_soft.wav") == 57 && SamplerView::note_in_name("Pad_G9.wav") == 127);
    verify(SamplerView::note_in_name("C4 then D5.wav") == 74 && SamplerView::note_in_name("Tone-C4v1.wav") == 60);
    // No note: a word, a number, a letter inside a word, past G9.
    verify(SamplerView::note_in_name("Cello.wav") < 0 && SamplerView::note_in_name("A440.wav") < 0);
    verify(SamplerView::note_in_name("Kick 808.wav") < 0 && SamplerView::note_in_name("Pad_B9.wav") < 0);
    verify(SamplerView::note_in_name("abc4.wav") < 0 && SamplerView::note_in_name("Take C.wav") < 0);
    // Lowest note first, unnamed files left out; zones reach up to the next
    // note. Files on one note share the first free group: a round-robin set.
    let files: list<str8> = ["Tone_G4.wav", "noise.wav", "Tone_C4.wav", "Tone_C5.wav", "Other_C4.wav"];
    let plan: list<AutoMapEntry> = SamplerView::auto_map_plan(files, [3, 5]);
    verify(plan.len() == 4);
    let a: AutoMapEntry = plan[0]; let b: AutoMapEntry = plan[1]; let c: AutoMapEntry = plan[2]; let d: AutoMapEntry = plan[3];
    verify(a.file == 2 && b.file == 4 && c.file == 0 && d.file == 3);
    verify(a.root == 60 && a.low == 0 && a.high == 66 && a.group == 3);
    verify(b.root == 60 && b.low == 0 && b.high == 66 && b.group == 3);
    verify(c.root == 67 && c.low == 67 && c.high == 71 && c.group == 0);
    verify(d.root == 72 && d.low == 72 && d.high == 127 && d.group == 0);
    // Out of free groups, a shared note plays as layers.
    let again: list<str8> = ["Tone_C4.wav", "Other_C4.wav"];
    let crowded: list<AutoMapEntry> = SamplerView::auto_map_plan(again, []);
    let first: AutoMapEntry = crowded[0]; verify(first.group == 0);
}

#[test]
fn tui_clip_slice_points() {
    var clip: AudioClip = AudioClip { source: clone("/loops/beat.wav"), channels: 1, sample_rate: 48000, frames: 48000, frames_per_row: 100 };
    // Silence with three bursts, at 12000, 24000 and 36000 frames.
    for f in 0..48000 {
        let burst: bool = (f >= 12000 && f < 14000) || (f >= 24000 && f < 26000) || (f >= 36000 && f < 38000);
        clip.samples.push(burst ? (f % 8 < 4 ? 0.8f : -0.8f) : 0.0f);
    }
    let equal: list<i64> = clip.slice_points(4, false);
    verify(equal.len() == 5 && equal[0] == 0 && equal[1] == 12000 && equal[3] == 36000 && equal[4] == 48000);
    // Each cut sits just before a burst, in order.
    let cuts: list<i64> = clip.slice_points(4, true);
    verify(cuts.len() == 5 && cuts[0] == 0 && cuts[4] == 48000);
    verify(cuts[1] >= 11936 && cuts[1] <= 12000 && cuts[2] >= 23936 && cuts[2] <= 24000 && cuts[3] >= 35936 && cuts[3] <= 36000);
    // Asked for more, only the three transients cut.
    let fewer: list<i64> = clip.slice_points(8, true); verify(fewer.len() == 5);
    let two: list<i64> = clip.slice_points(2, true); verify(two.len() == 3 && two[1] > 11700 && two[1] <= 36000);
    free(clip.source);
}

#[test]
fn tui_aux_routes_to_effect_channels() {
    let area: Rect = Rect::new(0, 0, 100, 12);
    var table: SequenceTable = SequenceTable::new();
    table.create_instrument_track(1, area);
    let index: i32 = i32(table.tracks.len()) - 1;
    // An aux bus can feed effect channel 3 (a send) or go nowhere.
    verify(table.set_aux_output(index, 8, -4) && table.track_aux_output(index, 8) == -4);
    verify(table.set_aux_output(index, 9, -10) && table.track_aux_output(index, 9) == -10);
    verify(!table.set_aux_output(index, 9, -11) && table.track_aux_output(index, 9) == -10);
    verify(table.set_aux_output(index, 8, -1) && table.track_aux_output(index, 8) == -1);
    table.release();
}

#[test]
fn tui_project_paths() {
    verify(is_project_path("/a/Song.mlaproj") && is_project_path("Song.MLAPROJ/") && !is_project_path("/a/Song.mlack"));
    let appended: str8 = project_folder("/a/Song//"); verify(appended == "/a/Song.mlaproj"); free(appended);
    let kept: str8 = project_folder("/a/Song.mlaproj/"); verify(kept == "/a/Song.mlaproj"); free(kept);
}

#[test]
fn tui_project_roundtrip_relocation_and_resave() {
    let directory: str8 = clone("/private/tmp/mlacker-project-test-XXXXXX"); mkdtemp(directory);
    let target: str8 = format!("{}/My song", directory);
    var library: PatternLibrary = PatternLibrary::new();
    var audio: AudioSystem = AudioSystem {}; var codec: SessionCodec = SessionCodec {};
    let area: Rect = Rect::new(0, 0, 120, 20);
    library.table.create_track_kind(false, true, area);
    // Two samples with the same file name must not overwrite each other.
    let clip: AudioClip = test_clip("/elsewhere/kick.wav", 2, 80);
    library.audio.samples.push(clip); library.audio.samples.push(test_clip("other/kick.wav", 1, 40));
    library.table.selected_row = 7; verify(library.table.insert_audio(clip, area));
    let saved: result<str8, str8> = codec.save_project(target, library, SessionView { bpm: 133 }, audio); verify(saved.is_ok());
    let folder: str8 = saved.unwrap();
    let expected: str8 = format!("{}/My song.mlaproj", directory); verify(folder == expected);
    let session: str8 = format!("{}/Project.mlack", folder); let first: str8 = format!("{}/Audio/kick.wav", folder);
    let second: str8 = format!("{}/Audio/kick 2.wav", folder); let presets: str8 = format!("{}/Presets", folder);
    verify(std::fs::file_exists(session) == 1 && std::fs::file_exists(first) == 1 && std::fs::file_exists(second) == 1 && std::fs::is_dir(presets) == 1);
    // Content paths are relative: the project opens after moving the folder.
    let parent: str8 = format!("{}/moved", directory); std::fs::mkdir_p(parent);
    let moved: str8 = format!("{}/Renamed.mlaproj", parent); verify(rename(folder, moved) == 0);
    let opened_path: str8 = format!("{}/", moved);
    let loaded: result<SessionData, str8> = SessionCodec::load_project(opened_path); verify(loaded.is_ok());
    var restored: SessionData = loaded.unwrap();
    verify(restored.view.bpm == 133 && restored.library.audio.samples.len() == 2);
    let sample: AudioClip = restored.library.audio.samples[0];
    let moved_audio: str8 = format!("{}/Audio/kick.wav", moved); verify(sample.source == moved_audio);
    verify(sample.channels == 2 && sample.frames == 80 && sample.frames_per_row == 10 && sample.peaks.len() == 8 && sample.detail_peaks.len() == 32);
    for i in 0..160 { verify(sample.samples[i] == clip.samples[i]); }
    let track: SequenceTrack = restored.library.table.tracks[restored.library.table.tracks.len() - 1];
    let placement: AudioInstance = track.instances[0]; verify(placement.start_row == 7 && placement.clip.frames == 80);
    // Saving over the opened project replaces it in place.
    let resaved: result<str8, str8> = codec.save_project(moved, restored.library, SessionView { bpm: 90 }, audio); verify(resaved.is_ok());
    let resaved_folder: str8 = resaved.unwrap(); verify(resaved_folder == moved); free(resaved_folder);
    restored.release();
    let staging: str8 = format!("{}.saving", moved); let previous: str8 = format!("{}.previous", moved);
    verify(std::fs::file_exists(staging) == 0 && std::fs::file_exists(previous) == 0);
    let reloaded: result<SessionData, str8> = SessionCodec::load_project(moved); verify(reloaded.is_ok());
    var again: SessionData = reloaded.unwrap(); verify(again.view.bpm == 90 && again.library.audio.samples.len() == 2); again.release();
    // A missing content file is named in the error.
    let moved_second: str8 = format!("{}/Audio/kick 2.wav", moved); std::fs::remove_tree(moved_second);
    let missing: result<SessionData, str8> = SessionCodec::load_project(moved); verify(missing.is_err());
    verify(std::strbuf::contains(missing.unwrap_err(), "Audio/kick 2.wav") == 1);
    // A plain .mlack loader rejects the project session and vice versa.
    let moved_session: str8 = format!("{}/Project.mlack", moved);
    let plain: result<SessionData, str8> = SessionCodec::load(moved_session); verify(plain.is_err());
    // A folder that is not a project is never replaced.
    let foreign: str8 = format!("{}/foreign.mlaproj", directory); std::fs::mkdir_p(foreign);
    let refused: result<str8, str8> = codec.save_project(foreign, library, SessionView {}, audio); verify(refused.is_err());
    let foreign_session: str8 = format!("{}/Project.mlack", foreign); verify(std::fs::is_dir(foreign) == 1 && std::fs::file_exists(foreign_session) == 0);
    library.release();
    std::fs::remove_tree(directory);
    free(foreign_session); free(foreign); free(moved_session); free(moved_second); free(staging); free(previous); free(moved_audio);
    free(opened_path); free(moved); free(parent); free(presets); free(second); free(first); free(session); free(expected); free(folder); free(target); free(directory);
}

#[test]
fn tui_session_empty_and_bad_file() {
    var library: PatternLibrary = PatternLibrary::empty(); var audio: AudioSystem = AudioSystem {}; var codec: SessionCodec = SessionCodec {};
    verify(library.table.tracks.len() == 0 && library.song.len() == 0 && library.audio.samples.len() == 0);
    let directory: str8 = clone("/private/tmp/mlacker-empty-test-XXXXXX"); mkdtemp(directory);
    let path: str8 = format!("{}/empty.mlack", directory);
    verify(codec.save(path, library, SessionView {}, audio));
    let loaded: result<SessionData, str8> = SessionCodec::load(path); verify(loaded.is_ok());
    var restored: SessionData = loaded.unwrap(); verify(restored.library.table.tracks.len() == 0); restored.release();
    std::fs::write_all_text(path, "not a session file and deliberately too short or malformed");
    let invalid: result<SessionData, str8> = SessionCodec::load(path); verify(invalid.is_err());
    library.release(); std::fs::remove_tree(directory); free(path); free(directory);
}

#[test]
fn tui_alternating_track_text() {
    var table: SequenceTable = SequenceTable::new(); let area: Rect = Rect::new(0, 0, 120, 10);
    let surface: Surface = Surface::new(120, 10); let theme: Theme = Theme::dark_blue();
    for stage in 0..3 {
        table.zoom_tracks(i32(stage), true, area);
        for selected in 0..3 {
            table.selected_column = table.track_start(i32(selected)); table.paint(surface, area, theme);
            let body: Rect = table.body(area);
            for t in 0..3 {
                let column: i32 = table.track_start(i32(t)); let x: i32 = table.column_x(column);
                let expected: i32 = t == 1 && t != selected ? darken(theme.foreground, 88) : theme.foreground;
                let cell: Cell = surface.cell(x, body.y); let stripe: Cell = surface.cell(x, body.y + 1);
                verify(cell.foreground == expected && stripe.foreground == expected);
                let vel: Cell = surface.cell(table.column_x(column + 1), body.y);
                verify(vel.foreground == (t == 1 ? darken(theme.foreground, 88) : theme.foreground));
            }
        }
        table.selected_column = table.track_start(1) + 1; table.paint(surface, area, theme);
        let body: Rect = table.body(area); let x: i32 = table.column_x(table.selected_column);
        let selected_vel: Cell = surface.cell(x, body.y); let selected_header: Cell = surface.cell(x, body.y - 1);
        verify(selected_vel.foreground == theme.foreground && selected_header.foreground == theme.accent);
    }
    var copy: SequenceTable = table.copy_pattern(); verify(copy.alternate_group_text); copy.release();
    surface.release(); table.release();
}

#[test]
fn tui_velocity_left_alignment() {
    var table: SequenceTable = SequenceTable::new();
    let area: Rect = Rect::new(0, 0, 120, 10);
    let surface: Surface = Surface::new(120, 10);
    let values: array<str8, 4> = {"0", "7", "42", "127"};
    let first_glyphs: array<i32, 4> = {48, 55, 52, 49};
    for t in 0..3 {
        table.selected_column = table.track_start(i32(t)) + 1;
        for r in 0..4 {
            table.selected_row = i32(r); table.edit_event(decode_input("\r"), area);
            table.editor.set_text(values[r]); table.edit_event(decode_input("\r"), area);
        }
    }
    for stage in 0..3 {
        table.zoom_tracks(i32(stage), true, area);
        table.paint(surface, area, Theme::dark_blue());
        table.paint_note_lengths(surface, area, Theme::dark_blue());
        let body: Rect = table.body(area);
        for t in 0..3 {
            let x: i32 = table.column_x(table.track_start(i32(t)) + 1);
            let header: Cell = surface.cell(x, body.y - 1); verify(header.glyph == 86);
            for r in 0..4 {
                let value: Cell = surface.cell(x, body.y + i32(r)); verify(value.glyph == first_glyphs[r]);
                let trailing: Cell = surface.cell(x + 3, body.y + i32(r)); verify(trailing.glyph == 32);
                let extra: Cell = surface.cell(x + 4, body.y + i32(r)); verify(extra.glyph == 32);
                let note: Cell = surface.cell(x - 6, body.y + i32(r));
                let rail: Cell = surface.cell(x - 1, body.y + i32(r));
                verify(rail.glyph == 0x2847 && rail.background == note.background);
            }
        }
        table.selected_column = 1;
        table.paint(surface, area, Theme::dark_blue()); table.paint_note_lengths(surface, area, Theme::dark_blue());
        let selected_note: Cell = surface.cell(table.column_x(1), body.y);
        let selected_rail: Cell = surface.cell(table.column_x(1) + 5, body.y);
        verify(selected_note.background == selected_rail.background);
    }
    surface.release(); table.release();
}

#[test]
fn tui_pattern_visual_clipboard() {
    var table: SequenceTable = SequenceTable::new(); let area: Rect = Rect::new(0, 0, 80, 20);
    table.selected_row = 0; table.selected_column = 1;
    table.edit_event(decode_input("v"), area); table.edit_event(decode_input("l"), area); table.edit_event(decode_input("j"), area);
    verify(table.visual && table.visual_cell(0, 1) && table.visual_cell(1, 2) && !table.visual_cell(2, 2));
    let surface: Surface = Surface::new(80, 20); table.paint(surface, area, Theme::dark_blue());
    let body: Rect = table.body(area);
    let selected: Cell = surface.cell(table.column_x(1), body.y);
    let other: Cell = surface.cell(table.column_x(6), body.y);
    verify(selected.background != other.background); surface.release();
    table.edit_event(decode_input("y"), area);
    verify(!table.visual && table.clipboard.len() == 2 && table.clipboard_kinds.len() == 2);
    let source: TableRow = table.rows[0]; let expected_note: str8 = clone(source.cells[1]); let expected_vel: str8 = clone(source.cells[2]);
    table.selected_row = 4; table.clear_row(); table.selected_row = 5; table.clear_row();
    table.selected_row = 4; table.selected_column = 6; table.edit_event(decode_input("p"), area);
    verify(!table.paste_error); let pasted: TableRow = table.rows[4];
    verify(pasted.cells[6] == expected_note && pasted.cells[7] == expected_vel && pasted.cells[8] == "1.00");
    table.selected_column = 7; table.edit_event(decode_input("p"), area);
    verify(table.paste_error); let unchanged: TableRow = table.rows[4]; verify(unchanged.cells[7] == expected_vel);
    table.selected_column = 7; table.selected_row = 5;
    table.edit_event(decode_input("v"), area); table.edit_event(decode_input("h"), area); table.edit_event(decode_input("k"), area);
    table.edit_event(decode_input("d"), area);
    verify(table.rows.len() == 64 && !table.visual); let cleared: TableRow = table.rows[4];
    verify(cleared.cells[6] == "" && cleared.cells[7] == "");
    table.edit_event(decode_input("p"), area); let restored: TableRow = table.rows[4]; verify(restored.cells[6] == expected_note && restored.cells[7] == expected_vel);
    table.selected_row = i32(table.rows.len()) - 1; table.edit_event(decode_input("p"), area); verify(table.paste_error);
    table.edit_event(decode_input("v"), area); table.edit_event(InputEvent { kind: InputKind::Menu, key: Key::Escape }, area); verify(!table.visual);
    free(expected_note); free(expected_vel); table.release();
}

#[test]
fn tui_pattern_visual_atomic_and_new_velocity() {
    var table: SequenceTable = SequenceTable::new(); let area: Rect = Rect::new(0, 0, 80, 20);
    table.selected_row = 0; table.selected_column = 1;
    table.edit_event(decode_input("v"), area); table.edit_event(decode_input("l"), area); table.edit_event(decode_input("y"), area);
    let copied: TableRow = table.clipboard[0]; free(copied.cells[1]);
    table.clipboard = [TableRow { cells: [copied.cells[0], clone("999")] }];
    table.selected_row = 4; table.selected_column = 1; table.clear_row();
    table.edit_event(decode_input("p"), area); verify(table.paste_error);
    let unchanged: TableRow = table.rows[4]; verify(unchanged.cells[1] == "" && unchanged.cells[2] == "");
    table.selected_column = 2; table.edit_event(decode_input("\r"), area); table.editor.set_text("12"); table.edit_event(decode_input("\r"), area);
    table.selected_column = 1; table.edit_event(decode_input("K"), area);
    let inserted: TableRow = table.rows[4]; verify(inserted.cells[1] == "C-4" && inserted.cells[2] == "100");
    table.release();
    var library: PatternLibrary = PatternLibrary::new(); library.table.selected_row = 0; library.table.selected_column = 1;
    library.table.edit_event(decode_input("v"), area); library.table.edit_event(decode_input("y"), area);
    library.select(2); verify(library.table.clipboard.len() == 1);
    library.table.selected_row = 4; library.table.selected_column = 1; library.table.edit_event(decode_input("p"), area);
    verify(!library.table.paste_error); library.release();
}

#[test]
fn tui_track_zoom_stages() {
    var table: SequenceTable = SequenceTable::new(); let area: Rect = Rect::new(0, 0, 80, 12);
    verify(table.total_width() == 37);
    let length: TableColumn = table.columns[3]; let cc: TableColumn = table.columns[5]; verify(length.hidden && cc.hidden);
    table.edit_event(decode_input("l"), area); verify(table.selected_column == 2);
    table.edit_event(decode_input("l"), area); verify(table.selected_column == 6);
    table.edit_event(decode_input("h"), area); verify(table.selected_column == 2);
    table.selected_column = 1; table.edit_event(decode_input("z"), area);
    verify(table.total_width() == 49);
    let shown_length: TableColumn = table.columns[3]; let hidden_cc: TableColumn = table.columns[5]; verify(!shown_length.hidden && hidden_cc.hidden);
    table.selected_column = 4; table.edit_event(decode_input("z"), area); verify(table.total_width() == 55 && table.selected_column == 4);
    table.edit_event(decode_input("z"), area); verify(table.total_width() == 37 && table.selected_column == 1);
    table.edit_event(decode_input("Z"), area); verify(table.total_width() == 73);
    table.edit_event(decode_input("z"), area);
    table.edit_event(decode_input("\x1b[122;2u"), area);
    let first: SequenceTrack = table.tracks[0]; let second: SequenceTrack = table.tracks[1];
    verify(first.zoom_stage == 0 && second.zoom_stage == 2);
    table.track_action(Action::CollapseNoteLines, area); verify(table.total_width() == 37);
    table.track_action(Action::ExpandNoteLines, area); verify(table.total_width() == 91);
    let data: TableRow = table.rows[0]; verify(data.cells[3] == "1.00" && data.cells[4] == "0.00");
    table.selected_column = 5; table.track_action(Action::CollapseNoteLines, area); verify(table.selected_column == 1);
    table.note_line_action(80, area); verify(table.total_width() == 48);
    table.edit_event(decode_input("l"), area); verify(table.selected_column == 6);
    table.edit_event(decode_input("l"), area); verify(table.selected_column == 10);
    // Collapsing a selected LEN returns to NOTE in the same note line/track.
    table.selected_column = 5; table.edit_event(decode_input("z"), area);
    table.selected_column = 7; table.track_action(83, area); verify(table.selected_column == 5);
    table.edit_event(decode_input("z"), area);
    var copy: SequenceTable = table.copy_pattern(); let saved: SequenceTrack = copy.tracks[0]; verify(saved.zoom_stage == 1);
    table.track_action(83, area); let still_saved: SequenceTrack = copy.tracks[0]; verify(still_saved.zoom_stage == 1);
    copy.create_track(true, area); let cloned: SequenceTrack = copy.tracks[3]; verify(cloned.zoom_stage == 1);
    table.create_track_kind(false, true, area); table.edit_event(decode_input("z"), area);
    table.edit_event(decode_input("Z"), area); let audio: SequenceTrack = table.tracks[3]; verify(audio.audio && audio.zoom_stage == 0);
    table.release(); copy.release();
}

fn visual_pair(column: i32, first: str8, second: str8) -> SequenceTable {
    var table: SequenceTable = SequenceTable::new(); let area: Rect = Rect::new(0, 0, 120, 20);
    table.zoom_tracks(2, true, area); table.selected_column = column;
    for r in 0..3 {
        table.selected_row = i32(r); table.edit_event(decode_input("\r"), area);
        table.editor.set_text(r == 0 ? first : (r == 1 ? second : ""));
        table.edit_event(decode_input("\r"), area); verify(!table.editing);
    }
    table.selected_row = 0; table.edit_event(decode_input("v"), area);
    table.edit_event(decode_input("j"), area); table.edit_event(decode_input("j"), area);
    return table;
}

#[test]
fn tui_visual_whole_rows() {
    let area: Rect = Rect::new(0, 0, 80, 12); var table: SequenceTable = SequenceTable::new();
    table.selected_column = 7; table.selected_row = 2;
    table.edit_event(decode_input("V"), area); table.edit_event(decode_input("k"), area);
    table.edit_event(decode_input("h"), area);
    verify(table.visual_rows && table.visual_cell(1, 1) && table.visual_cell(2, 15) && !table.visual_cell(0, 1));
    let surface: Surface = Surface::new(80, 12); table.paint(surface, area, Theme::dark_blue());
    let body: Rect = table.body(area); let mark: Cell = surface.cell(0, body.y + 2); let outside: Cell = surface.cell(0, body.y);
    verify(mark.background != outside.background); surface.release();
    table.edit_event(decode_input("y"), area);
    verify(!table.visual && table.clipboard_rows && table.clipboard.len() == 2 && table.clipboard_kinds.len() == 15);
    table.edit_event(decode_input("\x1b[118;2u"), area); table.edit_event(decode_input("j"), area); table.edit_event(decode_input("d"), area);
    verify(table.rows.len() == 64 && !table.visual);
    for r in 1..3 { let row: TableRow = table.rows[r]; for c in 1..row.cells.len() { verify(row.cells[c] == ""); } }
    table.edit_event(decode_input("p"), area); verify(!table.paste_error);
    let restored: TableRow = table.rows[1]; verify(restored.cells[1] == "C-4" && restored.cells[3] == "1.00" && restored.cells[14] == "0.00");
    table.edit_event(decode_input("V"), area); table.edit_event(decode_input("K"), area);
    verify(table.visual && table.visual_rows); let shifted: TableRow = table.rows[1]; verify(shifted.cells[1] == "C#4" && shifted.cells[3] == "1.00");
    table.edit_event(decode_input("V"), area); verify(!table.visual); table.release();
    var library: PatternLibrary = PatternLibrary::new(); library.table.selected_column = 2;
    library.table.edit_event(decode_input("V"), area); library.table.edit_event(decode_input("y"), area);
    library.select(2); verify(library.table.clipboard_rows);
    library.table.selected_row = 4; library.table.selected_column = 1; library.table.edit_event(decode_input("p"), area);
    verify(!library.table.paste_error); library.release();
}

#[test]
fn tui_visual_transpose_note_and_velocity_bounds() {
    let area: Rect = Rect::new(0, 0, 120, 20);
    var notes: SequenceTable = visual_pair(1, "F#9", "G-9");
    let revision: i64 = notes.revision;
    notes.edit_event(decode_input("K"), area);
    let high: TableRow = notes.rows[0]; verify(high.cells[1] == "F#9" && notes.revision == revision);
    notes.edit_event(decode_input("J"), area);
    let first: TableRow = notes.rows[0]; let second: TableRow = notes.rows[1]; let empty: TableRow = notes.rows[2];
    verify(first.cells[1] == "F-9" && second.cells[1] == "F#9" && empty.cells[1] == "");
    verify(first.cells[2] == "100" && notes.visual && notes.anchor_row == 0 && notes.selected_row == 2);
    notes.edit_event(decode_input("\x1b[107;2u"), area); let restored: TableRow = notes.rows[1]; verify(restored.cells[1] == "G-9");
    notes.release();
    var low: SequenceTable = visual_pair(1, "C--1", "C#-1"); low.edit_event(decode_input("J"), area);
    let unchanged: TableRow = low.rows[1]; verify(unchanged.cells[1] == "C#-1");
    low.edit_event(decode_input("K"), area); let moved: TableRow = low.rows[0]; verify(moved.cells[1] == "C#-1"); low.release();
    var velocity: SequenceTable = visual_pair(2, "126", "127"); velocity.edit_event(decode_input("K"), area);
    let vmax: TableRow = velocity.rows[0]; verify(vmax.cells[2] == "126");
    velocity.edit_event(decode_input("\x1b[106;2u"), area); let vdown: TableRow = velocity.rows[0]; verify(vdown.cells[2] == "125"); velocity.release();
    var vlow: SequenceTable = visual_pair(2, "0", "1"); vlow.edit_event(decode_input("J"), area);
    let vmin: TableRow = vlow.rows[1]; verify(vmin.cells[2] == "1"); vlow.release();
}

#[test]
fn tui_visual_transpose_length_offset_and_atomicity() {
    let area: Rect = Rect::new(0, 0, 120, 20);
    var length: SequenceTable = visual_pair(3, "16383.99", "16384.00"); length.edit_event(decode_input("K"), area);
    let top: TableRow = length.rows[0]; verify(top.cells[3] == "16383.99");
    length.edit_event(decode_input("J"), area); let down: TableRow = length.rows[0]; verify(down.cells[3] == "16383.98"); length.release();
    var minimum: SequenceTable = visual_pair(3, "0.01", "0.02"); minimum.edit_event(decode_input("J"), area);
    let bottom: TableRow = minimum.rows[1]; verify(bottom.cells[3] == "0.02"); minimum.release();
    var offset: SequenceTable = visual_pair(4, "16383.99", "16384.00"); offset.edit_event(decode_input("K"), area);
    let omax: TableRow = offset.rows[0]; verify(omax.cells[4] == "16383.99"); offset.release();
    var negative: SequenceTable = visual_pair(4, "-16384.00", "-16383.99"); negative.edit_event(decode_input("J"), area);
    let omin: TableRow = negative.rows[1]; verify(omin.cells[4] == "-16383.99");
    negative.edit_event(decode_input("K"), area); let oup: TableRow = negative.rows[0]; verify(oup.cells[4] == "-16383.99"); negative.release();
    var mixed: SequenceTable = visual_pair(1, "C-4", "D-4");
    mixed.visual = false; mixed.selected_column = 2; mixed.selected_row = 1;
    mixed.edit_event(decode_input("\r"), area); mixed.editor.set_text("127"); mixed.edit_event(decode_input("\r"), area);
    mixed.selected_column = 1; mixed.selected_row = 0; mixed.edit_event(decode_input("v"), area);
    mixed.edit_event(decode_input("l"), area); mixed.edit_event(decode_input("j"), area); mixed.edit_event(decode_input("K"), area);
    let blocked: TableRow = mixed.rows[0]; verify(blocked.cells[1] == "C-4" && blocked.cells[2] == "100");
    mixed.edit_event(decode_input("J"), area); let changed: TableRow = mixed.rows[0];
    verify(changed.cells[1] == "B-3" && changed.cells[2] == "99" && changed.cells[3] == "1.00"); mixed.release();
}

#[test]
fn tui_instrument_tracks_and_routing() {
    let area: Rect = Rect::new(0, 0, 100, 12);
    var library: PatternLibrary = PatternLibrary::new();
    library.add_instrument(1, "Synth one");
    verify(library.instruments_mode && library.selected_instrument() == 1);
    library.table.create_instrument_track(library.selected_instrument(), area);
    let track: SequenceTrack = library.table.tracks[3];
    verify(track.instrument && !track.audio && track.instrument_id == 1);
    // Isolate one note on the instrument track.
    for r in 0..64 { library.table.selected_row = i32(r); library.table.clear_row(); }
    library.table.selected_row = 0;
    library.table.edit_event(decode_input("\r"), area); library.table.editor.set_text("C-4"); library.table.edit_event(decode_input("\r"), area);
    library.table.selected_column = library.table.selected_column + 1;
    library.table.edit_event(decode_input("\r"), area); library.table.editor.set_text("100"); library.table.edit_event(decode_input("\r"), area);
    var playback: NotePlayback = NotePlayback {};
    playback.update(library.table, 0, true);
    verify(playback.events.len() == 1);
    let on: NoteEvent = playback.events[0]; verify(on.instrument == 1 && on.on == 1);
    library.add_instrument(2, "Synth two");
    let assigned: SequenceTrack = library.table.tracks[3]; verify(assigned.instrument_id == 2);
    playback.update(library.table, 15000, false);
    let off: NoteEvent = playback.events[0]; verify(off.instrument == 1 && off.on == 0);
    library.table.create_track(true, area);
    let duplicate: SequenceTrack = library.table.tracks[4]; verify(duplicate.instrument && duplicate.instrument_id == 2);
    var copied: SequenceTable = library.table.copy_pattern();
    let copied_track: SequenceTrack = copied.tracks[4]; verify(copied_track.instrument && copied_track.instrument_id == 2);
    library.select(2); library.select(1);
    let saved: SequenceTrack = library.table.tracks[4]; verify(saved.instrument && saved.instrument_id == 2);
    library.show_patterns(); verify(!library.instruments_mode);
    library.show_instruments(); library.on_event(decode_input("gg"), area);
    library.instruments.selected = 0; library.on_event(decode_input("\r"), area);
    let selected: SequenceTrack = library.table.tracks[4]; verify(selected.instrument_id == 1);
    library.show_audio(); verify(!library.instruments_mode && library.audio_mode);
    copied.release(); library.release();
}

#[test]
fn tui_pattern_controller_events() {
    let area: Rect = Rect::new(0, 0, 120, 12);
    var table: SequenceTable = SequenceTable::new();
    for r in 0..64 { table.selected_row = i32(r); table.clear_row(); }
    table.create_instrument_track(2, area); table.zoom_tracks(2, true, area);
    verify(table.add_automation(3, "cc:74") == 2);
    table.selected_row = 0; table.selected_column = table.automation_column(3, 1);
    table.edit_event(decode_input("\r"), area); table.editor.set_text("127"); table.edit_event(decode_input("\r"), area);
    table.selected_column = table.automation_column(3, 2);
    table.edit_event(decode_input("\r"), area); table.editor.set_text("64"); table.edit_event(decode_input("\r"), area);
    table.selected_row = 1; table.selected_column = table.automation_column(3, 1);
    table.edit_event(decode_input("\r"), area); table.editor.set_text("0"); table.edit_event(decode_input("\r"), area);
    table.zoom_tracks(0, true, area); // hidden automation still plays without notes
    var playback: NotePlayback = NotePlayback {};
    playback.update(table, 0, true); verify(playback.events.len() == 2 && playback.active.len() == 0);
    let first: NoteEvent = playback.events[0]; let second: NoteEvent = playback.events[1];
    verify(first.on == 2 && first.note == 1 && first.velocity == 127 && first.instrument == 2);
    verify(second.on == 2 && second.note == 74 && second.velocity == 64 && second.tick == 0);
    playback.update(table, 0, true); verify(playback.events.len() == 0);
    playback.update(table, 30000, true); verify(playback.events.len() == 1);
    let zero: NoteEvent = playback.events[0]; verify(zero.velocity == 0 && zero.tick == 15000);
    playback.update(table, 960000, true); verify(playback.events.len() == 2);
    playback.update(table, 960000, false); verify(playback.events.len() == 0);
    verify(table.configure_slot(1, "pitchbend"));
    playback.update(table, 15000, true); verify(playback.events.len() == 1);
    let bend: NoteEvent = playback.events[0]; verify(bend.note == 129 && bend.velocity == 8192);
    playback.update(table, 15000, false);
    verify(table.configure_slot(1, "custom:0:127"));
    playback.update(table, 15000, true); verify(playback.events.len() == 0);
    table.release();
}

#[test]
fn tui_note_duration_and_events() {

    verify(duration_ticks("1.00") == 15000 && duration_ticks("0.5") == 7500 && duration_ticks("3.75") == 56250);
    verify(duration_ticks("0") == -1 && duration_ticks("-1") == -1 && duration_ticks("1x25") == -1 && duration_ticks("1.001") == -1);
    let area: Rect = Rect::new(0, 0, 100, 12);
    var table: SequenceTable = SequenceTable::new(); table.zoom_tracks(2, true, Rect::new(0, 0, 120, 12));
    for r in 0..64 { table.selected_row = i32(r); table.clear_row(); }
    table.selected_row = 0; table.selected_column = 1; table.edit_event(decode_input("\r"), area); table.editor.set_text("C-4"); table.edit_event(decode_input("\r"), area); verify(!table.editing);
    let initial: TableRow = table.rows[0]; verify(initial.cells[3] == "1.00");
    table.selected_row = 0; table.selected_column = 2; table.edit_event(decode_input("\r"), area); table.editor.set_text("100"); table.edit_event(decode_input("\r"), area); verify(!table.editing); table.selected_row = 0; table.selected_column = 3; table.edit_event(decode_input("\r"), area); table.editor.set_text("3.75"); table.edit_event(decode_input("\r"), area); verify(!table.editing);
    table.selected_row = 1; table.selected_column = 1; table.edit_event(decode_input("\r"), area); table.editor.set_text("D-4"); table.edit_event(decode_input("\r"), area); verify(!table.editing); table.selected_row = 1; table.selected_column = 2; table.edit_event(decode_input("\r"), area); table.editor.set_text("80"); table.edit_event(decode_input("\r"), area); verify(!table.editing); table.selected_row = 1; table.selected_column = 3; table.edit_event(decode_input("\r"), area); table.editor.set_text("0.50"); table.edit_event(decode_input("\r"), area); verify(!table.editing);
    var playback: NotePlayback = NotePlayback {};

    playback.update(table, 0, true); verify(playback.events.len() == 1 && playback.active.len() == 1);
    let on: NoteEvent = playback.events[0]; verify(on.on == 1 && on.note == 60 && on.tick == 0);
    playback.update(table, 15000, true); verify(playback.events.len() == 1 && playback.active.len() == 2);
    playback.update(table, 22499, true); verify(playback.events.len() == 0);
    playback.update(table, 22500, true); verify(playback.events.len() == 1 && playback.active.len() == 1);
    let short_off: NoteEvent = playback.events[0]; verify(short_off.on == 0 && short_off.note == 62 && short_off.tick == 22500);
    playback.update(table, 56249, true); verify(playback.active.len() == 1 && playback.events.len() == 0);
    playback.update(table, 56250, true); verify(playback.active.len() == 0);

    let off: NoteEvent = playback.events[0]; verify(off.on == 0 && off.note == 60 && off.tick == 56250);
    // A late UI update still emits exact, ordered musical timestamps.
    playback.update(table, 0, false); playback.update(table, 0, true); playback.update(table, 60000, true);
    verify(playback.events.len() == 3);
    let late: NoteEvent = playback.events[2]; verify(late.tick == 56250 && late.on == 0);
    playback.update(table, 0, false); playback.update(table, 0, true); playback.update(table, 100, false);
    verify(playback.active.len() == 0 && playback.events.len() == 1);

    // Same-pitch overlap cannot send an early note-off for the longer voice.
    table.selected_row = 1; table.selected_column = 1; table.edit_event(decode_input("\r"), area); table.editor.set_text("C-4"); table.edit_event(decode_input("\r"), area); verify(!table.editing); playback.update(table, 0, true); playback.update(table, 22500, true);
    verify(playback.events.len() == 1 && playback.active.len() == 1);
    playback.update(table, 56250, true); verify(playback.events.len() == 1);

    let surface: Surface = Surface::new(100, 12); table.selected_row = 0; table.selected_column = 1; table.scroll_y = 0;
    table.paint(surface, area, Theme::dark_blue()); table.paint_note_lengths(surface, area, Theme::dark_blue());
    let x: i32 = table.column_x(1) + 5; let body: Rect = table.body(area);
    let full: Cell = surface.cell(x, body.y + 2); let partial: Cell = surface.cell(x, body.y + 3); let rest: Cell = surface.cell(x, body.y + 4);
    verify(full.glyph == 0x2847 && partial.glyph == 0x2807 && rest.glyph == 32);
    // A note begun at the last row is not cut at the pattern loop boundary.
    table.selected_row = 0; table.clear_row(); table.selected_row = 1; table.clear_row(); table.set_length(4, area);
    table.selected_row = 3; table.selected_column = 1;
    table.edit_event(decode_input("\r"), area); table.editor.set_text("E-4"); table.edit_event(decode_input("\r"), area);
    table.selected_column = 2; table.edit_event(decode_input("\r"), area); table.editor.set_text("100"); table.edit_event(decode_input("\r"), area);
    table.selected_column = 3; table.edit_event(decode_input("\r"), area); table.editor.set_text("1.50"); table.edit_event(decode_input("\r"), area);
    playback.update(table, 45000, false); playback.update(table, 45000, true);
    playback.update(table, 60000, true); verify(playback.active.len() == 1 && playback.events.len() == 0);
    playback.update(table, 67500, true); verify(playback.active.len() == 0 && playback.events.len() == 1);
    let loop_off: NoteEvent = playback.events[0]; verify(loop_off.note == 64 && loop_off.tick == 67500 && loop_off.on == 0);
    surface.release(); table.release();
}

#[test]
fn tui_note_offsets() {
    verify(offset_ticks("-0.50") == -7500 && offset_ticks("+0.50") == 7500);
    verify(offset_ticks("") == 0 && offset_ticks("-0.00") == 0 && offset_ticks("0") == 0);
    verify(offset_ticks("-16384.00") == -245760000 && offset_ticks("16384.01") < -245760000);
    verify(offset_ticks("0.001") < -245760000 && offset_ticks("1x25") < -245760000);
    let area: Rect = Rect::new(0, 0, 120, 12);
    var table: SequenceTable = SequenceTable::new(); table.zoom_tracks(2, true, Rect::new(0, 0, 120, 12));
    for r in 0..64 { table.selected_row = i32(r); table.clear_row(); }
    table.set_length(4, area); table.selected_row = 0; table.selected_column = 1;
    table.edit_event(decode_input("K"), area);
    let initial: TableRow = table.rows[0]; verify(initial.cells[3] == "1.00" && initial.cells[4] == "0.00");
    table.selected_column = 2; table.edit_event(decode_input("\r"), area); table.editor.set_text("100"); table.edit_event(decode_input("\r"), area);
    table.selected_column = 3; table.edit_event(decode_input("\r"), area); table.editor.set_text("0.50"); table.edit_event(decode_input("\r"), area);
    table.selected_column = 4; table.edit_event(decode_input("J"), area);
    let negative: TableRow = table.rows[0]; verify(negative.cells[4] == "-0.01");
    table.edit_event(decode_input("K"), area); let zero: TableRow = table.rows[0]; verify(zero.cells[4] == "0.00");
    table.edit_event(decode_input("\r"), area); table.editor.set_text("+0.50"); table.edit_event(decode_input("\r"), area); verify(!table.editing);
    table.selected_row = 2; table.selected_column = 1; table.edit_event(decode_input("\r"), area); table.editor.set_text("D-4"); table.edit_event(decode_input("\r"), area);
    table.selected_column = 2; table.edit_event(decode_input("\r"), area); table.editor.set_text("80"); table.edit_event(decode_input("\r"), area);
    table.selected_column = 4; table.edit_event(decode_input("\r"), area); table.editor.set_text("-0.50"); table.edit_event(decode_input("\r"), area);
    var playback: NotePlayback = NotePlayback {};
    playback.update(table, 0, true); verify(playback.events.len() == 0);
    playback.update(table, 7499, true); verify(playback.events.len() == 0);
    playback.update(table, 7500, true); verify(playback.events.len() == 1);
    let delayed: NoteEvent = playback.events[0]; verify(delayed.note == 60 && delayed.on == 1 && delayed.tick == 7500);
    playback.update(table, 14999, true); verify(playback.active.len() == 1);
    playback.update(table, 15000, true); let delayed_off: NoteEvent = playback.events[0]; verify(delayed_off.on == 0 && delayed_off.tick == 15000);
    playback.update(table, 22500, true); let early: NoteEvent = playback.events[0]; verify(early.note == 62 && early.on == 1 && early.tick == 22500);
    playback.update(table, 37499, true); verify(playback.active.len() == 1);
    playback.update(table, 37500, true); let early_off: NoteEvent = playback.events[0]; verify(early_off.on == 0 && early_off.tick == 37500);
    let surface: Surface = Surface::new(120, 12); let theme: Theme = Theme::dark_blue();
    table.selected_row = 0; table.selected_column = 1; table.paint(surface, area, theme); table.paint_note_lengths(surface, area, theme);
    let body: Rect = table.body(area); let x: i32 = table.column_x(1) + 5;
    let late_start: Cell = surface.cell(x, body.y); let early_start: Cell = surface.cell(x, body.y + 1); let early_end: Cell = surface.cell(x, body.y + 2);
    verify(late_start.glyph == 0x2844 && early_start.glyph == 0x2844 && early_end.glyph == 0x2803);
    var mixer: Mixer = Mixer {};
    for _i in 0..30 { mixer.update(table, 1, 7500, true, 10); }
    verify(mixer.level(0, 100, 0, false, false) == 629); // row 2's early note, before its row
    // Selecting OFF identifies the whole note line for duplication.
    table.selected_column = 4; table.track_action(82, area);
    let duplicated: TableRow = table.rows[2]; verify(duplicated.cells[4] == "-0.50" && duplicated.cells[8] == "-0.50");
    table.track_action(81, area);
    table.selected_row = 2; table.clear_row(); table.selected_row = 0; table.selected_column = 4;
    table.edit_event(decode_input("\r"), area); table.editor.set_text("-0.25"); table.edit_event(decode_input("\r"), area);
    playback.update(table, 0, false); playback.update(table, 0, true); verify(playback.events.len() == 0);
    playback.update(table, 56249, true); verify(playback.events.len() == 0);
    playback.update(table, 56250, true); let next_loop: NoteEvent = playback.events[0]; verify(next_loop.on == 1 && next_loop.tick == 56250);
    playback.update(table, 63750, true); let loop_off: NoteEvent = playback.events[0]; verify(loop_off.on == 0 && loop_off.tick == 63750);
    // A positive offset beyond one pattern must not fire in the first loop.
    table.edit_event(decode_input("\r"), area); table.editor.set_text("4.50"); table.edit_event(decode_input("\r"), area);
    playback.update(table, 0, false); playback.update(table, 0, true); playback.update(table, 67499, true); verify(playback.events.len() == 0);
    playback.update(table, 67500, true); let later_loop: NoteEvent = playback.events[0]; verify(later_loop.on == 1 && later_loop.tick == 67500);
    // Editing OFF while running invalidates future onsets, not active LEN gates.
    playback.update(table, 0, false);
    table.edit_event(decode_input("\r"), area); table.editor.set_text("1.00"); table.edit_event(decode_input("\r"), area);
    playback.update(table, 0, true); playback.update(table, 5000, true);
    table.edit_event(decode_input("\r"), area); table.editor.set_text("1.50"); table.edit_event(decode_input("\r"), area);
    playback.update(table, 15000, true); verify(playback.events.len() == 0);
    playback.update(table, 22500, true); let revised: NoteEvent = playback.events[0]; verify(revised.on == 1 && revised.tick == 22500);
    // Later rows may start first; a late update must retain event order.
    table.selected_row = 3; table.selected_column = 1; table.edit_event(decode_input("\r"), area); table.editor.set_text("D-4"); table.edit_event(decode_input("\r"), area);
    table.selected_column = 2; table.edit_event(decode_input("\r"), area); table.editor.set_text("90"); table.edit_event(decode_input("\r"), area);
    table.selected_column = 4; table.edit_event(decode_input("\r"), area); table.editor.set_text("-2.00"); table.edit_event(decode_input("\r"), area);
    playback.update(table, 0, false); playback.update(table, 0, true); playback.update(table, 30000, true);
    verify(playback.events.len() == 4);
    let first_event: NoteEvent = playback.events[0]; let second_event: NoteEvent = playback.events[1];
    verify(first_event.note == 62 && first_event.tick == 15000 && second_event.note == 60 && second_event.tick == 22500);
    var copy: SequenceTable = table.copy_pattern();
    table.edit_event(decode_input("K"), area); let saved_offset: TableRow = copy.rows[3]; verify(saved_offset.cells[4] == "-2.00"); copy.release();
    table.edit_event(decode_input("\r"), area); table.editor.set_text("0.001"); table.edit_event(decode_input("\r"), area); verify(table.editing);
    table.edit_event(InputEvent { kind: InputKind::Menu, key: Key::Escape }, area);
    surface.release(); table.release();
}

#[test]
fn tui_pattern_length() {
    let area: Rect = Rect::new(0, 0, 80, 12);
    var table: SequenceTable = SequenceTable::new(); table.zoom_tracks(2, true, Rect::new(0, 0, 120, 12));
    verify(table.length_truncates_data(32));
    verify(!table.set_length(0, area) && !table.set_length(16385, area));
    verify(table.rows.len() == 64);
    table.selected_row = 63;
    verify(table.set_length(32, area)); verify(table.rows.len() == 32 && table.selected_row == 31);
    verify(table.set_length(80, area));
    let empty: TableRow = table.rows[79]; verify(empty.cells[0] == "080" && empty.cells[1] == "" && empty.cells[2] == "");
    verify(!table.length_truncates_data(32));
    table.selected_row = 79; table.selected_column = 5;
    table.edit_event(decode_input("\r"), area); table.editor.set_text("0"); table.edit_event(decode_input("\r"), area);
    verify(table.length_truncates_data(32));
    table.release();
    var audio_table: SequenceTable = SequenceTable::new(); audio_table.track_action(28, area);
    var clip: AudioClip = AudioClip { source: clone("length-test"), frames: 40, frames_per_row: 10 };
    for _r in 0..4 { clip.peaks.push(WavePeak { left: 500 }); }
    for _r in 0..16 { clip.detail_peaks.push(WavePeak { left: 500 }); }
    audio_table.selected_row = 2; audio_table.insert_audio(clip, area);
    audio_table.selected_row = 8; audio_table.insert_audio(clip, area);
    // Clear MIDI cells to isolate detection of audio crossing the new end.
    for r in 0..64 { audio_table.selected_row = i32(r); audio_table.clear_row(); }
    verify(audio_table.length_truncates_data(4));
    audio_table.set_length(4, area);
    let trimmed: SequenceTrack = audio_table.tracks[3];
    verify(trimmed.instances.len() == 1);
    let placed: AudioInstance = trimmed.instances[0];
    verify(placed.clip.peaks.len() == 2 && placed.clip.detail_peaks.len() == 8 && placed.clip.frames == 20);
    verify(clip.peaks.len() == 4 && clip.frames == 40);
    audio_table.set_length(64, area); verify(!audio_table.length_truncates_data(4));
    audio_table.set_length(1, area); let removed: SequenceTrack = audio_table.tracks[3];
    verify(removed.instances.len() == 0 && audio_table.track_columns(3) == 2);
    audio_table.release(); clip.release();
    var dialog: BpmDialog = BpmDialog::new(); dialog.open_pattern_length(64);
    verify(dialog.editor.text == "64");
    dialog.editor.set_text("0"); dialog.on_event(decode_input("\r")); verify(dialog.active);
    dialog.editor.set_text("12.5"); dialog.on_event(decode_input("\r")); verify(dialog.active);
    dialog.editor.set_text("128"); dialog.on_event(decode_input("\r"));
    verify(!dialog.active && dialog.value == 128 && dialog.result == 1);
    dialog.open(120); verify(!dialog.pattern_length); dialog.release();
}

#[test]
fn tui_zoomed_waveform_time_slices() {
    let area: Rect = Rect::new(0, 0, 120, 12);
    var table: SequenceTable = SequenceTable::new(); table.zoom_tracks(2, true, area); table.create_track_kind(false, true, area);
    // 16 frames per row: at 1/32 zoom each dot row is 2 frames. Pulses on frames 0-1 and 4-5.
    var samples: list<f32> = [];
    for i in 0..32 { samples.push(i < 8 && i % 4 < 2 ? 1.0f : 0.0f); }
    let template: AudioClip = AudioClip { source: clone("zoom-test"), channels: 1, sample_rate: 48000, frames_per_row: 16 };
    let clip: AudioClip = template.with_samples(samples);
    verify(table.insert_audio(clip, area));
    table.row_scale = 2;
    let surface: Surface = Surface::new(120, 12); let theme: Theme = Theme::dark_blue();
    table.paint(surface, area, theme); table.paint_audio_style(surface, area, theme, true, false);
    let body: Rect = table.body(area);
    let wave: i32 = table.audio_waveform_column(3);
    let top: Cell = surface.cell(table.column_x(wave) + 3, body.y); let below: Cell = surface.cell(table.column_x(wave) + 3, body.y + 1);
    verify(top.glyph == 0x282d && below.glyph == 32);
    table.release(); clip.release(); surface.release();
}

#[test]
fn tui_audio_duration_gate() {
    let area: Rect = Rect::new(0, 0, 120, 12);
    var table: SequenceTable = SequenceTable::new(); table.zoom_tracks(2, true, Rect::new(0, 0, 120, 12)); table.create_track_kind(false, true, area);
    var clip: AudioClip = AudioClip { source: clone("gate-test"), frames: 40, frames_per_row: 10 };
    for _r in 0..4 { clip.peaks.push(WavePeak { left: 500, right: 250 }); }
    for _r in 0..16 { clip.detail_peaks.push(WavePeak { left: 500, right: 250 }); }
    verify(table.insert_audio(clip, area));
    let first: TableRow = table.rows[0]; verify(first.cells[16] == "4.00");
    table.selected_column = 16; table.edit_event(decode_input("\r"), area); table.editor.set_text("3.75"); table.edit_event(decode_input("\r"), area);
    verify(!table.editing);
    table.selected_column = table.audio_offset_column(3); table.edit_event(decode_input("\r"), area);
    table.editor.set_text("0.50"); table.edit_event(decode_input("\r"), area);
    verify(!table.editing && table.audio_timing_offset(3, 0) == 7500);
    table.edit_event(decode_input("l"), area);
    verify(table.is_audio_waveform() && table.columns[table.selected_column].read_only && table.columns[table.selected_column].selectable);
    table.selected_column = table.audio_length_column(3);
    let track: SequenceTrack = table.tracks[3]; let instance: AudioInstance = track.instances[0];
    verify(instance.duration() == 56250 && clip.frames == 40 && track.instance_at(4) == -1);
    let rendered: AudioClip = instance.render_clip(); verify(rendered.frames == 38);
    var mixer: Mixer = Mixer {};
    for _i in 0..30 { mixer.update(table, 3, 11249, true, 10); }
    verify(mixer.level(3, 100, 0, false, false) == 500);
    for _i in 0..30 { mixer.update(table, 3, 11250, true, 10); }
    verify(mixer.level(3, 100, 0, false, false) == 0);
    let surface: Surface = Surface::new(120, 12); let theme: Theme = Theme::dark_blue();
    table.paint(surface, area, theme); table.paint_audio_style(surface, area, theme, true, false);
    // 3.75 rows: the last row's fourth slice is past the gate.
    let wave: i32 = table.audio_waveform_column(3);
    let body: Rect = table.body(area); let center: Cell = surface.cell(table.column_x(wave) + 3, body.y + 3);
    verify(center.glyph == 0x283f && center.foreground == 0x8a8a8a);
    // At 1/32 zoom the row's second line holds only the slice before the gate.
    table.row_scale = 2; table.paint(surface, area, theme); table.paint_audio_style(surface, area, theme, true, false);
    let zoomed_top: Cell = surface.cell(table.column_x(wave) + 3, body.y + 6);
    let zoomed_end: Cell = surface.cell(table.column_x(wave) + 3, body.y + 7);
    verify(zoomed_top.glyph == 0x28ff && zoomed_end.glyph == 0x281b);
    table.row_scale = 1;
    table.edit_event(decode_input("\r"), area); table.editor.set_text("4.01"); table.edit_event(decode_input("\r"), area);
    verify(table.editing && table.error == "LEN exceeds the sample duration"); table.edit_event(InputEvent { kind: InputKind::Menu, key: Key::Escape }, area);
    table.edit_event(decode_input("K"), area); let stepped: TableRow = table.rows[0]; verify(stepped.cells[16] == "3.76");
    verify(table.move_audio(1, area));
    verify(table.audio_timing_offset(3, 0) == 0 && table.audio_timing_offset(3, 1) == 7500);
    var copy: SequenceTable = table.copy_pattern(); table.remove_audio_under_cursor();
    let saved: SequenceTrack = copy.tracks[3]; let saved_instance: AudioInstance = saved.instances[0]; verify(saved_instance.duration() == 56400);
    table.release(); copy.release(); clip.release(); surface.release();
}

#[test]
fn tui_audio_cut_copy_paste() {
    let area: Rect = Rect::new(0, 0, 120, 12);
    var table: SequenceTable = SequenceTable::new(); table.track_action(28, area);
    var clip: AudioClip = AudioClip { source: clone("cut-test"), frames: 80, frames_per_row: 10 };
    for _r in 0..8 { clip.peaks.push(WavePeak { left: 500 }); }
    for _r in 0..32 { clip.detail_peaks.push(WavePeak { left: 500 }); }
    table.selected_row = 2; verify(table.insert_audio(clip, area));
    let placed: SequenceTrack = table.tracks[3];
    verify(placed.instances.len() == 1 && placed.instance_at(9) == 0 && placed.instance_at(10) == -1);
    // Copy the tail from row 4 (offset 2): non-destructive, 6 rows on clipboard.
    table.selected_row = 4; verify(table.copy_audio());
    verify(table.audio_clipboard.peaks.len() == 6);
    let after_copy: SequenceTrack = table.tracks[3];
    verify(after_copy.instances.len() == 1); let copied: AudioInstance = after_copy.instances[0];
    verify(copied.clip.peaks.len() == 8);
    // Cut the tail at row 5 (offset 3): head keeps 3 rows, tail (5) goes to clipboard.
    table.selected_row = 5; verify(table.cut_audio(area));
    verify(table.audio_clipboard.peaks.len() == 5);
    let after_cut: SequenceTrack = table.tracks[3];
    verify(after_cut.instances.len() == 1); let head: AudioInstance = after_cut.instances[0];
    verify(head.start_row == 2 && head.clip.peaks.len() == 3 && head.duration() == 45000);
    verify(after_cut.instance_at(4) == 0 && after_cut.instance_at(5) == -1);
    let len_row: TableRow = table.rows[2]; verify(len_row.cells[table.audio_length_column(3)] == "3.00");
    // Paste the clipboard onto a free region starting at row 20.
    table.selected_row = 20; verify(table.paste_audio(area));
    let after_paste: SequenceTrack = table.tracks[3];
    verify(after_paste.instances.len() == 2);
    let pasted: AudioInstance = after_paste.instances[1];
    verify(pasted.start_row == 20 && pasted.clip.peaks.len() == 5);
    // Cutting on the first row of an instance removes it whole.
    table.selected_row = 20; verify(table.cut_audio(area));
    let after_whole_cut: SequenceTrack = table.tracks[3];
    verify(after_whole_cut.instances.len() == 1 && table.audio_clipboard.peaks.len() == 5);
    // Key routing through edit_event: y copies, p pastes, c cuts (audio context).
    table.selected_row = 2; verify(table.edit_event(decode_input("y"), area));
    verify(table.audio_clipboard.peaks.len() == 3);
    table.selected_row = 40; verify(table.edit_event(decode_input("p"), area));
    let after_key_paste: SequenceTrack = table.tracks[3];
    verify(after_key_paste.instances.len() == 2);
    let key_pasted: AudioInstance = after_key_paste.instances[1];
    verify(key_pasted.start_row == 40 && key_pasted.clip.peaks.len() == 3);
    table.selected_row = 41; verify(table.edit_event(decode_input("c"), area));
    verify(table.audio_clipboard.peaks.len() == 2);
    let after_key_cut: SequenceTrack = table.tracks[3];
    let key_head: AudioInstance = after_key_cut.instances[1];
    verify(key_head.clip.peaks.len() == 1 && after_key_cut.instance_at(41) == -1);
    // Empty clipboard and non-audio guards.
    var midi: SequenceTable = SequenceTable::new();
    verify(!midi.copy_audio() && midi.error == "Select an AUDIO track first");
    verify(!midi.paste_audio(area) && midi.error == "Clipboard is empty");
    midi.release(); table.release(); clip.release();
}

#[test]
fn tui_audio_visual_copy_fits_selected_rows() {
    let area: Rect = Rect::new(0, 0, 120, 20);
    var table: SequenceTable = SequenceTable::new(); table.track_action(28, area);
    var clip: AudioClip = AudioClip { source: clone("visual-copy-test"), channels: 1, frames: 80, frames_per_row: 10 };
    for _f in 0..80 { clip.samples.push(0.25f); }
    for _r in 0..8 { clip.peaks.push(WavePeak { left: 250 }); }
    for _r in 0..32 { clip.detail_peaks.push(WavePeak { left: 250 }); }
    table.selected_row = 0; verify(table.insert_audio(clip, area));
    // Split rows 2-3 out of the instance, then insert three empty rows directly
    // below the slice. The tail moves from row 4 to row 7.
    table.selected_row = 2; table.selected_column = table.audio_length_column(3);
    verify(table.edit_event(decode_input("v"), area)); table.selected_row = 3;
    verify(table.slice_audio(area));
    table.edit_event(decode_input("o"), area); table.edit_event(decode_input("o"), area); table.edit_event(decode_input("o"), area);
    let split: SequenceTrack = table.tracks[3];
    verify(split.instances.len() == 3 && split.instance_at(4) == -1 && split.instance_at(7) >= 0);
    // The middle is still a window into the full source, so LEN can expand
    // into the inserted space and then return to its original two rows.
    table.selected_row = 2; table.edit_event(decode_input("\r"), area); table.editor.set_text("4.00"); table.edit_event(decode_input("\r"), area);
    verify(!table.editing && table.tracks[3].instances[1].duration() == 60000);
    table.edit_event(decode_input("\r"), area); table.editor.set_text("2.00"); table.edit_event(decode_input("\r"), area);
    // Copy the two-row middle slice and paste it into the new three-row gap.
    table.selected_row = 2; verify(table.edit_event(decode_input("v"), area)); table.selected_row = 3;
    verify(table.edit_event(decode_input("y"), area));
    verify(table.audio_clipboard.peaks.len() == 8 && table.audio_clipboard.frames == 80);
    verify(table.audio_clipboard_offset == 20 && table.audio_clipboard_length == 30000);
    table.selected_row = 4; verify(table.edit_event(decode_input("p"), area));
    let track: SequenceTrack = table.tracks[3];
    verify(track.instances.len() == 4 && track.instance_at(4) >= 0 && track.instance_at(5) >= 0);
    verify(track.instance_at(6) == -1 && track.instance_at(7) >= 0);
    let pasted: AudioInstance = track.instances[3];
    verify(pasted.offset_frames == 20 && pasted.length_ticks == 30000 && pasted.clip.frames == 80);
    // Once the following tail is removed, the pasted non-destructive window
    // can also expand from two rows to four rows of its shared source.
    table.selected_row = 7; verify(table.remove_audio_under_cursor());
    table.selected_row = 4; table.edit_event(decode_input("\r"), area); table.editor.set_text("4.00"); table.edit_event(decode_input("\r"), area);
    let expanded: AudioInstance = table.audio_at_cursor();
    verify(!table.editing && expanded.duration() == 60000 && expanded.clip.frames == 80);
    table.release(); clip.release();
}

#[test]
fn tui_audio_visual_move_reverse() {
    let area: Rect = Rect::new(0, 0, 120, 12);
    var table: SequenceTable = SequenceTable::new(); table.track_action(28, area);
    var clip: AudioClip = AudioClip { source: clone("v-test"), frames: 80, frames_per_row: 10 };
    for _f in 0..80 { clip.samples.push(0.25f); }
    for r in 0..8 { clip.peaks.push(WavePeak { left: 100 + i32(r) }); }
    for _r in 0..32 { clip.detail_peaks.push(WavePeak { left: 200 }); }
    table.selected_row = 2; verify(table.insert_audio(clip, area));
    let len_col: i32 = table.audio_length_column(3);
    // Bug fix: transpose (J/K) on a non-start audio LEN cell is a silent no-op.
    table.selected_row = 5; table.selected_column = len_col;
    let cell_before: str8 = clone(table.rows[5].cells[len_col]);
    verify(table.edit_event(decode_input("J"), area));
    verify(table.error == "" && table.rows[5].cells[len_col] == cell_before);
    free(cell_before);
    // Visual copy lifts only the selected rows from the instance.
    table.selected_row = 3; table.selected_column = len_col;
    verify(table.edit_event(decode_input("v"), area)); verify(table.visual);
    table.selected_row = 6; verify(table.edit_event(decode_input("y"), area));
    verify(!table.visual && table.audio_clipboard.peaks.len() == 8);
    verify(table.audio_clipboard_offset == 10 && table.audio_clipboard_length == 60000);
    let intact: SequenceTrack = table.tracks[3];
    verify(intact.instances.len() == 1 && intact.instances[0].clip.peaks.len() == 8);
    // Visual whole-instance cut: d removes the intersecting instance entirely.
    table.selected_row = 4; verify(table.edit_event(decode_input("v"), area));
    table.selected_row = 5; verify(table.edit_event(decode_input("d"), area));
    let emptied: SequenceTrack = table.tracks[3];
    verify(emptied.instances.len() == 0 && table.audio_clipboard.peaks.len() == 8);
    // Move: Ctrl+J shifts the instance under the cursor down a row, cursor follows.
    var clip2: AudioClip = AudioClip { source: clone("m-test"), frames: 40, frames_per_row: 10 };
    for r in 0..4 { clip2.peaks.push(WavePeak { left: 300 + i32(r) }); }
    for _r in 0..16 { clip2.detail_peaks.push(WavePeak { left: 400 }); }
    table.selected_row = 2; verify(table.insert_audio(clip2, area));
    table.selected_row = 2; table.selected_column = len_col;
    verify(table.edit_event(decode_input("\x1b[106;5u"), area));
    let moved: SequenceTrack = table.tracks[3];
    verify(moved.instances[0].start_row == 3 && table.selected_row == 3);
    verify(table.rows[2].cells[len_col] == "" && table.rows[3].cells[len_col] == "4.00");
    verify(table.edit_event(decode_input("\x1b[107;5u"), area));
    verify(table.tracks[3].instances[0].start_row == 2 && table.selected_row == 2);
    // Reverse flips peak order: the first peak becomes the old last.
    let pre: AudioInstance = table.tracks[3].instances[0];
    let first_before: i32 = pre.clip.peaks[0].left; let last_before: i32 = pre.clip.peaks[3].left;
    verify(table.reverse_audio(area));
    let post: AudioInstance = table.tracks[3].instances[0];
    verify(post.clip.peaks[0].left == last_before && post.clip.peaks[3].left == first_before);
    table.release(); clip.release(); clip2.release();
}

#[test]
fn tui_multiple_note_lines() {
    var table: SequenceTable = SequenceTable::new(); table.zoom_tracks(2, true, Rect::new(0, 0, 120, 12)); let area: Rect = Rect::new(0, 0, 80, 12);
    table.selected_column = 3; table.edit_event(decode_input("\r"), area); table.editor.set_text("3.75"); table.edit_event(decode_input("\r"), area);
    table.selected_column = 5; table.edit_event(decode_input("\r"), area); table.editor.set_text("25"); table.edit_event(decode_input("\r"), area);
    table.track_action(80, area); // Add from CC appends before automation.
    let added: TableRow = table.rows[0]; let track: SequenceTrack = table.tracks[0];
    verify(track.note_lines == 2 && table.selected_column == 5 && table.track_start(1) == 10);
    verify(added.cells[1] == "C-4" && added.cells[5] == "" && added.cells[6] == "" && added.cells[9] == "25");
    table.selected_column = 2; table.track_action(82, area); // VEL selects its NOTE/VEL pair.
    let duplicated: TableRow = table.rows[0];
    verify(duplicated.cells[3] == "3.75" && duplicated.cells[7] == "3.75");
    verify(duplicated.cells[5] == "C-4" && duplicated.cells[6] == "100" && duplicated.cells[13] == "25");
    verify(table.automation_column(0, 1) == 13 && table.track_start(1) == 14 && table.is_note());
    table.edit_event(decode_input("K"), area);
    let edited: TableRow = table.rows[0]; verify(edited.cells[1] == "C-4" && edited.cells[5] == "C#4");
    var mixer: Mixer = Mixer {};
    for _i in 0..30 { mixer.update(table, 0, 0, true, 10); }
    verify(mixer.level(0, 100, 0, false, false) == 787); // two V100 notes are not summed
    table.selected_column = 6; table.edit_event(decode_input("\r"), area); table.editor.set_text("127"); table.edit_event(decode_input("\r"), area);
    for _i in 0..30 { mixer.update(table, 0, 0, true, 10); }
    verify(mixer.level(0, 100, 0, false, false) == 1000 && mixer.levels.len() == 3);
    table.selected_column = 5; table.edit_event(decode_input("\r"), area); table.editor.set_text(""); table.edit_event(decode_input("\r"), area); // empty NOTE ignores its high VEL
    for _i in 0..30 { mixer.update(table, 0, 0, true, 10); }
    verify(mixer.level(0, 100, 0, false, false) == 787);
    var copy: SequenceTable = table.copy_pattern();
    table.track_action(81, area); let removed: TableRow = table.rows[0];
    verify(table.track_columns(0) == 9 && removed.cells[5] == "" && removed.cells[9] == "25");
    table.track_action(81, area); verify(table.track_columns(0) == 5);
    table.track_action(81, area); verify(table.error != "" && table.track_columns(0) == 5);
    let saved: SequenceTrack = copy.tracks[0]; verify(saved.note_lines == 3);
    copy.create_track(true, area); let cloned: SequenceTrack = copy.tracks[3]; verify(cloned.note_lines == 3);
    copy.create_track_kind(false, true, area); copy.track_action(80, area);
    verify(copy.error == "Note lines require a MIDI track" && copy.track_columns(4) == 2);
    copy.release(); table.release();
}

#[test]
fn tui_meter_refresh_rate() {
    var rate: FrameRate = FrameRate {}; verify(rate.fps == 60);
    rate.set(60, 1000); rate.presented(1000);
    verify(!rate.ready(1016) && rate.ready(1017) && rate.sleep_ms(1010) == 7);
    rate.presented(1017); verify(!rate.ready(1033) && rate.ready(1034));
    rate.presented(1034); verify(rate.ready(1050));
    // Sixty scheduled frames in one second; no 20ms/50FPS polling ceiling.
    rate.set(60, 0); var frames: i32 = 0;
    for now in 0..1000 { if rate.ready(now) { frames = frames + 1; rate.presented(now); } }
    verify(frames == 60);
    verify(!rate.set(0, 1000) && !rate.set(241, 1000) && rate.fps == 60);
    rate.presented(5000); verify(!rate.ready(5000)); // skip missed frames, no catch-up burst
    var dialog: BpmDialog = BpmDialog::new(); dialog.open_meter_rate(60);
    dialog.editor.set_text("0"); dialog.on_event(decode_input("\r")); verify(dialog.active && dialog.error != "");
    dialog.editor.set_text("60.5"); dialog.on_event(decode_input("\r")); verify(dialog.active);
    dialog.editor.set_text("60"); dialog.on_event(decode_input("\r")); verify(!dialog.active && dialog.value == 60 && dialog.meter_rate);
    dialog.open_meter_rate(60); dialog.editor.set_text("120");
    dialog.on_event(InputEvent { kind: InputKind::Menu, key: Key::Escape }); verify(dialog.value == 60 && dialog.result == 2);
    dialog.open(137); verify(!dialog.meter_rate && dialog.title == "Set BPM");
    dialog.release();
}

#[test]
fn tui_transport_clock_and_bpm_dialog() {
    var transport: TransportStatus = TransportStatus {};
    transport.toggle(1000, 2, 4); verify(transport.playing && transport.row == 2 && transport.elapsed_ms == 250);
    transport.advance(1125, 4); verify(transport.row == 3 && transport.phase == 0);
    transport.advance(1250, 4); verify(transport.row == 0);
    transport.advance(1300, 4); verify(transport.phase == 6000);
    verify(transport.set_bpm(240)); transport.advance(1325, 4); verify(transport.phase == 12000);
    transport.advance(1338, 4); verify(transport.row == 1 && transport.phase == 120);
    transport.toggle(1338, 1, 4); verify(!transport.playing);
    transport.advance(2000, 4); verify(transport.row == 1);
    verify(!transport.set_bpm(0) && !transport.set_bpm(401) && transport.bpm == 240);
    transport.toggle(2000, 0, 4); transport.advance(12000, 4); verify(transport.row == 0);
    transport.advance(12010, 0); verify(!transport.playing && transport.row == -1);
    var dialog: BpmDialog = BpmDialog::new(); dialog.open(120);
    dialog.editor.set_text("1.5"); dialog.on_event(decode_input("\r")); verify(dialog.active && dialog.error != "");
    dialog.editor.set_text("401"); dialog.on_event(decode_input("\r")); verify(dialog.active);
    dialog.editor.set_text("137"); dialog.on_event(decode_input("\r")); verify(!dialog.active && dialog.value == 137 && dialog.result == 1);
    dialog.open(137); dialog.editor.set_text("200");
    dialog.on_event(InputEvent { kind: InputKind::Menu, key: Key::Escape }); verify(!dialog.active && dialog.value == 137 && dialog.result == 2);
    dialog.open(137); dialog.editor.set_text("200"); dialog.on_event(decode_input("\t")); dialog.on_event(decode_input("\r"));
    for _i in 0..10 { dialog.tick(); } verify(!dialog.active && dialog.value == 200 && dialog.result == 1);
    dialog.release();
}

#[test]
fn tui_sample_properties_dialog_and_frame_window() {
    let area: Rect = Rect::new(0, 0, 120, 20);
    var table: SequenceTable = SequenceTable::new(); table.create_track_kind(false, true, area);
    var clip: AudioClip = AudioClip { source: clone("dialog.wav"), channels: 1, sample_rate: 8000, frames: 100, frames_per_row: 10 };
    for _i in 0..100 { clip.samples.push(0.25f); }
    for _i in 0..10 { clip.peaks.push(WavePeak { left: 250, right: 250 }); }
    for _i in 0..40 { clip.detail_peaks.push(WavePeak { left: 250, right: 250 }); }
    table.selected_row = 4; verify(table.insert_audio(clip, area));
    var dialog: SampleDialog = SampleDialog::new(); dialog.open(table.audio_at_cursor(), 120);
    verify(dialog.start.text == "0" && dialog.end.text == "100" && dialog.bpm.text == "120");
    dialog.start.set_text("80"); dialog.end.set_text("40"); dialog.on_event(decode_input("\r"));
    verify(dialog.active && dialog.error != "");
    dialog.start.set_text("12"); dialog.end.set_text("78"); dialog.bpm.set_text("128"); dialog.algorithm.selected = 2;
    dialog.on_event(decode_input("\r"));
    verify(!dialog.active && dialog.result == 1 && dialog.frame_start == 12 && dialog.frame_end == 78);
    verify(table.set_audio_properties(dialog.frame_start, dialog.frame_end, dialog.original_bpm, i32(dialog.algorithm.selected_id()), dialog.pitch, i32(dialog.resample.selected_id()), i32(dialog.looping.selected_id()), area));
    let instance: AudioInstance = table.audio_at_cursor(); let rendered: AudioClip = instance.render_clip();
    verify(instance.offset_frames == 12 && instance.frame_end == 78 && instance.original_bpm == 128 && instance.stretch_algorithm == 2);
    verify(rendered.offset == 12 && rendered.frames == 66 && table.has_audio_properties());
    // Tab order reaches pitch and resampling; pitch with Off is refused.
    dialog.open(table.audio_at_cursor(), 120);
    verify(dialog.transpose.text == "0" && dialog.resample.selected_id() == 0);
    dialog.on_event(decode_input("\x1b[Z")); verify(dialog.focus.selected == 3);
    dialog.on_event(decode_input("\t")); verify(dialog.focus.selected == 0);
    dialog.on_event(decode_input("\t")); dialog.on_event(decode_input("\t")); dialog.on_event(decode_input("\t"));
    verify(dialog.focus.selected == 4);
    dialog.on_event(decode_input("\t")); verify(dialog.focus.selected == 5);
    dialog.on_event(decode_input("\t")); verify(dialog.focus.selected == 6);
    dialog.on_event(decode_input("\t")); verify(dialog.focus.selected == 7 && dialog.looping.selected_id() == 0);
    dialog.on_event(decode_input("\t")); verify(dialog.focus.selected == 3);
    dialog.algorithm.selected = 0; dialog.transpose.set_text("5"); dialog.focus.selected = 5; dialog.on_event(decode_input("\r"));
    verify(dialog.active && dialog.error == "Pitch needs Stretch, Beats or Transients");
    dialog.algorithm.selected = 4; dialog.transpose.set_text("-25"); dialog.on_event(decode_input("\r")); verify(dialog.active);
    dialog.transpose.set_text("-24"); dialog.resample.selected = 3; dialog.on_event(decode_input("\r"));
    verify(!dialog.active && dialog.result == 1 && dialog.pitch == -24 && dialog.algorithm.selected_id() == 4 && dialog.resample.selected_id() == 3);
    dialog.release(); table.release(); clip.release();
}

#[test]
fn tui_sample_properties_persist() {
    let directory: str8 = clone("/private/tmp/mlacker-properties-test-XXXXXX"); mkdtemp(directory);
    var library: PatternLibrary = PatternLibrary::new();
    var audio: AudioSystem = AudioSystem {}; var codec: SessionCodec = SessionCodec {};
    let area: Rect = Rect::new(0, 0, 120, 20);
    library.table.create_track_kind(false, true, area);
    let clip: AudioClip = test_clip("/elsewhere/loop.wav", 2, 80);
    library.audio.samples.push(clip);
    library.table.selected_row = 2; verify(library.table.insert_audio(clip, area));
    let index: i32 = i32(library.table.tracks.len()) - 1;
    verify(library.table.set_audio_properties(4, 60, 127, 5, -3, 2, 1, area));
    verify(library.has_audio_properties());
    // Session, project and pattern file each keep every property.
    let path: str8 = format!("{}/song.mlack", directory);
    verify(codec.save(path, library, SessionView { bpm: 120 }, audio));
    let loaded: result<SessionData, str8> = SessionCodec::load(path); verify(loaded.is_ok());
    var restored: SessionData = loaded.unwrap();
    var track: SequenceTrack = restored.library.table.tracks[index];
    var placement: AudioInstance = track.instances[0];
    verify(placement.offset_frames == 4 && placement.frame_end == 60 && placement.original_bpm == 127);
    verify(placement.stretch_algorithm == 5 && placement.pitch == -3 && placement.resample == 2 && placement.loop_mode == 1);
    restored.release();
    let target: str8 = format!("{}/Song", directory);
    let saved: result<str8, str8> = codec.save_project(target, library, SessionView { bpm: 120 }, audio); verify(saved.is_ok());
    let folder: str8 = saved.unwrap();
    let opened: result<SessionData, str8> = SessionCodec::load_project(folder); verify(opened.is_ok());
    var project: SessionData = opened.unwrap();
    track = project.library.table.tracks[index]; placement = track.instances[0];
    verify(placement.frame_end == 60 && placement.stretch_algorithm == 5 && placement.pitch == -3 && placement.loop_mode == 1);
    project.release();
    let pattern_path: str8 = format!("{}/part.mlapatt", directory);
    verify(SessionCodec::save_pattern(pattern_path, "part", library.table));
    let read: result<PatternData, str8> = SessionCodec::load_pattern(pattern_path); verify(read.is_ok());
    var pattern: PatternData = read.unwrap();
    track = pattern.table.tracks[index]; placement = track.instances[0];
    verify(placement.original_bpm == 127 && placement.resample == 2 && placement.loop_mode == 1);
    pattern.release();
    // A placement without properties writes no AUDIO_PROPERTIES, so such
    // files stay readable by older versions.
    var plain: PatternLibrary = PatternLibrary::new(); plain.table.create_track_kind(false, true, area);
    plain.table.selected_row = 0; verify(plain.table.insert_audio(clip, area) && !plain.has_audio_properties());
    plain.release(); library.release();
    let removed: result<i32, str8> = std::fs::remove_tree(directory); verify(removed.is_ok());
    free(path); free(target); free(folder); free(pattern_path); free(directory);
}

#[test]
fn tui_synced_sample_rows_follow_original_bpm() {
    // 8 rows of audio at 120 BPM (1000 frames a row at 8 kHz).
    let area: Rect = Rect::new(0, 0, 120, 20);
    var table: SequenceTable = SequenceTable::new(); table.create_track_kind(false, true, area);
    var clip: AudioClip = AudioClip { source: clone("synced.wav"), channels: 1, sample_rate: 8000, frames: 8000, frames_per_row: 1000 };
    for _i in 0..8000 { clip.samples.push(0.25f); }
    for _i in 0..8 { clip.peaks.push(WavePeak { left: 250, right: 250 }); }
    for _i in 0..32 { clip.detail_peaks.push(WavePeak { left: 250, right: 250 }); }
    table.selected_row = 0; verify(table.insert_audio(clip, area));
    var instance: AudioInstance = table.audio_at_cursor();
    verify(instance.duration() == 8 * 15000);
    // Recorded at 60 BPM: its 8000 frames are 4 rows of the pattern.
    verify(table.set_audio_properties(0, 8000, 60, 2, 0, 0, 0, area));
    instance = table.audio_at_cursor();
    verify(instance.synced() && instance.duration() == 4 * 15000 && instance.render_end() == 8000);
    var view: AudioClip = instance.render_clip();
    verify(instance.frames_of(15000) == 2000 && instance.ticks_of(2000) == 15000 && view.frames_per_row == 2000);
    // Recorded at 240 BPM: 16 rows; a frame window keeps its tempo.
    verify(table.set_audio_properties(1000, 7000, 240, 1, 0, 0, 0, area));
    instance = table.audio_at_cursor();
    view = instance.render_clip();
    verify(instance.duration() == 12 * 15000 && instance.render_end() == 7000 && view.frames == 6000);
    // Off: back to the clip's own rows.
    verify(table.set_audio_properties(0, 8000, 240, 0, 0, 0, 0, area));
    instance = table.audio_at_cursor();
    verify(!instance.synced() && instance.duration() == 8 * 15000);
    // Pitch needs a mode that keeps time apart from pitch; it leaves LEN alone.
    verify(!table.set_audio_properties(0, 8000, 60, 1, 7, 0, 0, area) && table.error == "Pitch needs Stretch, Beats or Transients");
    verify(table.set_audio_properties(0, 8000, 60, 4, -12, 2, 0, area));
    instance = table.audio_at_cursor();
    verify(instance.stretch_algorithm == 4 && instance.pitch == -12 && instance.resample == 2 && instance.duration() == 4 * 15000);
    table.release(); clip.release();
}

#[test]
fn tui_sequenced_meter_sources_and_ramps() {
    var table: SequenceTable = SequenceTable::new(); table.zoom_tracks(2, true, Rect::new(0, 0, 120, 12)); var mixer: Mixer = Mixer {};
    mixer.update(table, 0, 0, false, 10); verify(mixer.level(0, 100, 0, false, false) == 0);
    mixer.update(table, 0, 0, true, 10);
    let attack: i32 = mixer.level(0, 100, 0, false, false); verify(attack > 0 && attack < 788);
    for _i in 0..30 { mixer.update(table, 0, 0, true, 10); }
    verify(mixer.level(0, 100, 0, false, false) == 787);
    for _i in 0..30 { mixer.update(table, 0, 14000, true, 10); }
    verify(mixer.level(0, 100, 0, false, false) == 0);
    table.clear_row(); mixer.update(table, 0, 0, true, 10); verify(mixer.level(0, 100, 0, false, false) == 0);
    let area: Rect = Rect::new(0, 0, 100, 12); table.create_track_kind(false, true, area);
    var clip: AudioClip = AudioClip { source: clone("test") };
    clip.peaks.push(WavePeak { left: 1000, right: 500 }); clip.peaks.push(WavePeak { left: 100, right: 250 });
    table.insert_audio(clip, area); clip.release();
    for _i in 0..30 { mixer.update(table, 0, 0, true, 10); }
    verify(mixer.level(3, 100, 0, false, false) == 1000 && mixer.level(3, 100, 0, true, false) == 500);
    mixer.update(table, 1, 0, true, 10);
    let falling: i32 = mixer.level(3, 100, 0, false, false); verify(falling > 100 && falling < 1000);
    for _i in 0..30 { mixer.update(table, 1, 0, true, 10); }
    verify(mixer.level(3, 100, 0, false, false) == 100 && mixer.level(3, 100, 0, true, false) == 250);
    verify(mixer.level(3, 50, 0, true, false) == 125 && mixer.level(3, 100, -100, true, false) == 0);
    for _i in 0..30 { mixer.update(table, 1, 0, false, 10); }
    verify(mixer.level(3, 100, 0, false, false) == 0);
    verify(meter_ramp(0, 1000, 0) == 0 && meter_ramp(1000, 0, 10) < 1000);
    table.release();
}

#[test]
fn tui_loaded_audio_and_instances() {
    let mixer: Mixer = Mixer {}; let sample: SampleView = SampleView {};
    verify(mixer.grainy && sample.grainy);
    var library: PatternLibrary = PatternLibrary::new(); let area: Rect = Rect::new(0, 0, 100, 12);
    verify(library.load_audio("tests/fixtures/audio/stereo_tone.wav", 120, area));
    verify(library.audio_mode && library.audio.samples.len() == 1 && library.table.tracks.len() == 3);
    let label: ListItem = library.audio.view.items[0]; verify(label.label == "1 stereo_tone.wav");
    library.on_event(decode_input("\r"), area); verify(library.table.error == "Select an AUDIO track first");
    library.table.create_track_kind(false, true, area); library.table.selected_row = 10;
    verify(library.insert_selected_audio(area));
    let loaded: AudioClip = library.audio.samples[0]; let duration: i32 = i32(loaded.peaks.len());
    verify(library.table.rows.len() == duration + 10);
    let first_track: SequenceTrack = library.table.tracks[3]; let first: AudioInstance = first_track.instances[0];
    verify(first.start_row == 10 && first_track.instance_at(9) == -1 && first_track.instance_at(10) == 0);
    library.table.selected_row = 9; verify(!library.table.audio_under_cursor());
    library.table.selected_row = 11;
    verify(!library.insert_selected_audio(area)); // overlap must not replace anything
    verify(library.table.edit_event(decode_input("\x7f"), area));
    verify(!library.table.audio_under_cursor() && library.audio.samples.len() == 1 && library.table.track_columns(3) == 2);
    library.table.selected_row = 20; library.on_event(decode_input("\r"), area);
    library.table.selected_row = 20 + duration; library.on_event(decode_input("\r"), area);
    let repeated: SequenceTrack = library.table.tracks[3]; verify(repeated.instances.len() == 2);
    verify(repeated.instance_at(20) == 0 && repeated.instance_at(20 + duration) == 1);
    library.select(2); verify(!library.table.audio_under_cursor());
    library.select(1); verify(library.table.audio_under_cursor());
    library.table.edit_event(decode_input("\x08"), area);
    let remaining: SequenceTrack = library.table.tracks[3]; verify(remaining.instances.len() == 1 && remaining.instance_at(20) == 0);
    verify(library.audio.samples.len() == 1 && library.table.track_columns(3) == 3);
    library.table.selected_row = 20;
    let surface: Surface = Surface::new(100, 12);
    library.table.reconcile(area); library.table.paint(surface, area, Theme::dark_blue());
    library.table.paint_audio_style(surface, area, Theme::dark_blue(), true, false);
    surface.release(); library.release();
}

#[test]
fn tui_audio_track_destructive_groups_and_project_files() {
    let area: Rect = Rect::new(0, 0, 120, 20);
    var library: PatternLibrary = PatternLibrary::new();
    library.table.create_track_kind(false, true, area);
    let source: AudioClip = test_clip("/samples/SampleAudio.aif", 1, 40);
    verify(library.audio.add_clip(source.copy()) == 0);
    library.table.selected_row = 0; verify(library.table.insert_audio(source, area));
    // Split its four rows into 1 + 2 + 1 non-destructive placements.
    library.table.anchor_row = 1; library.table.selected_row = 2;
    library.table.visual = true; library.table.visual_rows = true;
    verify(library.table.slice_audio(area));
    verify(library.make_audio_track_destructive(area) == 3);
    verify(library.audio.samples.len() == 4);
    let track: SequenceTrack = library.table.tracks[library.table.active_track()];
    verify(track.instances.len() == 3);
    var one: bool = false; var two: bool = false; var three: bool = false;
    let instances: list<AudioInstance> = track.instances;
    for instance in instances {
        verify(instance.offset_frames == 0 && instance.frame_end == 0);
        if instance.clip.source == "SampleAudio.aif/SampleAudio.aif - 1" { one = true; verify(instance.clip.frames == 10); }
        if instance.clip.source == "SampleAudio.aif/SampleAudio.aif - 2" { two = true; verify(instance.clip.frames == 20); }
        if instance.clip.source == "SampleAudio.aif/SampleAudio.aif - 3" { three = true; verify(instance.clip.frames == 10); }
    }
    verify(one && two && three);
    // The open group (first), its three children, then the original row.
    verify(library.audio.view.items.len() == 5);
    let header: ListItem = library.audio.view.items[0]; verify(header.label == "v SampleAudio.aif");
    let last: ListItem = library.audio.view.items[4]; verify(last.label == "1 SampleAudio.aif");
    library.audio.view.selected = 0; verify(library.audio.selected_sample() == -1);
    verify(same(library.audio.selected_group(), "SampleAudio.aif"));
    verify(library.audio.toggle_group() && library.audio.view.items.len() == 2);
    verify(library.audio.toggle_group() && library.audio.view.items.len() == 5);

    let directory: str8 = clone("/private/tmp/mlacker-slice-group-test-XXXXXX"); mkdtemp(directory);
    let target: str8 = format!("{}/Grouped", directory);
    var codec: SessionCodec = SessionCodec {}; var audio: AudioSystem = AudioSystem {};
    let saved: result<str8, str8> = codec.save_project(target, library, SessionView {}, audio); verify(saved.is_ok());
    let folder: str8 = saved.unwrap();
    let first: str8 = format!("{}/Audio/SampleAudio/SampleAudio.aif - 1.wav", folder);
    let second: str8 = format!("{}/Audio/SampleAudio/SampleAudio.aif - 2.wav", folder);
    let third: str8 = format!("{}/Audio/SampleAudio/SampleAudio.aif - 3.wav", folder);
    verify(std::fs::file_exists(first) == 1 && std::fs::file_exists(second) == 1 && std::fs::file_exists(third) == 1);
    let loaded: result<SessionData, str8> = SessionCodec::load_project(folder); verify(loaded.is_ok());
    var restored: SessionData = loaded.unwrap();
    verify(restored.library.audio.samples.len() == 4 && restored.library.audio.view.items.len() == 2);
    restored.library.audio.view.selected = 0;
    verify(restored.library.audio.toggle_group() && restored.library.audio.view.items.len() == 5);
    let child: ListItem = restored.library.audio.view.items[1]; verify(child.label == "  2 SampleAudio.aif - 1");
    restored.release(); library.release(); source.release(); std::fs::remove_tree(directory);
    free(third); free(second); free(first); free(folder); free(target); free(directory);
}

/// String equality for values the comparison operator does not take
/// directly (call results, list elements of fields).
fn same(a: str8, b: str8) -> bool { return a == b; }

#[test]
fn tui_audio_groups_tree_nesting_and_removal() {
    let area: Rect = Rect::new(0, 0, 120, 20);
    var library: PatternLibrary = PatternLibrary::new();
    library.table.create_track_kind(false, true, area);
    // Groups nest; names are checked.
    verify(library.audio.add_group("", "Drums"));
    verify(library.audio.add_group("Drums", "Kicks"));
    verify(!library.audio.add_group("Drums", "Kicks") && library.audio.error == "That group already exists");
    verify(!library.audio.add_group("", "a/b") && !library.audio.add_group("", "  "));
    verify(library.audio.add_group("", "Bass"));
    verify(library.audio.groups.len() == 3 && library.audio.subgroup_count("Drums") == 1);
    let kick: AudioClip = test_clip("/s/kick.wav", 1, 40);
    let snare: AudioClip = test_clip("/s/snare.wav", 1, 30);
    let loose: AudioClip = test_clip("/s/loose.wav", 1, 20);
    verify(library.audio.add_clip_in(kick.copy(), "Drums/Kicks") == 0);
    verify(library.audio.add_clip_in(snare.copy(), "Drums") == 1);
    verify(library.audio.add_clip(loose.copy()) == 2);
    verify(same(library.audio.group_of(0), "Drums/Kicks") && same(library.audio.group_of(2), ""));
    // Groups in name order, a group's subgroups before its samples, then the
    // samples in no group.
    library.audio.expanded = [clone("Drums"), clone("Drums/Kicks")]; library.audio.rebuild();
    var labels: list<str8> = [];
    let items: list<ListItem> = library.audio.view.items; for item in items { labels.push(item.label); }
    verify(labels.len() == 6);
    verify(labels[0] == "> Bass" && labels[1] == "v Drums" && labels[2] == "  v Kicks" && labels[3] == "    1 kick.wav");
    verify(labels[4] == "  2 snare.wav" && labels[5] == "3 loose.wav");
    // A new item goes in the selected group, or the selected sample's group.
    library.audio.view.selected = 2; verify(same(library.audio.selected_group(), "Drums/Kicks") && same(library.audio.current_group(), "Drums/Kicks"));
    library.audio.view.selected = 4; verify(same(library.audio.selected_group(), "") && same(library.audio.current_group(), "Drums"));
    library.audio.view.selected = 5; verify(same(library.audio.current_group(), ""));
    // Removing Drums takes Kicks, both samples and their placements along.
    library.table.selected_row = 0; verify(library.table.insert_audio(kick, area));
    let gone: list<i32> = library.audio.samples_in_group("Drums"); verify(gone.len() == 2);
    var n: i64 = gone.len(); while n > 0 { n = n - 1; library.remove_sample(gone[n], area); }
    verify(library.remove_group("Drums", area) == 0);
    verify(library.audio.samples.len() == 1 && library.audio.groups.len() == 1 && same(library.audio.groups[0], "Bass"));
    verify(same(library.audio.group_of(0), "") && library.audio.sample_groups.len() == 1);
    let track: SequenceTrack = library.table.tracks[library.table.active_track()]; verify(track.instances.len() == 0);
    // Removing a group with samples left in it removes them too.
    verify(library.audio.add_clip_in(snare.copy(), "Bass") == 1);
    verify(library.remove_group("Bass", area) == 1 && library.audio.samples.len() == 1 && library.audio.groups.len() == 0);
    library.release(); kick.release(); snare.release(); loose.release();
}

#[test]
fn tui_audio_groups_saved_in_sessions_and_projects() {
    let area: Rect = Rect::new(0, 0, 120, 20);
    var library: PatternLibrary = PatternLibrary::new();
    library.table.create_track_kind(false, true, area);
    verify(library.audio.add_group("", "Drums") && library.audio.add_group("Drums", "Kicks") && library.audio.add_group("", "Empty"));
    let kick: AudioClip = test_clip("/s/kick.wav", 1, 40);
    let pad: AudioClip = test_clip("/s/pad.wav", 1, 30);
    verify(library.audio.add_clip_in(kick.copy(), "Drums/Kicks") == 0);
    verify(library.audio.add_clip(pad.copy()) == 1);
    let directory: str8 = clone("/private/tmp/mlacker-groups-test-XXXXXX"); mkdtemp(directory);
    var codec: SessionCodec = SessionCodec {}; var audio: AudioSystem = AudioSystem {};
    // A plain session keeps the groups, empty ones too, in AUDIO_GROUPS.
    let path: str8 = format!("{}/groups.mlack", directory);
    verify(codec.save(path, library, SessionView {}, audio));
    let loaded: result<SessionData, str8> = SessionCodec::load(path); verify(loaded.is_ok());
    var restored: SessionData = loaded.unwrap();
    verify(restored.library.audio.groups.len() == 3 && restored.library.audio.has_group("Empty"));
    verify(same(restored.library.audio.group_of(0), "Drums/Kicks") && same(restored.library.audio.group_of(1), ""));
    restored.release();
    // A project keeps each group as a folder below Audio/.
    let target: str8 = format!("{}/Grouped", directory);
    let saved: result<str8, str8> = codec.save_project(target, library, SessionView {}, audio); verify(saved.is_ok());
    let folder: str8 = saved.unwrap();
    let kick_file: str8 = format!("{}/Audio/Drums/Kicks/kick.wav", folder);
    let pad_file: str8 = format!("{}/Audio/pad.wav", folder);
    let empty_folder: str8 = format!("{}/Audio/Empty", folder);
    verify(std::fs::file_exists(kick_file) == 1 && std::fs::file_exists(pad_file) == 1 && std::fs::is_dir(empty_folder) == 1);
    let opened: result<SessionData, str8> = SessionCodec::load_project(folder); verify(opened.is_ok());
    var project: SessionData = opened.unwrap();
    verify(project.library.audio.groups.len() == 3 && same(project.library.audio.group_of(0), "Drums/Kicks"));
    verify(same(project.library.audio.group_of(1), "") && project.library.audio.has_group("Empty"));
    project.release();
    library.release(); kick.release(); pad.release(); std::fs::remove_tree(directory);
    free(empty_folder); free(pad_file); free(kick_file); free(folder); free(target); free(path); free(directory);
}

#[test]
fn tui_audio_move_to_group_updates_project_paths_and_placements() {
    let area: Rect = Rect::new(0, 0, 120, 20);
    var library: PatternLibrary = PatternLibrary::new();
    library.table.create_track_kind(false, true, area);
    verify(library.audio.add_group("", "Drums") && library.audio.add_group("Drums", "Kicks"));
    let kick: AudioClip = test_clip("/s/kick.wav", 1, 40);
    let pad: AudioClip = test_clip("/s/pad.wav", 1, 30);
    verify(library.audio.add_clip(kick.copy()) == 0 && library.audio.add_clip(pad.copy()) == 1);
    library.table.selected_row = 0; verify(library.table.insert_audio(kick, area));
    let folder: str8 = project_group_folder("Drums/Kicks"); verify(folder == "Audio/Drums/Kicks");
    // Outside a project only the group changes; paths stay.
    verify(library.move_samples_to_group([0, 1], "Drums/Kicks", "", folder) == 2);
    verify(same(library.audio.group_of(0), "Drums/Kicks") && same(library.audio.group_of(1), "Drums/Kicks"));
    let unchanged: AudioClip = library.audio.samples[0]; verify(unchanged.source == "/s/kick.wav");
    // Already there: nothing moves.
    verify(library.move_samples_to_group([0], "Drums/Kicks", "", folder) == 0);
    // Save as a project and reopen: the samples are project files.
    let directory: str8 = clone("/private/tmp/mlacker-move-group-test-XXXXXX"); mkdtemp(directory);
    let target: str8 = format!("{}/Moving", directory);
    var codec: SessionCodec = SessionCodec {}; var audio: AudioSystem = AudioSystem {};
    let saved: result<str8, str8> = codec.save_project(target, library, SessionView { move_unasked: true, editor_fullscreen: false }, audio); verify(saved.is_ok());
    let root: str8 = saved.unwrap();
    let opened: result<SessionData, str8> = SessionCodec::load_project(root); verify(opened.is_ok());
    var project: SessionData = opened.unwrap();
    // The project keeps its "Don't ask this again" and editor setting.
    verify(project.view.move_unasked && !project.view.editor_fullscreen);
    // Out of the group: the sample's path and its placement follow the file
    // to Audio/, and the next save writes it there.
    let top: str8 = project_group_folder("");
    verify(project.library.move_samples_to_group([0], "", root, top) == 1);
    let moved: AudioClip = project.library.audio.samples[0];
    let expected: str8 = format!("{}/Audio/kick.wav", root); verify(moved.source == expected);
    let track: SequenceTrack = project.library.table.tracks[project.library.table.active_track()];
    let instance: AudioInstance = track.instances[0]; verify(instance.clip.source == expected);
    verify(project.library.sample_usage(0) == 1);
    let resaved: result<str8, str8> = codec.save_project(root, project.library, SessionView {}, audio); verify(resaved.is_ok());
    let again: str8 = resaved.unwrap();
    let kick_file: str8 = format!("{}/Audio/kick.wav", again); let old_file: str8 = format!("{}/Audio/Drums/Kicks/kick.wav", again);
    verify(std::fs::file_exists(kick_file) == 1 && std::fs::file_exists(old_file) == 0);
    let reopened: result<SessionData, str8> = SessionCodec::load_project(again); verify(reopened.is_ok());
    var final: SessionData = reopened.unwrap();
    verify(!final.view.move_unasked && final.view.editor_fullscreen && same(final.library.audio.group_of(0), "") && same(final.library.audio.group_of(1), "Drums/Kicks"));
    final.release(); project.release(); library.release(); kick.release(); pad.release(); std::fs::remove_tree(directory);
    free(old_file); free(kick_file); free(again); free(expected); free(top); free(root); free(target); free(directory); free(folder);
}

#[test]
fn tui_audio_group_folders_do_not_clash_with_samples() {
    // A .wav sample made destructive: its group, illusion.wav, would want the
    // folder Audio/illusion.wav, where the sample's own file is. The group's
    // folder drops the extension, so the project still saves.
    let area: Rect = Rect::new(0, 0, 120, 20);
    var library: PatternLibrary = PatternLibrary::new();
    library.table.create_track_kind(false, true, area);
    let source: AudioClip = test_clip("/samples/illusion.wav", 1, 40);
    verify(library.audio.add_clip(source.copy()) == 0);
    library.table.selected_row = 0; verify(library.table.insert_audio(source, area));
    verify(library.make_audio_track_destructive(area) == 1);
    verify(same(library.audio.group_of(1), "illusion.wav"));
    let directory: str8 = clone("/private/tmp/mlacker-clash-test-XXXXXX"); mkdtemp(directory);
    let target: str8 = format!("{}/audiotest4", directory);
    var codec: SessionCodec = SessionCodec {}; var audio: AudioSystem = AudioSystem {};
    let saved: result<str8, str8> = codec.save_project(target, library, SessionView {}, audio);
    if saved.is_err() { println!("{}", saved.unwrap_err()); }
    verify(saved.is_ok());
    let folder: str8 = saved.unwrap();
    let original: str8 = format!("{}/Audio/illusion.wav", folder);
    let slice: str8 = format!("{}/Audio/illusion/illusion.wav - 1.wav", folder);
    verify(std::fs::file_exists(original) == 1 && std::fs::is_dir(original) == 0 && std::fs::file_exists(slice) == 1);
    // Reopened, the group keeps its name.
    let opened: result<SessionData, str8> = SessionCodec::load_project(folder); verify(opened.is_ok());
    var project: SessionData = opened.unwrap();
    verify(project.library.audio.samples.len() == 2 && same(project.library.audio.group_of(1), "illusion.wav"));
    verify(project.library.audio.groups.len() == 1 && project.library.audio.has_group("illusion.wav"));
    project.release(); library.release(); source.release(); std::fs::remove_tree(directory);
    free(slice); free(original); free(folder); free(target); free(directory);
}

#[test]
fn tui_audio_destructive_clips_nest_in_their_group() {
    // A sample in group Drums: its track clips go to Drums/<clip name>.
    let area: Rect = Rect::new(0, 0, 120, 20);
    var library: PatternLibrary = PatternLibrary::new();
    library.table.create_track_kind(false, true, area);
    verify(library.audio.add_group("", "Drums"));
    let source: AudioClip = test_clip("/samples/loop.wav", 1, 40);
    verify(library.audio.add_clip_in(source.copy(), "Drums") == 0);
    library.table.selected_row = 0; verify(library.table.insert_audio(source, area));
    verify(library.make_audio_track_destructive(area) == 1);
    verify(library.audio.has_group("Drums/loop.wav") && same(library.audio.group_of(1), "Drums/loop.wav"));
    let header: ListItem = library.audio.view.items[0]; verify(header.label == "v Drums");
    let inner: ListItem = library.audio.view.items[1]; verify(inner.label == "  v loop.wav");
    library.release(); source.release();
}

#[test]
fn tui_save_dialog_chooses_a_group() {
    var dialog: TrimSaveDialog = TrimSaveDialog::new();
    let groups: list<str8> = ["Drums", "Drums/Kicks"];
    dialog.open("kick - Trim 1.wav", groups, "Drums");
    verify(same(dialog.chosen_group(), "Drums"));
    dialog.on_event(decode_input("\t")); dialog.on_event(decode_input("\t"));
    verify(dialog.focus.selected == 2);
    dialog.on_event(decode_input("l")); verify(same(dialog.chosen_group(), "Drums/Kicks"));
    dialog.on_event(decode_input("l")); verify(same(dialog.chosen_group(), ""));
    dialog.on_event(decode_input("h")); verify(same(dialog.chosen_group(), "Drums/Kicks"));
    dialog.on_event(decode_input("\t")); verify(dialog.focus.selected == 3);
    dialog.release();
}

#[test]
fn tui_grainy_waveform_time_slices() {
    let surface: Surface = Surface::new(7, 1); let area: Rect = surface.bounds();
    let details: list<WavePeak> = [WavePeak { left: 1000, right: 1000 }, WavePeak {},
        WavePeak { left: 1000, right: 1000 }, WavePeak {}];
    paint_mono_grainy(surface, Rect::new(0, 0, 2, 1), area, details, 0, 4, 3, 2, false, 15000);
    let first: Cell = surface.cell(0, 0); let second: Cell = surface.cell(1, 0);
    verify(first.glyph == 0x282d && second.glyph == 0x282d);
    paint_mono_grainy(surface, Rect::new(2, 0, 2, 1), area, details, 0, 4, 3, 2, true, 15000);
    let outer_left: Cell = surface.cell(2, 0); let outer_right: Cell = surface.cell(3, 0);
    verify(outer_left.glyph == 0x2805 && outer_right.glyph == 0x2828);
    // L and R sum to one level mirrored around the center: 1000/0 is half height.
    let mixed: list<WavePeak> = [WavePeak { left: 1000 }, WavePeak { left: 1000 }, WavePeak { left: 1000 }, WavePeak { left: 1000 }];
    paint_mono_grainy(surface, Rect::new(4, 0, 3, 1), area, mixed, 0, 4, 3, 2, false, 15000);
    let edge_left: Cell = surface.cell(4, 0); let middle: Cell = surface.cell(5, 0); let edge_right: Cell = surface.cell(6, 0);
    verify(edge_left.glyph == 0x28b8 && middle.glyph == 0x28ff && edge_right.glyph == 0x2847);
    // Vertical zoom: a 1/32 line stretches two slices over the dot rows, a 1/64 line one.
    paint_mono_grainy(surface, Rect::new(0, 0, 2, 1), area, details, 0, 2, 3, 2, false, 7500);
    let half_row: Cell = surface.cell(0, 0); verify(half_row.glyph == 0x281b);
    paint_mono_grainy(surface, Rect::new(0, 0, 2, 1), area, details, 2, 1, 3, 2, false, 3750);
    let quarter_row: Cell = surface.cell(1, 0); verify(quarter_row.glyph == 0x28ff);
    surface.release();
}

#[test]
fn tui_horizontal_sample_zoom_and_render() {
    var clip: AudioClip = AudioClip { channels: 1, sample_rate: 8, frames: 32, frames_per_row: 8 };
    for i in 0..32 { clip.samples.push(i % 2 == 0 ? -1.0f : 1.0f); }
    var view: SampleView = SampleView { grainy: false };
    verify(view.span(clip, 8) == 32 && view.start(clip, 0, 8) == 0);
    view.on_key(decode_input("+"), clip, 10, 0);
    verify(view.span(clip, 8) == 16 && view.start(clip, 2, 8) == 8);
    view.on_key(decode_input("+"), clip, 10, 0);
    verify(view.span(clip, 8) == 8 && view.start(clip, 3, 8) == 20);
    view.on_key(decode_input("+"), clip, 10, 0); verify(view.zoom == 2);
    // The retired Ctrl+Shift+L pane shortcut is ignored, and Ctrl+H/L no longer zoom.
    verify(!view.on_key(decode_input("\x1b[108;6u"), clip, 10, 0));
    view.on_key(decode_input("\x1b[104;5u"), clip, 10, 0); verify(view.zoom == 2);
    view.on_key(decode_input("-"), clip, 10, 0); verify(view.zoom == 1);
    view.anchor_active = false; // the cursor follows the row again
    let surface: Surface = Surface::new(18, 6); let theme: Theme = Theme::dark_blue();
    view.wave = true; view.zoom = 20;
    view.paint(surface, surface.bounds(), theme, clip, 1);
    let signed_low: Cell = surface.cell(2, 5); verify(signed_low.glyph == 0x25cf);
    view.grainy = true;
    view.paint(surface, surface.bounds(), theme, clip, 0);
    let dots: Cell = surface.cell(2, 5); verify(dots.glyph >= 0x2800 && dots.glyph <= 0x28ff);
    view.paint_at(surface, surface.bounds(), theme, clip, 0, 7500);
    let moving: Cell = surface.cell(4, 1); let prior: Cell = surface.cell(2, 1);
    verify(moving.background == theme.selection && prior.background == theme.panel);
    view.paint(surface, Rect::new(0, 0, 1, 1), theme, clip, 0);
    surface.release();
}

#[test]
fn tui_sample_view_selection() {
    // slice_frames lifts a sample-accurate sub-clip with freshly built peaks.
    var clip: AudioClip = AudioClip { source: clone("s"), channels: 1, sample_rate: 8, frames: 32, frames_per_row: 8 };
    for i in 0..32 { clip.samples.push(i % 2 == 0 ? 0.5f : -0.5f); }
    for _r in 0..4 { clip.peaks.push(WavePeak { left: 500 }); }
    for _r in 0..16 { clip.detail_peaks.push(WavePeak { left: 500 }); }
    let sub: AudioClip = clip.slice_frames(8, 24);
    verify(sub.frames == 16 && sub.peaks.len() == 2 && sub.detail_peaks.len() == 8);
    verify(sub.samples.len() == 16 && sub.channels == 1 && sub.samples[0] == 0.5f);
    var empty: AudioClip = AudioClip { source: clone("e"), channels: 1, frames_per_row: 8 };
    let none: AudioClip = empty.slice_frames(0, 10); verify(none.frames == 0 && none.peaks.len() == 0);
    // v starts a selection at the cursor; it follows the cursor from there.
    var big: AudioClip = AudioClip { source: clone("b"), channels: 1, sample_rate: 48000, frames: 1024, frames_per_row: 128 };
    for _i in 0..1024 { big.samples.push(0.0f); }
    var view: SampleView = SampleView { visible: true };
    view.reset_selection(big.frames);
    verify(view.sel_start == 0 && view.sel_end == 1024 && view.sel_frames == 1024);
    verify(!view.anchor_active);
    // 34 columns: a 32-column wave, so h/l step 1024 / 32 = 32 frames.
    verify(view.on_key(decode_input("l"), big, 34, 0) && view.anchor_active && view.anchor_frame == 32);
    verify(view.on_key(decode_input("v"), big, 34, 0) && view.selecting && !view.has_selection(big.frames));
    verify(view.on_key(decode_input("l"), big, 34, 0)); verify(view.sel_start == 32 && view.sel_end == 64);
    // Back past where v was pressed: the selection flips to that side.
    for _i in 0..2 { view.on_key(decode_input("h"), big, 34, 0); }
    verify(view.sel_start == 0 && view.sel_end == 32);
    // Shift+E / Shift+B: the clip's end / beginning; the selection follows.
    verify(view.on_key(decode_input("E"), big, 34, 0)); verify(view.sel_start == 32 && view.sel_end == 1024);
    verify(view.on_key(decode_input("\x1b[98;2u"), big, 34, 0)); verify(view.sel_start == 0 && view.sel_end == 32);
    verify(view.anchor_frame == 0);
    // The old Ctrl+M and Shift+N/M edge keys are gone.
    verify(!view.on_key(decode_input("\x1b[109;5u"), big, 34, 0));
    verify(!view.on_key(decode_input("N"), big, 34, 0));
    verify(view.on_key(decode_input("+"), big, 34, 0)); verify(view.zoom == 1);
    // A proper subset shades its columns lighter than the panel; outside stays panel.
    var mono: AudioClip = AudioClip { source: clone("m"), channels: 1, sample_rate: 8, frames: 32, frames_per_row: 8 };
    for i in 0..32 { mono.samples.push(i % 2 == 0 ? -1.0f : 1.0f); }
    var paint: SampleView = SampleView { grainy: true };
    paint.sel_frames = 32; paint.sel_start = 0; paint.sel_end = 16;
    let surface: Surface = Surface::new(18, 6); let theme: Theme = Theme::dark_blue();
    paint.paint_at(surface, surface.bounds(), theme, mono, 3, 0);
    let inside: Cell = surface.cell(4, 1); let outside: Cell = surface.cell(12, 1);
    verify(inside.background == lighten(theme.panel, 22) && inside.background != theme.selection);
    verify(outside.background == theme.panel);
    surface.release();
    clip.release(); empty.release(); big.release(); mono.release();
}

#[test]
fn tui_audio_trim_and_slice() {
    let area: Rect = Rect::new(0, 0, 120, 12);
    // --- Non-destructive trim: only offset/length change; full buffer intact. ---
    var table: SequenceTable = SequenceTable::new(); table.track_action(28, area);
    var clip: AudioClip = AudioClip { source: clone("t-test"), channels: 1, sample_rate: 80, frames: 80, frames_per_row: 10 };
    for _i in 0..80 { clip.samples.push(0.25f); }
    for r in 0..8 { clip.peaks.push(WavePeak { left: 100 + i32(r) }); }
    for _r in 0..32 { clip.detail_peaks.push(WavePeak { left: 200 }); }
    let len_col: i32 = table.audio_length_column(3);
    table.selected_row = 0; table.selected_column = len_col; verify(table.insert_audio(clip, area));
    verify(table.trim_audio(20, 60, area));
    let inst: AudioInstance = table.tracks[3].instances[0];
    verify(inst.offset_frames == 20 && inst.length_ticks == 60000);
    verify(inst.clip.frames == 80 && inst.clip.samples.len() == 80);
    verify(table.rows[0].cells[len_col] == "4.00");
    let rc: AudioClip = inst.render_clip();
    verify(rc.offset == 20 && rc.frames == 40);
    // Trimming again is relative to the current window (offset accumulates).
    verify(table.trim_audio(10, 30, area));
    let inst2: AudioInstance = table.tracks[3].instances[0];
    verify(inst2.offset_frames == 30 && inst2.length_ticks == 30000);
    verify(inst2.clip.samples.len() == 80);
    table.release();
    // --- Non-destructive slice: one instance becomes head / middle / tail. ---
    var slab: SequenceTable = SequenceTable::new(); slab.track_action(28, area);
    var sclip: AudioClip = AudioClip { source: clone("sl-test"), channels: 1, sample_rate: 80, frames: 80, frames_per_row: 10 };
    for _i in 0..80 { sclip.samples.push(0.5f); }
    for _r in 0..8 { sclip.peaks.push(WavePeak { left: 100 }); }
    for _r in 0..32 { sclip.detail_peaks.push(WavePeak { left: 200 }); }
    let scol: i32 = slab.audio_length_column(3);
    slab.selected_row = 0; slab.selected_column = scol; verify(slab.insert_audio(sclip, area));
    slab.selected_row = 2; verify(slab.edit_event(decode_input("v"), area)); verify(slab.visual);
    slab.selected_row = 4; verify(slab.slice_audio(area));
    verify(!slab.visual);
    let track: SequenceTrack = slab.tracks[3];
    verify(track.instances.len() == 3);
    verify(track.instances[0].start_row == 0 && track.instances[0].offset_frames == 0 && track.instances[0].length_ticks == 30000);
    verify(track.instances[1].start_row == 2 && track.instances[1].offset_frames == 20 && track.instances[1].length_ticks == 45000);
    verify(track.instances[2].start_row == 5 && track.instances[2].offset_frames == 50 && track.instances[2].length_ticks == 45000);
    verify(track.instances[1].clip.frames == 80 && track.instances[1].clip.samples.len() == 80);
    verify(slab.rows[0].cells[scol] == "2.00" && slab.rows[2].cells[scol] == "3.00" && slab.rows[5].cells[scol] == "3.00");
    slab.release();
}

#[test]
fn tui_waveform_fractional_edges() {
    let surface: Surface = Surface::new(13, 5); let area: Rect = surface.bounds();
    surface.fill(area, Cell { glyph: 32, foreground: 1, background: 2 });
    // 300 peak over 6.5 cells per side: 16 eighths each way from the center.
    paint_mono_wave(surface, Rect::new(0, 0, 13, 1), area, 300, 250, 3, 2, false);
    let outside: Cell = surface.cell(3, 0); let left_edge: Cell = surface.cell(4, 0);
    let solid: Cell = surface.cell(6, 0); let right_edge: Cell = surface.cell(8, 0);
    verify(outside.glyph == 32 && solid.glyph == 0x2588);
    verify(left_edge.glyph == 0x258c && left_edge.foreground == 2 && left_edge.background == 3);
    verify(right_edge.glyph == 0x258c && right_edge.foreground == 3 && right_edge.background == 2);
    paint_mono_wave(surface, Rect::new(0, 1, 13, 1), area, 300, 0, 3, 2, false);
    let shade: Cell = surface.cell(6, 1); verify(shade.glyph == 0x2592);
    // Quiet rows thicken a line in the center cell.
    paint_mono_wave(surface, Rect::new(0, 2, 13, 1), area, 30, 0, 3, 2, false);
    let thin: Cell = surface.cell(6, 2); let beside: Cell = surface.cell(5, 2);
    verify(thin.glyph == 0x2503 && beside.glyph == 32);
    paint_mono_wave(surface, Rect::new(0, 3, 13, 1), area, 0, 0, 3, 2, false);
    let silent: Cell = surface.cell(6, 3); verify(silent.glyph == 32);
    paint_mono_wave(surface, Rect::new(0, 4, 13, 1), Rect::new(7, 4, 6, 1), 2000, 2000, 3, 2, false);
    let clipped: Cell = surface.cell(6, 4); let full: Cell = surface.cell(12, 4);
    verify(clipped.glyph == 32 && full.glyph == 0x2588);
    surface.release();
}

#[test]
fn tui_audio_import_and_waveform() {
    var table: SequenceTable = SequenceTable::new(); table.zoom_tracks(2, true, Rect::new(0, 0, 120, 12)); let area: Rect = Rect::new(0, 0, 120, 12);
    verify(!table.import_audio("tests/fixtures/audio/stereo_tone.wav", 120, area));
    table.create_track_kind(false, true, area);
    verify(!table.import_audio("README.md", 120, area));
    verify(table.import_audio("tests/fixtures/audio/stereo_tone.wav", 120, area));
    let track: SequenceTrack = table.tracks[3];
    let audio: AudioInstance = track.instances[0];
    verify(audio.clip.detail_peaks.len() == audio.clip.peaks.len() * 4);
    verify(audio.clip.samples.len() == audio.clip.frames * audio.clip.channels);
    verify(table.audio_under_cursor());
    verify(audio.clip.peaks.len() > 64 && table.rows.len() == audio.clip.peaks.len());
    verify(table.track_columns(3) == 3 && table.columns.len() == 19);
    let tail: TableRow = table.rows[64];
    verify(tail.cells.len() == 19 && tail.cells[1] == "" && tail.cells[2] == "");
    let original: TableRow = table.rows[0]; verify(original.cells[1] == "C-4");
    let wave: i32 = table.audio_waveform_column(3);
    let wave_column: TableColumn = table.columns[wave]; verify(wave_column.read_only && wave_column.selectable);
    let surface: Surface = Surface::new(120, 12); let theme: Theme = Theme::dark_blue();
    table.paint(surface, area, theme); table.paint_audio(surface, area, theme);
    // One mono waveform through the middle of the column, with no divider.
    let center: Cell = surface.cell(table.column_x(wave) + 3, 2);
    verify(center.glyph > 0x2800 && center.glyph <= 0x28ff && center.foreground == 0x8a8a8a);
    // The waveform column has one fixed width; z does not zoom it.
    verify(wave_column.width == 7 && table.edit_event(decode_input("z"), area));
    let unzoomed: TableColumn = table.columns[wave]; verify(unzoomed.width == 7);
    verify(table.selected_column == 16 && table.selected_row == 0);
    var copy: SequenceTable = table.copy_pattern();
    table.clear_track(); verify(table.track_columns(3) == 2);
    let saved: SequenceTrack = copy.tracks[3]; let saved_audio: AudioInstance = saved.instances[0];
    verify(saved_audio.clip.peaks.len() > 64);
    verify(saved_audio.clip.samples.len() > 0 && saved_audio.clip.samples[0] == audio.clip.samples[0]);
    copy.create_track(true, area); verify(copy.track_columns(4) == 3);
    let duplicated: SequenceTrack = copy.tracks[4]; verify(duplicated.audio);
    copy.remove_track(area); verify(copy.tracks.len() == 4);
    verify(!copy.import_audio("missing-file.wav", 120, area));
    let retained: SequenceTrack = copy.tracks[3]; verify(retained.instances.len() == 1);
    copy.release(); table.release(); surface.release();
}

#[test]
fn tui_transport_status() {
    let surface: Surface = Surface::new(80, 3); let theme: Theme = Theme::dark_blue();
    var status: TransportStatus = TransportStatus {};
    verify(status.bpm == 120 && status.beats_per_bar == 4 && status.beat_unit == 4);
    status.paint(surface, Rect::new(0, 2, 80, 1), theme, "Untitled");
    let idle: Cell = surface.cell(42, 2);
    verify(idle.glyph == 9675 && idle.foreground == theme.muted);
    // " | Untitled" follows "STOP"; a saved project shows its folder name.
    let untitled: Cell = surface.cell(51, 2); verify(untitled.glyph == 85);
    status.paint(surface, Rect::new(0, 2, 80, 1), theme, "Song.mlaproj");
    let project: Cell = surface.cell(51, 2); let suffix: Cell = surface.cell(56, 2);
    verify(project.glyph == 83 && suffix.glyph == 109 && project.foreground == theme.foreground);
    status.elapsed_ms = 62003; status.bpm = 140; status.beats_per_bar = 7; status.beat_unit = 8;
    status.midi_received = true;
    status.paint(surface, Rect::new(0, 2, 80, 1), theme, "Untitled");
    let active: Cell = surface.cell(42, 2);
    verify(active.glyph == 9679 && active.foreground == 0x5adc8c);
    let minute: Cell = surface.cell(17, 2); let second: Cell = surface.cell(20, 2);
    verify(minute.glyph == 49 && second.glyph == 50);
    // CPU use sits at the right end: "CPU 42% " ends one cell before the edge.
    let before: Cell = surface.cell(72, 2);
    verify(before.glyph == 32);
    status.cpu_percent = 42;
    status.paint(surface, Rect::new(0, 2, 80, 1), theme, "Untitled");
    let c: Cell = surface.cell(72, 2); let percent: Cell = surface.cell(78, 2);
    verify(c.glyph == 67 && percent.glyph == 37 && percent.foreground == theme.foreground);
    status.cpu_percent = 95;
    status.paint(surface, Rect::new(0, 2, 80, 1), theme, "Untitled");
    let busy: Cell = surface.cell(78, 2); verify(busy.foreground == theme.accent);
    // Too narrow to clear the transport text: the meter is left out.
    status.paint(surface, Rect::new(0, 2, 50, 1), theme, "Untitled");
    let hidden: Cell = surface.cell(43, 2); verify(hidden.glyph != 67);
    status.paint(surface, Rect::new(0, 2, 5, 1), theme, "Untitled");
    status.paint(surface, Rect::new(0, 2, 0, 0), theme, "Untitled");
    surface.release();
}

#[test]
fn cpu_meter_samples_every_period() {
    var meter: CpuMeter = CpuMeter {};
    verify(meter.percent == -1);
    verify(!meter.update(1000)); // first sample only sets the baseline
    verify(!meter.update(1200)); // inside the 300 ms period
    var sum: i64 = 0;
    for i in 0..5000000 { sum = sum + i % 3; }
    verify(sum > 0);
    verify(meter.update(1300));
    verify(meter.percent >= 0 && meter.percent <= 100);
}

#[test]
fn tui_pattern_library_independence() {
    var library: PatternLibrary = PatternLibrary::new(); let area: Rect = Rect::new(0, 0, 20, 10);
    verify(library.patterns.len() == 3 && library.song.len() == 4 && library.active_id == 1);
    library.table.edit_event(decode_input("K"), area);
    library.table.track_action(25, area);
    library.on_event(decode_input("j"), area);
    verify(library.active_id == 2);
    let verse: TableRow = library.table.rows[0]; let verse_track: SequenceTrack = library.table.tracks[0];
    verify(verse.cells[1] == "E-4" && !verse_track.muted);
    library.on_event(decode_input("k"), area);
    let intro: TableRow = library.table.rows[0]; let intro_track: SequenceTrack = library.table.tracks[0];
    verify(intro.cells[1] == "C#4" && intro_track.muted);
    library.add(true); verify(library.active_id == 4 && library.patterns.len() == 4);
    library.table.edit_event(decode_input("K"), area);
    library.select(1); let original: TableRow = library.table.rows[0]; verify(original.cells[1] == "C#4");
    library.select(4); let duplicate: TableRow = library.table.rows[0]; verify(duplicate.cells[1] == "D-4");
    verify(library.rename("Intro copy edited"));
    library.show_patterns();
    let last: ListItem = library.view.items[3]; verify(last.label == "004 Intro copy edited");
    library.add(false); verify(library.active_id == 5);
    let blank: TableRow = library.table.rows[0]; verify(blank.cells[1] == "" && blank.cells[2] == "");
    library.release();
}

#[test]
fn tui_song_and_pattern_removal() {
    var library: PatternLibrary = PatternLibrary::new(); let area: Rect = Rect::new(0, 0, 20, 10);
    library.show_patterns();
    library.on_event(decode_input("j"), area); verify(library.active_id == 2);
    // Removing a pattern takes it out of every matrix row.
    verify(library.song.len() == 4);
    library.remove_active(area);
    verify(library.patterns.len() == 2);
    let order: list<i32> = library.song;
    for id in order { verify(id != 2); }
    library.on_event(decode_input("G"), area); verify(library.active_id == 3);
    library.on_event(decode_input("g"), area); library.on_event(decode_input("g"), area); verify(library.active_id == 1);
    library.remove_active(area);
    verify(library.patterns.len() == 1 && library.error == "");
    library.remove_active(area);
    verify(library.patterns.len() == 1 && library.error != "");
    library.release();
}

#[test]
fn tui_song_matrix_row_and_cell_operations() {
    var library: PatternLibrary = PatternLibrary::new(); let area: Rect = Rect::new(0, 0, 40, 10);
    verify(library.song.len() == 4 && library.song[0] == 1);
    // o/O insert whole rows, empty in every lane.
    verify(library.set_song_at(0, 1, 3));
    verify(library.matrix_insert_row(0, true));
    verify(library.song.len() == 5 && library.song_at(1, 0) == 0 && library.song_at(1, 1) == 0);
    verify(library.song_at(0, 1) == 3 && library.song_at(2, 0) == library.song[2]);
    verify(library.matrix_insert_row(0, false));
    verify(library.song.len() == 6 && library.song_at(0, 0) == 0 && library.song_at(1, 1) == 3);
    // dd removes the row from every lane.
    verify(library.matrix_remove_row(0));
    verify(library.song.len() == 5 && library.song_at(0, 1) == 3);
    verify(!library.matrix_remove_row(9));
    // Ctrl+O shifts one lane only, leaving the others in place.
    let before: i32 = library.song_at(0, 0);
    verify(library.matrix_insert_cell(0, 1, false));
    verify(library.song_at(0, 1) == 0 && library.song_at(1, 1) == 3);
    verify(library.song_at(0, 0) == before);
    library.release();
}

#[test]
fn tui_sequence_jump_navigation() {
    var table: SequenceTable = SequenceTable::new(); table.zoom_tracks(2, true, Rect::new(0, 0, 120, 12));
    let area: Rect = Rect::new(0, 0, 40, 10);
    table.edit_event(decode_input("G"), area);
    verify(table.selected_row == 63 && table.scroll_y > 0);
    table.edit_event(decode_input("g"), area); verify(table.selected_row == 63);
    table.edit_event(decode_input("g"), area); verify(table.selected_row == 0 && table.scroll_y == 0);
    table.edit_event(decode_input("\x1b[103;2u"), area); verify(table.selected_row == 63);
    table.edit_event(decode_input("g"), area); table.edit_event(decode_input("k"), area);
    table.edit_event(decode_input("g"), area); verify(table.selected_row == 62);
    table.edit_event(decode_input("g"), area); verify(table.selected_row == 0);
    table.edit_event(decode_input("\r"), area);
    table.editor.set_text(""); table.edit_event(decode_input("G"), area);
    table.edit_event(decode_input("g"), area); table.edit_event(decode_input("g"), area);
    verify(table.editor.text == "Ggg" && table.selected_row == 0);
    table.edit_event(InputEvent { kind: InputKind::Menu, key: Key::Escape }, area);
    for _i in 0..64 { table.delete_row(area); }
    table.edit_event(decode_input("G"), area);
    table.edit_event(decode_input("g"), area); table.edit_event(decode_input("g"), area);
    verify(table.selected_row == -1 && table.scroll_y == 0);
    table.release();
}

#[test]
fn tui_pattern_insert_rows() {
    let area: Rect = Rect::new(0, 0, 40, 8); var table: SequenceTable = SequenceTable::new();
    table.selected_row = 3; table.selected_column = 2;
    table.edit_event(decode_input("o"), area);
    verify(table.rows.len() == 65 && table.selected_row == 4 && table.selected_column == 2);
    let blank: TableRow = table.rows[4]; verify(blank.cells[0] == "005");
    for c in 1..blank.cells.len() { verify(blank.cells[c] == ""); }
    let shifted: TableRow = table.rows[5]; verify(shifted.cells[0] == "006" && shifted.cells[1] == "C-4" && shifted.cells[3] == "1.00");
    table.edit_event(decode_input("O"), area); verify(table.rows.len() == 66 && table.selected_row == 4);
    table.selected_row = 0; table.edit_event(decode_input("\x1b[111;2u"), area);
    verify(table.selected_row == 0 && table.rows.len() == 67);
    table.selected_row = 66; table.edit_event(decode_input("o"), area);
    verify(table.selected_row == 67 && table.rows.len() == 68 && table.scroll_y > 0);
    table.release();
    var empty: SequenceTable = SequenceTable::empty();
    for _r in 0..64 { empty.selected_row = 0; empty.delete_row(area); }
    empty.edit_event(decode_input("o"), area); verify(empty.rows.len() == 1 && empty.selected_row == 0);
    verify(empty.set_length(16384, area)); let revision: i64 = empty.revision;
    empty.edit_event(decode_input("O"), area); verify(empty.rows.len() == 16384 && empty.revision == revision && empty.error != ""); empty.release();
}

#[test]
fn tui_pattern_insert_shifts_audio() {
    let area: Rect = Rect::new(0, 0, 120, 12);
    var table: SequenceTable = SequenceTable::new(); table.create_track_kind(false, true, area);
    var clip: AudioClip = AudioClip { source: clone("insert-test"), frames: 40, frames_per_row: 10 };
    for _r in 0..4 { clip.peaks.push(WavePeak { left: 500, right: 250 }); }
    for _r in 0..16 { clip.detail_peaks.push(WavePeak { left: 500, right: 250 }); }
    table.selected_row = 5; verify(table.insert_audio(clip, area));
    table.edit_event(decode_input("O"), area);
    let shifted: SequenceTrack = table.tracks[3]; let instance: AudioInstance = shifted.instances[0];
    verify(table.selected_row == 5 && instance.start_row == 6 && instance.duration() == 60000);
    let start: TableRow = table.rows[6]; verify(start.cells[16] == "4.00");
    table.selected_row = 7; table.edit_event(decode_input("o"), area);
    let retained: SequenceTrack = table.tracks[3]; let span: AudioInstance = retained.instances[0];
    verify(span.start_row == 6 && span.duration() == 60000 && table.selected_row == 8);
    table.release(); clip.release();
}

#[test]
fn tui_vu_meter_and_mixer() {
    let theme: Theme = Theme::dark_blue();
    let surface: Surface = Surface::new(40, 18);
    let full: VuMeter = VuMeter { level: 2000 };
    full.paint(surface, Rect::new(1, 1, 1, 10), theme.panel);
    let red: Cell = surface.cell(1, 1); let green: Cell = surface.cell(1, 10);
    verify(red.glyph == 0x2588 && red.foreground == 0xFF604C && green.foreground == 0x74F078);
    let partial: VuMeter = VuMeter { level: 250 };
    partial.paint(surface, Rect::new(2, 1, 1, 1), theme.panel);
    let quarter: Cell = surface.cell(2, 1); verify(quarter.glyph == 0x2582);
    let empty: VuMeter = VuMeter { level: -1 };
    empty.paint(surface, Rect::new(3, 1, 1, 1), theme.panel);
    let silent: Cell = surface.cell(3, 1); verify(silent.foreground == 0x163A2A);
    var mixer: Mixer = Mixer { visible: true };
    var table: SequenceTable = SequenceTable::new(); table.zoom_tracks(2, true, Rect::new(0, 0, 120, 12));
    let track: SequenceTrack = table.tracks[0]; verify(track.volume == 100 && track.pan == 0);
    let before: i32 = mixer.level(0, 100, 0, false, false); mixer.update(table, 0, 0, true, 10);
    verify(before != mixer.level(0, 100, 0, false, false));
    verify(mixer.level(0, 100, 0, false, true) == 0 && mixer.level(0, 100, 100, false, false) == 0);
    mixer.paint(surface, Rect::new(0, 0, 27, 16), theme, table.tracks, 1);
    let selected: Cell = surface.cell(8, 0); let other: Cell = surface.cell(0, 0);
    verify(selected.background == lighten(theme.panel, 8) && other.background == theme.panel);
    let volume: Cell = surface.cell(8, 1); let pan: Cell = surface.cell(8, 2);
    verify(volume.glyph == 86 && pan.glyph == 80);
    verify(mixer.update_master(900, 400, 20));
    verify(mixer.master.left > mixer.master.right && mixer.master.right > 0);
    let previous_master: i32 = mixer.master.left;
    mixer.update_master(0, 0, 20); verify(mixer.master.left < previous_master);
    mixer.paint(surface, Rect::new(0, 0, 27, 16), theme, table.tracks, 2);
    let master_title: Cell = surface.cell(21, 0); verify(master_title.glyph == 77);
    mixer.paint(surface, Rect::new(0, 0, 9, 8), theme, table.tracks, 2);
    let last: Cell = surface.cell(1, 0); verify(last.glyph == 51);
    for size in 0..5 { mixer.paint(surface, Rect::new(0, 0, i32(size), i32(size)), theme, table.tracks, 2); }
    table.release(); surface.release();
}

#[test]
fn tui_mixed_track_types() {
    var table: SequenceTable = SequenceTable::new(); table.zoom_tracks(2, true, Rect::new(0, 0, 120, 12));
    let area: Rect = Rect::new(0, 0, 40, 12);
    table.track_action(28, area);
    verify(table.tracks.len() == 4 && table.selected_column == 16 && table.track_columns(3) == 2 && !table.is_note());
    let audio: SequenceTrack = table.tracks[3]; verify(audio.audio && audio.automation.len() == 0);
    let group: TableGroup = table.groups[3]; verify(group.first == 16 && group.count == 2);
    let column: TableColumn = table.columns[16]; verify(column.title == "LEN");
    // AUDIO tracks play no MIDI: no CC columns to add or configure.
    verify(table.add_automation(3, "cc:1") == 0 && table.error == "An AUDIO track has no MIDI output to automate");
    verify(!table.configure_slot(1, "pitchbend"));
    table.track_action(21, area); verify(table.selected_column == 18 && table.is_note());
    table.edit_event(decode_input("K"), area); table.edit_event(decode_input("K"), area);
    verify(table.add_automation(4, "pitchbend") == 2 && table.automation_column(4, 2) == 23);
    let bend: TableColumn = table.columns[23]; verify(bend.title == "PB" && !bend.hidden && !bend.validate("C-4"));
    table.selected_column = 23;
    table.edit_event(decode_input("\r"), area); table.editor.set_text("-123"); table.edit_event(decode_input("\r"), area);
    let mixed: TableRow = table.rows[0]; verify(mixed.cells[23] == "-123" && mixed.cells[18] == "C#4");
    table.selected_column = 18; table.create_track(true, area);
    let duplicate: SequenceTrack = table.tracks[5]; verify(!duplicate.audio && duplicate.automation.len() == 2 && table.selected_column == 24);
    let copied: TableRow = table.rows[0]; verify(copied.cells[29] == "-123");
    table.clear_track(); let cleared: TableRow = table.rows[0]; verify(cleared.cells[29] == "" && cleared.cells[23] == "-123");
    table.remove_track(area); table.selected_column = 16; table.remove_track(area);
    verify(table.tracks.len() == 4 && table.is_note() && table.selected_column == 16);
    let shifted: TableRow = table.rows[0]; verify(shifted.cells[16] == "C#4" && shifted.cells[21] == "-123");
    table.release();
}

#[test]
fn tui_meter_styles_and_channel_counts() {
    let surface: Surface = Surface::new(30, 16); let theme: Theme = Theme::dark_blue();
    let solid: VuMeter = VuMeter { level: 250 };
    let grainy: VuMeter = VuMeter { level: 250, grainy: true };
    solid.paint(surface, Rect::new(0, 0, 1, 1), theme.panel);
    grainy.paint(surface, Rect::new(1, 0, 1, 1), theme.panel);
    let bar: Cell = surface.cell(0, 0); let dots: Cell = surface.cell(1, 0);
    verify(bar.glyph == 0x2582 && dots.glyph == 0x28C0 && dots.foreground == bar.foreground);
    verify(VuMeter::color(519) == 0x74F078 && VuMeter::color(520) == 0xFFD65C);
    verify(VuMeter::color(700) == 0xFF9046 && VuMeter::color(850) == 0xFF604C);
    var table: SequenceTable = SequenceTable::new(); table.zoom_tracks(2, true, Rect::new(0, 0, 120, 12)); table.create_track_kind(false, true, Rect::new(0, 0, 40, 12));
    let mixer: Mixer = Mixer { visible: true };
    mixer.paint(surface, Rect::new(0, 0, 24, 12), theme, table.tracks, 3);
    // Meters stop above the fader value and the OUT row beneath it.
    let mono: Cell = surface.cell(3, 9); let empty: Cell = surface.cell(4, 9);
    let left: Cell = surface.cell(11, 9); let right: Cell = surface.cell(12, 9);
    verify(mono.glyph != 32 && empty.glyph == 32 && left.glyph != 32 && right.glyph != 32);
    let identity: Cell = surface.cell(8, 0); verify(identity.glyph == 65);
    let master: Cell = surface.cell(18, 0); verify(master.glyph == 77);
    table.release(); surface.release();
}

#[test]
fn tui_track_groups_and_frozen_row() {
    var table: SequenceTable = SequenceTable::new(); table.zoom_tracks(2, true, Rect::new(0, 0, 120, 12));
    let area: Rect = Rect::new(2, 1, 42, 10);
    let surface: Surface = Surface::new(48, 14); let theme: Theme = Theme::dark_blue();
    verify(table.tracks.len() == 3 && table.columns.len() == 16 && table.groups.len() == 3);
    table.paint(surface, area, theme);
    let active: Cell = surface.cell(6, 1); let inactive: Cell = surface.cell(41, 1);
    verify(active.background == theme.selection && inactive.background == theme.menu_background);
    let row: Cell = surface.cell(2, 3); verify(row.glyph == 48);
    table.selected_column = 15; table.paint(surface, area, theme);
    verify(table.scroll_x > 0 && table.active_track() == 2);
    let pinned: Cell = surface.cell(2, 3); verify(pinned.glyph == 48);
    let header: Cell = surface.cell(2, 2); verify(header.glyph == 82);
    let selected: Rect = table.selected_rect(area);
    verify(selected.x >= area.x + 4 && selected.x + selected.width <= area.x + area.width - 1);
    let right_group: Cell = surface.cell(selected.x, 1); verify(right_group.background == theme.selection);
    for width in 0..8 { table.paint(surface, Rect::new(0, 0, i32(width), 2), theme); }
    table.release(); surface.release();
}

#[test]
fn tui_track_actions_and_automation() {
    var table: SequenceTable = SequenceTable::new(); table.zoom_tracks(2, true, Rect::new(0, 0, 120, 12)); let area: Rect = Rect::new(0, 0, 45, 12);
    verify(table.rename_track("Lead"));
    let fresh: SequenceTrack = table.tracks[0]; let wheel: AutomationSlot = fresh.automation[0];
    verify(fresh.automation.len() == 1 && wheel.parameter == "cc:1" && table.track_columns(0) == 5);
    let wheel_column: TableColumn = table.columns[5]; verify(wheel_column.title == "CC1");
    verify(table.configure_slot(1, "pitchbend"));
    table.selected_column = 5;
    table.edit_event(decode_input("\r"), area); table.editor.set_text("-8192"); table.edit_event(decode_input("\r"), area);
    let bend: TableRow = table.rows[0]; verify(bend.cells[5] == "-8192" && bend.cells[10] == "");
    verify(!table.configure_slot(1, "cc:7"));
    verify(!table.configure_slot(2, "cc:7") && table.error == "Select a CC column first");
    // Track > Automation > Add CC column.
    table.track_action(27, area); verify(table.editing && table.edit_mode == 3 && table.editor.text == "cc:74");
    table.editor.set_text("pitchbend"); table.edit_event(decode_input("\r"), area);
    verify(table.editing && table.error == "The track already has a column for that controller");
    table.editor.set_text("cutoff:-100:1000"); table.edit_event(decode_input("\r"), area);
    verify(!table.editing && table.selected_column == 6 && table.track_start(1) == 7);
    let cutoff: TableColumn = table.columns[6]; verify(cutoff.title == "cutof");
    verify(!table.configure_slot(2, "bad:9:1") && !table.configure_slot(2, "cc:128") && !table.configure_slot(2, "pitchbend"));
    table.track_action(26, area); verify(table.edit_mode == 2 && table.edit_slot == 2 && table.editor.text == "cutoff:-100:1000");
    table.edit_event(InputEvent { kind: InputKind::Menu, key: Key::Escape }, area); verify(!table.editing);
    table.track_action(25, area);
    let muted: SequenceTrack = table.tracks[0]; verify(muted.muted);
    table.create_track(true, area); verify(table.tracks.len() == 4 && table.active_track() == 3);
    let duplicate: TableRow = table.rows[0]; verify(duplicate.cells[21] == "-8192");
    table.clear_track();
    let cleared: TableRow = table.rows[0]; verify(cleared.cells[21] == "" && cleared.cells[5] == "-8192");
    table.remove_track(area); verify(table.tracks.len() == 3 && table.active_track() == 2);
    table.create_track(false, area); let added: TableRow = table.rows[0]; let plain: SequenceTrack = table.tracks[3];
    verify(table.tracks.len() == 4 && plain.automation.len() == 1 && added.cells[21] == "" && table.columns.len() == 22);
    // Track > Automation > Remove CC column drops the column and its values.
    table.selected_column = 6; table.track_action(85, area);
    verify(table.track_columns(0) == 5 && table.selected_column == 5 && table.track_start(1) == 6);
    let kept: TableRow = table.rows[0]; verify(kept.cells[5] == "-8192" && kept.cells[6] == "C-4");
    table.track_action(85, area); verify(table.track_columns(0) == 4 && table.selected_column == 1);
    table.track_action(26, area); verify(!table.editing && table.error == "The track has no CC column; add one first");
    for _i in 0..5 { table.remove_track(area); }
    verify(table.tracks.len() == 1 && table.columns.len() == 6);
    table.release();
}

#[test]
fn tui_sequence_empty_clear_delete() {
    var column: TableColumn = TableColumn { title: "VEL", width: 7, value_type: "i32", nullable: true,
        bounded: true, minimum: 0, maximum: 127 };
    verify(column.validate("") && !column.validate(" ") && !column.validate("128"));
    column.nullable = false; verify(!column.validate(""));
    column.nullable = true; column.value_type = "unknown"; verify(!column.validate(""));
    var table: SequenceTable = SequenceTable::new(); table.zoom_tracks(2, true, Rect::new(0, 0, 120, 12));
    let area: Rect = Rect::new(0, 0, 40, 10);
    table.edit_event(decode_input("\x7f"), area);
    let unchanged: TableRow = table.rows[0]; verify(unchanged.cells[1] == "C-4" && unchanged.cells[2] == "100");
    table.edit_event(decode_input("\r"), area);
    table.edit_event(decode_input("\x1b[127;2u"), area);
    let editing_row: TableRow = table.rows[0]; verify(editing_row.cells[1] == "C-4" && editing_row.cells[2] == "100");
    table.edit_event(InputEvent { kind: InputKind::Menu, key: Key::Escape }, area);
    table.edit_event(decode_input("\r"), area); table.editor.set_text("");
    table.edit_event(decode_input("\r"), area);
    let empty: TableRow = table.rows[0]; verify(!table.editing && empty.cells[1] == "" && empty.cells[2] == "100");
    table.edit_event(decode_input("K"), area);
    let initialized: TableRow = table.rows[0]; verify(initialized.cells[1] == "C-4");
    table.edit_event(decode_input("\x1b[127;2u"), area);
    let cleared: TableRow = table.rows[0];
    verify(cleared.cells[0] == "001" && cleared.cells[1] == "" && cleared.cells[2] == "" && cleared.cells[3] == "");
    verify(table.rows.len() == 64);
    table.edit_event(decode_input("K"), area);
    table.edit_event(decode_input("l"), area); table.edit_event(decode_input("J"), area);
    let numeric: TableRow = table.rows[0]; verify(numeric.cells[2] == "99");
    table.edit_event(decode_input("d"), area); verify(table.rows.len() == 64);
    table.edit_event(decode_input("j"), area); table.edit_event(decode_input("d"), area);
    verify(table.rows.len() == 64);
    table.edit_event(decode_input("d"), area); verify(table.rows.len() == 63 && table.selected_row == 1);
    let renumbered: TableRow = table.rows[1]; verify(renumbered.cells[0] == "002");
    table.selected_row = 62;
    table.edit_event(decode_input("d"), area); table.edit_event(decode_input("d"), area);
    verify(table.rows.len() == 62 && table.selected_row == 61);
    for _i in 0..62 { table.delete_row(area); }
    verify(table.rows.len() == 0 && table.selected_row == -1 && table.scroll_y == 0);
    table.clear_row(); table.delete_row(area);
    table.edit_event(decode_input("d"), area); table.edit_event(decode_input("d"), area);
    table.release();
}

#[test]
fn tui_sequence_editing() {
    var table: SequenceTable = SequenceTable::new(); table.zoom_tracks(2, true, Rect::new(0, 0, 120, 12));
    let area: Rect = Rect::new(0, 0, 40, 10);
    verify(table.notes.len() == 128);
    table.reconcile(area); verify(table.selected_column == 1);
    table.edit_event(decode_input("h"), area); verify(table.selected_column == 1);
    table.edit_event(decode_input("K"), area);
    let sharp: TableRow = table.rows[0]; verify(sharp.cells[1] == "C#4");
    table.edit_event(decode_input("\x1b[106;2u"), area);
    let natural: TableRow = table.rows[0]; verify(natural.cells[1] == "C-4");
    for _i in 0..150 { table.edit_event(decode_input("J"), area); }
    let lowest: TableRow = table.rows[0]; verify(lowest.cells[1] == "C--1");
    for _i in 0..150 { table.edit_event(decode_input("K"), area); }
    let highest: TableRow = table.rows[0]; verify(highest.cells[1] == "G-9");
    table.edit_event(decode_input("\r"), area); table.editor.set_text("G#9");
    table.edit_event(decode_input("\r"), area); verify(table.editing);
    table.editor.set_text("C#4"); table.edit_event(decode_input("\r"), area);
    let manual_note: TableRow = table.rows[0]; verify(!table.editing && manual_note.cells[1] == "C#4");
    table.edit_event(decode_input("l"), area);
    for _i in 0..140 { table.edit_event(decode_input("K"), area); }
    let maximum: TableRow = table.rows[0]; verify(maximum.cells[2] == "127");
    for _i in 0..140 { table.edit_event(decode_input("J"), area); }
    let minimum: TableRow = table.rows[0]; verify(minimum.cells[2] == "0");
    table.edit_event(decode_input("\r"), area); table.editor.set_text("128");
    table.edit_event(decode_input("\r"), area); verify(table.editing && table.error != "");
    table.editor.set_text("42"); table.edit_event(decode_input("\r"), area);
    let manual: TableRow = table.rows[0]; verify(!table.editing && manual.cells[2] == "42");
    table.edit_event(decode_input("\r"), area); table.editor.set_text("55");
    table.edit_event(InputEvent { kind: InputKind::Menu, key: Key::Escape }, area);
    let cancelled: TableRow = table.rows[0]; verify(cancelled.cells[2] == "42");
    verify(!table.set_cell(0, 0, "2") && !table.set_cell(0, 2, "bad"));
    table.release();
}

fn test_clip(frames: i64, value: f32) -> AudioClip {
    var samples: list<f32> = [];
    for i in 0..frames { samples.push(value * f32(i + 1) / f32(frames)); }
    let made: result<AudioClip, str8> = AudioClip::from_pcm("edit-test.wav", samples, 1, 8000, 120);
    return made.unwrap();
}

#[test]
fn tui_sample_edit_primitives() {
    let pcm: list<f32> = [0.1f, -0.1f, 0.2f, -0.2f, 0.3f, -0.3f, 0.4f, -0.4f];
    let cropped: list<f32> = pcm_crop(pcm, 2, 1, 3);
    verify(cropped.len() == 4 && cropped[0] == 0.2f && cropped[3] == -0.3f);
    let deleted: list<f32> = pcm_delete(pcm, 2, 1, 3);
    verify(deleted.len() == 4 && deleted[2] == 0.4f && deleted[3] == -0.4f);
    // Channel order within a frame survives reversing a range.
    let reversed: list<f32> = pcm_reverse(pcm, 2, 0, 2);
    verify(reversed[0] == 0.2f && reversed[1] == -0.2f && reversed[2] == 0.1f && reversed[6] == 0.4f);
    let faded_in: list<f32> = pcm_scale(pcm, 2, 0, 4, 1.0f, 1);
    verify(faded_in[0] == 0.0f && faded_in[7] == -0.4f);
    let faded_out: list<f32> = pcm_scale(pcm, 2, 0, 4, 1.0f, 2);
    verify(faded_out[0] == 0.1f && faded_out[6] == 0.0f);
    // Gain hard-clips so sessions (which require -1..1) can always be saved.
    let loud: list<f32> = pcm_scale(pcm, 2, 0, 4, 4.0f, 0);
    verify(loud[6] == 1.0f && loud[7] == -1.0f && loud[0] == 0.4f);
    verify(pcm_peak(pcm, 2, 0, 4) == 0.4f && pcm_peak(pcm, 2, 0, 1) == 0.1f);
    // Out-of-range frames clamp instead of failing.
    let clamped: list<f32> = pcm_crop(pcm, 2, -5, 99); verify(clamped.len() == 8);
}

#[test]
fn tui_sample_editor_keys_select_trim_and_undo() {
    let source: AudioClip = test_clip(4000, 0.5f);
    var editor: SampleEditor = SampleEditor {};
    editor.open(source, 0);
    verify(editor.active && !editor.modified && !editor.has_selection());
    // 82 columns: an 80-column wave, so h/l step 4000 / 80 = 50 frames.
    let width: i32 = 82;
    let escape: InputEvent = InputEvent { kind: InputKind::Menu, key: Key::Escape };
    verify(editor.on_event(decode_input("t"), width) == 0 && !editor.modified); // trim needs a selection
    // Use case: find the start, v, move to the end, t trims to it.
    for _i in 0..4 { editor.on_event(decode_input("l"), width); }
    verify(editor.cursor() == 200 && !editor.has_selection());
    editor.on_event(decode_input("v"), width);
    verify(editor.view.selecting && !editor.has_selection());
    for _i in 0..10 { editor.on_event(decode_input("l"), width); }
    verify(editor.selection_start() == 200 && editor.selection_end() == 700);
    // Shift+L: an eighth of the view (500 frames), in either key spelling; a
    // Num Lock bit in the modifiers changes nothing.
    editor.on_event(decode_input("L"), width);
    editor.on_event(decode_input("\x1b[108;130u"), width);
    verify(editor.selection_start() == 200 && editor.selection_end() == 1700);
    // Esc unselects; the editor stays open.
    verify(editor.on_event(escape, width) == 0 && !editor.has_selection() && !editor.view.selecting && editor.active);
    editor.on_event(decode_input("v"), width);
    for _i in 0..4 { editor.on_event(decode_input("h"), width); }
    verify(editor.selection_start() == 1500 && editor.selection_end() == 1700);
    editor.on_event(decode_input("t"), width);
    verify(editor.modified && editor.clip.frames == 200 && editor.cursor() == 0 && !editor.has_selection());
    verify(editor.clip.detail_peaks.len() == editor.clip.peaks.len() * 4);
    verify(source.samples[3999] == 0.5f); // the session copy is untouched
    editor.on_event(decode_input("u"), width);
    verify(editor.clip.frames == 4000 && !editor.modified);
    verify(!editor.undo());
    // Use case: find the start, v, Shift+B to the beginning, x deletes it.
    for _i in 0..10 { editor.on_event(decode_input("l"), width); }
    editor.on_event(decode_input("v"), width);
    editor.on_event(decode_input("B"), width);
    verify(editor.selection_start() == 0 && editor.selection_end() == 500);
    editor.on_event(decode_input("x"), width);
    verify(editor.clip.frames == 3500 && editor.clip.samples[0] == source.samples[500]);
    // x also cuts from the middle, closing the gap.
    editor.select(1000, 1500); editor.on_event(decode_input("x"), width);
    verify(editor.clip.frames == 3000 && editor.clip.samples[1000] == source.samples[2000]);
    editor.undo(); editor.undo();
    // +/- zoom around the cursor, = fits the whole sample again.
    editor.on_event(decode_input("+"), width); verify(editor.view.zoom == 1);
    editor.on_event(decode_input("-"), width); verify(editor.view.zoom == 0);
    editor.on_event(decode_input("+"), width); editor.on_event(decode_input("+"), width); verify(editor.view.zoom == 2);
    editor.on_event(decode_input("="), width); verify(editor.view.zoom == 0);
    // Zoomed in, h/l steps shrink with the view.
    editor.on_event(decode_input("+"), width); editor.on_event(decode_input("l"), width);
    verify(editor.cursor() == 25);
    editor.on_event(decode_input("="), width);
    // Ctrl+P plays, Ctrl+S asks for the clip's name and mode.
    verify(editor.on_event(decode_input("\x10"), width) == 3);
    verify(editor.on_event(decode_input("\x13"), width) == 4);
    let no_groups: list<str8> = [];
    editor.open_save("edit-test - Trim 1.wav", no_groups, "");
    verify(editor.save.active && !editor.save.destructive);
    editor.on_event(decode_input("\t"), width);
    editor.on_event(decode_input(" "), width);
    verify(editor.save.destructive);
    verify(editor.on_event(decode_input("\r"), width) == 1);
    let saved: str8 = editor.saved_name();
    verify(saved == "edit-test - Trim 1.wav" && editor.save_destructive && !editor.save.active);
    // A rejected name keeps the dialog open; ".wav" is added when missing.
    editor.save_failed("taken");
    let shown: str8 = editor.save.error;
    verify(editor.save.active && shown == "taken");
    editor.save.name.set_text("Other");
    verify(editor.on_event(decode_input("\r"), width) == 1);
    let renamed: str8 = editor.saved_name(); verify(renamed == "Other.wav");
    // With an unsaved trim, the first Esc only warns.
    editor.select(0, 2000); editor.trim();
    verify(editor.on_event(escape, width) == 0 && editor.close_pending);
    verify(editor.on_event(escape, width) == 2);
    // Undo depth is bounded.
    for _i in 0..20 { editor.select(0, editor.clip.frames - 10); editor.trim(); }
    verify(editor.history.len() == 16);
    let taken: AudioClip = editor.take();
    verify(!editor.active && taken.frames == 2000 - 200);
    taken.release(); source.release();
}

#[test]
fn tui_sample_editor_trim_names_and_transients() {
    let none: list<AudioClip> = [];
    let first: str8 = trim_name("/a/b/kick.wav", none); verify(first == "kick - Trim 1.wav"); free(first);
    var samples: list<f32> = []; for _i in 0..100 { samples.push(0.0f); }
    let made: result<AudioClip, str8> = AudioClip::from_pcm("/a/b/kick - Trim 1.wav", samples, 1, 8000, 120);
    let named: AudioClip = made.unwrap();
    let library: list<AudioClip> = [named];
    let second: str8 = trim_name("/a/b/kick.wav", library); verify(second == "kick - Trim 2.wav"); free(second);
    // Trimming a trim numbers on from the original name.
    let again: str8 = trim_name("/a/b/kick - Trim 1.wav", library); verify(again == "kick - Trim 2.wav"); free(again);
    let path: str8 = sibling_path("/a/b/kick.wav", "kick - Trim 1.wav"); verify(path == "/a/b/kick - Trim 1.wav"); free(path);
    let bare: str8 = sibling_path("kick.wav", "x.wav"); verify(bare == "x.wav"); free(bare);
    for clip in library { clip.release(); }
    // Two bursts in silence: one transient at (or just before) each onset.
    var pcm: list<f32> = [];
    for i in 0..8000 { pcm.push((i >= 2000 && i < 2400) || (i >= 6000 && i < 6400) ? 0.8f : 0.0f); }
    let decoded: result<AudioClip, str8> = AudioClip::from_pcm("bursts.wav", pcm, 1, 8000, 120);
    let bursts: AudioClip = decoded.unwrap();
    let points: list<i64> = transient_frames(bursts);
    verify(points.len() == 2);
    verify(points[0] > 1930 && points[0] <= 2000 && points[1] > 5930 && points[1] <= 6000);
    // Ctrl+L / Ctrl+H jump to the next / previous transient, in either key
    // spelling; a running selection keeps its start.
    var editor: SampleEditor = SampleEditor {};
    editor.open(bursts, 0);
    editor.on_event(decode_input("v"), 82);
    editor.on_event(decode_input("\x0c"), 82); verify(editor.cursor() == points[0]);
    editor.on_event(decode_input("\x1b[108;5u"), 82); verify(editor.cursor() == points[1]);
    verify(editor.selection_start() == 0 && editor.selection_end() == points[1]);
    editor.on_event(decode_input("\x0c"), 82); verify(editor.cursor() == 8000);
    editor.on_event(decode_input("\x1b[104;5u"), 82); verify(editor.cursor() == points[1]);
    // Transient mode (Shift+T): h/l step between transients, H/L between the
    // strong ones (both bursts here are equally strong).
    editor.view.clear_selection(8000, 0);
    editor.on_event(decode_input("T"), 82); verify(editor.view.transient_mode);
    verify(editor.view.transients_strong.len() == 2);
    editor.on_event(decode_input("l"), 82); verify(editor.cursor() == points[0]);
    editor.on_event(decode_input("l"), 82); verify(editor.cursor() == points[1]);
    editor.on_event(decode_input("h"), 82); verify(editor.cursor() == points[0]);
    editor.on_event(decode_input("L"), 82); verify(editor.cursor() == points[1]);
    editor.on_event(decode_input("\x1b[116;2u"), 82); verify(!editor.view.transient_mode);
    editor.on_event(decode_input("h"), 82); verify(editor.cursor() == points[1] - 100);
    // The status bar names the clip and shows the position and the mode.
    let bar: str8 = sample_info(editor.view, editor.clip, 0, "bursts.wav", "");
    verify(std::strbuf::find(bar, " bursts.wav | 0.") == 0 && std::strbuf::find(bar, "Transients off") > 0); free(bar);
    editor.release(); bursts.release();
}

#[test]
fn tui_replace_sample_updates_all_placements() {
    var library: PatternLibrary = PatternLibrary::new();
    let area: Rect = Rect::new(0, 0, 120, 20);
    library.table.create_track_kind(false, true, area);
    let clip: AudioClip = test_clip(8000, 0.25f);
    library.audio.samples.push(clip);
    library.audio.view.items.push(ListItem { id: 1, label: clone("1 edit-test.wav") });
    library.table.selected_row = 2;
    verify(library.table.insert_audio(clip, area));
    library.table.selected_row = 20;
    verify(library.table.insert_audio(clip, area));
    var editor: SampleEditor = SampleEditor {};
    let stored_clip: AudioClip = library.audio.samples[0]; editor.open(stored_clip, 0);
    editor.select(0, 3000);
    verify(editor.trim());
    verify(library.replace_sample(0, editor.take()) == 2);
    let track: SequenceTrack = library.table.tracks[library.table.tracks.len() - 1];
    let first: AudioInstance = track.instances[0]; let second: AudioInstance = track.instances[1];
    verify(first.clip.frames == 3000 && second.clip.frames == 3000 && first.length_ticks == 0);
    let stored: AudioClip = library.audio.samples[0]; verify(stored.frames == 3000);
    // The edited session still round-trips: placements resolve to the sample.
    let directory: str8 = clone("/private/tmp/mlacker-edit-test-XXXXXX"); mkdtemp(directory);
    let path: str8 = format!("{}/edited.mlack", directory);
    var audio: AudioSystem = AudioSystem {}; var codec: SessionCodec = SessionCodec {};
    verify(codec.save(path, library, SessionView {}, audio));
    let loaded: result<SessionData, str8> = SessionCodec::load(path); verify(loaded.is_ok());
    var restored: SessionData = loaded.unwrap();
    let sample: AudioClip = restored.library.audio.samples[0]; verify(sample.frames == 3000);
    restored.release();
    let spare: AudioClip = test_clip(10, 0.1f); verify(library.replace_sample(5, spare) == -1);
    library.release(); std::fs::remove_tree(directory); free(path); free(directory);
}

#[test]
fn tui_sample_pane_keys_on_a_clip_window() {
    // The Sample pane shows a placement's window of its sample (offset 1000,
    // 4000 frames) and starts with the cursor on the pattern row.
    var base: AudioClip = test_clip(8000, 0.5f);
    var window: AudioClip = AudioClip {}; window = base;
    window.offset = 1000; window.frames = 4000;
    var view: SampleView = SampleView { grainy: true };
    view.reset_selection(window.frames);
    let row: i32 = 2;
    let at: i64 = 2 * window.frames_per_row;
    verify(view.cursor(window, row) == at);
    // Num Lock and Caps Lock bits in the modifiers do not matter.
    verify(view.on_key(decode_input("\x1b[108;129u"), window, 82, row));
    verify(view.cursor(window, row) == at + 50);
    verify(view.on_key(decode_input("v"), window, 82, row) && view.selecting);
    verify(view.on_key(decode_input("L"), window, 82, row));
    verify(view.has_selection(window.frames) && view.sel_start == at + 50 && view.sel_end == at + 550);
    verify(view.on_key(decode_input("\x1b[101;66u"), window, 82, row) && view.cursor(window, row) == 4000);
    verify(view.sel_start == at + 50 && view.sel_end == 4000);
    verify(view.on_key(decode_input("+"), window, 82, row) && view.zoom == 1);
    verify(view.on_key(decode_input("="), window, 82, row) && view.zoom == 0);
    // Keys that are not the pane's are left to the rest of the app.
    verify(!view.on_key(decode_input("q"), window, 82, row));
    verify(sample_pane_key(decode_input("x")) && sample_pane_key(decode_input("t")) && sample_pane_key(decode_input("\x10")));
    verify(sample_pane_key(decode_input("\x13")) && sample_pane_key(decode_input("\x1b[108;5u")) && sample_pane_key(decode_input("\x0c")));
    verify(!sample_pane_key(decode_input("j")) && !sample_pane_key(decode_input("\x0e")));
    window.release();
}

#[test]
fn tui_sample_pane_cut_from_the_middle() {
    // x on a middle selection in the Sample pane: the placement plays a new
    // sample, "<name> - Edit 1.wav", holding its window without the cut.
    var library: PatternLibrary = PatternLibrary::new();
    let area: Rect = Rect::new(0, 0, 120, 20);
    library.table.create_track_kind(false, true, area);
    let clip: AudioClip = test_clip(8000, 0.25f);
    library.audio.samples.push(clip);
    library.audio.view.items.push(ListItem { id: 1, label: clone("1 edit-test.wav") });
    library.table.selected_row = 2;
    verify(library.table.insert_audio(clip, area));
    let track: SequenceTrack = library.table.tracks[library.table.tracks.len() - 1];
    let instance: AudioInstance = track.instances[0];
    let rc: AudioClip = instance.render_clip();
    let window: list<f32> = pcm_crop(instance.clip.samples, 1, rc.offset, rc.offset + rc.frames);
    var edited: AudioClip = instance.clip.with_samples(pcm_delete(window, 1, 2000, 3000));
    let name: str8 = numbered_name(instance.clip.source, library.audio.samples, "Edit");
    verify(name == "edit-test - Edit 1.wav");
    free(edited.source); edited.source = sibling_path(instance.clip.source, name); free(name);
    verify(library.audio.add_clip(edited.copy()) == 1);
    verify(library.table.replace_audio_clip(edited, area));
    let after: SequenceTrack = library.table.tracks[library.table.tracks.len() - 1];
    let cut: AudioInstance = after.instances[0];
    verify(cut.clip.frames == 7000 && cut.offset_frames == 0 && cut.clip.samples[2000] == clip.samples[3000]);
    let original: AudioClip = library.audio.samples[0]; verify(original.frames == 8000);
    // The session keeps the placement on the new sample.
    let directory: str8 = clone("/private/tmp/mlacker-cut-test-XXXXXX"); mkdtemp(directory);
    let path: str8 = format!("{}/cut.mlack", directory);
    var audio: AudioSystem = AudioSystem {}; var codec: SessionCodec = SessionCodec {};
    verify(codec.save(path, library, SessionView {}, audio));
    let loaded: result<SessionData, str8> = SessionCodec::load(path); verify(loaded.is_ok());
    var restored: SessionData = loaded.unwrap();
    verify(restored.library.audio.samples.len() == 2);
    let kept: AudioClip = restored.library.audio.samples[1]; verify(kept.frames == 7000);
    restored.release();
    library.release(); std::fs::remove_tree(directory); free(path); free(directory);
}

#[test]
fn tui_sample_editor_crop_to_watched_range() {
    let source: AudioClip = test_clip(4000, 0.5f);
    var editor: SampleEditor = SampleEditor {};
    // A trim to exactly the selected (watched) range: a Sampler slot's loop.
    editor.open(source, 0);
    editor.select(1000, 3000);
    verify(editor.selection_start() == 1000 && editor.selection_end() == 3000);
    verify(editor.trim() && editor.clip.frames == 2000 && editor.cropped_to_watch);
    // Undoing it, or trimming another range, is not.
    verify(editor.undo() && !editor.cropped_to_watch);
    editor.release(); editor.open(source, 0);
    editor.select(1000, 3000);
    editor.view.sel_start = 500; editor.view.sel_end = 3000;
    verify(editor.trim() && !editor.cropped_to_watch);
    // Nor is one after an earlier trim moved the audio.
    editor.release(); editor.open(source, 0);
    editor.select(1000, 3000);
    editor.view.sel_start = 0; editor.view.sel_end = 3900;
    verify(editor.trim());
    editor.view.sel_start = 1000; editor.view.sel_end = 3000; editor.view.sel_frames = editor.clip.frames;
    verify(editor.trim() && !editor.cropped_to_watch);
    // The selection is clamped to the sample.
    editor.release(); editor.open(source, 0);
    editor.select(-10, 999999);
    verify(editor.selection_start() == 0 && editor.selection_end() == 4000);
    editor.release(); source.release();
}

#[test]
fn tui_audio_library_add_clip_reuses_identical_samples() {
    var audio: AudioLibrary = AudioLibrary {};
    verify(audio.add_clip(test_clip(100, 0.5f)) == 0);
    verify(audio.add_clip(test_clip(100, 0.5f)) == 0);
    verify(audio.add_clip(test_clip(100, 0.25f)) == 1);
    verify(audio.samples.len() == 2 && audio.view.items.len() == 2);
    audio.release();
}

#[test]
fn tui_piano_dialog_picks_pad_keys() {
    verify(piano_note_name(60) == "C-4" && piano_note_name(37) == "C#2");
    verify(piano_is_black(37) && !piano_is_black(36) && !piano_is_black(40) && piano_is_black(46));
    var piano: PianoDialog = PianoDialog::new();
    // Pads 1 and 2 loaded: the cursor starts on the first empty pad.
    piano.open("Pick", 36, 16, 3, [clone("kick.wav"), clone("snare.wav")], "inserts");
    verify(piano.active && piano.key == 38 && piano.pad() == 2);
    verify(piano.is_loaded(0) && piano.is_loaded(1) && !piano.is_loaded(2));
    piano.on_event(InputEvent { kind: InputKind::Menu, key: Key::Left, code: 104 });
    piano.on_event(InputEvent { kind: InputKind::Menu, key: Key::Left, code: 104 });
    piano.on_event(InputEvent { kind: InputKind::Menu, key: Key::Left, code: 104 });
    verify(piano.key == 36); // clamped to the pad range
    piano.on_event(InputEvent { kind: InputKind::Menu, key: Key::Up, code: 107 });
    verify(piano.key == 48);
    piano.on_event(InputEvent { kind: InputKind::Menu, key: Key::Up, code: 107 });
    verify(piano.key == 51);
    // Delete only clears a loaded pad.
    piano.on_event(InputEvent { kind: InputKind::Edit, key: Key::Delete });
    verify(piano.active);
    piano.on_event(InputEvent { kind: InputKind::Menu, key: Key::Down, code: 106 });
    piano.on_event(InputEvent { kind: InputKind::Menu, key: Key::Down, code: 106 });
    verify(piano.key == 36);
    piano.on_event(InputEvent { kind: InputKind::Edit, key: Key::Delete });
    verify(!piano.active && piano.result == 3 && piano.pad() == 0);
    piano.open("Pick", 36, 16, 0, [], "inserts");
    piano.on_event(InputEvent { kind: InputKind::Menu, key: Key::Right, code: 108 });
    piano.on_event(InputEvent { kind: InputKind::Menu, key: Key::Enter, code: 13 });
    verify(!piano.active && piano.result == 1 && piano.pad() == 1);
    // The keyboard paints: selected key darker gray, dots on loaded pads.
    piano.open("Pick", 36, 16, 1, [clone("kick.wav")], "inserts");
    let surface: Surface = Surface::new(100, 30);
    piano.paint(surface, surface.bounds(), Theme::dark_blue());
    var selected: i32 = 0; var dots: i32 = 0; var black: i32 = 0;
    for y in 0..30 { for x in 0..100 {
        let cell: Cell = surface.cell(i32(x), i32(y));
        if cell.background == 0x5f5f5f { selected = selected + 1; }
        if cell.glyph == 0x25cf { dots = dots + 1; }
        if cell.background == 0x0c0c0c { black = black + 1; }
    } }
    // Cursor on the first empty pad, C#2: a 2x2 black key.
    verify(selected == 4 && dots == 1 && black > 0);
    piano.on_event(InputEvent { kind: InputKind::Menu, key: Key::Left, code: 104 });
    piano.paint(surface, surface.bounds(), Theme::dark_blue());
    selected = 0;
    for y in 0..30 { for x in 0..100 { let cell: Cell = surface.cell(i32(x), i32(y)); if cell.background == 0x5f5f5f { selected = selected + 1; } } }
    verify(selected == 10); // C-2: a 3x4 white key minus the C# key over its top-right corner
    surface.release(); piano.release();
}

#[test]
fn tui_keymap_matches_every_terminal_spelling_and_labels_menus() {
    var keymap: Keymap = Keymap::new(default_keymap());
    // <C-s>: legacy control byte and kitty/CSI-u; global over dialogs.
    let save: KeyMatch = keymap.feed(decode_input("\x13")); verify(save.action == Action::SaveSession && save.global);
    let kitty: KeyMatch = keymap.feed(decode_input("\x1b[115;5u")); verify(kitty.action == Action::SaveSession);
    let fullscreen: KeyMatch = keymap.feed(decode_input("\x06")); verify(fullscreen.action == Action::TogglePaneFullscreen);
    let view: KeyMatch = keymap.feed(decode_input("\x07")); verify(view.action == Action::ToggleViewPane);
    // <S-m>: legacy uppercase and CSI-u shifted letter; not global.
    let matrix: KeyMatch = keymap.feed(decode_input("M")); verify(matrix.action == Action::ViewSongMatrix && !matrix.global);
    let shifted: KeyMatch = keymap.feed(decode_input("\x1b[109;2u")); verify(shifted.action == Action::ViewSongMatrix);
    // <C-S-m>, <S-p> and the Ctrl+Shift+F1-F3 sidebar views.
    let spectrum: KeyMatch = keymap.feed(decode_input("\x1b[109;6u")); verify(spectrum.action == Action::ToggleSpectrum);
    let piano: KeyMatch = keymap.feed(decode_input("P")); verify(piano.action == Action::ToggleVirtualKeyboard);
    let patterns: KeyMatch = keymap.feed(decode_input("\x1b[1;6P")); verify(patterns.action == Action::ViewPatterns);
    let audio: KeyMatch = keymap.feed(decode_input("\x1b[1;6Q")); verify(audio.action == Action::ViewAudio);
    let instruments: KeyMatch = keymap.feed(decode_input("\x1b[13;6~")); verify(instruments.action == Action::ViewInstruments);
    // Ctrl+F1 alone is left to macOS.
    let ctrl_f1: KeyMatch = keymap.feed(decode_input("\x1b[1;5P")); verify(ctrl_f1.action == Action::None);
    // Plain F1 opens the File menu, not a keymap action; plain letters are free.
    let f1: KeyMatch = keymap.feed(decode_input("\x1bOP")); verify(f1.action == Action::None && !f1.waiting);
    let m: KeyMatch = keymap.feed(decode_input("m")); verify(m.action == Action::None);
    let save_label: str8 = keymap.shortcut_for(Action::SaveSession); verify(save_label == "<C-s>");
    let fullscreen_label: str8 = keymap.shortcut_for(Action::TogglePaneFullscreen); verify(fullscreen_label == "<C-f>");
    let view_label: str8 = keymap.shortcut_for(Action::ToggleViewPane); verify(view_label == "<C-g>");
    let matrix_label: str8 = keymap.shortcut_for(Action::ViewSongMatrix); verify(matrix_label == "<S-m>");
    let spectrum_label: str8 = keymap.shortcut_for(Action::ToggleSpectrum); verify(spectrum_label == "<C-S-m>");
    let piano_label: str8 = keymap.shortcut_for(Action::ToggleVirtualKeyboard); verify(piano_label == "<S-p>");
    let patterns_label: str8 = keymap.shortcut_for(Action::ViewPatterns); verify(patterns_label == "<C-S-F1>");
    let instruments_label: str8 = keymap.shortcut_for(Action::ViewInstruments); verify(instruments_label == "<C-S-F3>");
    let none_label: str8 = keymap.shortcut_for(Action::Quit); verify(none_label == "");
    // A multi-press shortcut: the first press waits, the second completes it.
    var custom: Keymap = Keymap::new([bind(Action::Quit, [key(97, true, false), key(109, true, false)], false),
        bind(Action::Undo, [key(109, true, false)], false)]);
    let sequence_label: str8 = custom.shortcut_for(Action::Quit); verify(sequence_label == "<C-a><C-m>");
    let first: KeyMatch = custom.feed(decode_input("\x1b[97;5u")); verify(first.waiting && first.action == Action::None);
    let second: KeyMatch = custom.feed(decode_input("\x1b[109;5u")); verify(second.action == Action::Quit && !second.waiting);
    // A press that breaks the sequence is matched on its own.
    custom.feed(decode_input("\x1b[97;5u"));
    let broken: KeyMatch = custom.feed(decode_input("x")); verify(broken.action == Action::None && !broken.waiting);
    let alone: KeyMatch = custom.feed(decode_input("\x1b[109;5u")); verify(alone.action == Action::Undo);
    let plain: KeyBinding = bind(Action::EditSample, [key(101, false, false)], false); verify(plain.label == "<e>");
}

#[test]
fn tui_main_panes_fullscreen_preserves_view_and_piano() {
    let area: Rect = Rect::new(0, 1, 100, 40);
    let normal: list<Pane> = main_panes(area, true, -1, false);
    verify(normal[0].bounds.width == 22 && normal[1].visible() && normal[2].visible());
    let editor: list<Pane> = main_panes(area, true, 1, false);
    verify(editor[0].bounds.x == normal[0].bounds.x && editor[0].bounds.y == normal[0].bounds.y &&
        editor[0].bounds.width == normal[0].bounds.width && editor[0].bounds.height == normal[0].bounds.height &&
        editor[1].bounds.height > normal[1].bounds.height && !editor[2].visible());
    let without_view: list<Pane> = main_panes(area, false, 1, false);
    verify(!without_view[0].visible() && without_view[1].bounds.width == area.width);
    let piano: list<Pane> = main_panes(area, true, 1, true);
    verify(piano[0].bounds.width == normal[0].bounds.width && piano[0].bounds.height == normal[0].bounds.height &&
        piano[2].bounds.x == normal[2].bounds.x && piano[2].bounds.y == normal[2].bounds.y &&
        piano[2].bounds.width == normal[2].bounds.width && piano[2].bounds.height == normal[2].bounds.height && piano[2].visible());
    let details: list<Pane> = main_panes(area, true, 2, false);
    verify(!details[1].visible() && details[2].bounds.height > normal[2].bounds.height);
}

fn test_ids(first: i32, second: i32) -> list<i32> { var ids: list<i32> = []; ids.push(first); ids.push(second); return ids; }

#[test]
fn tui_dialog_buttons_replay_their_keys() {
    let tab: InputEvent = InputEvent { kind: InputKind::Menu, key: Key::Toggle };
    let right: InputEvent = InputEvent { kind: InputKind::Menu, key: Key::Right };
    let enter: InputEvent = InputEvent { kind: InputKind::Menu, key: Key::Enter };
    // Pattern picker: Tab reaches OK / Empty / Cancel; a press completes on a
    // later tick and is replayed as its key.
    var picker: PatternPicker = PatternPicker::new();
    picker.open(test_ids(1, 2), [clone("001 A"), clone("002 B")], 2);
    verify(picker.buttons.len() == 3 && picker.focus.selected == 0);
    picker.on_event(tab); picker.on_event(right); picker.on_event(enter);
    verify(picker.active && picker.pressed_button == 1);
    var action: i32 = 0;
    for _i in 0..10 { if action == 0 { action = picker.tick(); } }
    verify(action == 3 && picker.focus.selected == 0);
    picker.on_event(button_key(action)); verify(!picker.active && picker.result == 3);
    picker.open(test_ids(1, 2), [clone("001 A"), clone("002 B")], 2);
    picker.on_event(tab); picker.on_event(enter);
    action = 0; for _i in 0..10 { if action == 0 { action = picker.tick(); } }
    picker.on_event(button_key(action)); verify(!picker.active && picker.result == 1 && picker.chosen() == 2);
    picker.release();
    // Output picker: Cancel.
    var outputs: OutputPicker = OutputPicker::new();
    outputs.open(test_ids(0, 1), [clone("Master"), clone("Track 1")], 1);
    outputs.on_event(tab); outputs.on_event(right); outputs.on_event(enter);
    action = 0; for _i in 0..10 { if action == 0 { action = outputs.tick(); } }
    outputs.on_event(button_key(action)); verify(action == 2 && !outputs.active && outputs.result == 2);
    outputs.release();
    // Piano: the OK button carries the action; Clear pad needs a loaded pad.
    var piano: PianoDialog = PianoDialog::new();
    piano.open("Pick", 36, 16, 1, [clone("kick.wav")], "Insert sample");
    let ok: PushButton = piano.buttons[0]; let clear: PushButton = piano.buttons[1];
    verify(piano.key == 37 && ok.label == "Insert sample" && !clear.enabled);
    piano.on_event(InputEvent { kind: InputKind::Menu, key: Key::Left, code: 104 });
    let loaded: PushButton = piano.buttons[1]; verify(piano.key == 36 && loaded.enabled);
    piano.on_event(tab); piano.on_event(right); piano.on_event(enter);
    action = 0; for _i in 0..10 { if action == 0 { action = piano.tick(); } }
    piano.on_event(button_key(action)); verify(action == 3 && !piano.active && piano.result == 3 && piano.pad() == 0);
    piano.release();
    // Text prompt: text keys stay with the owner; buttons after Tab.
    var prompt: TextPrompt = TextPrompt::new();
    prompt.follow(1); verify(prompt.active && prompt.focus.selected == 0);
    verify(!prompt.on_event(InputEvent { kind: InputKind::Text, key: Key::Enter, code: 97 }));
    verify(prompt.on_event(tab) && prompt.focus.selected == 3);
    verify(!prompt.on_event(InputEvent { kind: InputKind::Menu, key: Key::Escape }));
    prompt.on_event(right); prompt.on_event(enter);
    action = 0; for _i in 0..10 { if action == 0 { action = prompt.tick(); } }
    verify(action == 2 && prompt.focus.selected == 0);
    prompt.follow(0); verify(!prompt.active);
}

#[test]
fn tui_piano_dialog_black_keys_sit_between_their_notes() {
    var piano: PianoDialog = PianoDialog::new();
    // Pads 1-15 loaded, so the cursor sits on pad 16 (D#3) outside the first octave.
    piano.open("Pick", 36, 16, 32767, [], "inserts");
    verify(piano.key == 51);
    let surface: Surface = Surface::new(100, 30);
    piano.paint(surface, surface.bounds(), Theme::dark_blue());
    // Top row of the keyboard: the first row holding an in-range white key.
    var top: i32 = -1; var left: i32 = -1;
    for y in 0..30 {
        for x in 0..100 {
            let cell: Cell = surface.cell(i32(x), i32(y));
            if cell.background == 0xf2f2f2 && top < 0 { top = i32(y); left = i32(x); }
        }
    }
    verify(top >= 0);
    // One octave from C-2, three columns per white key: C# over C|D, D# over
    // D|E, no key over E|F, then F#, G#, A# over their boundaries.
    var row: str8 = clone("");
    for col in 0..21 {
        let cell: Cell = surface.cell(left + i32(col), top);
        let next: str8 = format!("{}{}", row, cell.background == 0x0c0c0c ? "B" : "W");
        free(row); row = next;
    }
    verify(row == "WWBBWBBWWWWBBWBBWBBWW");
    // The lower half is all white keys; separators start each key.
    let separator: Cell = surface.cell(left + 3, top + 3);
    verify(separator.glyph == 0x2502 && separator.background == 0xf2f2f2);
    let label: Cell = surface.cell(left, top + 4);
    verify(label.glyph == 67); // "C-2" under the C key
    free(row); surface.release(); piano.release();
}

#[test]
fn tui_virtual_keyboard_plays_and_releases_notes() {
    var keyboard: VirtualKeyboard = VirtualKeyboard { visible: true };
    verify(VirtualKeyboard::key_offset(122) == 0 && VirtualKeyboard::key_offset(113) == 12 && VirtualKeyboard::key_offset(112) == 28);
    verify(VirtualKeyboard::key_offset(97) == -1 && keyboard.base() == 48);
    let z: InputEvent = InputEvent { kind: InputKind::Text, key: Key::Escape, code: 122 };
    verify(VirtualKeyboard::handles(z) && keyboard.on_event(z, 3, 1000) == 48);
    // Auto-repeat keeps the note sounding without restarting it.
    verify(keyboard.on_event(z, 3, 1300) == -1 && keyboard.is_held(48));
    let early: list<HeldNote> = keyboard.release_due(1600, false);
    verify(early.len() == 0);
    let due: list<HeldNote> = keyboard.release_due(1700, false);
    verify(due.len() == 1 && !keyboard.is_held(48));
    let first: HeldNote = due[0];
    verify(first.note == 48 && first.target == 3);
    let events: list<MidiInputEvent> = keyboard.take_events();
    verify(events.len() == 2);
    let on: MidiInputEvent = events[0]; let off: MidiInputEvent = events[1];
    verify(on.kind == 1 && on.note == 48 && on.velocity == 100 && off.kind == 2 && off.received_ms == 1700);
    // Octave keys: "=" up, Right arrow up, "-" down; "q" plays C an octave above.
    keyboard.on_event(InputEvent { kind: InputKind::Text, key: Key::Escape, code: 61 }, 3, 2000);
    keyboard.on_event(InputEvent { kind: InputKind::Menu, key: Key::Right }, 3, 2000);
    keyboard.on_event(InputEvent { kind: InputKind::Text, key: Key::Escape, code: 45 }, 3, 2000);
    verify(keyboard.octave == 4);
    verify(keyboard.on_event(InputEvent { kind: InputKind::Quit, key: Key::Escape, code: 113 }, 3, 2000) == 72);
    // "h" is a note, not the Left arrow; no target plays nothing.
    verify(keyboard.on_event(InputEvent { kind: InputKind::Menu, key: Key::Left, code: 104 }, -1, 2000) == -1 && keyboard.octave == 4);
    let all: list<HeldNote> = keyboard.release_due(2000, true);
    verify(all.len() == 1);
    // Pane moves, Tab, Space and the view toggles reach the application.
    verify(!VirtualKeyboard::handles(InputEvent { kind: InputKind::Pane, key: Key::Up, code: 107, modifiers: 6 }));
    verify(!VirtualKeyboard::handles(InputEvent { kind: InputKind::Text, key: Key::Escape, code: 32 }));
    verify(!VirtualKeyboard::handles(InputEvent { kind: InputKind::Text, key: Key::Escape, code: 80 }));
    verify(!VirtualKeyboard::handles(InputEvent { kind: InputKind::Menu, key: Key::Toggle, code: 9 }));
    // Painted keys: the held note is darkened.
    keyboard.on_event(z, 3, 3000);
    let surface: Surface = Surface::new(90, 9);
    keyboard.paint(surface, surface.bounds(), Theme::dark_blue(), "status");
    var darkened: i32 = 0;
    for y in 0..9 { for x in 0..90 { let cell: Cell = surface.cell(i32(x), i32(y)); if cell.background == PianoKeyboard::darkened() { darkened = darkened + 1; } } }
    verify(darkened > 0);
    surface.release();
}

#[test]
fn tui_virtual_keyboard_holds_chords_until_key_release() {
    var keyboard: VirtualKeyboard = VirtualKeyboard { visible: true };
    let z: InputEvent = InputEvent { kind: InputKind::Text, key: Key::Escape, code: 122 };
    let c: InputEvent = InputEvent { kind: InputKind::Text, key: Key::Escape, code: 99 };
    let b: InputEvent = InputEvent { kind: InputKind::Text, key: Key::Escape, code: 98 };
    // The first release shows the terminal reports them: no more timeouts.
    verify(keyboard.on_event(z, 3, 1000) == 48);
    let first: list<HeldNote> = keyboard.on_release(InputEvent { kind: InputKind::Text, key: Key::Escape, code: 122, released: true }, 1100);
    verify(first.len() == 1 && keyboard.releases_seen);
    // A C major chord, held with no repeats far past the old hold time.
    verify(keyboard.on_event(z, 3, 2000) == 48 && keyboard.on_event(c, 3, 2010) == 52 && keyboard.on_event(b, 3, 2020) == 55);
    let none: list<HeldNote> = keyboard.release_due(9000, false);
    verify(none.len() == 0 && keyboard.is_held(48) && keyboard.is_held(52) && keyboard.is_held(55));
    // Releasing one key ends only its note, even after an octave change.
    keyboard.shift_octave(1);
    let ended: list<HeldNote> = keyboard.on_release(InputEvent { kind: InputKind::Text, key: Key::Escape, code: 99, released: true }, 9100);
    verify(ended.len() == 1 && !keyboard.is_held(52) && keyboard.is_held(48) && keyboard.is_held(55));
    let gone: HeldNote = ended[0];
    verify(gone.note == 52 && gone.target == 3);
    let rest: list<HeldNote> = keyboard.release_due(9200, true);
    verify(rest.len() == 2);
}

#[test]
fn tui_remove_sample_drops_its_clips() {
    var library: PatternLibrary = PatternLibrary::new();
    let area: Rect = Rect::new(0, 0, 120, 20);
    library.table.create_track_kind(false, true, area);
    let kick: AudioClip = test_clip(4000, 0.25f);
    let snare: AudioClip = test_clip(2000, 0.5f);
    library.audio.samples.push(kick);
    library.audio.view.items.push(ListItem { id: 1, label: clone("1 edit-test.wav") });
    verify(library.audio.add_clip(snare.copy()) == 1);
    library.table.selected_row = 0;
    verify(library.table.insert_audio(kick, area));
    library.table.selected_row = 12;
    verify(library.table.insert_audio(kick, area));
    verify(library.sample_usage(0) == 2 && library.sample_usage(1) == 0);
    // Removing the sample takes its placements with it and renumbers the list.
    verify(library.remove_sample(0, area) == 2);
    verify(library.audio.samples.len() == 1 && library.audio.view.items.len() == 1);
    let remaining: AudioClip = library.audio.samples[0];
    verify(remaining.frames == 2000);
    let track: SequenceTrack = library.table.tracks[library.table.tracks.len() - 1];
    verify(track.instances.len() == 0);
    verify(library.remove_sample(5, area) == -1);
    snare.release(); library.release();
}

#[test]
fn tui_remove_instrument_tracks_or_keep_them() {
    var library: PatternLibrary = PatternLibrary::new();
    let area: Rect = Rect::new(0, 0, 120, 20);
    library.table.create_instrument_track(1, area);
    library.table.create_instrument_track(1, area);
    library.table.create_instrument_track(2, area);
    verify(library.instrument_usage(1) == 2 && library.instrument_usage(2) == 1);
    let before: i64 = library.table.tracks.len();
    // Keeping the tracks only clears their assignment.
    library.table.detach_instrument(2);
    verify(library.instrument_usage(2) == 0 && library.table.tracks.len() == before);
    // Removing takes the tracks that played it.
    verify(library.remove_tracks_using_instrument(1, area) == 2);
    verify(library.instrument_usage(1) == 0 && library.table.tracks.len() == before - 2);
    library.release();
}

fn song_test_library() -> PatternLibrary {
    // Two patterns that both play instrument 1 with the same notes, and two
    // song rows to place them in.
    var library: PatternLibrary = PatternLibrary::empty();
    let area: Rect = Rect::new(0, 0, 120, 20);
    library.table.create_instrument_track(1, area);
    library.table.set_cell(0, 1, clone("C-2")); library.table.set_cell(0, 2, clone("100"));
    library.table.set_cell(4, 1, clone("D-2")); library.table.set_cell(4, 2, clone("100"));
    library.add(true);                       // clone -> pattern 2, song row 1
    library.matrix_insert_row(0, true);       // a second song row
    library.set_song_at(0, 0, 1); library.set_song_at(1, 0, 2);
    return library;
}

#[test]
fn tui_song_matrix_lanes_and_rows() {
    var library: PatternLibrary = song_test_library();
    let area: Rect = Rect::new(0, 0, 120, 20);
    verify(library.song.len() == 2 && library.song_lanes() == 1);
    verify(library.song_at(0, 0) == 1 && library.song_at(1, 0) == 2);
    // Lane 2 of row 0 runs parallel to lane 1.
    verify(library.set_song_at(0, 1, 2));
    verify(library.song_lanes() == 2 && library.song_at(0, 1) == 2 && library.song_at(1, 1) == 0);
    // Any cell can be emptied, lane 1 included; unused lanes disappear.
    verify(library.set_song_at(0, 0, 0) && library.song_at(0, 0) == 0);
    verify(library.set_song_at(0, 0, 1));
    verify(library.set_song_at(0, 1, 0) && library.song_lanes() == 1);
    // Inserting a song row keeps the lanes aligned with it.
    verify(library.set_song_at(1, 1, 2));
    verify(library.matrix_insert_row(0, true));
    verify(library.song.len() == 3 && library.song_at(2, 1) == 2 && library.song_at(1, 1) == 0);
    // Out-of-range cells are refused, and lane 16 does not exist.
    verify(!library.set_song_at(9, 1, 2) && !library.set_song_at(0, 16, 2));
    library.release();
}

#[test]
fn tui_song_matrix_detects_note_clashes() {
    var library: PatternLibrary = song_test_library();
    // The clone shares instrument 1 and both notes.
    verify(library.clashing_notes(1, 2) == 2);
    verify(library.song_row_clashes(0, 1, 2) == 2);
    // A pattern never clashes with itself, and an empty row is quiet.
    verify(library.clashing_notes(1, 1) == 0);
    verify(library.song_row_clashes(1, 1, 1) == 0 || library.song_at(1, 0) == 2);
    library.release();
}

#[test]
fn tui_song_matrix_split_moves_notes_to_their_own_line() {
    var library: PatternLibrary = song_test_library();
    let area: Rect = Rect::new(0, 0, 120, 20);
    verify(library.set_song_at(0, 1, 2));
    // Splitting the newcomer gives its clashing track its own note line.
    verify(library.split_song_clashes(0, 1, 2, area) == 1);
    let entry: PatternEntry = library.patterns[library.index_of(2)];
    let index: i32 = i32(entry.data.tracks.len()) - 1;
    let track: SequenceTrack = entry.data.tracks[index];
    verify(track.note_lines == 2);
    verify(ends_with(track.name, " - 2") == 1);
    // The notes moved off the first line, so the two patterns no longer drive
    // the instrument through the same one.
    let row: TableRow = entry.data.rows[0];
    let start: i32 = entry.data.track_start(index);
    verify(row.cells[start] == "" && row.cells[start + 4] == "C-2" && row.cells[start + 5] == "100");
    // Splitting again renames to " - 3" rather than stacking suffixes.
    verify(library.set_song_at(0, 2, 2));
    library.split_song_clashes(0, 2, 2, area);
    let again: PatternEntry = library.patterns[library.index_of(2)];
    let renamed: SequenceTrack = again.data.tracks[index];
    verify(ends_with(renamed.name, " - 3") == 1 && !ends_with(renamed.name, "2 - 3"));
    library.release();
}

#[test]
fn tui_song_matrix_survives_a_session_round_trip() {
    // Plain patterns: an instrument assignment would need a loaded plugin.
    var library: PatternLibrary = PatternLibrary::empty();
    let area: Rect = Rect::new(0, 0, 120, 20);
    library.table.create_track_kind(false, false, area);
    library.add(true);
    library.matrix_insert_row(0, true);
    verify(library.song.len() == 2);
    verify(library.set_song_at(0, 1, 1) && library.set_song_at(1, 2, 2));
    verify(library.song_lanes() == 3);
    let directory: str8 = clone("/private/tmp/mlacker-matrix-test-XXXXXX"); mkdtemp(directory);
    let path: str8 = format!("{}/matrix.mlack", directory);
    var audio: AudioSystem = AudioSystem {}; var codec: SessionCodec = SessionCodec {};
    verify(codec.save(path, library, SessionView {}, audio));
    let loaded: result<SessionData, str8> = SessionCodec::load(path); verify(loaded.is_ok());
    var restored: SessionData = loaded.unwrap();
    verify(restored.library.song_lanes() == 3);
    verify(restored.library.song_at(0, 1) == 1 && restored.library.song_at(1, 2) == 2);
    verify(restored.library.song_at(1, 1) == 0 && restored.library.song_at(0, 2) == 0);
    restored.release();
    library.release(); std::fs::remove_tree(directory); free(path); free(directory);
}

#[test]
fn tui_song_matrix_keys() {
    var matrix: SongMatrix = SongMatrix { visible: true };
    // Navigation is clamped to the grid; lane 3 is the spare empty one.
    verify(matrix.on_event(decode_input("j"), 2, 3) == 0 && matrix.row == 1);
    verify(matrix.on_event(decode_input("j"), 2, 3) == 0 && matrix.row == 1);
    verify(matrix.on_event(decode_input("l"), 2, 3) == 0 && matrix.lane == 1);
    verify(matrix.on_event(decode_input("k"), 2, 3) == 0 && matrix.row == 0);
    verify(matrix.on_event(decode_input("h"), 2, 3) == 0 && matrix.lane == 0);
    // Enter picks a pattern, Backspace clears the cell.
    verify(matrix.on_event(decode_input("\r"), 2, 3) == 1);
    verify(matrix.on_event(decode_input("\x7f"), 2, 3) == 2);
    // o/O insert whole rows; Ctrl+O/Ctrl+Shift+O shift this lane only.
    verify(matrix.on_event(decode_input("o"), 2, 3) == 3);
    verify(matrix.on_event(decode_input("O"), 2, 3) == 4);
    verify(matrix.on_event(decode_input("\x1b[111;5u"), 2, 3) == 5);
    verify(matrix.on_event(decode_input("\x1b[79;5u"), 2, 3) == 6);
    // y copies, p pastes.
    verify(matrix.on_event(decode_input("y"), 2, 3) == 8);
    verify(matrix.on_event(decode_input("p"), 2, 3) == 9);
    // dd removes a row: the first d only arms the chord.
    verify(matrix.on_event(decode_input("d"), 2, 3) == 0 && matrix.delete_pending);
    verify(matrix.on_event(decode_input("d"), 2, 3) == 7 && !matrix.delete_pending);
    // Any other key cancels a pending d.
    verify(matrix.on_event(decode_input("d"), 2, 3) == 0);
    verify(matrix.on_event(decode_input("j"), 2, 3) == 0 && !matrix.delete_pending);
    verify(matrix.on_event(decode_input("d"), 2, 3) == 0 && matrix.delete_pending);
}

#[test]
fn tui_song_matrix_arms_a_pattern_for_recording() {
    var matrix: SongMatrix = SongMatrix { visible: true };
    // Shift+R arms (in either key encoding); plain r still loops.
    verify(matrix.on_event(decode_input("R"), 2, 3) == 12);
    verify(matrix.on_event(decode_input("\x1b[114;2u"), 2, 3) == 12);
    verify(matrix.on_event(decode_input("r"), 2, 3) == 10);
    var library: PatternLibrary = PatternLibrary::new();
    let surface: Surface = Surface::new(80, 12); let theme: Theme = Theme::dark_blue();
    matrix.armed_row = 0; matrix.armed_lane = 0;
    for pass in 0..2 {
        matrix.recording = pass == 1;
        matrix.paint(surface, surface.bounds(), theme, library, true, -1);
        // The armed lane's header carries a red R, brighter while recording.
        let red: i32 = pass == 1 ? 0xd03030 : 0x902828; var marked: bool = false;
        for y in 0..12 { for x in 0..80 { let cell: Cell = surface.cell(i32(x), i32(y)); if cell.glyph == 82 && cell.background == red { marked = true; } } }
        verify(marked);
    }
    surface.release(); library.release();
}

#[test]
fn tui_matrix_take_leaves_its_pattern_out_of_the_row() {
    let area: Rect = Rect::new(0, 0, 120, 20);
    // Song rows: pattern 1, 2, 2, 3; lane 2 of row 1 also plays pattern 2.
    var library: PatternLibrary = PatternLibrary::new();
    verify(library.set_song_at(0, 1, 2));
    var both: SequenceTable = library.merge_song_row(0, area, false); verify(both.tracks.len() == 6); both.release();
    library.recording_pattern = 2;
    var others: SequenceTable = library.merge_song_row(0, area, false); verify(others.tracks.len() == 3); others.release();
    library.recording_pattern = 1;
    var lane_two: SequenceTable = library.merge_song_row(0, area, false); verify(lane_two.tracks.len() == 3); lane_two.release();
    // A row the take plays alone keeps its length, with nothing to play.
    library.recording_pattern = 3;
    var alone: SequenceTable = library.merge_song_row(3, area, false);
    verify(alone.tracks.len() == 0 && alone.rows.len() == 64); alone.release();
    library.recording_pattern = 0;
    var back: SequenceTable = library.merge_song_row(3, area, false); verify(back.tracks.len() == 3); back.release();
    library.release();
}

#[test]
fn tui_matrix_take_track_and_length() {
    let area: Rect = Rect::new(0, 0, 120, 20);
    var table: SequenceTable = SequenceTable::new();
    // An armed MIDI track wins, then the cursor track, then the first MIDI one.
    verify(table.recording_candidate() == 0);
    table.selected_column = table.track_start(2); verify(table.recording_candidate() == 2);
    verify(table.set_record_armed(1, true) && table.recording_candidate() == 1);
    verify(table.set_record_armed(1, false) && table.recording_candidate() == 2);
    // An armed AUDIO track records audio, never a MIDI take.
    table.create_track_kind(false, true, area); verify(table.set_record_armed(3, true) && table.recording_candidate() == 0);
    verify(table.armed_audio_track() == 3);
    // The take ends at the nearest bar line and never cuts off a note.
    for r in 0..64 { table.selected_row = i32(r); table.clear_row(); }
    verify(table.take_length(0, 16) == 16 && table.take_length(15000 * 23, 16) == 16);
    verify(table.take_length(15000 * 25, 16) == 32 && table.take_length(15000 * 90, 16) == 96);
    table.selected_row = 20; table.selected_column = 1;
    table.edit_event(decode_input("\r"), area); table.editor.set_text("C-4"); table.edit_event(decode_input("\r"), area);
    verify(table.take_length(15000 * 17, 16) == 32 && table.take_length(15000 * 17, 12) == 24);
    table.release();
}

#[test]
fn tui_automation_curve_between_marked_values() {
    let area: Rect = Rect::new(0, 0, 120, 12);
    var table: SequenceTable = SequenceTable::new();
    for r in 0..64 { table.selected_row = i32(r); table.clear_row(); }
    table.zoom_tracks(2, true, area);
    let column: i32 = table.automation_column(0, 1);
    table.set_cell(0, column, clone("0")); table.set_cell(2, column, clone("80"));
    table.selected_column = column;
    // Ctrl+V marks values only, and both ends are needed.
    table.selected_row = 1; verify(table.toggle_curve_point() == -1 && table.error == "Mark a CC value, not an empty step");
    table.selected_row = 0; verify(table.toggle_curve_point() == 1);
    verify(!table.curve_ready() && table.error == "Mark two CC values with Ctrl+V first");
    table.selected_row = 2; verify(table.toggle_curve_point() == 2 && table.curve_ready());
    verify(table.toggle_curve_point() == 1 && table.toggle_curve_point() == 2);
    // The marks show amber in the pattern.
    let surface: Surface = Surface::new(120, 12); let theme: Theme = Theme::dark_blue();
    table.scroll_y = 0; table.paint(surface, area, theme); table.paint_automation(surface, area, theme);
    var amber: i32 = 0;
    for y in 0..12 { for x in 0..120 { let cell: Cell = surface.cell(i32(x), i32(y)); if cell.background == 0xe0a030 { amber = amber + 1; } } }
    verify(amber == 12); surface.release();
    // Linear 0 -> 80 over eight 1/64 steps fills every step between.
    verify(table.apply_curve(0) == 7 && table.curve_points.len() == 0);
    let first: TableRow = table.rows[0]; let second: TableRow = table.rows[1]; let third: TableRow = table.rows[2];
    verify(first.cells[column] == "0 10 20 30" && second.cells[column] == "40 50 60 70" && third.cells[column] == "80");
    // Only changes are written: 0 -> 2 over eight steps sets two of them.
    table.set_cell(4, column, clone("0")); table.set_cell(6, column, clone("2"));
    table.selected_row = 4; table.toggle_curve_point(); table.selected_row = 6; table.toggle_curve_point();
    verify(table.apply_curve(0) == 2);
    let slow: TableRow = table.rows[4]; let slower: TableRow = table.rows[5];
    verify(slow.cells[column] == "0 . 1 ." && slower.cells[column] == ". . 2 .");
    // Each shape's first step on a 0 -> 100 ramp over four steps.
    let expected: list<i32> = [25, 51, 9, 15, 41];
    for shape in 0..5 {
        table.set_cell(8, column, clone("0")); table.set_cell(9, column, clone("100"));
        table.selected_row = 8; table.toggle_curve_point(); table.selected_row = 9; table.toggle_curve_point();
        verify(table.apply_curve(i32(shape)) > 0);
        let ramp: TableRow = table.rows[8]; let steps: list<str8> = automation_steps(ramp.cells[column]);
        let value: result<i64, str8> = table_integer(steps[1]);
        verify(value.is_ok() && value.unwrap() == wide(expected[shape]));
        for step in steps { free(step); }
    }
    // Zoomed to 1/64, a mark takes the step under the cursor; a ramp can fall.
    table.set_cell(12, column, clone("50 . . 10"));
    table.cycle_vertical_zoom(area); table.cycle_vertical_zoom(area);
    table.selected_row = 12; table.selected_subrow = 3; verify(table.toggle_curve_point() == 1);
    table.selected_subrow = 1; verify(table.toggle_curve_point() == -1);
    table.selected_subrow = 0; verify(table.toggle_curve_point() == 2);
    verify(table.apply_curve(0) == 2);
    let falling: TableRow = table.rows[12]; verify(falling.cells[column] == "50 37 23 10");
    // A changed end is refused rather than guessed.
    table.selected_subrow = 0; table.toggle_curve_point(); table.selected_subrow = 3; table.toggle_curve_point();
    table.set_cell(12, column, clone("50"));
    verify(table.apply_curve(0) == -1 && table.error == "A marked CC value was changed; mark again");
    table.release();
}

#[test]
fn tui_automation_curve_dialog() {
    var dialog: CurveDialog = CurveDialog::new();
    dialog.open(); verify(dialog.active && dialog.selected == 0);
    dialog.on_event(InputEvent { kind: InputKind::Menu, key: Key::Down });
    dialog.on_event(InputEvent { kind: InputKind::Menu, key: Key::Down }); verify(dialog.selected == 2);
    for _i in 0..9 { dialog.on_event(InputEvent { kind: InputKind::Menu, key: Key::Down }); }
    verify(dialog.selected == 4);
    dialog.on_event(InputEvent { kind: InputKind::Menu, key: Key::Enter }); verify(!dialog.active && dialog.result == 1);
    // Reopening starts on Linear; Esc cancels.
    dialog.open(); verify(dialog.selected == 0);
    dialog.on_event(InputEvent { kind: InputKind::Menu, key: Key::Escape }); verify(!dialog.active && dialog.result == 2);
    // Tab reaches OK/Cancel; Cancel is pressed like any dialog button.
    dialog.open(); dialog.on_event(InputEvent { kind: InputKind::Menu, key: Key::Toggle });
    dialog.on_event(InputEvent { kind: InputKind::Menu, key: Key::Right });
    dialog.on_event(InputEvent { kind: InputKind::Menu, key: Key::Enter });
    for _i in 0..10 { dialog.tick(); }
    verify(!dialog.active && dialog.result == 2);
    let surface: Surface = Surface::new(80, 24); dialog.open(); dialog.paint(surface, surface.bounds(), Theme::dark_blue());
    surface.release();
}

#[test]
fn tui_pattern_view_shows_instrument_under_track_name() {
    var table: SequenceTable = SequenceTable::new();
    let area: Rect = Rect::new(0, 0, 120, 20);
    let plain: i32 = table.header_height();
    // A MIDI-only pattern keeps the two-line header.
    table.instrument_labels(AudioController {});
    verify(!table.group_subtitles && table.header_height() == plain);
    // An instrument track adds the line, showing the slot number.
    table.create_instrument_track(0, area);
    table.instrument_labels(AudioController {});
    verify(table.group_subtitles && table.header_height() == plain + 1);
    let group: TableGroup = table.groups[table.groups.len() - 1];
    verify(group.subtitle == "- unassigned -");
    table.assign_instrument(7);
    table.instrument_labels(AudioController {});
    let assigned: TableGroup = table.groups[table.groups.len() - 1];
    verify(starts_with(assigned.subtitle, "007 ") == 1);
    // Tracks that play no instrument keep an empty line under their name.
    let first: TableGroup = table.groups[0];
    verify(first.subtitle == "");
    table.release();
}

#[test]
fn tui_song_matrix_merges_a_row_for_playback() {
    var library: PatternLibrary = song_test_library();
    let area: Rect = Rect::new(0, 0, 120, 20);
    // Row 0 holds pattern 1; add pattern 2 beside it.
    verify(library.set_song_at(0, 1, 2));
    let one: PatternEntry = library.patterns[library.index_of(1)];
    let tracks: i64 = one.data.tracks.len();
    var merged: SequenceTable = library.merge_song_row(0, area, false);
    // Both patterns' tracks play together.
    verify(merged.tracks.len() == tracks * 2);
    let appended: SequenceTrack = merged.tracks[merged.tracks.len() - 1];
    verify(appended.instrument && appended.instrument_id == 1);
    // The appended notes came across.
    let row: TableRow = merged.rows[0];
    let start: i32 = merged.track_start(i32(merged.tracks.len()) - 1);
    verify(row.cells[start] == "C-2" && row.cells[start + 1] == "100");
    merged.release();
    // An empty row merges to an empty table, and playback skips it.
    verify(library.matrix_insert_row(0, false));
    var blank: SequenceTable = library.merge_song_row(0, area, false);
    verify(blank.rows.len() == 0);
    blank.release();
    // next_song_row skips empty rows and wraps.
    verify(library.next_song_row(0) == 1);
    verify(library.next_song_row(i32(library.song.len()) - 1) == 1);
    library.release();
}

#[test]
fn tui_song_matrix_marks_the_playing_row() {
    var library: PatternLibrary = song_test_library();
    var matrix: SongMatrix = SongMatrix { visible: true };
    let bounds: Rect = Rect::new(0, 0, 60, 12);
    let theme: Theme = Theme::dark_blue();
    let surface: Surface = Surface::new(60, 12);
    matrix.paint(surface, bounds, theme, library, true, 1);
    // Row 2 plays: its cells sit brighter than the idle row above.
    var playing_bg: i32 = 0; var idle_bg: i32 = 0;
    for y in 0..12 {
        // Lane 2, away from the cursor cell in lane 1.
        let cell: Cell = surface.cell(20, i32(y));
        let tens: Cell = surface.cell(1, i32(y));
        let ones: Cell = surface.cell(3, i32(y));
        if tens.glyph == 48 && ones.glyph == 50 { playing_bg = cell.background; }
        if tens.glyph == 48 && ones.glyph == 49 { idle_bg = cell.background; }
    }
    verify(playing_bg != 0 && idle_bg != 0 && playing_bg != idle_bg);
    verify(playing_bg == lighten(theme.panel, 36) && idle_bg == theme.panel);
    surface.release(); library.release();
}

#[test]
fn tui_track_output_channels_and_labels() {
    var table: SequenceTable = SequenceTable::empty();
    let area: Rect = Rect::new(0, 0, 120, 20);
    table.create_track_kind(false, false, area);     // 0: MIDI
    table.create_track_kind(false, true, area);      // 1: AUDIO
    table.create_track_kind(false, true, area);      // 2: AUDIO
    // Master by default, on every kind of channel.
    let first: str8 = track_output_label(table.tracks, 0); verify(first == "OUT:MST"); free(first);
    // Only an audio track takes another channel, and never itself.
    verify(!table.set_track_output(1, 2));
    verify(table.error == "A track cannot feed itself");
    verify(!table.set_track_output(2, 1));
    verify(table.error == "Only an AUDIO track can take another channel");
    verify(table.set_track_output(2, 2) && table.track_output(2) == 2);
    let routed: str8 = track_output_label(table.tracks, 2); verify(routed == "OUT:A2"); free(routed);
    // A route back into the feeding track would loop.
    verify(!table.set_track_output(1, 3));
    verify(table.error == "That route would loop back to this track");
    // An instrument track shows the instance it plays, and both hops once routed.
    verify(table.set_instrument_output(0, 4));
    let played: str8 = track_output_label(table.tracks, 0); verify(played == "OUT:I4"); free(played);
    verify(table.set_track_output(0, 2));
    let both: str8 = track_output_label(table.tracks, 0); verify(both == "I4>A2"); free(both);
    // Detaching the instrument leaves a plain MIDI track on the same channel.
    verify(table.set_instrument_output(0, 0));
    let detached: str8 = track_output_label(table.tracks, 0); verify(detached == "OUT:A2"); free(detached);
    verify(!table.set_instrument_output(1, 4));
    verify(table.error == "An AUDIO track has no MIDI output");
    table.release();
}

#[test]
fn tui_removing_a_track_remaps_output_channels() {
    var table: SequenceTable = SequenceTable::empty();
    let area: Rect = Rect::new(0, 0, 120, 20);
    table.create_track_kind(false, true, area);      // 0: AUDIO
    table.create_track_kind(false, true, area);      // 1: AUDIO
    table.create_track_kind(false, false, area);     // 2: MIDI -> A2
    verify(table.set_track_output(2, 2));
    // Removing track 0 shifts the destination down with it.
    table.selected_column = table.track_start(0);
    table.remove_track(area);
    verify(table.tracks.len() == 2);
    let shifted: SequenceTrack = table.tracks[1]; verify(shifted.output == 1);
    let label: str8 = track_output_label(table.tracks, 1); verify(label == "OUT:A1"); free(label);
    // Removing the destination itself drops the route back to master.
    table.selected_column = table.track_start(0);
    table.remove_track(area);
    let orphan: SequenceTrack = table.tracks[0]; verify(orphan.output == 0);
    table.release();
}

#[test]
fn tui_output_channels_survive_a_session_round_trip() {
    var library: PatternLibrary = PatternLibrary::empty();
    let area: Rect = Rect::new(0, 0, 120, 20);
    library.table.create_track_kind(false, true, area);     // 0: AUDIO
    library.table.create_track_kind(false, false, area);    // 1: MIDI -> A1
    verify(library.table.set_track_output(1, 1));
    verify(library.has_output_routes());
    let directory: str8 = clone("/private/tmp/mlacker-output-test-XXXXXX"); mkdtemp(directory);
    let path: str8 = format!("{}/outputs.mlack", directory);
    var audio: AudioSystem = AudioSystem {}; var codec: SessionCodec = SessionCodec {};
    verify(codec.save(path, library, SessionView {}, audio));
    let loaded: result<SessionData, str8> = SessionCodec::load(path); verify(loaded.is_ok());
    var restored: SessionData = loaded.unwrap();
    verify(restored.library.table.track_output(1) == 1);
    let label: str8 = track_output_label(restored.library.table.tracks, 1);
    verify(label == "OUT:A1"); free(label);
    restored.release();
    library.release(); std::fs::remove_tree(directory); free(path); free(directory);
}

/// One note on row `row` of an otherwise empty pattern of `rows` rows.
fn one_note_pattern(rows: i32, row: i32, name: str8) -> SequenceTable {
    let area: Rect = Rect::new(0, 0, 100, 12);
    var table: SequenceTable = SequenceTable::new();
    table.set_length(rows, area);
    for r in 0..rows { table.selected_row = i32(r); table.clear_row(); }
    table.selected_row = row; table.selected_column = 1;
    table.edit_event(decode_input("\r"), area); table.editor.set_text(name); table.edit_event(decode_input("\r"), area);
    table.selected_column = 2;
    table.edit_event(decode_input("\r"), area); table.editor.set_text("100"); table.edit_event(decode_input("\r"), area);
    table.selected_column = 1;
    return table;
}

#[test]
fn tui_playback_starts_on_the_row_it_was_started_from() {
    var table: SequenceTable = one_note_pattern(4, 0, "C-4");
    var playback: NotePlayback = NotePlayback {};
    // Stopped, cursor on row 0, then Space: the transport starts at tick 0 but
    // the first update only arrives a UI frame later.
    playback.update(table, 0, false);
    playback.start_row = 0;
    playback.update(table, 1920, true);
    verify(playback.events.len() == 1);
    let on: NoteEvent = playback.events[0];
    verify(on.on == 1 && on.note == 60 && on.tick == 0);
    // It does not play twice, and the loop keeps its timing.
    playback.update(table, 3840, true); verify(playback.events.len() == 0);
    playback.update(table, 60000, true);
    verify(playback.events.len() == 2);   // note-off of the first hit, then row 0 again
    let looped: NoteEvent = playback.events[1];
    verify(looped.on == 1 && looped.tick == 60000);
    table.release();
}

#[test]
fn tui_playback_follows_a_pattern_change_mid_song() {
    var first: SequenceTable = one_note_pattern(4, 0, "C-4");
    var second: SequenceTable = one_note_pattern(2, 0, "D-4");
    var playback: NotePlayback = NotePlayback {};
    playback.start_row = 0;
    playback.update(first, 0, true); verify(playback.events.len() == 1);
    // The matrix moves to the next row: a shorter pattern takes over a frame
    // after the previous one wrapped, and starts from its own row 0.
    playback = NotePlayback {}; playback.start_row = 0;
    playback.update(second, 61920, true);
    verify(playback.events.len() == 1);
    let on: NoteEvent = playback.events[0];
    verify(on.on == 1 && on.note == 62 && on.tick == 60000);
    // Its own loop follows the new length, not the old grid: one row of note,
    // then the next hit two rows after the first.
    playback.update(second, 75000, true); verify(playback.events.len() == 1);
    let release: NoteEvent = playback.events[0]; verify(release.on == 0 && release.tick == 75000);
    playback.update(second, 89999, true); verify(playback.events.len() == 0);
    playback.update(second, 90000, true); verify(playback.events.len() == 1);
    let repeat: NoteEvent = playback.events[0];
    verify(repeat.on == 1 && repeat.note == 62 && repeat.tick == 90000);
    first.release(); second.release();
}

#[test]
fn tui_merged_song_row_keeps_fx_routing_and_clips() {
    var library: PatternLibrary = PatternLibrary::empty();
    let area: Rect = Rect::new(0, 0, 120, 20);
    // Pattern 1: an audio track with a clip, fed by an instrument track that
    // carries an insert and an aux send.
    library.table.create_track_kind(false, true, area);
    var clip: AudioClip = AudioClip { source: clone("embedded.wav"), channels: 2, sample_rate: 8000, frames: 4000, frames_per_row: 1000 };
    for _i in 0..4000 { clip.samples.push(0.5f); clip.samples.push(0.25f); }
    for _i in 0..4 { clip.peaks.push(WavePeak { left: 500, right: 250 }); }
    library.table.selected_row = 0; verify(library.table.insert_audio(clip, area));
    library.table.create_instrument_track(1, area);
    let instrument: i32 = i32(library.table.tracks.len()) - 1;
    library.table.set_insert(instrument, 0, 3);
    verify(library.table.set_send(instrument, 1, 40));
    verify(library.table.set_track_output(instrument, 1));
    // A second lane's pattern joins it in the same song row.
    library.add(true);
    verify(library.set_song_at(0, 0, 1) && library.set_song_at(0, 1, 2));
    var merged: SequenceTable = library.merge_song_row(0, area, false);
    verify(merged.tracks.len() == 4);
    // Lane 1 arrives through copy_pattern, lane 2 through append_tracks_from:
    // both keep the routing the mixer set, and the clip that plays.
    for t in 0..merged.tracks.len() {
        let track: SequenceTrack = merged.tracks[t];
        if track.audio { verify(track.instances.len() == 1); }
        else { verify(track.insert_id(0) == 3 && track.send_level(1) == 40 && track.output == 1); }
    }
    let routed: str8 = track_output_label(merged.tracks, instrument);
    verify(routed == "I1>A1"); free(routed);
    merged.release(); library.release(); clip.release();
}

#[test]
fn tui_clips_restart_on_the_pattern_the_matrix_moves_to() {
    let area: Rect = Rect::new(0, 0, 120, 20);
    // One row of audio, so a clip cannot outlive the row it starts on.
    var clip: AudioClip = AudioClip { source: clone("embedded.wav"), channels: 2, sample_rate: 8000, frames: 1000, frames_per_row: 1000 };
    for _i in 0..1000 { clip.samples.push(0.5f); clip.samples.push(0.25f); }
    clip.peaks.push(WavePeak { left: 500, right: 250 });
    var table: SequenceTable = SequenceTable::new();
    table.set_length(4, area);
    table.create_track_kind(false, true, area);
    table.selected_row = 0; verify(table.insert_audio(clip, area));
    let opened: result<AudioController, str8> = AudioController::new(8000, 128);
    var audio: AudioSystem = AudioSystem {}; audio.output = opened.unwrap();
    let allocated: result<PcmBlock, str8> = PcmBlock::new(1024); let block: PcmBlock = allocated.unwrap();
    audio.sync_volumes(table);
    // Playing from row 0 of this pattern: the clip sounds.
    audio.restart_samples(0);
    verify(audio.sample_playback(table, 0, true, 120));
    audio.output.process(block, 1024); verify(audio.output.master_peak(0) > 0);
    verify(audio.registered_clips.len() == 1);
    // The matrix moves on: a pattern of another length takes over mid-song and
    // starts from its own row 0, so its clip plays there instead of keeping the
    // grid the previous pattern happened to use.
    var other: SequenceTable = SequenceTable::new();
    other.set_length(2, area);
    other.create_track_kind(false, true, area);
    other.selected_row = 0; verify(other.insert_audio(clip, area));
    audio.sync_volumes(other);
    audio.restart_samples(0);
    // Row 3 of the four-row pattern is not a boundary of the two-row one.
    verify(audio.sample_playback(other, 46920, true, 120));
    // Re-arming uploads nothing: the same audio keeps its registration, so the
    // switch needs no stopped device and no effect tail is cut.
    verify(audio.registered_clips.len() == 1);
    audio.output.process(block, 1024); verify(audio.output.master_peak(0) > 0);
    // Its own two-row loop repeats it; the previous four-row grid does not.
    verify(audio.sample_playback(other, 60000, true, 120));
    audio.output.process(block, 1024); verify(audio.output.master_peak(0) == 0);
    verify(audio.sample_playback(other, 75000, true, 120));
    audio.output.process(block, 1024); verify(audio.output.master_peak(0) > 0);
    // Different audio of the same shape keeps its own registration.
    var quiet: AudioClip = AudioClip { source: clone("embedded.wav"), channels: 2, sample_rate: 8000, frames: 1000, frames_per_row: 1000 };
    for _i in 0..1000 { quiet.samples.push(0.1f); quiet.samples.push(0.05f); }
    quiet.peaks.push(WavePeak { left: 100, right: 50 });
    other.selected_row = 1; verify(other.insert_audio(quiet, area));
    audio.restart_samples(0);
    verify(audio.sample_playback(other, 75000, true, 120));
    verify(audio.registered_clips.len() == 2);
    block.close(); audio.release(); table.release(); other.release(); clip.release(); quiet.release();
}

#[test]
fn tui_matrix_browsing_follows_the_cell_pattern() {
    var library: PatternLibrary = song_test_library();
    // Row 0 holds pattern 1, row 1 pattern 2; the clone is active to start.
    verify(library.active_id == 2);
    verify(library.follow_matrix_cell(0, 0) && library.active_id == 1);
    verify(library.selected_pattern() == 1);
    // The same cell twice is not a change, and an empty cell keeps the pattern.
    verify(!library.follow_matrix_cell(0, 0));
    verify(!library.follow_matrix_cell(0, 1) && library.active_id == 1);
    verify(!library.follow_matrix_cell(9, 0) && library.active_id == 1);
    // Edits made through the mixer land in the pattern the cursor is on.
    verify(library.table.set_track_output(0, 0));
    verify(library.follow_matrix_cell(1, 0) && library.active_id == 2);
    verify(library.selected_pattern() == 2);
    library.release();
}

#[test]
fn tui_merged_row_shows_each_channel_once() {
    var library: PatternLibrary = PatternLibrary::empty();
    let area: Rect = Rect::new(0, 0, 120, 20);
    // Pattern 1: a drum channel and a bass channel. Pattern 2 is a clone that
    // gains a lead of its own, so the two share two channels out of three.
    library.table.create_instrument_track(1, area);
    library.table.rename_track("Drums");
    library.table.create_instrument_track(2, area);
    library.table.rename_track("Bass");
    library.add(true);
    library.table.create_instrument_track(3, area);
    library.table.rename_track("Lead");
    verify(library.set_song_at(0, 0, 1) && library.set_song_at(0, 1, 2));
    // Playing the row keeps every lane's tracks: both patterns' notes sound.
    var played: SequenceTable = library.merge_song_row(0, area, false);
    verify(played.tracks.len() == 5);
    // The mixer's view of the same row lists each channel once.
    var shown: SequenceTable = library.merge_song_row(0, area, true);
    verify(shown.tracks.len() == 3);
    let first: SequenceTrack = shown.tracks[0]; verify(first.name == "Drums");
    let second: SequenceTrack = shown.tracks[1]; verify(second.name == "Bass");
    let third: SequenceTrack = shown.tracks[2]; verify(third.name == "Lead");
    // A channel that only looks alike, on another instrument, is its own strip.
    played.release(); shown.release();
    library.select(2);
    library.table.create_instrument_track(4, area);
    library.table.rename_track("Drums");
    var mixed: SequenceTable = library.merge_song_row(0, area, true);
    verify(mixed.tracks.len() == 4);
    mixed.release(); library.release();
}

#[test]
fn tui_following_the_song_row_shows_its_pattern() {
    var library: PatternLibrary = song_test_library();
    // Row 0 holds pattern 1 in lane 1, row 1 holds pattern 2.
    verify(library.song_row_pattern(0) == 1 && library.song_row_pattern(1) == 2);
    verify(library.follow_pattern(library.song_row_pattern(0)));
    verify(library.active_id == 1 && library.selected_pattern() == 1);
    verify(!library.follow_pattern(library.song_row_pattern(0)));
    verify(library.follow_pattern(library.song_row_pattern(1)) && library.active_id == 2);
    // An empty row names no pattern and changes nothing.
    verify(library.matrix_insert_row(1, true) && library.song_row_pattern(2) == 0);
    verify(!library.follow_pattern(library.song_row_pattern(2)) && library.active_id == 2);
    library.release();
}

#[test]
fn tui_matrix_rows_hold_a_fixed_stretch_of_pattern() {
    var library: PatternLibrary = PatternLibrary::empty();
    let area: Rect = Rect::new(0, 0, 120, 20);
    library.table.create_instrument_track(1, area);
    library.table.set_length(128, area);                      // pattern 1: two matrix rows
    library.table.set_cell(0, 1, clone("C-2")); library.table.set_cell(0, 2, clone("100"));
    library.table.set_cell(64, 1, clone("D-2")); library.table.set_cell(64, 2, clone("100"));
    library.add(true); library.table.set_length(64, area);    // pattern 2: one row
    library.add(true);                                        // pattern 3: one row
    while library.song.len() < 3 { library.matrix_insert_row(0, true); }
    for r in 0..library.song.len() { library.set_song_at(i32(r), 0, 0); library.set_song_at(i32(r), 1, 0); }
    verify(library.matrix_steps == 64);
    verify(library.set_song_at(0, 0, 1));
    verify(library.song_span(1) == 2 && library.song_span(2) == 1);
    // The long pattern owns both rows of its lane: nothing else starts inside it.
    verify(library.song_placement_blocked(1, 0, 2) == -1);
    verify(!library.set_song_at(1, 0, 2));
    verify(library.song_continues(1, 0) && !library.song_continues(0, 0));
    // The lane beside it plays two short patterns meanwhile.
    verify(library.set_song_at(0, 1, 2) && library.set_song_at(1, 1, 3));
    let second: SongCover = library.song_cover(1, 0);
    verify(second.id == 1 && second.offset == 1);
    let beside: SongCover = library.song_cover(1, 1);
    verify(beside.id == 3 && beside.offset == 0);
    // Each matrix row plays its own stretch of the long pattern.
    var first_row: SequenceTable = library.merge_song_row(0, area, false);
    verify(first_row.rows.len() == 64);
    let opening: TableRow = first_row.rows[0]; verify(opening.cells[1] == "C-2");
    var second_row: SequenceTable = library.merge_song_row(1, area, false);
    verify(second_row.rows.len() == 64);
    let later: TableRow = second_row.rows[0]; verify(later.cells[1] == "D-2");
    // Both rows play, and the empty one after them is skipped.
    verify(library.next_song_row(0) == 1 && library.next_song_row(1) == 0);
    // A pattern already below blocks a longer one from growing over it.
    verify(library.set_song_at(0, 0, 0) && library.set_song_at(1, 0, 3));
    verify(library.song_placement_blocked(0, 0, 1) == 3);
    verify(!library.set_song_at(0, 0, 1));
    first_row.release(); second_row.release(); library.release();
}

#[test]
fn tui_matrix_grid_survives_a_session_round_trip() {
    var library: PatternLibrary = PatternLibrary::empty();
    let area: Rect = Rect::new(0, 0, 120, 20);
    library.table.create_track_kind(false, false, area);
    library.matrix_steps = 16;
    let directory: str8 = clone("/private/tmp/mlacker-grid-test-XXXXXX"); mkdtemp(directory);
    let path: str8 = format!("{}/grid.mlack", directory);
    var audio: AudioSystem = AudioSystem {}; var codec: SessionCodec = SessionCodec {};
    verify(codec.save(path, library, SessionView {}, audio));
    let loaded: result<SessionData, str8> = SessionCodec::load(path); verify(loaded.is_ok());
    var restored: SessionData = loaded.unwrap();
    verify(restored.library.matrix_steps == 16);
    restored.release();
    // The default is not written at all, and loads as 64.
    library.matrix_steps = 64;
    verify(codec.save(path, library, SessionView {}, audio));
    let plain: result<SessionData, str8> = SessionCodec::load(path); verify(plain.is_ok());
    var basic: SessionData = plain.unwrap();
    verify(basic.library.matrix_steps == 64);
    basic.release();
    library.release(); std::fs::remove_tree(directory); free(path); free(directory);
}

#[test]
fn tui_session_without_a_grid_takes_it_from_its_patterns() {
    var library: PatternLibrary = PatternLibrary::empty();
    let area: Rect = Rect::new(0, 0, 120, 20);
    library.table.create_track_kind(false, false, area);
    library.table.set_length(64, area);          // pattern 1: 64 rows
    library.add(false); library.table.set_length(16, area);
    library.add(false); library.table.set_length(16, area);
    library.add(false); library.table.set_length(8, area);
    // Most patterns are 16 rows long, so that is one matrix row.
    verify(library.derive_matrix_steps() == 16);
    verify(library.matrix_steps == 64);          // not written: this is a 1.0 song
    let directory: str8 = clone("/private/tmp/mlacker-derive-test-XXXXXX"); mkdtemp(directory);
    let path: str8 = format!("{}/derive.mlack", directory);
    var audio: AudioSystem = AudioSystem {}; var codec: SessionCodec = SessionCodec {};
    verify(codec.save(path, library, SessionView {}, audio));
    let loaded: result<SessionData, str8> = SessionCodec::load(path); verify(loaded.is_ok());
    var restored: SessionData = loaded.unwrap();
    verify(restored.library.matrix_steps == 16);
    // A 64-row pattern then takes four matrix rows, and a 16-row one takes one.
    verify(restored.library.song_span(1) == 4 && restored.library.song_span(2) == 1);
    restored.release();
    library.release(); std::fs::remove_tree(directory); free(path); free(directory);
}

#[test]
fn tui_timed_recording_chords() {
    let area: Rect = Rect::new(0, 0, 120, 20);
    var table: SequenceTable = SequenceTable::new();
    table.clear_row();
    verify(!table.start_recording());
    verify(table.mixer_event(decode_input("R"), area));
    verify(table.start_recording());
    verify(table.record_timed(67, 110, 0, 1500, true));
    verify(table.record_timed(60, 90, 0, 1800, true));
    verify(table.record_timed(64, 100, 0, 2100, true));
    let chord: TableRow = table.rows[0];
    verify(chord.cells[1] == "C-4" && chord.cells[5] == "E-4" && chord.cells[9] == "G-4");
    verify(chord.cells[2] == "90" && chord.cells[6] == "100" && chord.cells[10] == "110");
    verify(chord.cells[4] == "0.12" && chord.cells[8] == "0.14" && chord.cells[12] == "0.10");
    verify(table.record_timed(67, 0, 0, 16500, false));
    let released: TableRow = table.rows[0]; verify(released.cells[11] == "1.00");
    table.selected_row = 1; table.clear_row();
    verify(table.record_timed(72, 80, 0, 14850, true));
    let early: TableRow = table.rows[1]; verify(early.cells[4] == "-0.01");
    table.grow_recording(15000 * 80);
    verify(table.rows.len() >= 82);
    table.stop_recording(31800, area);
    let finished: TableRow = table.rows[0]; verify(finished.cells[3] == "2.00");
    verify(table.recording_track == -1 && table.editing && table.edit_mode == 1);
    table.release();
}

#[test]
fn tui_automation_step_text() {
    let single: list<str8> = automation_steps("64");
    verify(single.len() == 4 && single[0] == "64" && single[1] == "" && single[3] == "");
    let plain: str8 = automation_text(single); verify(plain == "64"); free(plain);
    let steps: list<str8> = automation_steps("12 . -31 40");
    verify(steps.len() == 4 && steps[0] == "12" && steps[1] == "" && steps[2] == "-31" && steps[3] == "40");
    let joined: str8 = automation_text(steps); verify(joined == "12 . -31 40"); free(joined);
    let tail: list<str8> = automation_steps(". . . 7"); let late: str8 = automation_text(tail); verify(late == ". . . 7"); free(late);
    verify(automation_valid("", 0, 127) && automation_valid("127", 0, 127) && automation_valid("0 . 64 127", 0, 127));
    verify(!automation_valid("128", 0, 127) && !automation_valid("0 . 64 128", 0, 127) && !automation_valid("1 2 3", 0, 127));
    verify(!automation_valid("1  2 3 4", 0, 127) && !automation_valid("x", 0, 127) && automation_valid("-8192 . . 8191", -8192, 8191));
    verify(automation_controller("cc:74") == 74 && automation_controller("pitchbend") == 129 && automation_controller("cutoff:0:9") == -1);
    let title: str8 = automation_title("cc:74"); let bend: str8 = automation_title("pitchbend"); let named: str8 = automation_title("resonance:0:9");
    verify(title == "CC74" && bend == "PB" && named == "reson"); free(title); free(bend); free(named);
    verify(automation_controller("aftertouch") == 128);
    let pressure: str8 = automation_title("aftertouch"); verify(pressure == "AT"); free(pressure);
}

#[test]
fn tui_automation_sixty_fourth_steps() {
    let area: Rect = Rect::new(0, 0, 120, 12);
    var table: SequenceTable = SequenceTable::new();
    for r in 0..64 { table.selected_row = i32(r); table.clear_row(); }
    table.zoom_tracks(2, true, area);
    let column: i32 = table.automation_column(0, 1);
    table.selected_row = 0; table.selected_column = column;
    table.cycle_vertical_zoom(area); table.cycle_vertical_zoom(area); verify(table.row_spacing() == 4);
    // Zoomed to 1/64, each line of a row is one automation step.
    table.selected_subrow = 1; table.edit_event(decode_input("\r"), area); table.editor.set_text("20"); table.edit_event(decode_input("\r"), area);
    let first: TableRow = table.rows[0]; verify(!table.editing && first.cells[column] == ". 20 . .");
    table.selected_subrow = 3; table.edit_event(decode_input("K"), area);
    let started: TableRow = table.rows[0]; verify(started.cells[column] == ". 20 . 0");
    table.edit_event(decode_input("K"), area);
    table.selected_subrow = 1; table.edit_event(decode_input("\r"), area); verify(table.editor.text == "20");
    table.editor.set_text("200"); table.edit_event(decode_input("\r"), area); verify(table.editing);
    table.editor.set_text(""); table.edit_event(decode_input("\r"), area);
    let cleared: TableRow = table.rows[0]; verify(!table.editing && cleared.cells[column] == ". . . 1");
    table.selected_subrow = 0; table.edit_event(decode_input("\r"), area); table.editor.set_text("5"); table.edit_event(decode_input("\r"), area);
    // Unzoomed, J/K moves every step and Enter edits the whole cell.
    table.cycle_vertical_zoom(area); verify(table.row_spacing() == 1);
    table.edit_event(decode_input("K"), area);
    let moved: TableRow = table.rows[0]; verify(moved.cells[column] == "6 . . 2");
    table.edit_event(decode_input("\r"), area); verify(table.editor.text == "6 . . 2");
    table.editor.set_text("1 2"); table.edit_event(decode_input("\r"), area); verify(table.editing);
    table.editor.set_text("10 . 30 40"); table.edit_event(decode_input("\r"), area); verify(!table.editing);
    // Steps between the visible lines mark the row and show as "+".
    table.mark_hidden_notes(); verify(table.bright_rows.len() == 1 && table.bright_rows[0] == 0);
    let surface: Surface = Surface::new(120, 12); let theme: Theme = Theme::dark_blue();
    table.paint(surface, area, theme); table.paint_automation(surface, area, theme);
    let body: Rect = table.body(area); let x: i32 = area.x + table.column_x(column);
    let digit: Cell = surface.cell(x, body.y); let plus: Cell = surface.cell(x + 2, body.y); let blank: Cell = surface.cell(x + 3, body.y);
    verify(digit.glyph == 49 && plus.glyph == 43 && blank.glyph == 32);
    table.cycle_vertical_zoom(area); table.cycle_vertical_zoom(area);
    table.paint(surface, area, theme); table.paint_automation(surface, area, theme);
    let third: Cell = surface.cell(x, body.y + 2); let hole: Cell = surface.cell(x, body.y + 1);
    verify(third.glyph == 51 && hole.glyph == 32);
    surface.release();
    // Playback sends each step on its own 1/64 note.
    var playback: NotePlayback = NotePlayback {};
    playback.update(table, 0, true); verify(playback.events.len() == 1);
    let at_row: NoteEvent = playback.events[0]; verify(at_row.on == 2 && at_row.note == 1 && at_row.velocity == 10 && at_row.tick == 0);
    playback.update(table, 7499, true); verify(playback.events.len() == 0);
    playback.update(table, 7500, true); verify(playback.events.len() == 1);
    let half: NoteEvent = playback.events[0]; verify(half.velocity == 30 && half.tick == 7500);
    playback.update(table, 11250, true); verify(playback.events.len() == 1);
    let last: NoteEvent = playback.events[0]; verify(last.velocity == 40 && last.tick == 11250);
    table.release();
}

#[test]
fn tui_record_controllers_into_cc_columns() {
    let area: Rect = Rect::new(0, 0, 120, 20);
    var table: SequenceTable = SequenceTable::new();
    for r in 0..64 { table.selected_row = i32(r); table.clear_row(); }
    table.selected_row = 0; table.selected_column = 1;
    verify(!table.record_control(74, 64, 0));
    verify(table.mixer_event(decode_input("R"), area)); verify(table.start_recording());
    verify(!table.record_control(74, 128, 0) && !table.record_control(130, 1, 0));
    // The mod wheel lands in the CC1 column every track starts with.
    verify(table.record_control(1, 100, 0));
    // Moving the cutoff adds a shown CC74 column; values snap to 1/64 notes.
    verify(table.record_control(74, 10, 1000));
    verify(table.record_control(74, 20, 2000));
    verify(table.record_control(74, 30, 3700));
    verify(table.record_control(74, 40, 13200));
    let track: SequenceTrack = table.tracks[0]; verify(track.automation.len() == 2 && track.zoom_stage == 2);
    let cutoff: AutomationSlot = track.automation[1]; verify(cutoff.parameter == "cc:74" && cutoff.maximum == 127);
    let header: TableColumn = table.columns[6]; verify(header.title == "CC74" && !header.hidden);
    let first: TableRow = table.rows[0]; verify(first.cells[5] == "100" && first.cells[6] == "10 30 . .");
    // Pitch bend arrives as a raw 14-bit value and is stored signed.
    verify(table.record_control(129, 0, 26250));
    let second: TableRow = table.rows[1]; verify(second.cells[6] == "40" && second.cells[7] == ". . . -8192");
    let bend: TableColumn = table.columns[7]; verify(bend.title == "PB" && table.track_start(1) == 8);
    // Aftertouch (controller 128) gets an AT column of 0-127.
    verify(table.record_control(128, 64, 0));
    let pressure: TableColumn = table.columns[8]; verify(pressure.title == "AT");
    let pressed: TableRow = table.rows[0]; verify(pressed.cells[8] == "64");
    // Notes of the take still fill the note columns before the CC columns.
    verify(table.record_timed(60, 90, 0, 0, true));
    let notes: TableRow = table.rows[0]; verify(notes.cells[1] == "C-4" && notes.cells[6] == "10 30 . .");
    // Loop takes wrap onto the pattern instead of growing it.
    table.stop_recording(30000, area); table.editing = false; table.edit_mode = 0;
    table.selected_column = 1; table.recording_extend = false; verify(table.start_recording());
    verify(table.record_control(74, 99, 64 * 15000 + 3750) && table.rows.len() == 64);
    let wrapped: TableRow = table.rows[0]; verify(wrapped.cells[6] == "10 99 . .");
    table.release();
}

#[test]
fn tui_pattern_file_round_trip() {
    var library: PatternLibrary = PatternLibrary::new();
    let area: Rect = Rect::new(0, 0, 120, 20);
    library.table.create_instrument_track(7, area);
    library.table.create_track_kind(false, true, area);
    let clip: AudioClip = test_clip(4000, 0.25f);
    verify(library.table.insert_audio(clip, area));
    let audio_track: i32 = i32(library.table.tracks.len()) - 1;
    library.table.selected_column = library.table.audio_offset_column(audio_track);
    library.table.edit_event(decode_input("\r"), area); library.table.editor.set_text("0.75"); library.table.edit_event(decode_input("\r"), area);
    let directory: str8 = clone("/private/tmp/mlacker-pattern-test-XXXXXX"); mkdtemp(directory);
    let base: str8 = format!("{}/pattern", directory);
    let path: str8 = format!("{}.mlapatt", base);
    verify(SessionCodec::save_pattern(base, "My pattern", library.table));
    let loaded: result<mlacker_ui::session::PatternData, str8> = SessionCodec::load_pattern(path);
    verify(loaded.is_ok());
    let data: mlacker_ui::session::PatternData = loaded.unwrap();
    verify(data.name == "My pattern" && data.clips.len() == 1);
    verify(data.table.rows.len() == library.table.rows.len());
    verify(data.table.tracks.len() == library.table.tracks.len());
    for i in 0..data.table.rows.len() {
        let actual: TableRow = data.table.rows[i]; let expected: TableRow = library.table.rows[i];
        for j in 0..actual.cells.len() { verify(actual.cells[j] == expected.cells[j]); }
    }
    let tracks: list<SequenceTrack> = data.table.tracks;
    for track in tracks { verify(track.instrument_id == 0); }
    let last: SequenceTrack = tracks[tracks.len() - 1];
    verify(last.instances.len() == 1);
    verify(data.table.audio_timing_offset(i32(tracks.len()) - 1, 0) == 11250);
    let before: i64 = library.song.len();
    verify(library.import_pattern(data.name, data.table, data.clips));
    let name: str8 = library.active_name();
    verify(library.active_id == 4 && name == "My pattern");
    verify(library.song.len() == before && library.audio.samples.len() == 1);
    data.release(); library.release(); clip.release();
    std::fs::remove_tree(directory); free(base); free(path); free(directory);
}

#[test]
fn tui_record_count_in_and_signature() {
    var clock: TransportStatus = TransportStatus { bpm: 120 };
    clock.toggle(1000, 8, 64); clock.begin_count_in();
    verify(clock.count_in == 240000 && clock.metronome_beat() == 0);
    verify(clock.metronome_beat() == -1);
    clock.advance(1500, 64); verify(clock.metronome_beat() == 1 && clock.row == 8);
    clock.advance(2000, 64); verify(clock.metronome_beat() == 2 && clock.ticks == 120000);
    clock.advance(2500, 64); verify(clock.metronome_beat() == 3 && clock.count_in == 60000);
    clock.advance(3000, 64); verify(clock.metronome_beat() == 0 && clock.count_in == 0 && clock.row == 8);
    clock.advance(3125, 64); verify(clock.row == 9);
    clock.toggle(3125, 0, 64); verify(clock.metronome_beat() == -1);
    clock.beats_per_bar = 3; clock.beat_unit = 8;
    clock.toggle(4000, 0, 64); clock.begin_count_in();
    verify(clock.count_in == 90000 && clock.metronome_beat() == 0);
    clock.advance(4250, 64); verify(clock.metronome_beat() == 1 && clock.row == 0);
    clock.advance(4500, 64); verify(clock.metronome_beat() == 2 && clock.row == 0);
    clock.advance(4775, 64); verify(clock.metronome_beat() == 0 && clock.count_in == 0 && clock.ticks == 3000);
}

#[test]
fn tui_record_loop_replaces_previous_take() {
    let area: Rect = Rect::new(0, 0, 120, 20);
    var table: SequenceTable = SequenceTable::new();
    table.set_length(4, area); table.selected_row = 0; table.selected_column = 1;
    verify(table.mixer_event(decode_input("R"), area));
    table.recording_extend = false; verify(table.start_recording());
    verify(table.record_timed(60, 90, 0, 0, true));
    verify(table.record_timed(64, 80, 0, 100, true));
    let chord: TableRow = table.rows[0]; verify(chord.cells[1] == "C-4" && chord.cells[5] == "E-4");
    table.grow_recording(60000);
    verify(table.rows.len() == 4);
    let cleared: TableRow = table.rows[0]; verify(cleared.cells[1] == "" && cleared.cells[5] == "");
    verify(table.record_timed(67, 70, 0, 61500, true));
    verify(table.record_timed(60, 0, 0, 62000, false));
    verify(table.record_timed(67, 0, 0, 64500, false));
    let replaced: TableRow = table.rows[0];
    verify(replaced.cells[1] == "G-4" && replaced.cells[5] == "");
    verify(replaced.cells[3] == "0.20" && replaced.cells[4] == "0.10");
    table.stop_recording(65000, area); table.release();
}

#[test]
fn tui_record_metronome_audio() {
    let opened: result<AudioController, str8> = AudioController::new(48000, 128);
    verify(opened.is_ok());
    var audio: AudioSystem = AudioSystem { output: opened.unwrap() };
    let allocated: result<PcmBlock, str8> = PcmBlock::new(2048);
    let block: PcmBlock = allocated.unwrap();
    audio.metronome(true); verify(audio.output.process(block, 2048) == 0);
    verify(audio.output.master_peak(0) > 0 && block.left(2047) == 0.0f);
    var high_crossings: i32 = 0;
    for i in 1..1440 { if block.left(i) * block.left(i - 1) < 0.0f { high_crossings = high_crossings + 1; } }
    audio.metronome(false); verify(audio.output.process(block, 2048) == 0);
    var low_crossings: i32 = 0;
    for i in 1..1440 { if block.left(i) * block.left(i - 1) < 0.0f { low_crossings = low_crossings + 1; } }
    verify(high_crossings > low_crossings && low_crossings > 20);
    verify(block.left(2047) == 0.0f);
    block.close(); audio.release();
}

#[test]
fn tui_vertical_zoom_keeps_rows_and_places_offset_notes() {
    var table: SequenceTable = SequenceTable::new();
    let area: Rect = Rect::new(0, 0, 100, 24);
    table.zoom_tracks(2, true, area);
    table.selected_column = 1; table.selected_row = 0; table.edit_event(decode_input("\r"), area); table.editor.set_text("C-4"); table.edit_event(decode_input("\r"), area);
    table.selected_column = 4; table.edit_event(decode_input("\r"), area); table.editor.set_text("0.00"); table.edit_event(decode_input("\r"), area);
    table.selected_row = 1; table.selected_column = 1; table.edit_event(decode_input("\r"), area); table.editor.set_text("D-4"); table.edit_event(decode_input("\r"), area);
    table.selected_column = 4; table.edit_event(decode_input("\r"), area); table.editor.set_text("-0.50"); table.edit_event(decode_input("\r"), area);
    table.selected_row = 2; table.selected_column = 1; table.edit_event(decode_input("\r"), area); table.editor.set_text("E-4"); table.edit_event(decode_input("\r"), area);
    table.selected_column = 4; table.edit_event(decode_input("\r"), area); table.editor.set_text("-1.75"); table.edit_event(decode_input("\r"), area);
    table.selected_row = 0; table.selected_column = 1;
    let count: i64 = table.rows.len(); let revision: i64 = table.revision;
    let surface: Surface = Surface::new(100, 24); let theme: Theme = Theme::dark_blue();
    table.cycle_vertical_zoom(area); verify(table.row_scale == 2);
    table.paint(surface, area, theme); table.paint_subdivision_notes(surface, area, theme);
    let body: Rect = table.body(area); let x: i32 = table.column_x(1);
    let number: Cell = surface.cell(0, body.y + 1); verify(number.glyph == 46);
    table.cycle_vertical_zoom(area); verify(table.row_scale == 4);
    table.paint(surface, area, theme); table.paint_subdivision_notes(surface, area, theme);
    let main: Cell = surface.cell(x, body.y); let quarter: Cell = surface.cell(x, body.y + 1); let half: Cell = surface.cell(x, body.y + 2);
    verify(main.glyph == 67 && quarter.glyph == 69 && half.glyph == 68);
    verify(main.foreground > half.foreground && half.foreground > quarter.foreground);
    let next_number: Cell = surface.cell(0, body.y + 4); verify(next_number.glyph != 32);
    let dark: Cell = surface.cell(0, body.y + 1); let light: Cell = surface.cell(0, body.y + 2);
    verify(dark.background < light.background && light.background < next_number.background);
    verify(table.rows.len() == count && table.revision == revision);
    table.selected_row = 63; table.reconcile(area);
    table.selected_subrow = 3; table.reconcile(area);
    let selected: Rect = table.selected_rect(area); verify(selected.height == 1 && selected.y >= body.y && selected.y < body.y + body.height);
    table.cycle_vertical_zoom(area); verify(table.row_scale == 1 && table.selected_row == 63);
    let stored: TableRow = table.rows[2]; verify(stored.cells[1] == "E-4" && stored.cells[4] == "-1.75");
    surface.release(); table.release();
}

#[test]
fn tui_subdivision_notes_edit_save_and_play_without_zoom() {
    let area: Rect = Rect::new(0, 0, 120, 24);
    var sequence: SequenceTable = SequenceTable::empty(); sequence.create_track_kind(false, false, area);
    sequence.selected_row = 0; sequence.selected_column = 1;
    sequence.cycle_vertical_zoom(area); sequence.cycle_vertical_zoom(area);
    let pitches: list<str8> = ["C-4", "D-4", "E-4", "F-4"];
    for i in 0..4 {
        verify(sequence.selected_row == 0 && sequence.selected_subrow == i);
        sequence.edit_event(decode_input("\r"), area); sequence.editor.set_text(pitches[i]);
        sequence.edit_event(decode_input("\r"), area); verify(!sequence.editing);
        sequence.edit_event(decode_input("j"), area);
    }
    verify(sequence.selected_row == 1 && sequence.selected_subrow == 0 && sequence.rows.len() == 64);
    sequence.edit_event(decode_input("k"), area); verify(sequence.selected_row == 0 && sequence.selected_subrow == 3);
    sequence.edit_event(decode_input("\r"), area); verify(sequence.editor.text == "F-4");
    sequence.editor.set_text("G-4"); sequence.edit_event(decode_input("\r"), area);
    verify(sequence.mixer_event(decode_input("R"), area));
    verify(sequence.record_note(67, 101));
    sequence.cycle_vertical_zoom(area); verify(sequence.row_spacing() == 1 && sequence.selected_subrow == 0);
    var playback: NotePlayback = NotePlayback { start_row: 0 };
    for i in 0..4 {
        playback.update(sequence, i * 3750, true);
        verify(playback.events.len() == 1);
        let event: NoteEvent = playback.events[0];
        verify(event.on == 1 && event.tick == i * 3750 && event.note == (i == 3 ? 67 : 60 + i * 2));
    }
    let directory: str8 = clone("/private/tmp/mlacker-subrow-test-XXXXXX"); mkdtemp(directory);
    let path: str8 = format!("{}/subrows.mlapatt", directory);
    var holder: PatternLibrary = PatternLibrary::empty(); holder.table.release(); holder.table = sequence;
    verify(SessionCodec::save_pattern(path, "Subrows", holder.table));
    let loaded: result<mlacker_ui::session::PatternData, str8> = SessionCodec::load_pattern(path); verify(loaded.is_ok());
    let data: mlacker_ui::session::PatternData = loaded.unwrap();
    var replay: NotePlayback = NotePlayback { start_row: 0 };
    for i in 0..4 {
        replay.update(data.table, i * 3750, true); verify(replay.events.len() == 1);
        let event: NoteEvent = replay.events[0]; verify(event.on == 1 && event.tick == i * 3750);
    }
    data.release(); holder.release(); std::fs::remove_tree(directory); free(path); free(directory);
}

#[test]
fn tui_subdivision_clipboard_keeps_spacing_and_hidden_indicator() {
    let area: Rect = Rect::new(0, 0, 120, 24);
    var sequence: SequenceTable = SequenceTable::empty(); sequence.create_track_kind(false, false, area);
    sequence.selected_row = 0; sequence.selected_column = 1;
    sequence.cycle_vertical_zoom(area); sequence.cycle_vertical_zoom(area);
    sequence.edit_event(decode_input("j"), area);
    sequence.edit_event(decode_input("\r"), area); sequence.editor.set_text("C-4"); sequence.edit_event(decode_input("\r"), area);
    sequence.edit_event(decode_input("j"), area);
    sequence.edit_event(decode_input("\r"), area); sequence.editor.set_text("D-4"); sequence.edit_event(decode_input("\r"), area);
    sequence.edit_event(decode_input("k"), area);
    sequence.edit_event(decode_input("v"), area); sequence.edit_event(decode_input("j"), area); sequence.edit_event(decode_input("y"), area);
    verify(sequence.clipboard.len() == 2 && sequence.clipboard_spacing == 4);
    sequence.selected_row = 1; sequence.selected_subrow = 2;
    sequence.edit_event(decode_input("p"), area); verify(!sequence.paste_error);
    sequence.edit_event(decode_input("\r"), area); verify(sequence.editor.text == "C-4"); sequence.edit_event(decode_input("\r"), area);
    sequence.edit_event(decode_input("j"), area);
    sequence.edit_event(decode_input("\r"), area); verify(sequence.editor.text == "D-4"); sequence.edit_event(decode_input("\r"), area);
    // Cutting two subrows must leave their original notes in main row zero intact.
    sequence.edit_event(decode_input("k"), area);
    sequence.edit_event(decode_input("v"), area); sequence.edit_event(decode_input("j"), area); sequence.edit_event(decode_input("d"), area);
    verify(!sequence.paste_error);
    sequence.edit_event(decode_input("\r"), area); verify(sequence.editor.text == ""); sequence.edit_event(decode_input("\r"), area);
    // A clipboard retains its quarter-row timing when pasted without zoom.
    sequence.cycle_vertical_zoom(area); sequence.selected_row = 2; sequence.selected_column = 1;
    sequence.edit_event(decode_input("p"), area); verify(!sequence.paste_error);
    sequence.mark_hidden_notes(); verify(sequence.bright_rows.len() == 2);
    sequence.selected_row = 4;
    let surface: Surface = Surface::new(120, 24); let theme: Theme = Theme::dark_blue();
    sequence.paint(surface, area, theme); let body: Rect = sequence.body(area);
    let marked: Cell = surface.cell(0, body.y); let plain: Cell = surface.cell(0, body.y + 6);
    verify(marked.background > plain.background);
    var playback: NotePlayback = NotePlayback { start_row: 2 };
    playback.update(sequence, 30000, true); verify(playback.events.len() == 1);
    let first: NoteEvent = playback.events[0]; verify(first.note == 60 && first.tick == 30000);
    playback.update(sequence, 33750, true); verify(playback.events.len() == 1);
    let second: NoteEvent = playback.events[0]; verify(second.note == 62 && second.tick == 33750);
    sequence.cycle_vertical_zoom(area); sequence.cycle_vertical_zoom(area);
    sequence.mark_hidden_notes(); verify(sequence.bright_rows.len() == 0);
    // Whole-row selection includes hidden VEL/LEN/OFF and rebases OFF correctly.
    sequence.selected_row = 0; sequence.selected_subrow = 1; sequence.selected_column = 1;
    sequence.edit_event(decode_input("V"), area); sequence.edit_event(decode_input("y"), area);
    sequence.selected_row = 3; sequence.selected_subrow = 3; sequence.selected_column = 1;
    sequence.edit_event(decode_input("p"), area); verify(!sequence.paste_error);
    sequence.edit_event(decode_input("\r"), area); verify(sequence.editor.text == "C-4"); sequence.edit_event(decode_input("\r"), area);
    verify(sequence.rows.len() == 64);
    surface.release(); sequence.release();
}

#[test]
fn tui_subdivision_insert_delete_moves_only_one_visible_slot() {
    let area: Rect = Rect::new(0, 0, 120, 24);
    var sequence: SequenceTable = SequenceTable::empty(); sequence.create_track_kind(false, false, area);
    sequence.selected_row = 0; sequence.selected_column = 1;
    sequence.cycle_vertical_zoom(area); sequence.cycle_vertical_zoom(area);
    let pitches: list<str8> = ["C-4", "D-4", "E-4", "F-4", "G-4"];
    for pitch in pitches {
        sequence.edit_event(decode_input("\r"), area); sequence.editor.set_text(pitch); sequence.edit_event(decode_input("\r"), area);
        sequence.edit_event(decode_input("j"), area);
    }
    sequence.selected_row = 0; sequence.selected_subrow = 1;
    sequence.edit_event(decode_input("d"), area); sequence.edit_event(decode_input("d"), area);
    verify(sequence.rows.len() == 64 && sequence.selected_subrow == 1);
    let deleted: list<mlacker_ui::sequence::ViewNote> = sequence.view_notes(0);
    verify(deleted.len() == 4);
    for i in 0..4 { let note: mlacker_ui::sequence::ViewNote = deleted[i]; verify(note.slot == i); }
    sequence.edit_event(decode_input("\r"), area); verify(sequence.editor.text == "E-4"); sequence.edit_event(decode_input("\r"), area);
    sequence.edit_event(decode_input("o"), area);
    verify(sequence.selected_row == 0 && sequence.selected_subrow == 2);
    sequence.edit_event(decode_input("\r"), area); verify(sequence.editor.text == ""); sequence.edit_event(decode_input("\r"), area);
    let below: list<mlacker_ui::sequence::ViewNote> = sequence.view_notes(0);
    let moved: mlacker_ui::sequence::ViewNote = below[2]; verify(moved.slot == 3);
    sequence.edit_event(decode_input("O"), area);
    let above: list<mlacker_ui::sequence::ViewNote> = sequence.view_notes(0);
    let moved_again: mlacker_ui::sequence::ViewNote = above[2]; verify(moved_again.slot == 4);
    let last: mlacker_ui::sequence::ViewNote = above[3]; verify(last.slot == 5);
    verify(sequence.rows.len() == 64);
    // At 1/32, the edit step is two 1/64 positions.
    sequence.cycle_vertical_zoom(area); sequence.cycle_vertical_zoom(area);
    sequence.selected_row = 1; sequence.selected_subrow = 0;
    sequence.edit_event(decode_input("O"), area);
    sequence.cycle_vertical_zoom(area);
    let half: list<mlacker_ui::sequence::ViewNote> = sequence.view_notes(0);
    let shifted: mlacker_ui::sequence::ViewNote = half[2]; verify(shifted.slot == 6);
    // A final-slot insertion provides a new empty position without dropping notes.
    sequence.selected_row = 63; sequence.selected_subrow = 3;
    sequence.edit_event(decode_input("o"), area);
    verify(sequence.rows.len() == 65 && sequence.selected_row == 64 && sequence.selected_subrow == 0);
    sequence.release();
}

#[test]
fn tui_visual_boundary_selection_copy_and_backspace() {
    let area: Rect = Rect::new(0, 0, 120, 24);
    for zoom in 0..3 {
        var sequence: SequenceTable = SequenceTable::empty(); sequence.create_track_kind(false, false, area);
        sequence.set_length(4, area); sequence.selected_row = 0; sequence.selected_column = 1;
        for _i in 0..zoom { sequence.cycle_vertical_zoom(area); }
        sequence.edit_event(decode_input("\r"), area); sequence.editor.set_text("C-4"); sequence.edit_event(decode_input("\r"), area);
        sequence.edit_event(decode_input("G"), area);
        verify(sequence.selected_row == 3 && sequence.selected_subrow == sequence.row_spacing() - 1);
        sequence.edit_event(decode_input("\r"), area); sequence.editor.set_text("D-4"); sequence.edit_event(decode_input("\r"), area);
        sequence.edit_event(decode_input("g"), area); sequence.edit_event(decode_input("g"), area);
        verify(sequence.selected_row == 0 && sequence.selected_subrow == 0);
        sequence.edit_event(decode_input("v"), area); sequence.edit_event(decode_input("G"), area);
        verify(sequence.visual && sequence.anchor_row == 0 && sequence.anchor_subrow == 0);
        sequence.edit_event(decode_input("y"), area);
        verify(!sequence.visual && sequence.clipboard.len() == 4 * sequence.row_spacing());
        // Select backwards to the first subdivision, then clear without cutting.
        sequence.edit_event(decode_input("G"), area); sequence.edit_event(decode_input("v"), area);
        sequence.edit_event(decode_input("g"), area); sequence.edit_event(decode_input("g"), area);
        verify(sequence.visual && sequence.selected_row == 0 && sequence.selected_subrow == 0);
        sequence.edit_event(decode_input("\x7f"), area);
        verify(!sequence.visual && !sequence.paste_error && sequence.rows.len() == 4);
        let empty: list<mlacker_ui::sequence::ViewNote> = sequence.view_notes(0); verify(empty.len() == 0);
        verify(sequence.clipboard.len() == 4 * sequence.row_spacing());
        sequence.edit_event(decode_input("p"), area); verify(!sequence.paste_error);
        let restored: list<mlacker_ui::sequence::ViewNote> = sequence.view_notes(0); verify(restored.len() == 2);
        // v-G also works from a middle row without moving the anchor.
        sequence.selected_row = 1; sequence.selected_subrow = 0;
        sequence.edit_event(decode_input("v"), area); sequence.edit_event(decode_input("G"), area);
        verify(sequence.visual && sequence.anchor_row == 1);
        sequence.edit_event(decode_input("\x08"), area);
        let remaining: list<mlacker_ui::sequence::ViewNote> = sequence.view_notes(0); verify(remaining.len() == 1);
        sequence.release();
    }
}

#[test]
fn tui_sidebar_marks_and_pattern_snapshot() {
    var view: ListView = ListView { items: [ListItem { id: 4, label: "A" }, ListItem { id: 9, label: "B" }] };
    verify(view.toggle_mark()); view.selected = 1; verify(view.toggle_mark());
    let both: list<i32> = view.targets(); verify(both.len() == 2 && both[0] == 4 && both[1] == 9);
    verify(view.toggle_mark()); let one: list<i32> = view.targets(); verify(one.len() == 1 && one[0] == 4);
    var library: PatternLibrary = PatternLibrary::empty(); var audio: AudioSystem = AudioSystem {};
    let area: Rect = Rect::new(0, 0, 120, 24);
    library.table.create_track_kind(false, false, area);
    library.table.edit_event(decode_input("K"), area);
    var clipboard: SidebarClipboard = SidebarClipboard {};
    verify(clipboard.copy(library, audio) == 1);
    library.table.clear_row();
    let pasted: SidebarPaste = clipboard.paste(library, audio); library = pasted.library; audio = pasted.audio;
    verify(pasted.count == 1 && library.patterns.len() == 2);
    let name: str8 = library.active_name(); verify(name == "Untitled - 1");
    let row: TableRow = library.table.rows[0]; verify(row.cells[1] == "C-4");
    library.select(1); let original: TableRow = library.table.rows[0]; verify(original.cells[1] == "");
    clipboard.release(); library.release(); audio.release();
}

#[test]
fn tui_sidebar_audio_copy_is_numbered_lossless_and_exclusive() {
    let directory: str8 = clone("/private/tmp/mlacker-sidebar-test-XXXXXX"); mkdtemp(directory);
    let path: str8 = format!("{}/Kick - 4.wav", directory);
    let occupied: str8 = format!("{}/Kick - 5.wav", directory);
    let saved: result<i32, str8> = std::fs::write_all_text(occupied, "keep"); verify(saved.is_ok());
    var clip: AudioClip = test_clip(4000, 0.25f); free(clip.source); clip.source = clone(path);
    var library: PatternLibrary = PatternLibrary::empty(); var audio: AudioSystem = AudioSystem {};
    verify(library.audio.add_clip(clip) == 0); library.show_audio();
    var clipboard: SidebarClipboard = SidebarClipboard {}; verify(clipboard.copy(library, audio) == 1);
    let pasted: SidebarPaste = clipboard.paste(library, audio); library = pasted.library; audio = pasted.audio;
    verify(pasted.count == 1 && library.audio.samples.len() == 2);
    let expected: str8 = format!("{}/Kick - 6.wav", directory);
    let copy: AudioClip = library.audio.samples[1]; verify(copy.source == expected);
    let decoded: result<AudioClip, str8> = AudioClip::load(expected, 120); verify(decoded.is_ok());
    let wave: AudioClip = decoded.unwrap(); verify(wave.channels == 1 && wave.sample_rate == 8000 && wave.frames == 4000);
    for i in 0..wave.samples.len() { verify(wave.samples[i] == copy.samples[i]); }
    let opened: result<std::fs::File, str8> = std::fs::File::open(occupied); let file: std::fs::File = opened.unwrap();
    let size: result<i64, str8> = file.size(); verify(size.unwrap() == 4); file.close();
    wave.release(); clipboard.release(); library.release(); audio.release();
    std::fs::remove_tree(directory); free(path); free(occupied); free(expected); free(directory);
}

fn spectrum_red(color: i32) -> i32 { return (color >> 16) & 255; }

fn spectrum_green(color: i32) -> i32 { return (color >> 8) & 255; }

fn spectrum_blue(color: i32) -> i32 { return color & 255; }

#[test]
fn test_spectrum_gradient_stops() {
    verify(spectrum_color(0) == 0x4B32C8);     // indigo floor
    verify(spectrum_color(430) == 0x28DC8C);   // green in the middle
    verify(spectrum_color(670) == 0xFFD84A);   // yellow
    verify(spectrum_color(1000) == 0xFF5CD2);  // magenta at 0 dBFS
    verify(spectrum_color(-50) == spectrum_color(0) && spectrum_color(2000) == spectrum_color(1000));
}

#[test]
fn test_spectrum_gradient_is_smooth_and_varied() {
    // Neighbouring levels never jump by more than a small step per channel,
    // and the lower half is not all one hue.
    var previous: i32 = spectrum_color(0);
    for level in 1..1001 {
        let color: i32 = spectrum_color(i32(level));
        let dr: i32 = spectrum_red(color) - spectrum_red(previous); let dg: i32 = spectrum_green(color) - spectrum_green(previous); let db: i32 = spectrum_blue(color) - spectrum_blue(previous);
        verify(dr < 4 && dr > -4 && dg < 4 && dg > -4 && db < 4 && db > -4);
        previous = color;
    }
    verify(spectrum_blue(spectrum_color(100)) > spectrum_green(spectrum_color(100)));
    verify(spectrum_green(spectrum_color(450)) > spectrum_blue(spectrum_color(450)));
    verify(spectrum_red(spectrum_color(850)) > spectrum_green(spectrum_color(850)));
}

fn loop_test_library() -> PatternLibrary {
    // Pattern 1: 16 rows (C-2 on row 0); pattern 2: 64 rows (E-2 on row 32);
    // pattern 3: 16 rows (G-2 on row 0). A 16-row matrix grid, six song rows.
    var library: PatternLibrary = PatternLibrary::empty();
    let area: Rect = Rect::new(0, 0, 120, 20);
    library.table.create_track_kind(false, false, area);
    library.table.set_length(16, area);
    library.table.set_cell(0, 1, clone("C-2")); library.table.set_cell(0, 2, clone("100"));
    library.add(false); library.table.create_track_kind(false, false, area); library.table.set_length(64, area);
    library.table.set_cell(32, 1, clone("E-2")); library.table.set_cell(32, 2, clone("100"));
    library.add(false); library.table.create_track_kind(false, false, area); library.table.set_length(16, area);
    library.table.set_cell(0, 1, clone("G-2")); library.table.set_cell(0, 2, clone("100"));
    library.matrix_steps = 16;
    while library.song.len() < 6 { library.matrix_insert_row(i32(library.song.len()) - 1, true); }
    for r in 0..library.song.len() { library.set_song_at(i32(r), 0, 0); }
    return library;
}

#[test]
fn tui_matrix_loop_repeats_until_the_next_pattern() {
    var library: PatternLibrary = loop_test_library();
    let area: Rect = Rect::new(0, 0, 120, 20);
    verify(library.set_song_at(0, 0, 1) && library.set_song_at(0, 1, 2));
    // Without looping the short pattern plays its one row only.
    let once: SongCover = library.song_cover(1, 0);
    verify(once.id == 0);
    // Looping repeats it down the lane, beside the long pattern.
    verify(library.toggle_song_loop(0, 0) == 0 && library.song_loops(0, 0));
    for r in 1..6 {
        let cover: SongCover = library.song_cover(i32(r), 0);
        verify(cover.id == 1 && cover.offset == i32(r) && library.song_loop_repeat(i32(r), 0));
        verify(!library.song_continues(i32(r), 0));
    }
    // Matrix row 3 mixes the loop repeat with the long pattern's third quarter.
    var third: SequenceTable = library.merge_song_row(2, area, false);
    verify(third.rows.len() == 16 && third.tracks.len() >= 2);
    let top: TableRow = third.rows[0];
    verify(top.cells[third.track_start(0)] == "C-2" && top.cells[third.track_start(1)] == "E-2");
    third.release();
    // Toggling from a repeat row switches the loop of the pattern above.
    verify(library.toggle_song_loop(3, 0) == 0 && !library.song_loops(0, 0));
    verify(library.toggle_song_loop(3, 0) == -1);
    verify(library.toggle_song_loop(0, 0) == 0);
    // A pattern placed on a repeat takes over from there.
    verify(library.set_song_at(3, 0, 3));
    let taken: SongCover = library.song_cover(3, 0);
    verify(taken.id == 3 && taken.offset == 0);
    let still: SongCover = library.song_cover(2, 0);
    verify(still.id == 1);
    let after: SongCover = library.song_cover(4, 0);
    verify(after.id == 0);
    library.release();
}

#[test]
fn tui_matrix_split_ends_loops_and_long_patterns() {
    var library: PatternLibrary = loop_test_library();
    verify(library.set_song_at(0, 0, 1) && library.set_song_at(0, 1, 2));
    library.toggle_song_loop(0, 0);
    // Splitting a repeat silences the lane from there; the first row keeps it.
    verify(library.split_song(3, 0) && library.song_split(3, 0));
    let before: SongCover = library.song_cover(2, 0);
    verify(before.id == 1);
    for r in 3..6 { let cover: SongCover = library.song_cover(i32(r), 0); verify(cover.id == 0); }
    // Nothing to split where nothing runs, or where a pattern starts.
    verify(!library.split_song(3, 0) && !library.split_song(0, 0));
    // Removing the split lets the loop run on again.
    verify(library.set_song_raw(3, 0, 0) && !library.song_split(3, 0));
    let resumed: SongCover = library.song_cover(5, 0);
    verify(resumed.id == 1);
    // A long pattern can be cut short the same way.
    verify(library.split_song(2, 1));
    let cut: SongCover = library.song_cover(2, 1);
    verify(cut.id == 0);
    let kept: SongCover = library.song_cover(1, 1);
    verify(kept.id == 2 && kept.offset == 1);
    library.release();
}

#[test]
fn tui_matrix_loops_move_with_rows_and_survive_a_session() {
    var library: PatternLibrary = loop_test_library();
    verify(library.set_song_at(1, 0, 1) && library.set_song_at(0, 1, 3));
    library.toggle_song_loop(1, 0); library.split_song(4, 0);
    // A row inserted above moves the loop and its split with their cells.
    verify(library.matrix_insert_row(0, false));
    verify(library.song_loops(2, 0) && library.song_split(5, 0) && library.song_at(2, 0) == 1);
    // Shifting one lane down moves them too.
    verify(library.matrix_insert_cell(0, 0, false));
    verify(library.song_loops(3, 0) && library.song_split(6, 0));
    let directory: str8 = clone("/private/tmp/mlacker-loop-test-XXXXXX"); mkdtemp(directory);
    let path: str8 = format!("{}/loops.mlack", directory);
    var audio: AudioSystem = AudioSystem {}; var codec: SessionCodec = SessionCodec {};
    verify(codec.save(path, library, SessionView {}, audio));
    let loaded: result<SessionData, str8> = SessionCodec::load(path); verify(loaded.is_ok());
    var restored: SessionData = loaded.unwrap();
    verify(restored.library.song_loops(3, 0) && restored.library.song_split(6, 0));
    verify(restored.library.song_at(3, 0) == 1 && restored.library.song_at(1, 1) == 3);
    let repeat: SongCover = restored.library.song_cover(5, 0);
    verify(repeat.id == 1 && repeat.offset == 2);
    restored.release();
    // Removing the pattern removes its loop.
    library.select(1); library.remove_active(Rect::new(0, 0, 120, 20));
    verify(!library.has_song_loops() || library.song_split(5, 0));
    library.release(); std::fs::remove_tree(directory); free(path); free(directory);
}

#[test]
fn tui_matrix_loop_keys() {
    var matrix: SongMatrix = SongMatrix { visible: true };
    verify(matrix.on_event(decode_input("r"), 2, 3) == 10);
    verify(matrix.on_event(decode_input("s"), 2, 3) == 11);
}

#[test]
fn tui_matrix_parallel_lane_keeps_every_note_line() {
    // Lane 2 holds a chord track (three note lines and a CC value); merging
    // it beside lane 1 must keep all of them, not just the first line.
    var library: PatternLibrary = loop_test_library();
    let area: Rect = Rect::new(0, 0, 120, 20);
    library.select(2);
    verify(library.table.ensure_note_lines(0, 3));
    library.table.rebuild_columns();
    let start: i32 = library.table.track_start(0);
    library.table.set_cell(0, start + 4, clone("E-3")); library.table.set_cell(0, start + 5, clone("90"));
    library.table.set_cell(0, start + 8, clone("G-3")); library.table.set_cell(0, start + 9, clone("80"));
    let automation: i32 = library.table.automation_column(0, 1);
    library.table.set_cell(0, automation, clone("64"));
    library.select(1);
    verify(library.set_song_at(0, 0, 1) && library.set_song_at(0, 1, 2));
    var merged: SequenceTable = library.merge_song_row(0, area, false);
    // Lane 1 brings its tracks first; lane 2's chord track follows them.
    let lead: PatternEntry = library.patterns[library.index_of(1)];
    let chord: i32 = i32(lead.data.tracks.len());
    let track: SequenceTrack = merged.tracks[chord];
    verify(track.note_lines == 3);
    let first: i32 = merged.track_start(chord);
    let row: TableRow = merged.rows[0];
    verify(row.cells[first + 4] == "E-3" && row.cells[first + 5] == "90");
    verify(row.cells[first + 8] == "G-3" && row.cells[first + 9] == "80");
    verify(row.cells[merged.automation_column(chord, 1)] == "64");
    merged.release(); library.release();
}

fn playback_test_table(rows: i32, row: i32, note: str8, length: str8) -> SequenceTable {
    let area: Rect = Rect::new(0, 0, 120, 20);
    var table: SequenceTable = SequenceTable::new();
    for r in 0..64 { table.selected_row = i32(r); table.clear_row(); }
    table.selected_row = 0;
    table.set_length(rows, area);
    if note != "" {
        table.set_cell(row, 1, clone(note)); table.set_cell(row, 2, clone("100"));
        if length != "" { table.set_cell(row, 3, clone(length)); }
    }
    return table;
}

#[test]
fn tui_prepared_matrix_row_plays_like_a_fresh_one() {
    // The next matrix row's score, built ahead with the row change tick as
    // its epoch, fires the same notes at the same ticks as one built there.
    var next: SequenceTable = playback_test_table(16, 0, "C-2", "");
    next.set_cell(4, 1, clone("D-2")); next.set_cell(4, 2, clone("90"));
    let boundary: i64 = 16 * 15000;
    var fresh: NotePlayback = NotePlayback { start_row: 0 };
    var early: NotePlayback = NotePlayback {};
    early.prepare(next, boundary);
    verify(early.next_event_tick() == boundary);
    var tick: i64 = boundary;
    var fresh_notes: i32 = 0; var early_notes: i32 = 0;
    while tick < boundary + 16 * 15000 {
        fresh.update(next, tick, true); early.update(next, tick, true);
        verify(fresh.events.len() == early.events.len());
        for i in 0..fresh.events.len() {
            let a: NoteEvent = fresh.events[i]; let b: NoteEvent = early.events[i];
            verify(a.on == b.on && a.note == b.note && a.tick == b.tick);
            if a.on == 1 { fresh_notes = fresh_notes + 1; early_notes = early_notes + 1; }
        }
        tick = tick + 5000;
    }
    verify(fresh_notes == 2 && early_notes == 2);
    next.release();
}

#[test]
fn tui_looped_pattern_plays_its_last_pass_once() {
    // A pattern already looping gets another one queued behind it: its
    // current pass still plays, and nothing past that pass is sent ahead.
    var table: SequenceTable = playback_test_table(16, 4, "C-2", "");
    let period: i64 = 16 * 15000;
    var playback: NotePlayback = NotePlayback { start_row: 0 };
    playback.lookahead = 30000;
    var tick: i64 = 0;
    while tick < period { playback.update(table, tick, true); tick = tick + 5000; }
    playback.once = true;
    var played: bool = false; var past: bool = false;
    while tick < 2 * period {
        playback.update(table, tick, true);
        if has_note_on(playback, period + 60000) { played = true; }
        let events: list<NoteEvent> = playback.events;
        for event in events { if event.tick >= 2 * period { past = true; } }
        tick = tick + 5000;
    }
    verify(played && !past);
    table.release();
}

fn has_note_on(source: &NotePlayback, tick: i64) -> bool {
    var playback: NotePlayback = NotePlayback {}; playback = source;
    let events: list<NoteEvent> = playback.events;
    for event in events { if event.on == 1 && event.tick == tick { return true; } }
    return false;
}

#[test]
fn tui_playback_sends_notes_ahead() {
    // Notes on row 0 and row 4 (tick 60000) of a 16-row pattern.
    var table: SequenceTable = playback_test_table(16, 4, "C-2", "");
    table.set_cell(0, 1, clone("D-2")); table.set_cell(0, 2, clone("90"));
    // Without lookahead a note goes out once the transport reaches it.
    var plain: NotePlayback = NotePlayback { start_row: 0 };
    plain.update(table, 0, true); verify(has_note_on(plain, 0));
    plain.update(table, 55000, true); verify(!has_note_on(plain, 60000));
    plain.update(table, 60000, true); verify(has_note_on(plain, 60000));
    // 60 ms ahead at 120 BPM (7200 ticks), it goes out early, and only once.
    var ahead: NotePlayback = NotePlayback { start_row: 0, lookahead: 7200 };
    ahead.update(table, 0, true); verify(has_note_on(ahead, 0));
    ahead.update(table, 55000, true); verify(has_note_on(ahead, 60000));
    ahead.update(table, 60000, true); verify(!has_note_on(ahead, 60000));
    // A pattern loops into its next pass ahead; a matrix row stops at its end.
    ahead.update(table, 235000, true); verify(has_note_on(ahead, 240000));
    var row: NotePlayback = NotePlayback { start_row: 0, lookahead: 7200, once: true };
    row.update(table, 0, true); row.update(table, 235000, true); verify(!has_note_on(row, 240000));
    // The next row, prepared ahead, sends its first notes before the change.
    var next: NotePlayback = NotePlayback {};
    next.prepare(table, 240000); next.lookahead = 7200; next.once = true;
    next.update(table, 230000, true); verify(next.events.len() == 0 && !next.started());
    next.update(table, 235000, true); verify(has_note_on(next, 240000) && next.started());
    next.update(table, 240000, true); verify(!has_note_on(next, 240000));
    table.release();
}

#[test]
fn tui_sequencer_ticks_map_to_audio_frames() {
    // 120 BPM is 120000 ticks a second: one second after the anchor tick is
    // one second of frames after the anchor frame.
    let audio: AudioSystem = AudioSystem { scheduling: true, schedule_tick: 15000, schedule_frame: 48000,
        schedule_bpm: 120, schedule_rate: 48000 };
    verify(audio.frame_of(15000) == 48000 && audio.frame_of(135000) == 96000 && audio.frame_of(16500) == 48600);
    verify(audio.lookahead_ticks(120) == 7200);
    // No hardware output, no stamps: notes are sent as they fall due.
    var idle: AudioSystem = AudioSystem {};
    idle.schedule_transport(0, 120, true);
    verify(!idle.scheduling && idle.lookahead_ticks(120) == 0);
}

#[test]
fn tui_matrix_row_change_ends_held_notes() {
    // A note with LEN 8 on row 12 of a 16-row matrix row outlasts the row by
    // four rows. The next row's playback takes it over and sends its note-off.
    var first: SequenceTable = playback_test_table(16, 12, "C-2", "8.00");
    var second: SequenceTable = playback_test_table(16, 0, "", "");
    var playing: NotePlayback = NotePlayback { start_row: 0 };
    var tick: i64 = 0;
    while tick < 16 * 15000 { playing.update(first, tick, true); tick = tick + 5000; }
    let held: NoteEvent = NoteEvent { tick: -1 };
    verify(playing.next_event_tick() == 20 * 15000);
    var next: NotePlayback = NotePlayback {};
    next.prepare(second, 16 * 15000);
    next.carry_voices(playing);
    var off_tick: i64 = -1;
    while tick <= 24 * 15000 {
        next.update(second, tick, true);
        let events: list<NoteEvent> = next.events;
        for event in events { if event.on == 0 && event.note == 36 { off_tick = event.tick; } }
        tick = tick + 5000;
    }
    verify(off_tick == 20 * 15000 && held.tick == -1);
    first.release(); second.release();
}

fn decode_input(text: str8) -> InputEvent {
    var decoder: InputDecoder = InputDecoder::new();
    let result: result<Bytes, str8> = Bytes::from_string(text);
    let bytes: Bytes = result.unwrap();
    var event: InputEvent = InputEvent { kind: InputKind::None, key: Key::Escape };
    for i in 0..bytes.len() { event = decoder.feed(bytes.get(i)); }
    bytes.close();
    return event;
}

mod mlacker_ui::audio_take;
use mlacker_ui::audio_take::AudioTake;

#[test]
fn audio_take_records_the_live_input_onto_an_armed_audio_track() {
    var table: SequenceTable = SequenceTable::new();
    let area: Rect = Rect::new(0, 0, 120, 20);
    table.create_track_kind(false, true, area);
    let track: i32 = i32(table.tracks.len()) - 1;
    verify_eq_i32(-1, table.armed_audio_track());
    // AUDIO tracks arm now: they record the audio input.
    verify(table.set_record_armed(track, true));
    verify_eq_i32(track, table.armed_audio_track());
    let opened: result<AudioController, str8> = AudioController::new(8000, 128);
    let output: AudioController = opened.unwrap();
    let allocated: result<PcmBlock, str8> = PcmBlock::new(1024); let block: PcmBlock = allocated.unwrap();
    var take: AudioTake = AudioTake::begin(track, 2);
    verify(take.active());
    // Before the count-in ends nothing records.
    take.capture(output, false, -1);
    verify(!take.started);
    let latency: i64 = output.record_latency();
    verify(latency > 0 && latency < 1024);
    take.capture(output, true, 0);
    verify(take.started);
    for _b in 0..8 {
        var chunk: list<f32> = [];
        for _i in 0..1024 { chunk.push(0.5f); }
        verify(output.input_feed(chunk, 1, 8000) == 0);
        verify(output.process(block, 1024) == 0);
        take.capture(output, true, 0);
    }
    let finished: result<AudioClip, str8> = take.finish(output, "Recording 1.wav", 120);
    verify(finished.is_ok());
    verify(!take.active());
    let clip: AudioClip = finished.unwrap();
    // Recording starts `latency` frames into the stream, so it lines up with
    // what output frame 0 played; the input reader primes on its second block.
    verify_eq_i64(8192 - latency, clip.frames);
    verify_eq_i64(2, clip.channels);
    verify_eq(0.5f, clip.samples[clip.samples.len() - 1]);
    verify_eq(0.0f, clip.samples[0]);
    verify(table.place_audio(track, 2, clip, area));
    let placed: SequenceTrack = table.tracks[track];
    verify_eq_i64(1, placed.instances.len());
    let instance: AudioInstance = placed.instances[0];
    verify_eq_i32(2, instance.start_row);
    // A second take over the same rows does not fit there.
    verify(!table.place_audio(track, 3, clip, area));
    // A take stopped before it started records nothing.
    var empty: AudioTake = AudioTake::begin(track, 0);
    let nothing: result<AudioClip, str8> = empty.finish(output, "Recording 2.wav", 120);
    verify(nothing.is_err());
    block.close(); output.close(); clip.release(); table.release();
}

#[test]
fn audio_input_monitor_plays_the_live_input_through_its_track() {
    let opened: result<AudioController, str8> = AudioController::new(8000, 128);
    let output: AudioController = opened.unwrap();
    let allocated: result<PcmBlock, str8> = PcmBlock::new(1024); let block: PcmBlock = allocated.unwrap();
    verify(output.input_monitor(0, true) == -1 && output.input_monitor(65, true) == -1);
    // Not monitored: the input is silent on the output.
    var loud: f32 = 0.0f;
    for _b in 0..4 {
        var chunk: list<f32> = []; for _i in 0..1024 { chunk.push(0.5f); }
        verify(output.input_feed(chunk, 1, 8000) == 0);
        verify(output.process(block, 1024) == 0);
        if block.left(1000) > loud { loud = block.left(1000); }
    }
    verify(loud == 0.0f);
    // Track 1 monitors it: the input plays through its fader.
    verify(output.input_monitor(1, true) == 0);
    for _b in 0..4 {
        var chunk: list<f32> = []; for _i in 0..1024 { chunk.push(0.5f); }
        output.input_feed(chunk, 1, 8000); output.process(block, 1024);
    }
    // The track carries the input at full level (peak 0.5); the output has
    // the controller's master gain (0.25) on top, as clips do.
    verify(output.track_peak(0, 0) == 500 && block.left(1000) == 0.125f && block.right(1000) == 0.125f);
    output.track_volume(0, 0, 50);
    var chunk: list<f32> = []; for _i in 0..1024 { chunk.push(0.5f); }
    output.input_feed(chunk, 1, 8000); output.process(block, 1024);
    verify(output.track_peak(0, 0) == 250 && block.left(1000) == 0.0625f);
    // Off again: silence.
    verify(output.input_monitor(1, false) == 0);
    var rest: list<f32> = []; for _i in 0..1024 { rest.push(0.5f); }
    output.input_feed(rest, 1, 8000); output.process(block, 1024);
    verify(block.left(1000) == 0.0f);
    block.close(); output.close();
}

#[test]
fn input_and_record_arming_show_in_the_track_header() {
    var table: SequenceTable = SequenceTable::new();
    let area: Rect = Rect::new(0, 0, 120, 20);
    table.create_track_kind(false, true, area);
    table.create_track_kind(false, true, area);
    let first: i32 = i32(table.tracks.len()) - 2; let second: i32 = first + 1;
    // Only AUDIO tracks take the input.
    verify(!table.set_input_armed(0, true));
    verify(table.set_input_armed(first, true));
    verify(table.set_record_armed(first, true) && table.set_record_armed(second, true));
    let armed: list<i32> = table.armed_audio_tracks();
    verify(armed.len() == 2 && armed[0] == first && armed[1] == second);
    let surface: Surface = Surface::new(120, 20); let theme: Theme = Theme::dark_blue();
    table.paint(surface, area, theme); table.paint_arm_marks(surface, area, theme);
    // In the header row, at the right edge of each track's columns: A and R
    // for the first track, R for the second.
    let group: TableGroup = table.groups[first];
    var width: i32 = 0; for c in group.first..group.first + group.count { width = width + table.column_width(i32(c)); }
    let right: i32 = table.column_x(group.first) + width - 1;
    let r_cell: Cell = surface.cell(right, 0); let a_cell: Cell = surface.cell(right - 1, 0);
    verify(r_cell.glyph == 82 && r_cell.background == 0xC02030 && a_cell.glyph == 65 && a_cell.background == 0xC02030);
    let other: TableGroup = table.groups[second];
    var other_width: i32 = 0; for c in other.first..other.first + other.count { other_width = other_width + table.column_width(i32(c)); }
    let other_right: i32 = table.column_x(other.first) + other_width - 1;
    let only_r: Cell = surface.cell(other_right, 0); let beside: Cell = surface.cell(other_right - 1, 0);
    verify(only_r.glyph == 82 && beside.glyph != 65);
    // A take is placed on every armed AUDIO track.
    let take: AudioTake = AudioTake::begin_all(armed, 3);
    verify(take.track == first && take.tracks.len() == 2 && take.row == 3);
    surface.release(); table.release();
}

mod mlacker_ui::bounce;
use mlacker_ui::bounce::Bounce;

#[test]
fn bounce_renders_selected_rows_offline() {
    var table: SequenceTable = SequenceTable::new();
    let area: Rect = Rect::new(0, 0, 120, 20);
    table.create_track_kind(false, true, area);
    let track: i32 = i32(table.tracks.len()) - 1;
    // 4 rows of a constant clip from row 1 (1000 frames per row at 8 kHz, 120 BPM).
    var clip: AudioClip = AudioClip { source: clone("embedded.wav"), channels: 2, sample_rate: 8000, frames: 4000, frames_per_row: 1000 };
    for _i in 0..4000 { clip.samples.push(0.5f); clip.samples.push(0.25f); }
    for _i in 0..4 { clip.peaks.push(WavePeak { left: 500, right: 250 }); }
    table.selected_row = 1; verify(table.insert_audio(clip, area));
    let opened: result<AudioController, str8> = AudioController::new(8000, 128);
    var audio: AudioSystem = AudioSystem {}; audio.output = opened.unwrap();
    // Rows 2-3 (index 1 and 2): 2000 frames of the clip through the master
    // gain (0.25), then a quiet tail that is trimmed.
    var job: Bounce = audio.bounce_begin(120);
    verify(job.ok());
    // The demo MIDI tracks would add the preview tone: bounce only the clip's.
    audio.bounce_segment(&mut job, table, 1, 3, [track]);
    let rendered: list<f32> = audio.bounce_finish(&mut job, table, 2);
    let frames: i64 = rendered.len() / 2;
    verify(frames >= 2000 && frames <= 2000 + 128);
    verify_eq(0.125f, rendered[1000 * 2]);
    verify_eq(0.0625f, rendered[1000 * 2 + 1]);
    verify(!audio.scheduling);
    // Only the tracks listed play: leaving the clip's track out is silence.
    var other: Bounce = audio.bounce_begin(120);
    // (The demo MIDI tracks would play the preview tone: keep only a second,
    // empty AUDIO track.)
    table.create_track_kind(false, true, area);
    var tracks: list<i32> = [i32(table.tracks.len()) - 1];
    verify(tracks[0] != track);
    audio.bounce_segment(&mut other, table, 1, 3, tracks);
    let silent: list<f32> = audio.bounce_finish(&mut other, table, 2);
    var loudest: f32 = 0.0f;
    for v in silent { if v > loudest { loudest = v; } }
    verify_eq(0.0f, loudest);
    verify(silent.len() / 2 >= 2000);
    // Two segments follow each other without a gap.
    var joined: Bounce = audio.bounce_begin(120);
    audio.bounce_segment(&mut joined, table, 1, 2, [track]);
    audio.bounce_segment(&mut joined, table, 2, 3, [track]);
    let both: list<f32> = audio.bounce_finish(&mut joined, table, 2);
    verify(both.len() / 2 >= 2000);
    verify_eq(0.125f, both[990 * 2]);
    verify_eq(0.125f, both[1010 * 2]);
    // No audio: the bounce explains instead of rendering.
    var none: AudioSystem = AudioSystem {};
    let refused: Bounce = none.bounce_begin(120);
    verify(!refused.ok());
    audio.release(); table.release(); clip.release();
}

#[test]
fn bounce_tail_and_second_pass() {
    var table: SequenceTable = SequenceTable::new();
    let area: Rect = Rect::new(0, 0, 120, 20);
    table.create_track_kind(false, true, area);
    let track: i32 = i32(table.tracks.len()) - 1;
    // A clip on rows 2-5: rows 1-4 of the area hold silence, then the clip.
    var clip: AudioClip = AudioClip { source: clone("embedded.wav"), channels: 2, sample_rate: 8000, frames: 4000, frames_per_row: 1000 };
    for i in 0..4000 { clip.samples.push(0.5f * f32(i % 100) / 100.0f); clip.samples.push(0.25f); }
    for _i in 0..4 { clip.peaks.push(WavePeak { left: 500, right: 250 }); }
    table.selected_row = 2; verify(table.insert_audio(clip, area));
    let opened: result<AudioController, str8> = AudioController::new(8000, 128);
    var audio: AudioSystem = AudioSystem {}; audio.output = opened.unwrap();
    // No tail: exactly the area (rows 1-4 = 4000 frames, rounded up to a block).
    var single: Bounce = audio.bounce_begin(120);
    audio.bounce_segment(&mut single, table, 0, 4, [track]);
    let one: list<f32> = audio.bounce_finish(&mut single, table, 0);
    verify(one.len() / 2 >= 4000 && one.len() / 2 < 4000 + 64);
    // The clip starts on its exact frame (row 2 = frame 2000), from its first
    // sample, not on a block boundary: past its 3 ms (24-frame) fade-in,
    // frame 2030 carries ramp value 30 (0.15 through the 0.25 master gain).
    verify_eq(0.0f, one[1999 * 2]);
    verify(one[2001 * 2] > 0.0f);
    verify_eq(0.0375f, one[2030 * 2]);
    verify_eq(0.0625f, one[2030 * 2 + 1]);
    // Second pass: the same area again with nothing reset; only pass two is
    // kept, aligned to the area's start like a single pass.
    var twice: Bounce = audio.bounce_begin(120);
    audio.bounce_segment(&mut twice, table, 0, 4, [track]);
    audio.bounce_next_pass(&mut twice);
    audio.bounce_segment(&mut twice, table, 0, 4, [track]);
    let two: list<f32> = audio.bounce_finish(&mut twice, table, 0);
    verify(two.len() / 2 >= 4000 && two.len() / 2 < 4000 + 128);
    // The clip is stateless, so pass two sounds like pass one.
    for f in 1990..2100 { verify_eq(one[f * 2], two[f * 2]); }
    verify_eq(0.0f, two[1000 * 2]);
    verify(two[2050 * 2] > 0.0f);
    verify(!audio.scheduling);
    audio.release(); table.release(); clip.release();
}

#[test]
fn tui_comment_column_speaks_with_notes() {
    let area: Rect = Rect::new(0, 0, 160, 20);
    var table: SequenceTable = SequenceTable::new();
    for r in 0..64 { table.selected_row = i32(r); table.clear_row(); }
    table.create_instrument_track(1, area);
    let before: i32 = i32(table.columns.len());
    table.selected_column = table.track_start(3);
    table.track_action(Action::ToggleCommentColumn, area);
    // After the note line and the CC column, shown and selected.
    let column: i32 = table.comment_column(3);
    verify(i32(table.columns.len()) == before + 1);
    verify(column == table.track_start(3) + 5 && table.is_comment());
    let shown: TableColumn = table.columns[column]; verify(shown.title == "TEXT" && !shown.hidden);
    // A CC column added later goes before it.
    verify(table.add_automation(3, "cc:74") == 2);
    verify(table.comment_column(3) == column + 1);
    table.selected_row = 0; table.selected_column = table.comment_column(3);
    table.edit_event(decode_input("\r"), area); table.editor.set_text("Hello world"); table.edit_event(decode_input("\r"), area);
    table.selected_row = 4;
    table.edit_event(decode_input("\r"), area); table.editor.set_text("Atari"); table.edit_event(decode_input("\r"), area);
    let first_row: TableRow = table.rows[0]; verify(first_row.cells[table.comment_column(3)] == "Hello world");
    table.set_cell(0, table.track_start(3), clone("C-4")); table.set_cell(0, table.track_start(3) + 1, clone("90"));
    table.revision = table.revision + 1;
    // Collapsed tracks hide it; the third column stage shows it.
    table.zoom_tracks(0, true, area);
    let hidden: TableColumn = table.columns[table.comment_column(3)]; verify(hidden.hidden);
    table.zoom_tracks(1, true, area);
    let still: TableColumn = table.columns[table.comment_column(3)]; verify(still.hidden);
    table.zoom_tracks(2, true, area);
    let again: TableColumn = table.columns[table.comment_column(3)]; verify(!again.hidden);
    // Row 0's text goes with its note; row 4's has no note and speaks at C-3.
    var playback: NotePlayback = NotePlayback { start_row: 0 };
    playback.update(table, 0, true);
    verify(playback.events.len() == 1);
    let first: NoteEvent = playback.events[0];
    verify(first.on == 1 && first.text == 1 && first.note == 60 && first.instrument == 1);
    playback.update(table, 4 * 15000, true);
    var spoken: bool = false;
    let events: list<NoteEvent> = playback.events;
    for event in events { if event.on == 1 && event.text == 5 && event.note == speech_note() && event.instrument == 1 { spoken = true; } }
    verify(spoken);
    // Pattern files keep the column and its texts.
    let directory: str8 = clone("/private/tmp/mlacker-comment-test-XXXXXX"); mkdtemp(directory);
    let path: str8 = format!("{}/comment.mlapatt", directory);
    var holder: PatternLibrary = PatternLibrary::empty(); holder.table.release(); holder.table = table.copy_pattern();
    verify(SessionCodec::save_pattern(path, "Words", holder.table));
    let loaded: result<mlacker_ui::session::PatternData, str8> = SessionCodec::load_pattern(path); verify(loaded.is_ok());
    let data: mlacker_ui::session::PatternData = loaded.unwrap();
    let loaded_track: SequenceTrack = data.table.tracks[3]; verify(loaded_track.comment);
    let loaded_row: TableRow = data.table.rows[4]; verify(loaded_row.cells[data.table.comment_column(3)] == "Atari");
    data.release(); holder.release(); std::fs::remove_tree(directory); free(path); free(directory);
    // A MIDI track's text is only a comment: nothing to speak.
    table.selected_column = table.track_start(0); table.track_action(Action::ToggleCommentColumn, area);
    table.set_cell(8, table.comment_column(0), clone("just a note to self"));
    table.revision = table.revision + 1;
    var quiet: NotePlayback = NotePlayback { start_row: 0 };
    quiet.update(table, 8 * 15000, true);
    let quiet_events: list<NoteEvent> = quiet.events;
    for event in quiet_events { verify(event.track != 0); }
    // Too long a text is refused; removing the column drops its texts.
    table.selected_column = table.comment_column(3); table.selected_row = 2;
    table.edit_event(decode_input("\r"), area);
    var long: str8 = clone("");
    for _i in 0..25 { let next: str8 = format!("{}0123456789", long); free(long); long = next; }
    table.editor.set_text(long); free(long);
    table.edit_event(decode_input("\r"), area); verify(table.editing && table.error != "");
    table.editing = false;
    table.selected_column = table.comment_column(3); table.track_action(Action::ToggleCommentColumn, area);
    verify(table.comment_column(3) == -1);
    table.release();
}

fn sysex_edit(table: &mut SequenceTable, row: i32, column: i32, value: str8, area: Rect) -> void {
    table.selected_row = row; table.selected_column = column;
    table.edit_event(decode_input("\r"), area); table.editor.set_text(value); table.edit_event(decode_input("\r"), area);
}

#[test]
fn tui_sysex_columns_send_messages() {
    let area: Rect = Rect::new(0, 0, 160, 20);
    var table: SequenceTable = SequenceTable::new();
    for r in 0..64 { table.selected_row = i32(r); table.clear_row(); }
    table.create_instrument_track(1, area);
    let before: i32 = i32(table.columns.len());
    table.selected_column = table.track_start(3);
    table.track_action(Action::ToggleSysExColumns, area);
    // ID and SYSEX after the note line and the CC column, shown, ID selected.
    let id: i32 = table.sysex_column(3);
    verify(i32(table.columns.len()) == before + 2);
    verify(id == table.track_start(3) + 5 && table.is_sysex_id());
    let id_column: TableColumn = table.columns[id]; verify(id_column.title == "ID" && !id_column.hidden);
    let data_column: TableColumn = table.columns[id + 1]; verify(data_column.title == "SYSEX" && !data_column.hidden);
    // A CC column added later goes before them, a TEXT column after them.
    verify(table.add_automation(3, "cc:74") == 2);
    verify(table.sysex_column(3) == id + 1);
    table.selected_column = table.track_start(3); table.track_action(Action::ToggleCommentColumn, area);
    verify(table.comment_column(3) == table.sysex_column(3) + 2);
    let sysex: i32 = table.sysex_column(3);
    // Hex bytes are stored upper case; status bytes and odd digits are refused.
    sysex_edit(&mut table, 0, sysex, "43 1a", area);
    let first_row: TableRow = table.rows[0]; verify(first_row.cells[sysex] == "43 1A" && table.error == "");
    sysex_edit(&mut table, 0, sysex + 1, "4c 00 00 7e 00", area);
    let filled: TableRow = table.rows[0]; verify(filled.cells[sysex + 1] == "4C 00 00 7E 00");
    sysex_edit(&mut table, 2, sysex + 1, "F0 43", area); verify(table.editing && table.error != ""); table.editing = false;
    sysex_edit(&mut table, 2, sysex, "43 10 1 2", area); verify(table.editing && table.error != ""); table.editing = false;
    // The ID carries down to rows below it until another one is set.
    sysex_edit(&mut table, 4, sysex + 1, "01 02", area);
    let carried: list<i32> = table.sysex_message(3, 4);
    verify(carried.len() == 6 && carried[0] == 240 && carried[1] == 67 && carried[2] == 26 && carried[3] == 1 && carried[4] == 2 && carried[5] == 247);
    let whole: list<i32> = table.sysex_message(3, 0);
    verify(whole.len() == 9 && whole[3] == 76 && whole[6] == 126 && whole[8] == 247);
    let none: list<i32> = table.sysex_message(3, 1); verify(none.len() == 0);
    // Collapsed tracks hide both columns with the CC columns.
    table.zoom_tracks(1, true, area);
    let hidden: TableColumn = table.columns[sysex + 1]; verify(hidden.hidden);
    table.zoom_tracks(2, true, area);
    let shown: TableColumn = table.columns[sysex]; verify(!shown.hidden);
    // A row's message goes before its notes.
    table.set_cell(0, table.track_start(3), clone("C-4")); table.set_cell(0, table.track_start(3) + 1, clone("90"));
    table.revision = table.revision + 1;
    var playback: NotePlayback = NotePlayback { start_row: 0 };
    playback.update(table, 0, true);
    verify(playback.events.len() == 2);
    let message: NoteEvent = playback.events[0]; let note: NoteEvent = playback.events[1];
    verify(message.on == 3 && message.text == 1 && message.instrument == 1 && message.track == 3);
    verify(note.on == 1 && note.note == 60);
    playback.update(table, 4 * 15000, true);
    var sent: bool = false;
    let events: list<NoteEvent> = playback.events;
    for event in events { if event.on == 3 && event.text == 5 { sent = true; } }
    verify(sent);
    // Pattern files keep the columns, with TEXT beside them.
    let directory: str8 = clone("/private/tmp/mlacker-sysex-test-XXXXXX"); mkdtemp(directory);
    let path: str8 = format!("{}/sysex.mlapatt", directory);
    var holder: PatternLibrary = PatternLibrary::empty(); holder.table.release(); holder.table = table.copy_pattern();
    verify(SessionCodec::save_pattern(path, "SysEx", holder.table));
    let loaded: result<mlacker_ui::session::PatternData, str8> = SessionCodec::load_pattern(path); verify(loaded.is_ok());
    let data: mlacker_ui::session::PatternData = loaded.unwrap();
    let loaded_track: SequenceTrack = data.table.tracks[3]; verify(loaded_track.sysex && loaded_track.comment);
    let loaded_row: TableRow = data.table.rows[0];
    verify(loaded_row.cells[data.table.sysex_column(3)] == "43 1A" && loaded_row.cells[data.table.sysex_column(3) + 1] == "4C 00 00 7E 00");
    data.release(); holder.release(); std::fs::remove_tree(directory); free(path); free(directory);
    // Removing the columns drops their messages.
    table.selected_column = table.sysex_column(3); table.track_action(Action::ToggleSysExColumns, area);
    verify(table.sysex_column(3) == -1 && table.comment_column(3) == table.track_start(3) + 6);
    table.release();
}

#[test]
fn tui_status_line_midi_text() {
    let note: str8 = midi_message_text(1, 9, 36, 100); verify(note == "CH10 C-2 v100"); free(note);
    let off: str8 = midi_message_text(2, 0, 60, 0); verify(off == "CH1 C-4 off"); free(off);
    let cc: str8 = midi_message_text(6, 0, 74, 64); verify(cc == "CH1 CC74=64"); free(cc);
    let at: str8 = midi_message_text(6, 1, 128, 40); verify(at == "CH2 AT 40"); free(at);
    let bend: str8 = midi_message_text(7, 0, 129, 8192); verify(bend == "CH1 PB 0"); free(bend);
    let knob: str8 = midi_message_text(8, 0, 6, 99); verify(knob == "KNOB 7=99"); free(knob);
    let none: str8 = midi_message_text(0, 0, 0, 0); verify(none == ""); free(none);
}

#[test]
fn tui_mpd218_pad_grid() {
    verify(PadGrid::pad_of(36) == 0 && PadGrid::pad_of(51) == 15 && PadGrid::pad_of(83) == 47);
    verify(PadGrid::pad_of(35) == -1 && PadGrid::pad_of(84) == -1);
    var pads: PadGrid = PadGrid { visible: true };
    // A hit lights its pad at once and shows its bank; a short note stays lit 120 ms.
    verify(pads.note_on(53, 100, 1000) && pads.bank == 1 && pads.level(17, 1000) == 100);
    verify(pads.note_off(53) && pads.level(17, 1050) == 64 && pads.level(17, 1120) == 0);
    verify(!pads.note_on(20, 100, 1000));
    // Sequencer notes wait for the transport to reach their tick.
    pads.schedule(36, true, 120, 15000); pads.schedule(36, false, 0, 30000);
    verify(!pads.advance(10000, true, 2000, 2000) && pads.level(0, 2000) == 0);
    verify(pads.advance(15000, true, 2100, 2000) && pads.level(0, 2100) == 120 && pads.bank == 0);
    verify(pads.advance(30000, true, 2400, 2100) && pads.level(0, 2400) == 0);
    // Stopped, whatever is queued applies now; clear darkens everything.
    pads.schedule(38, true, 90, 999999);
    verify(pads.advance(0, false, 3000, 2400) && pads.level(2, 3000) == 90);
    pads.clear(); verify(pads.level(2, 3000) == 0 && pads.pending.len() == 0);
    let title: str8 = pads.title(); verify(title == " MPD218 pads | Bank A "); std::strbuf::free(title);
    // The audio system gathers the selected track's notes, even without output.
    var audio: AudioSystem = AudioSystem { collect_pads: true, pad_track: 2 };
    var table: SequenceTable = SequenceTable::new();
    let events: list<NoteEvent> = [NoteEvent { on: 1, track: 2, note: 36, velocity: 100, tick: 15000 },
        NoteEvent { on: 1, track: 1, note: 38, velocity: 100 }, NoteEvent { on: 2, track: 2, note: 1, velocity: 64 },
        NoteEvent { on: 0, track: 2, note: 36, tick: 30000 }];
    audio.sequencer_events(events, table);
    let taken: list<NoteEvent> = audio.take_pad_events();
    verify(taken.len() == 2 && taken[0].note == 36 && taken[0].on == 1 && taken[1].on == 0);
    let again: list<NoteEvent> = audio.take_pad_events(); verify(again.len() == 0);
    table.release();
}

#[test]
fn tui_relative_midi_knobs() {
    // Two's complement (1 up, 127 down) and binary offset (65 up, 63 down).
    verify(relative_delta(1) == 1 && relative_delta(3) == 3 && relative_delta(127) == -1 && relative_delta(125) == -3);
    verify(relative_delta(65) == 1 && relative_delta(70) == 6 && relative_delta(63) == -1 && relative_delta(60) == -4);
    verify(relative_delta(0) == 0 && relative_delta(64) == 0 && relative_delta(200) == 0);
    // The project's mode wins; "as in Settings" takes the default.
    verify(knobs_relative(0, true) && !knobs_relative(0, false));
    verify(!knobs_relative(1, true) && knobs_relative(2, false));
}

#[test]
fn tui_knob_settings_file() {
    // Settings are kept in a file between runs; a missing file is the default.
    let directory: str8 = clone("/private/tmp/mlacker-knobs-test-XXXXXX"); mkdtemp(directory);
    let path: str8 = format!("{}/config/mlacker/settings", directory);
    let fresh: Preferences = Preferences::load(path); verify(!fresh.relative_knobs);
    let wanted: Preferences = Preferences { relative_knobs: true };
    let saved: str8 = wanted.save(path); verify(saved == ""); free(saved);
    let loaded: Preferences = Preferences::load(path); verify(loaded.relative_knobs);
    std::fs::remove_tree(directory); free(path); free(directory);
}

#[test]
fn tui_knob_mode_in_sessions() {
    // A plain session and a project keep the project's knob mode.
    let directory: str8 = clone("/private/tmp/mlacker-knob-session-XXXXXX"); mkdtemp(directory);
    var library: PatternLibrary = PatternLibrary::new();
    var codec: SessionCodec = SessionCodec {}; var audio: AudioSystem = AudioSystem {};
    let session: str8 = format!("{}/knobs.mlack", directory);
    verify(codec.save(session, library, SessionView { knob_mode: 2 }, audio));
    let opened: result<SessionData, str8> = SessionCodec::load(session); verify(opened.is_ok());
    var data: SessionData = opened.unwrap(); verify(data.view.knob_mode == 2 && data.view.editor_fullscreen); data.release();
    verify(codec.save(session, library, SessionView {}, audio));
    let plain: result<SessionData, str8> = SessionCodec::load(session); verify(plain.is_ok());
    var reread: SessionData = plain.unwrap(); verify(reread.view.knob_mode == 0); reread.release();
    let target: str8 = format!("{}/Knobs", directory);
    let project: result<str8, str8> = codec.save_project(target, library, SessionView { knob_mode: 1, move_unasked: true }, audio); verify(project.is_ok());
    let root: str8 = project.unwrap();
    let reopened: result<SessionData, str8> = SessionCodec::load_project(root); verify(reopened.is_ok());
    var kept: SessionData = reopened.unwrap(); verify(kept.view.knob_mode == 1 && kept.view.move_unasked); kept.release();
    library.release(); std::fs::remove_tree(directory);
    free(root); free(target); free(session); free(directory);
}

#[test]
fn tui_project_settings_dialog() {
    var dialog: ProjectSettingsDialog = ProjectSettingsDialog::new();
    dialog.open(2); verify(dialog.active && dialog.knob_mode() == 2);
    dialog.on_event(InputEvent { kind: InputKind::Menu, key: Key::Escape }); verify(!dialog.active && dialog.result == 2);
    dialog.open(0); verify(dialog.knob_mode() == 0);
    dialog.release();
}
