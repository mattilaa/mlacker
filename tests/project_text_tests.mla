mod mlacker_ui::project_text;
use mlacker_ui::project_text::*;
mod std::serde::detail;
mod std::fs;
mod std::strbuf;
mod std::testing;
use std::serde::detail::*;
use std::strbuf::clone;
use std::strbuf::free;
use std::strbuf::len;
use std::strbuf::starts_with;
use std::strbuf::contains;
use std::strbuf::builder_free;
use std::testing::verify;
extern fn mkdtemp(template: str8) -> str8;

#[test]
fn text_project_roundtrips_primitive_values_losslessly() {
    let directory: str8 = clone("/private/tmp/mlacker-project-text-XXXXXX"); mkdtemp(directory);
    let path: str8 = format!("{}/Project.mlack", directory);
    let writer: i64 = project_text_new_writer(); verify(writer != 0);
    project_text_append_record(writer, "integer", "9223372036854775807");
    let precise: f64 = 0.12345678901234567;
    project_text_append_real(writer, precise);
    let expected: str8 = "C#4\ncredits: \"SID\" \\ Unicode: ää";
    let quoted: str8 = format!("{:json}", expected);
    project_text_append_record(writer, "string", quoted); free(quoted);
    verify(project_text_write_atomic(writer, path) == 0); builder_free(writer);
    let text: result<str8, str8> = std::fs::read_all_text(path); verify(text.is_ok());
    let visible: str8 = text.unwrap(); verify(starts_with(visible, "{") == 1 && contains(visible, "C#4") == 1); free(visible);
    let decoded: result<i64, str8> = project_text_read_binary(path); verify(decoded.is_ok());
    let binary: i64 = decoded.unwrap(); let reader: i64 = __mlang_std_serde_reader_new(binary); __mlang_std_serde_binary_free(binary);
    verify(__mlang_std_serde_reader_read_i64(reader) == 9223372036854775807);
    verify(__mlang_std_serde_reader_read_f64(reader) == precise);
    let actual: str8 = __mlang_std_serde_reader_read_string(reader); verify(actual == expected); free(actual);
    verify(__mlang_std_serde_reader_remaining(reader) == 0); __mlang_std_serde_reader_free(reader);
    std::fs::remove_tree(directory); free(path); free(directory);
}

#[test]
fn text_project_rejects_bad_types_and_unsupported_versions() {
    let directory: str8 = clone("/private/tmp/mlacker-project-invalid-XXXXXX"); mkdtemp(directory);
    let path: str8 = format!("{}/Project.mlack", directory);
    let invalid: list<str8> = ["{}", "{", "{\"format\":\"mlacker-project\",\"version\":2,\"records\":[[\"integer\",1]]}",
        "{\"format\":\"mlacker-project\",\"version\":1,\"records\":[[\"integer\",1.5]]}",
        "{\"format\":\"mlacker-project\",\"version\":1,\"records\":[[\"integer\",\"1\"]]}",
        "{\"format\":\"mlacker-project\",\"version\":1,\"records\":[[\"unknown\",1]]}"];
    for text in invalid {
        std::fs::write_all_text(path, text);
        let decoded: result<i64, str8> = project_text_read_binary(path); verify(decoded.is_err());
    }
    std::fs::remove_tree(directory); free(path); free(directory);
}
