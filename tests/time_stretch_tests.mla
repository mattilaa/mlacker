mod std::testing;
mod std::math;
mod mlacker_ui::time_stretch;
use std::testing::verify;
use std::testing::verify_eq;
mod tui::geometry;
use tui::geometry::wide;
use mlacker_ui::time_stretch::*;

/// Mono sine of `hz` at 44.1 kHz.
fn sine(hz: f32, frames: i64) -> list<f32> {
    var out: list<f32> = [];
    for f in 0..frames { out.push(0.5f * std::math::sin(6.283185307179586f * hz * f32(f) / 44100.0f)); }
    return out;
}
/// Upward zero crossings of channel 0.
fn crossings(samples: &list<f32>, channels: i64) -> i64 {
    var count: i64 = 0; let frames: i64 = samples.len() / channels;
    for f in 1..frames { if samples[(f - 1) * channels] < 0.0f && samples[f * channels] >= 0.0f { count = count + 1; } }
    return count;
}

#[test]
fn resample_plays_the_range_in_the_new_length() {
    // A stereo ramp: half the frames play it twice as fast.
    var ramp: list<f32> = [];
    for f in 0..1000 { ramp.push(f32(f)); ramp.push(-f32(f)); }
    let out: list<f32> = resample(ramp, 2, 100, 900, 400, 1);
    verify_eq(out.len(), 800);
    verify(out[0] == 100.0f && out[1] == -100.0f);
    verify(out[200 * 2] > 499.9f && out[200 * 2] < 500.1f);
    // Pitch follows speed: 440 Hz played 127/120 faster.
    let tone: list<f32> = sine(440.0f, 44100);
    let fast: list<f32> = resample(tone, 1, 0, 44100, 44100 * 120 / 127, 0);
    let cycles: i64 = crossings(fast, 1);
    verify(cycles >= 437 && cycles <= 441);
}

#[test]
fn stretch_keeps_the_pitch() {
    let tone: list<f32> = sine(440.0f, 44100);
    // 127 BPM material at 120 BPM: longer, same frequency.
    let frames: i64 = 44100 * 127 / 120;
    let out: list<f32> = stretch(tone, 1, 44100, 0, 44100, frames);
    verify_eq(out.len(), frames);
    let cycles: i64 = crossings(out, 1);
    verify(cycles >= 460 && cycles <= 470);
    // Level stays steady through the overlaps (no window ripple or fade-in).
    var low: f32 = 1.0f; var high: f32 = 0.0f;
    for block in 0..20 {
        var peak: f32 = 0.0f; let first: i64 = block * 2000; let stop: i64 = first + 2000;
        for f in first..stop { let v: f32 = out[f] < 0.0f ? -out[f] : out[f]; if v > peak { peak = v; } }
        if peak < low { low = peak; } if peak > high { high = peak; }
    }
    verify(low > 0.4f && high < 0.6f);
}

#[test]
fn beats_moves_each_hit_to_its_stretched_time() {
    // Four clicks a beat (120 BPM, 22050 frames) apart, then played at 60 BPM.
    var clicks: list<f32> = [];
    for f in 0..88200 { let phase: i64 = f % 22050; clicks.push(phase >= 1000 && phase < 1400 ? 0.8f : 0.0f); }
    let points: list<i64> = onsets(clicks, 44100);
    verify_eq(points.len(), 5);
    verify(points[1] > 900 && points[1] <= 1000 && points[2] > 22950 && points[2] <= 23050);
    let out: list<f32> = beats(clicks, 1, 44100, 0, 88200, 176400);
    verify_eq(out.len(), 176400);
    // Each click keeps its length and starts at twice its source time.
    for hit in 1..4 {
        let at: i64 = 2 * (wide(hit) * 22050 + 1000);
        verify(out[at + 200] > 0.7f && out[at - 300] == 0.0f && out[at + 600] == 0.0f);
    }
}

/// Peak level of frames [from, to).
fn peak(samples: &list<f32>, from: i64, to: i64) -> f32 {
    var high: f32 = 0.0f;
    for f in from..to { let v: f32 = samples[f] < 0.0f ? -samples[f] : samples[f]; if v > high { high = v; } }
    return high;
}

#[test]
fn low_pass_stops_aliasing_when_reading_faster() {
    // 15 kHz read twice as fast is 30 kHz, above Nyquist: unfiltered it
    // folds down to 14.1 kHz, filtered it is gone.
    let tone: list<f32> = sine(15000.0f, 44100);
    let plain: list<f32> = resample(tone, 1, 0, 44100, 22050, 1);
    let filtered: list<f32> = resample(tone, 1, 0, 44100, 22050, 0);
    let linear: list<f32> = resample(tone, 1, 0, 44100, 22050, 2);
    verify(peak(plain, 1000, 21000) > 0.3f);
    verify(peak(filtered, 1000, 21000) < 0.01f && peak(linear, 1000, 21000) < 0.01f);
    // A low tone passes the filter unchanged.
    let low: list<f32> = resample(sine(440.0f, 44100), 1, 0, 44100, 22050, 0);
    verify(peak(low, 1000, 21000) > 0.49f && peak(low, 1000, 21000) < 0.51f);
}

#[test]
fn pitch_transposes_without_changing_length() {
    let tone: list<f32> = sine(440.0f, 44100);
    // An octave up and a fifth down at the same tempo.
    for algorithm in [2, 4, 5] {
        let up: list<f32> = render_synced(tone, 1, 44100, 0, 44100, 44100, i32(algorithm), 12, 0, 0);
        verify_eq(up.len(), 44100);
        let cycles: i64 = crossings(up, 1);
        verify(cycles >= 870 && cycles <= 890);
    }
    // Beats: the steady tone is one hit; transposed up it plays at the
    // octave for half the time, then leaves the gap Beats leaves.
    let beat: list<f32> = render_synced(tone, 1, 44100, 0, 44100, 44100, 3, 12, 0, 0);
    verify_eq(beat.len(), 44100);
    let half: i64 = crossings(beat, 1);
    verify(half >= 430 && half <= 460 && peak(beat, 23000, 44100) < 0.01f);
    let down: list<f32> = render_synced(tone, 1, 44100, 0, 44100, 44100, 2, -7, 1, 0);
    let cycles: i64 = crossings(down, 1);
    verify(cycles >= 288 && cycles <= 300);
    // Repitch ignores pitch: its pitch follows the tempo.
    let repitched: list<f32> = render_synced(tone, 1, 44100, 0, 44100, 22050, 1, 12, 1, 0);
    let repitched_cycles: i64 = crossings(repitched, 1); verify(repitched_cycles >= 438 && repitched_cycles <= 441);
}

#[test]
fn transients_keep_attacks_and_fill_the_gaps() {
    // Decaying hits a beat (22050 frames) apart, played at half the tempo.
    var hits: list<f32> = [];
    for f in 0..88200 {
        let phase: i64 = f % 22050;
        let decay: f32 = phase < 1000 ? 0.0f : 0.8f * f32(22050 - phase) / 21050.0f;
        hits.push(decay * std::math::sin(6.283185307179586f * 220.0f * f32(phase) / 44100.0f));
    }
    let out: list<f32> = transients(hits, 1, 44100, 0, 88200, 176400);
    verify_eq(out.len(), 176400);
    for hit in 1..4 {
        let at: i64 = 2 * (wide(hit) * 22050 + 1000);
        // Silent before the hit, its attack on time, and still sounding
        // (no gap like Beats) well after the source hit would have ended.
        verify(peak(out, at - 400, at - 100) < 0.05f);
        verify(peak(out, at, at + 300) > 0.5f);
        verify(peak(out, at + 30000, at + 32000) > 0.15f);
    }
    let beat: list<f32> = beats(hits, 1, 44100, 0, 88200, 176400);
    verify(peak(beat, 2 * 23050 + 30000, 2 * 23050 + 32000) == 0.0f);
}

#[test]
fn transients_2_join_hits_without_dips_or_overs() {
    // A held 110 Hz bass under a tick every beat (22050 frames) at full
    // scale, played at half the tempo.
    var mix: list<f32> = []; var source_peak: f32 = 0.0f;
    for f in 0..88200 {
        let phase: i64 = f % 22050;
        let tick: f32 = phase >= 1000 && phase < 1300 ? 0.55f * std::math::sin(6.283185307179586f * 2000.0f * f32(phase) / 44100.0f) : 0.0f;
        let v: f32 = 0.45f * std::math::sin(6.283185307179586f * 110.0f * f32(f) / 44100.0f) + tick;
        mix.push(v); let a: f32 = v < 0.0f ? -v : v; if a > source_peak { source_peak = a; }
    }
    let smooth: list<f32> = render_synced(mix, 1, 44100, 0, 88200, 176400, 5, 0, 0, 0);
    verify_eq(smooth.len(), 176400);
    verify(peak(smooth, 0, 176400) <= source_peak + 0.0001f);
    for hit in 1..4 {
        let at: i64 = 2 * (wide(hit) * 22050 + 1000);
        // The tick on time over the bass.
        verify(peak(smooth, at + 20, at + 300) > 0.7f);
        // Around the seam the bass keeps its level (a 110 Hz cycle is 401
        // frames, so any 200 frames reach most of its peak).
        var lowest: f32 = 1.0f;
        var w: i64 = at - 1200;
        while w < at + 400 { let p: f32 = peak(smooth, w, w + 200); if p < lowest { lowest = p; } w = w + 50; }
        verify(lowest > 0.3f);
    }
    // No clicks at the seams: before each tick the steps between frames stay
    // those of the bass (at most 0.45 * 2 pi * 110 / 44100 = 0.007).
    for hit in 1..4 {
        let at: i64 = 2 * (wide(hit) * 22050 + 1000);
        var step: f32 = 0.0f;
        let lo: i64 = at - 1200; let hi: i64 = at - 80;
        for f in lo..hi { let d: f32 = smooth[f] - smooth[f - 1]; let a: f32 = d < 0.0f ? -d : d; if a > step { step = a; } }
        verify(step < 0.012f);
    }
}

/// Decaying 220 Hz hits a beat (22050 frames) apart, lasting `ring` frames.
fn ringing_hits(ring: i64) -> list<f32> {
    var out: list<f32> = [];
    for f in 0..88200 {
        let phase: i64 = f % 22050;
        let body: i64 = phase - 1000;
        let v: f32 = body < 0 || body >= ring ? 0.0f : 0.8f * f32(ring - body) / f32(ring) * std::math::sin(6.283185307179586f * 220.0f * f32(body) / 44100.0f);
        out.push(v);
    }
    return out;
}

#[test]
fn transients_2_loops_fill_slowed_hits() {
    // Hits ringing the whole beat, at half the tempo: each hit plays its
    // beat at its own speed, then the loop fills the second beat.
    let hits: list<f32> = ringing_hits(21050);
    let forward: list<f32> = render_synced(hits, 1, 44100, 0, 88200, 176400, 5, 0, 0, 0);
    let bounce: list<f32> = render_synced(hits, 1, 44100, 0, 88200, 176400, 5, 0, 0, 1);
    let off: list<f32> = render_synced(hits, 1, 44100, 0, 88200, 176400, 5, 0, 0, 2);
    verify_eq(forward.len(), 176400); verify_eq(bounce.len(), 176400); verify_eq(off.len(), 176400);
    for hit in 1..4 {
        let at: i64 = 2 * (wide(hit) * 22050 + 1000);
        // The attack at the original speed (220 Hz: 200 frames a cycle) and on time.
        verify(peak(forward, at + 20, at + 300) > 0.7f && peak(off, at + 20, at + 300) > 0.7f);
        // Late in the stretched beat: looped sound, or silence without the loop.
        verify(peak(forward, at + 30000, at + 34000) > 0.05f && peak(bounce, at + 30000, at + 34000) > 0.05f);
        verify(peak(off, at + 30000, at + 34000) == 0.0f);
    }
    // No clicks at the forward loop's seams: between the hits the steps
    // between frames stay those of the decaying 220 Hz tone (at most
    // 0.8 * 2 pi * 220 / 44100 = 0.025).
    var later: f32 = 0.0f;
    for hit in 1..4 {
        let at: i64 = 2 * (wide(hit) * 22050 + 1000);
        let lo: i64 = at + 23000; let hi: i64 = at + 43000 < 176400 ? at + 43000 : 176400;
        for f in lo..hi { let d: f32 = forward[f] - forward[f - 1]; let a: f32 = d < 0.0f ? -d : d; if a > later { later = a; } }
    }
    verify(later < 0.03f);
    // Faster (double tempo): each hit is cut by the next, still on time.
    let fast: list<f32> = render_synced(hits, 1, 44100, 0, 88200, 44100, 5, 0, 0, 0);
    verify_eq(fast.len(), 44100);
    for hit in 1..4 { let at: i64 = (wide(hit) * 22050 + 1000) / 2; verify(peak(fast, at + 20, at + 300) > 0.5f); }
}
