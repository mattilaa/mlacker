mod tui::surface;
mod mlacker_ui::audio_clip;
use mlacker_ui::audio_clip::WavePeak;
use tui::geometry::*;
use tui::surface::*;

/// Mono view level of a stereo peak: L and R summed (averaged) to one channel.
pub fn mono_level(left: i32, right: i32) -> i32 {
    let value: i32 = (left + right) / 2;
    return value > 1000 ? 1000 : (value < 0 ? 0 : value);
}

/// One braille line of the mono waveform, centered in `area` and growing
/// outward to both edges. Detail slices `first`..`first + count` (1, 2 or 4
/// quarter-row slices, oldest on top) share the four dot rows evenly; slices
/// at or past `remaining` ticks stay empty.
pub fn paint_mono_grainy(surface: Surface, area: Rect, clip: Rect, details: &list<WavePeak>, first: i32, count: i32,
    color: i32, background: i32, wave: bool, remaining: i64) -> void {
    let bits: array<i32, 8> = {1, 8, 2, 16, 4, 32, 64, 128};
    let side: i32 = area.width;
    let slices: i32 = count == 1 || count == 2 ? count : 4; let height: i32 = 4 / slices;
    for x in 0..area.width {
        if !clip.contains(area.x + i32(x), area.y) { continue; }
        var mask: i32 = 0;
        for part in 0..4 {
            let slice: i32 = i32(part) / height;
            if wide(slice) * 3750 >= remaining { continue; }
            let index: i32 = first + slice;
            if index < 0 || index >= details.len() { continue; }
            let peak: WavePeak = details[index];
            let units: i32 = (mono_level(peak.left, peak.right) * side + 999) / 1000;
            for dot in 0..2 {
                let position: i32 = i32(x) * 2 + i32(dot);
                let distance: i32 = position < side ? side - 1 - position : position - side;
                if distance < units && (!wave || distance == units - 1) { mask = mask + bits[part * 2 + dot]; }
            }
        }
        if mask != 0 { surface.put(area.x + i32(x), area.y, Cell { glyph: 0x2800 + mask, foreground: color, background: background }); }
    }
}

/// One row of the mono waveform in eighth-cell steps, centered in `area`: a
/// solid average-amplitude body inside a shaded peak envelope. `wave` draws
/// only the envelope edges.
pub fn paint_mono_wave(surface: Surface, area: Rect, clip: Rect, peak: i32, body: i32,
    color: i32, background: i32, wave: bool) -> void {
    if area.width <= 0 || area.height <= 0 { return; }
    let level: i32 = peak < 0 ? 0 : (peak > 1000 ? 1000 : peak);
    let average: i32 = body < 0 ? 0 : (body > level ? level : body);
    let center: i32 = area.width * 4;
    let units: i32 = (level * center + 999) / 1000; let solid: i32 = average * center / 1000;
    let lo: i32 = center - units; let hi: i32 = center + units;
    for slot in 0..area.width {
        let start: i32 = i32(slot) * 8; let stop: i32 = start + 8;
        let from: i32 = lo > start ? lo : start; let to: i32 = hi < stop ? hi : stop;
        if to <= from { continue; }
        let x: i32 = area.x + i32(slot);
        if !clip.contains(x, area.y) { continue; }
        let amount: i32 = to - from;
        var glyph: i32 = start >= center - solid && stop <= center + solid ? 0x2588 : 0x2592;
        var fg: i32 = color; var bg: i32 = background;
        if wave {
            let edge: bool = (lo >= start && lo < stop) || (hi - 1 >= start && hi - 1 < stop);
            if !edge { continue; }
            glyph = 0x25cf;
        } else if from > start && to < stop {
            // Both edges inside the center cell: a line thick as the level.
            glyph = amount <= 2 ? 0x2502 : (amount <= 4 ? 0x2503 : 0x2588);
        } else if from > start {
            // Right-aligned eighths: an inverted left block.
            glyph = 0x2588 + amount; fg = background; bg = color;
        } else if to < stop {
            glyph = 0x2588 + 8 - amount;
        }
        surface.put(x, area.y, Cell { glyph: glyph, foreground: fg, background: bg });
    }
}
