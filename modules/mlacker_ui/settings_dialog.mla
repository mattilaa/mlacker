mod tui::dialog;
mod tui::dropdown;
mod std::audio;
mod std::midi;
mod std::thread;
use std::thread::cpu_count;
use std::thread::performance_cpu_count;
mod std::audio::controller;
use std::audio::controller::AudioController;
use std::midi::input_count;
use std::midi::input_name;
use std::audio::output_device_count;
use std::audio::output_device_name;
use std::audio::input_device_count;
use std::audio::input_device_name;
use tui::dialog::Dialog;
use tui::dropdown::*;
use tui::button::PushButton;
use tui::focus::PaneFocus;
use tui::layout::Alignment;
use tui::geometry::*;
use tui::surface::*;
use tui::theme::*;
use tui::input::*;
use tui::menu::Key;
use std::strbuf::clone;
use std::strbuf::free;
mod mlacker_ui::spectrum;
use mlacker_ui::spectrum::headroom_choices;
use mlacker_ui::spectrum::default_headroom_db;

/// File > Settings. Fields top to bottom: the audio output and input, the
/// sample rate, buffer size and master headroom, then MIDI, the MIDI knob
/// mode and the CPU cores.
pub struct SettingsDialog : Dialog {
    var midi: DropDown; var output: DropDown; var buffer: DropDown; var rate: DropDown;
    /// Live audio input (AUHAL): -2 disabled, -1 system default, else an
    /// input device index. Instruments can take it as their input.
    var input: DropDown;
    /// The fixed gain after the master bus, in dB (0 = none, -12 default).
    var headroom: DropDown;
    /// Render threads (0 = every core), read from and applied to the audio
    /// runtime directly: the cap takes effect without reopening the device.
    var cores: DropDown; var core_label: str8;
    /// MIDI knobs: 0 absolute (positions 0-127), 1 relative (endless
    /// encoders sending increments). Saved between runs; a project can
    /// override it (File > Project > Project settings).
    var knobs: DropDown;
    var error: str8;
};

/// Field indexes, in the order they are shown and Tab visits them.
fn field_output() -> i32 { return 0; }
fn field_input() -> i32 { return 1; }
fn field_rate() -> i32 { return 2; }
fn field_buffer() -> i32 { return 3; }
fn field_headroom() -> i32 { return 4; }
fn field_midi() -> i32 { return 5; }
fn field_knobs() -> i32 { return 6; }
fn field_cores() -> i32 { return 7; }
/// The buttons follow the last field.
pub fn settings_buttons() -> i32 { return 8; }
/// Choices of the MIDI knob mode, by id: 0 absolute, 1 relative.
pub fn knob_mode_items() -> list<DropDownItem> {
    return [DropDownItem { id: 0, label: "Absolute (positions 0-127)" }, DropDownItem { id: 1, label: "Relative (endless encoders, +/- steps)" }];
}

impl SettingsDialog {
    pub fn new() -> SettingsDialog {
        return SettingsDialog { title: "Settings", width: 64, height: 31,
            error: clone(""), core_label: clone(""), focus: PaneFocus::new(0), button_alignment: Alignment::Center,
            buttons: [PushButton { label: "OK", action: 1 }, PushButton { label: "Cancel", action: 2 }] };
    }
    pub fn open(self: &mut Self, midi_id: i64, output_id: i64) -> void {
        self.open_with_buffer(midi_id, output_id, 128);
    }
    pub fn open_with_buffer(self: &mut Self, midi_id: i64, output_id: i64, frames: i64) -> void {
        self.open_audio(midi_id, output_id, frames, 0);
    }
    pub fn open_audio(self: &mut Self, midi_id: i64, output_id: i64, frames: i64, rate: i64) -> void {
        self.open_devices(midi_id, output_id, frames, rate, -2);
    }
    pub fn open_devices(self: &mut Self, midi_id: i64, output_id: i64, frames: i64, rate: i64, input_id: i64) -> void {
        self.open_settings(midi_id, output_id, frames, rate, input_id, default_headroom_db());
    }
    pub fn open_settings(self: &mut Self, midi_id: i64, output_id: i64, frames: i64, rate: i64, input_id: i64, headroom_db: i32) -> void {
        var audio_items: list<DropDownItem> = [DropDownItem { id: -2, label: clone("Disabled") }, DropDownItem { id: -1, label: clone("AUHAL - System default") }];
        let audio_count: i64 = std::audio::output_device_count();
        for id in 0..audio_count {
            audio_items.push(DropDownItem { id: id, label: format!("AUHAL - {}", std::audio::output_device_name(id)) });
        }
        self.output.set_items(audio_items, output_id);
        for item in audio_items { free(item.label); }
        var input_items: list<DropDownItem> = [DropDownItem { id: -2, label: clone("Disabled") }, DropDownItem { id: -1, label: clone("AUHAL - System default") }];
        let input_count: i64 = std::audio::input_device_count();
        for id in 0..input_count {
            input_items.push(DropDownItem { id: id, label: format!("AUHAL - {}", std::audio::input_device_name(id)) });
        }
        self.input.set_items(input_items, input_id);
        for item in input_items { free(item.label); }
        self.rate.set_items([DropDownItem { id: 0, label: "Device default" },
            DropDownItem { id: 44100, label: "44.1 kHz" }, DropDownItem { id: 48000, label: "48 kHz" },
            DropDownItem { id: 96000, label: "96 kHz" }], rate);
        var buffer_items: list<DropDownItem> = [];
        var size: i64 = 32;
        while size <= 4096 {
            buffer_items.push(DropDownItem { id: size, label: format!("{} frames", size) });
            size = size * 2;
        }
        self.buffer.set_items(buffer_items, frames);
        for item in buffer_items { free(item.label); }
        var headroom_items: list<DropDownItem> = [];
        let choices: list<i32> = headroom_choices();
        for i in 0..choices.len() {
            let db: i32 = choices[i];
            let label: str8 = db == 0 ? clone("0 dB (none)") : (db == default_headroom_db() ? format!("{} dB (default)", db) : format!("{} dB", db));
            headroom_items.push(DropDownItem { id: wide(db), label: label });
        }
        self.headroom.set_items(headroom_items, wide(headroom_db));
        for item in headroom_items { free(item.label); }
        var midi_items: list<DropDownItem> = [DropDownItem { id: -2, label: clone("Disabled") }, DropDownItem { id: -1, label: clone("System default") }];
        let midi_count: i64 = std::midi::input_count();
        for id in 0..midi_count {
            midi_items.push(DropDownItem { id: id, label: clone(std::midi::input_name(id)) });
        }
        self.midi.set_items(midi_items, midi_id);
        for item in midi_items { free(item.label); }
        self.knobs.set_items(knob_mode_items(), 0);
        self.open_cores(AudioController::render_thread_limit());
        free(self.error); self.error = clone("");
        self.reset_buttons(); self.focus.selected = 0; self.active = true;
    }
    /// Core choices come from the OS: every online core, the performance
    /// cores named where the CPU has two kinds.
    fn open_cores(self: &mut Self, limit: i64) -> void {
        let cores: i64 = AudioController::max_render_threads();
        let online: i64 = cpu_count();
        let performance: i64 = performance_cpu_count();
        var items: list<DropDownItem> = [DropDownItem { id: 0, label: format!("All cores ({})", cores) }];
        for count in 1..cores + 1 {
            items.push(DropDownItem { id: count, label: count == 1 ? clone("1 core (no worker threads)") : format!("{} cores", count) });
        }
        self.cores.set_items(items, limit > cores ? 0 : limit);
        for item in items { free(item.label); }
        free(self.core_label);
        self.core_label = performance < online
            ? format!("CPU cores for audio ({} performance + {} efficiency)", performance, online - performance)
            : format!("CPU cores for audio ({} online)", online);
    }
    /// Show the saved MIDI knob mode; call after opening.
    pub fn set_relative_knobs(self: &mut Self, relative: bool) -> void { self.knobs.set_items(knob_mode_items(), relative ? 1 : 0); }
    pub fn relative_knobs(self: SettingsDialog) -> bool { return self.knobs.selected_id() == 1; }
    pub fn fail(self: &mut Self, error: str8) -> void {
        free(self.error); self.error = clone(error); self.active = true; self.reset_buttons();
    }
    fn cancel_popups(self: &mut Self) -> void {
        self.output.cancel(); self.input.cancel(); self.rate.cancel(); self.buffer.cancel(); self.headroom.cancel();
        self.midi.cancel(); self.knobs.cancel(); self.cores.cancel();
    }
    pub fn on_event(self: &mut Self, event: InputEvent) -> void {
        if self.pressed_button >= 0 { return; }
        if event.kind == InputKind::Pane || (event.kind == InputKind::Menu && event.key == Key::Toggle) {
            self.cancel_popups();
            // Fields top to bottom, then the buttons, wrapping around.
            let back: bool = (event.kind == InputKind::Pane && (event.key == Key::Up || event.key == Key::Left)) || event.modifiers == 2;
            let count: i32 = settings_buttons() + 1;
            self.focus.selected = (self.focus.selected + (back ? count - 1 : 1)) % count;
            return;
        }
        let f: i32 = self.focus.selected;
        if f == field_output() { if self.output.on_event(event) { return; } }
        if f == field_input() { if self.input.on_event(event) { return; } }
        if f == field_rate() { if self.rate.on_event(event) { return; } }
        if f == field_buffer() { if self.buffer.on_event(event) { return; } }
        if f == field_headroom() { if self.headroom.on_event(event) { return; } }
        if f == field_midi() { if self.midi.on_event(event) { return; } }
        if f == field_knobs() { if self.knobs.on_event(event) { return; } }
        if f == field_cores() { if self.cores.on_event(event) { return; } }
        if event.kind == InputKind::Menu && event.key == Key::Escape && event.code < 32 {
            self.active = false; self.result = 2; return;
        }
        if f == settings_buttons() { self.on_button_event(event); }
    }
    pub fn tick(self: &mut Self) -> void {
        let action: i32 = self.tick_buttons();
        if action == 1 || action == 2 { self.active = false; self.result = action; }
    }
    /// Field `index`'s row: its label is the line above it.
    fn field_row(body: Rect, index: i32) -> Rect {
        let y: i32 = 1 + index * 3;
        return Rect::new(body.x + 1, body.y + y, body.width - 2, body.height > y ? 1 : 0);
    }
    fn label(surface: Surface, body: Rect, index: i32, text: str8, theme: Theme) -> void {
        let y: i32 = index * 3;
        if body.height > y { surface.text(Rect::new(body.x, body.y + y, body.width, 1), text, theme.foreground, theme.panel); }
    }
    pub fn paint(self: SettingsDialog, surface: Surface, viewport: Rect, theme: Theme) -> void {
        if !self.active { return; }
        let body: Rect = self.paint_frame(surface, viewport, theme);
        let f: i32 = self.focus.selected;
        SettingsDialog::label(surface, body, field_output(), "Audio output (AUHAL)", theme);
        SettingsDialog::label(surface, body, field_input(), "Audio input (AUHAL)", theme);
        SettingsDialog::label(surface, body, field_rate(), "Sample rate", theme);
        SettingsDialog::label(surface, body, field_buffer(), "Buffer size (a request; the device may differ)", theme);
        SettingsDialog::label(surface, body, field_headroom(), "Master headroom (a full-level track reads this far down)", theme);
        SettingsDialog::label(surface, body, field_midi(), "MIDI input adapter", theme);
        SettingsDialog::label(surface, body, field_knobs(), "MIDI knobs (default for projects; MIDI learn and MPD218)", theme);
        SettingsDialog::label(surface, body, field_cores(), self.core_label, theme);
        self.output.paint(surface, SettingsDialog::field_row(body, field_output()), theme, f == field_output());
        self.input.paint(surface, SettingsDialog::field_row(body, field_input()), theme, f == field_input());
        self.rate.paint(surface, SettingsDialog::field_row(body, field_rate()), theme, f == field_rate());
        self.buffer.paint(surface, SettingsDialog::field_row(body, field_buffer()), theme, f == field_buffer());
        self.headroom.paint(surface, SettingsDialog::field_row(body, field_headroom()), theme, f == field_headroom());
        self.midi.paint(surface, SettingsDialog::field_row(body, field_midi()), theme, f == field_midi());
        self.knobs.paint(surface, SettingsDialog::field_row(body, field_knobs()), theme, f == field_knobs());
        self.cores.paint(surface, SettingsDialog::field_row(body, field_cores()), theme, f == field_cores());
        let error_y: i32 = settings_buttons() * 3;
        if body.height > error_y { surface.text(Rect::new(body.x, body.y + error_y, body.width, 1), self.error, theme.accent, theme.panel); }
        // Overlays are last, so they cover labels, fields and buttons.
        self.output.paint_popup(surface, SettingsDialog::field_row(body, field_output()), viewport, theme);
        self.input.paint_popup(surface, SettingsDialog::field_row(body, field_input()), viewport, theme);
        self.rate.paint_popup(surface, SettingsDialog::field_row(body, field_rate()), viewport, theme);
        self.buffer.paint_popup(surface, SettingsDialog::field_row(body, field_buffer()), viewport, theme);
        self.headroom.paint_popup(surface, SettingsDialog::field_row(body, field_headroom()), viewport, theme);
        self.midi.paint_popup(surface, SettingsDialog::field_row(body, field_midi()), viewport, theme);
        self.knobs.paint_popup(surface, SettingsDialog::field_row(body, field_knobs()), viewport, theme);
        self.cores.paint_popup(surface, SettingsDialog::field_row(body, field_cores()), viewport, theme);
    }
    pub fn release(self: &mut Self) -> void {
        self.midi.release(); self.output.release(); self.buffer.release(); self.rate.release(); self.cores.release(); self.input.release();
        self.headroom.release(); self.knobs.release();
        free(self.core_label); free(self.error);
    }
}
