/// MLACK binary session 1.0. All lengths and integers are little endian.
/// A project (1.4) is a `.mlaproj` folder: Project.mlack refers to float WAVs
/// in Audio/ and plugin presets in Presets/ by paths relative to the folder.
mod std::serde::detail;
mod std::fs;
mod std::bytes;
mod std::audio;
mod mlacker_ui::patterns;
mod mlacker_ui::audio_controller;
mod mlacker_ui::audio_library;
mod mlacker_ui::spectrum;
use mlacker_ui::spectrum::MasterBus;
use std::serde::detail::*;
use std::fs::File;
use mlacker_ui::patterns::*;
use mlacker_ui::sequence::*;
use mlacker_ui::audio_clip::*;
use mlacker_ui::audio_library::*;
use mlacker_ui::audio_controller::AudioSystem;
use mlacker_ui::audio_controller::EffectChannel;
use mlacker_ui::audio_controller::PadAssignment;
use mlacker_ui::audio_controller::PadMarkers;
use mlacker_ui::patterns::SongLane;
use std::audio::controller::AudioController;
use std::audio::PcmAudio;
use tui::table::*;
use tui::listview::*;
use tui::geometry::*;
use std::strbuf::clone;
use std::strbuf::free;
use std::strbuf::len;
extern fn __mlang_std_serde_binary_write_atomic(handle: i64, path: str8) -> i32;
extern fn rename(from: str8, to: str8) -> i32;
// Small session-specific adapters avoid pulling unrelated generic serde traits
// into the widget demo. Encoding is the std::serde primitive wire format.
pub struct SessionBuffer { var handle: i64; };
impl SessionBuffer {
    pub fn new(capacity: i64) -> result<SessionBuffer, str8> {
        let h: i64 = __mlang_std_serde_binary_new(capacity);
        if h == 0 { return Err<SessionBuffer, str8>("Allocation failed"); }
        return Ok<SessionBuffer, str8>(SessionBuffer { handle: h });
    }
    pub fn len(self: SessionBuffer) -> i64 { return __mlang_std_serde_binary_len(self.handle); }
    pub fn close(self: SessionBuffer) -> void { __mlang_std_serde_binary_free(self.handle); }
    pub fn write_i64(self: SessionBuffer, value: i64) -> result<i32, str8> {
        if __mlang_std_serde_binary_append_i64(self.handle, value) != 0 { return Err<i32, str8>("Write failed"); } return Ok<i32, str8>(0);
    }
    pub fn write_f64(self: SessionBuffer, value: f64) -> result<i32, str8> {
        if __mlang_std_serde_binary_append_f64(self.handle, value) != 0 { return Err<i32, str8>("Write failed"); } return Ok<i32, str8>(0);
    }
    pub fn write_string(self: SessionBuffer, value: str8) -> result<i32, str8> {
        if __mlang_std_serde_binary_append_string(self.handle, value) != 0 { return Err<i32, str8>("Write failed"); } return Ok<i32, str8>(0);
    }
    pub fn write_atomic(self: SessionBuffer, path: str8) -> result<i32, str8> {
        if __mlang_std_serde_binary_write_atomic(self.handle, path) != 0 { return Err<i32, str8>("Save failed"); } return Ok<i32, str8>(0);
    }
}
pub struct SessionReader { var handle: i64; };
impl SessionReader {
    pub fn from_file(path: str8) -> result<SessionReader, str8> {
        let binary: i64 = __mlang_std_serde_binary_read_file(path);
        if binary == 0 { return Err<SessionReader, str8>("Read failed"); }
        let h: i64 = __mlang_std_serde_reader_new(binary); __mlang_std_serde_binary_free(binary);
        if h == 0 { return Err<SessionReader, str8>("Read failed"); } return Ok<SessionReader, str8>(SessionReader { handle: h });
    }
    pub fn remaining(self: SessionReader) -> i64 { return __mlang_std_serde_reader_remaining(self.handle); }
    pub fn close(self: SessionReader) -> void { __mlang_std_serde_reader_free(self.handle); }
    pub fn read_i64(self: SessionReader) -> result<i64, str8> {
        let value: i64 = __mlang_std_serde_reader_read_i64(self.handle);
        if __mlang_std_serde_last_ok() == 0 { return Err<i64, str8>("Truncated"); } return Ok<i64, str8>(value);
    }
    pub fn read_f64(self: SessionReader) -> result<f64, str8> {
        let value: f64 = __mlang_std_serde_reader_read_f64(self.handle);
        if __mlang_std_serde_last_ok() == 0 { return Err<f64, str8>("Truncated"); } return Ok<f64, str8>(value);
    }
    pub fn read_string(self: SessionReader) -> result<str8, str8> {
        let before: i64 = self.remaining();
        let value: str8 = __mlang_std_serde_reader_read_string(self.handle);
        if __mlang_std_serde_last_ok() == 0 { free(value); return Err<str8, str8>("Truncated"); }
        if before - self.remaining() != 8 + len(value) || len(value) > 4096 { free(value); return Err<str8, str8>("Invalid string"); }
        return Ok<str8, str8>(value);
    }
}

pub struct PluginSnapshot { var slot: i32; var path: str8; var ids: list<i64>; var values: list<f64>; };
pub struct SessionView {
    var bpm: i32{120}; var beats: i32{4}; var unit: i32{4}; var row: i32; var phase: i64;
    var pane: i32; var sidebar: i32; var list_selected: i32; var list_scroll: i32;
    var audio_selected: i32; var audio_scroll: i32; var instrument_selected: i32; var instrument_scroll: i32;
    var mixer: bool; var meter_grainy: bool{true}; var meter_fps: i32{60};
    var sample: bool; var sample_grainy: bool{true}; var sample_wave: bool; var sample_zoom: i32;
    var editor: bool; var editor_slot: i32; var editor_selected: i32; var editor_scroll: i32;
    var effect_focus: bool; var effect_selected: i32;
    /// Spectrum analyzer and master bus. `master` is only meaningful when
    /// `master_saved`: a nested struct is not default-initialized.
    var spectrum: bool; var spectrum_detail: i32; var spectrum_fps: i32{30};
    var master_saved: bool; var master: MasterBus;
    /// Project options: Audio > Move to group saves the project without
    /// asking; the sample editor opens full screen.
    var move_unasked: bool; var editor_fullscreen: bool{true};
};
/// Plugin preset outcome. Kit presets (MLAPRE 1.1) also carry sampler pads:
/// `pads[i]` is loaded from `clips[i]`; the caller owns the clips.
pub struct PresetResult { var status: str8; var ok: bool; var has_pads: bool; var pads: list<i32>; var clips: list<AudioClip>; var keys: list<i64>; var values: list<f64>; };
pub struct MidiLearnSnapshot { var key: i32; var slot: i32; var parameter_id: i64; };
pub struct SessionData { var library: PatternLibrary; var plugins: list<PluginSnapshot>; var view: SessionView; var midi_learn: list<MidiLearnSnapshot>; var effect_volumes: list<i32>; var pads: list<PadAssignment>; var markers: list<PadMarkers>; };
impl SessionData {
    pub fn release_plugins(self: &mut Self) -> void {
        let plugins: list<PluginSnapshot> = self.plugins; for plugin in plugins { free(plugin.path); }
        self.plugins = [];
    }
    pub fn release(self: &mut Self) -> void { self.library.release(); self.release_plugins(); }
    /// Construct a replacement without touching the running session.
    pub fn prepare_audio(self: SessionData, source: &AudioSystem) -> result<AudioSystem, str8> {
        var current: AudioSystem = AudioSystem {}; current = source;
        var next: AudioSystem = AudioSystem { midi_id: current.midi_id, output_id: current.output_id, input_id: current.input_id, hardware_requested: current.hardware_requested, requested_buffer_frames: current.requested_buffer_frames, requested_sample_rate: current.requested_sample_rate };
        // A failed initial device open is not a request for silent/offline audio.
        let hardware: bool = current.hardware_requested;
        let opened: result<AudioController, str8> = hardware ? AudioController::open_at_rate(current.output_id, current.requested_buffer_frames, current.requested_sample_rate) : AudioController::new(current.requested_sample_rate == 0 ? 48000 : current.requested_sample_rate, current.requested_buffer_frames);
        if opened.is_err() { return Err<AudioSystem, str8>("Cannot prepare session audio output"); }
        next.output = opened.unwrap();
        if next.input_id != -2 && next.output.input_open(next.input_id) != 0 { next.input_id = -2; }
        let plugins: list<PluginSnapshot> = self.plugins;
        for plugin in plugins {
            if plugin.slot >= 41 { next.insert_paths.push(clone(plugin.path)); }
            if plugin.slot > 32 && plugin.slot <= 40 {
                next.effects.push(EffectChannel { path: plugin.path == "" ? "" : clone(plugin.path), volume: self.effect_volumes[plugin.slot - 33] });
                next.output.effect_volume(plugin.slot - 33, self.effect_volumes[plugin.slot - 33]);
                if plugin.path == "" { continue; }
            }
            let loaded: i32 = plugin.slot >= 41 ? next.output.load_insert(plugin.slot - 40, plugin.path) : (plugin.slot > 32 ? next.output.load_effect(plugin.slot - 33, plugin.path) : (plugin.slot == 0 ? next.output.load_processor(plugin.path) : next.output.load_instrument(plugin.slot, plugin.path)));
            if loaded != 0 { next.release(); return Err<AudioSystem, str8>("A session VST3 plugin is missing or could not load"); }
            if plugin.slot == 0 { next.processor_path = clone(plugin.path); }
            else if plugin.slot <= 32 {
                while next.instrument_paths.len() < plugin.slot { next.instrument_paths.push(""); }
                let old: list<str8> = next.instrument_paths; var paths: list<str8> = [];
                for i in 0..old.len() { paths.push(i + 1 == plugin.slot ? clone(plugin.path) : old[i]); }
                next.instrument_paths = paths;
            }
            let count: i32 = i32(next.output.parameter_info(plugin.slot, 0, 0));
            if count != plugin.ids.len() { next.release(); return Err<AudioSystem, str8>("VST3 parameter layout changed; session retained"); }
            for i in 0..plugin.ids.len() {
                var found: i32 = i32(i);
                if next.output.parameter_info(plugin.slot, i, 4) != f64(plugin.ids[i]) {
                    found = -1;
                    for j in 0..count { if next.output.parameter_info(plugin.slot, j, 4) == f64(plugin.ids[i]) { found = i32(j); } }
                }
                if found < 0 || next.output.restore_parameter(plugin.slot, found, plugin.values[i]) != 0 {
                    next.release(); return Err<AudioSystem, str8>("Cannot restore VST3 parameters; session retained");
                }
            }
        }
        let mappings: list<MidiLearnSnapshot> = self.midi_learn;
        for mapping in mappings {
            let count: i64 = next.output.parameter_info(mapping.slot, 0, 0);
            var found: i64 = -1;
            for index in 0..count { if next.output.parameter_info(mapping.slot, index, 4) == f64(mapping.parameter_id) { found = index; } }
            if found < 0 { next.release(); return Err<AudioSystem, str8>("MIDI learn parameter no longer exists"); }
            if next.output.midi_learn(mapping.key, mapping.slot, found) != 0 { next.release(); return Err<AudioSystem, str8>("Cannot restore MIDI learn mapping"); }
        }
        // Sampler pads reference the embedded sample list, not source files.
        let pads: list<PadAssignment> = self.pads;
        for entry in pads {
            let clip: AudioClip = self.library.audio.samples[entry.sample];
            let name: str8 = base_name(clip.source);
            let sent: i32 = next.output.instrument_pad(entry.slot, entry.pad, clip.samples, clip.channels, clip.sample_rate, name);
            free(name);
            if sent != 0 { next.release(); return Err<AudioSystem, str8>("Cannot restore a sampler pad; session retained"); }
        }
        next.pads = self.pads;
        // Hand-set slice markers follow their pads' samples.
        let markers: list<PadMarkers> = self.markers;
        for entry in markers {
            var frames: list<f64> = []; let marks: list<i64> = entry.frames;
            for frame in marks { frames.push(f64(frame)); }
            if next.output.instrument_set_markers(wide(entry.slot), wide(entry.pad), frames, false) != 0 {
                next.release(); return Err<AudioSystem, str8>("Cannot restore a pad's slice markers; session retained");
            }
        }
        next.pad_markers = self.markers;
        return Ok<AudioSystem, str8>(next);
    }
}

/// The session inside a project folder.
pub fn project_session() -> str8 { return "Project.mlack"; }
/// True for a `.mlaproj` project folder path, with or without trailing '/'.
pub fn is_project_path(path: str8) -> bool { return tui::table::table_matches(".*\\.[mM][lL][aA][pP][rR][oO][jJ]/*", path); }
/// Owned project folder for `path`: trailing separators dropped and
/// `.mlaproj` appended when missing.
pub fn project_folder(path: str8) -> str8 {
    var end: i64 = len(path);
    while end > 1 {
        let last: str8 = std::strbuf::sub(path, end - 1, 1); let slash: bool = last == "/"; free(last);
        if !slash { break; } end = end - 1;
    }
    let trimmed: str8 = std::strbuf::sub(path, 0, end);
    if is_project_path(trimmed) { return trimmed; }
    let folder: str8 = format!("{}.mlaproj", trimmed); free(trimmed); return folder;
}
/// Owned copy of `name` usable as a file name: control characters and path
/// separators become '_'. May be empty.
fn file_safe(name: str8) -> str8 {
    let raw: result<std::bytes::Bytes, str8> = std::bytes::Bytes::from_string(name);
    if raw.is_err() { return clone(""); }
    let bytes: std::bytes::Bytes = raw.unwrap();
    let builder: i64 = std::strbuf::builder_new(len(name) + 1);
    for i in 0..bytes.len() {
        let ch: i32 = bytes.get(i);
        std::strbuf::builder_append_char(builder, ch < 32 || ch == 127 || ch == 47 || ch == 92 || ch == 58 ? 95 : ch);
    }
    let safe: str8 = std::strbuf::builder_to_string(builder);
    std::strbuf::builder_free(builder); bytes.close(); return safe;
}
/// A project content path is `folder/name`; Audio additionally permits group
/// folders, `Audio/group/.../name`. Components never escape root.
fn content_path(path: str8, folder: str8) -> bool {
    let pattern: str8 = folder == "Audio"
        ? format!("{}/[^./\\\\][^/\\\\]*(/[^./\\\\][^/\\\\]*)*", folder)
        : format!("{}/[^./\\\\][^/\\\\]*", folder);
    let valid: bool = tui::table::table_matches(pattern, path); free(pattern); return valid;
}
/// Owned `name` without an audio file extension (.wav, .aif, .aiff); other
/// dots, as in "kick.wav - 1", stay.
fn audio_stem(name: str8) -> str8 {
    let dot: i64 = std::strbuf::rfind(name, ".");
    if dot <= 0 { return clone(name); }
    let ext: str8 = std::strbuf::sub(name, dot, std::strbuf::len(name) - dot);
    let known: bool = ext == ".wav" || ext == ".WAV" || ext == ".aif" || ext == ".AIF" || ext == ".aiff" || ext == ".AIFF"; free(ext);
    return known ? std::strbuf::sub(name, 0, dot) : clone(name);
}
/// Owned project folder of Audio-list group `group`, relative to the project
/// ("Audio" for none, "Audio/Drums/Kicks" for "Drums/Kicks",
/// "Audio/Drums/loop" for "Drums/loop.wav").
pub fn project_group_folder(group: str8) -> str8 {
    var folder: str8 = clone("Audio");
    var rest: str8 = clone(group);
    while rest != "" {
        let slash: i64 = std::strbuf::find(rest, "/");
        let part: str8 = slash < 0 ? clone(rest) : std::strbuf::sub(rest, 0, slash);
        let tail: str8 = slash < 0 ? clone("") : std::strbuf::sub(rest, slash + 1, std::strbuf::len(rest) - slash - 1);
        // Sample files always end in .wav, so a folder without an audio
        // extension never clashes with one: group "illusion.wav" (named
        // after its clip) is the folder "illusion", beside illusion.wav.
        var bare: str8 = audio_stem(part); free(part);
        var stem: str8 = audio_stem(bare);
        while stem != bare { free(bare); bare = stem; stem = audio_stem(bare); }
        free(stem);
        let safe: str8 = file_safe(bare); free(bare);
        if safe != "" { let deeper: str8 = format!("{}/{}", folder, safe); free(folder); folder = deeper; }
        free(safe); free(rest); rest = tail;
    }
    free(rest);
    return folder;
}
/// True for a group path of non-empty components that are not "." or "..".
fn group_path_valid(path: str8) -> bool {
    return tui::table::table_matches("[^/\\\\]+(/[^/\\\\]+)*", path) && std::strbuf::find(path, "//") < 0 &&
        path != "." && path != ".." && std::strbuf::find(path, "/../") < 0 && std::strbuf::find(path, "/./") < 0 &&
        std::strbuf::starts_with(path, "../") == 0 && std::strbuf::starts_with(path, "./") == 0 &&
        std::strbuf::ends_with(path, "/..") == 0 && std::strbuf::ends_with(path, "/.") == 0;
}
/// Owned group of project audio file `path` (relative, "Audio/a/b/x.wav" ->
/// "a/b"), "" for a file directly in Audio/.
fn path_group(path: str8) -> str8 {
    let slash: i64 = std::strbuf::rfind(path, "/");
    if slash <= 6 { return clone(""); }
    return std::strbuf::sub(path, 6, slash - 6);
}
/// Owned file name stem for the plugin in `slot`.
fn slot_label(slot: i32) -> str8 {
    if slot == 0 { return clone("Master"); }
    if slot <= 32 { return format!("Instrument {}{}", slot < 10 ? "0" : "", slot); }
    if slot <= 40 { return format!("Effect {}", slot - 32); }
    return format!("Insert {}", slot - 40);
}

/// Portable pattern: owned sequence and embedded source clips.
pub struct PatternData { var name: str8; var table: SequenceTable; var clips: list<AudioClip>; };
impl PatternData {
    pub fn release(self: PatternData) -> void {
        free(self.name); self.table.release();
        let clips: list<AudioClip> = self.clips; for clip in clips { clip.release(); }
    }
}
/// Sticky errors prevent a later successful operation from masking truncation.
/// `minor` is the document's minor version: 0 stores two fixed automation
/// slots per track, 1 a counted list, 2 is a project session. `root` is the
/// project folder (empty for a plain session); `problem` explains the first
/// failure involving a project file.
pub struct SessionCodec { var reading: bool; var failed: bool; var binary: SessionBuffer; var reader: SessionReader; var cells: i64; var minor: i32;
    var audio_off: bool;
    var root: str8{""}; var problem: str8{""}; };
impl SessionCodec {
    /// Exposed-parameter preset. Caller joins MIDI before loading; IDs are stable.
    /// Saving with `pads` (sampler pad numbers, with their `clips`) writes a
    /// 1.1 kit preset that also embeds the pad samples.
    pub fn preset_file(path: str8, output: AudioController, slot: i64, saving: bool, pads: list<i32>, clips: list<AudioClip>) -> PresetResult {
        return SessionCodec::preset_body(path, output, slot, saving, pads, clips, false);
    }
    pub fn effect_preset_file(path: str8, output: AudioController, slot: i64, saving: bool) -> PresetResult {
        return SessionCodec::preset_body(path, output, slot, saving, [], [], true);
    }
    fn preset_body(path: str8, output: AudioController, slot: i64, saving: bool, pads: list<i32>, clips: list<AudioClip>, effect: bool) -> PresetResult {
        var result: PresetResult = PresetResult { status: "" };
        let parameters: i64 = output.parameter_info(slot, 0, 0);
        let valid_slot: bool = effect ? (slot == 0 || (slot >= 33 && slot <= 296)) : (slot >= 1 && slot <= 32);
        if !valid_slot || parameters < 0 { result.status = clone(effect ? "Select a loaded effect first" : "Select a loaded instrument first"); return result; }
        let extension: str8 = effect ? ".mlafxpre" : ".mlapre";
        let pattern: str8 = effect ? ".*\\.[mM][lL][aA][fF][xX][pP][rR][eE]" : ".*\\.[mM][lL][aA][pP][rR][eE]";
        let actual: str8 = saving && !tui::table::table_matches(pattern, path) ? format!("{}{}", path, extension) : clone(path);
        var codec: SessionCodec = SessionCodec { reading: !saving };
        if saving {
            let created: result<SessionBuffer, str8> = SessionBuffer::new(4096);
            if created.is_err() { free(actual); result.status = clone("Cannot allocate plugin preset"); return result; }
            codec.binary = created.unwrap();
        } else {
            let opened: result<File, str8> = File::open(actual);
            if opened.is_err() { free(actual); result.status = clone("Cannot open plugin preset"); return result; }
            let file: File = opened.unwrap(); let size: result<i64, str8> = file.size(); file.close();
            if size.is_err() { free(actual); result.status = clone("Cannot read plugin preset"); return result; }
            if size.unwrap() > 268435456 { free(actual); result.status = clone("Plugin preset exceeds 256 MiB"); return result; }
            let read: result<SessionReader, str8> = SessionReader::from_file(actual);
            if read.is_err() { free(actual); result.status = clone("Cannot read plugin preset"); return result; }
            codec.reader = read.unwrap();
        }
        let expected_magic: str8 = effect ? "MLAFXPRE" : "MLAPRE";
        let magic: str8 = codec.text(expected_magic);
        if magic != expected_magic { codec.failed = true; } if !saving { free(magic); }
        codec.number(1, 1, 1);
        let minor: i32 = codec.number(saving && pads.len() > 0 ? 1 : 0, 0, effect ? 0 : 1);
        let plugin_name: str8 = slot == 0 ? output.processor_name() : output.instrument_name(slot);
        let name: str8 = codec.text(plugin_name);
        if name != plugin_name { codec.failed = true; } if !saving { free(name); }
        let count: i32 = codec.number(i32(parameters), 0, 16384);
        if count != parameters { codec.failed = true; }
        var ids: list<i64> = []; var indices: list<i64> = []; var values: list<f64> = []; var previous: list<f64> = [];
        for i in 0..count {
            if codec.failed { break; }
            let source_id: i64 = saving ? output.parameter_info(slot, i, 4) : 0.0;
            let id: i64 = codec.integer(source_id, 0, 4294967295);
            let value: f64 = codec.real(saving ? output.parameter_info(slot, i, 2) : 0.0, 0.0, 1.0);
            if !saving {
                var found: i64 = -1;
                for index in 0..parameters { if output.parameter_info(slot, index, 4) == f64(id) { found = index; } }
                for seen in ids { if seen == id { codec.failed = true; } }
                if found < 0 { codec.failed = true; }
                ids.push(id); indices.push(found); values.push(value); previous.push(output.parameter_info(slot, found, 2));
            }
        }
        // 1.1: tagged sampler pads, strictly increasing pad numbers, session clip encoding.
        if minor == 1 && !codec.failed {
            let tag: str8 = codec.text("SAMPLER_PADS"); if tag != "SAMPLER_PADS" { codec.failed = true; } if !saving { free(tag); }
            let count: i32 = codec.number(i32(pads.len()), 0, 64);
            var previous: i32 = -1;
            for i in 0..count {
                if codec.failed { break; }
                let pad: i32 = codec.number(saving ? pads[i] : 0, previous + 1, 127); previous = pad;
                var clip: AudioClip = AudioClip {}; if saving { clip = clips[i]; }
                let decoded: AudioClip = codec.clip(clip);
                if !saving { result.pads.push(pad); result.clips.push(decoded); }
            }
            if !saving { result.has_pads = true; }
        }
        if saving {
            if !codec.failed { let written: result<i32, str8> = codec.binary.write_atomic(actual); if written.is_err() { codec.failed = true; } }
            codec.binary.close();
            let status: str8 = codec.failed ? clone("Cannot save plugin preset") : format!("Saved plugin preset: {}", actual);
            result.ok = !codec.failed;
            free(actual); result.status = status; return result;
        }
        if codec.reader.remaining() != 0 { codec.failed = true; } codec.reader.close();
        if codec.failed {
            let decoded: list<AudioClip> = result.clips; for clip in decoded { clip.release(); }
            result.clips = []; result.pads = []; result.has_pads = false;
            free(actual); result.status = clone("Invalid/incompatible plugin preset; parameters unchanged"); return result;
        }
        let restart: bool = output.hardware_output();
        if output.stop() != 0 { free(actual); result.status = clone("Cannot stop audio; preset not loaded"); return result; }
        output.panic(); output.midi_learn(-1, 0, 0);
        for i in 0..indices.len() {
            if output.restore_parameter(slot, indices[i], values[i]) != 0 { codec.failed = true; break; }
        }
        if codec.failed { for i in 0..indices.len() { output.restore_parameter(slot, indices[i], previous[i]); } }
        var status: str8 = codec.failed ? clone("Plugin rejected preset; previous parameters restored where possible") : format!("Loaded plugin preset: {}", actual);
        result.ok = !codec.failed;
        if restart { if output.start() != 0 { free(status); status = clone("Preset processed but audio restart failed; reopen Settings"); } }
        free(actual); result.status = status; return result;
    }
    /// Mla Sampler slot preset (.mlaslot): one slot's parameters, as
    /// slot-independent `keys` (see SamplerView::slot_key) with their
    /// normalized `values`, and its sample when `has_clip`. Loading returns
    /// them in the result (`clips` empty for a slot without a sample) and
    /// leaves applying them to the caller.
    pub fn sampler_slot_file(path: str8, plugin_name: str8, saving: bool, keys: list<i64>, values: list<f64>, clip: AudioClip, has_clip: bool) -> PresetResult {
        var result: PresetResult = PresetResult { status: "" };
        let actual: str8 = saving && !tui::table::table_matches(".*\\.[mM][lL][aA][sS][lL][oO][tT]", path) ? format!("{}.mlaslot", path) : clone(path);
        var codec: SessionCodec = SessionCodec { reading: !saving };
        if saving {
            let created: result<SessionBuffer, str8> = SessionBuffer::new(4096);
            if created.is_err() { free(actual); result.status = clone("Cannot allocate slot preset"); return result; }
            codec.binary = created.unwrap();
        } else {
            let opened: result<File, str8> = File::open(actual);
            if opened.is_err() { free(actual); result.status = clone("Cannot open slot preset"); return result; }
            let file: File = opened.unwrap(); let size: result<i64, str8> = file.size(); file.close();
            if size.is_err() || size.unwrap() > 268435456 { free(actual); result.status = clone("Cannot read slot preset"); return result; }
            let read: result<SessionReader, str8> = SessionReader::from_file(actual);
            if read.is_err() { free(actual); result.status = clone("Cannot read slot preset"); return result; }
            codec.reader = read.unwrap();
        }
        let magic: str8 = codec.text("MLASLOT");
        if magic != "MLASLOT" { codec.failed = true; } if !saving { free(magic); }
        codec.number(1, 1, 1); codec.number(0, 0, 0);
        let name: str8 = codec.text(plugin_name);
        if name != plugin_name { codec.failed = true; } if !saving { free(name); }
        let count: i32 = codec.number(i32(keys.len()), 0, 4096);
        for i in 0..count {
            if codec.failed { break; }
            let key: i64 = codec.integer(saving ? keys[i] : 0, 0, 1048575);
            let value: f64 = codec.real(saving ? values[i] : 0.0, 0.0, 1.0);
            if !saving {
                let seen: list<i64> = result.keys;
                for other in seen { if other == key { codec.failed = true; } }
                result.keys.push(key); result.values.push(value);
            }
        }
        let sampled: bool = codec.flag(has_clip);
        if sampled && !codec.failed {
            var source: AudioClip = AudioClip {}; if saving { source = clip; }
            let decoded: AudioClip = codec.clip(source);
            if !saving { result.clips.push(decoded); }
        }
        if saving {
            if !codec.failed { let written: result<i32, str8> = codec.binary.write_atomic(actual); if written.is_err() { codec.failed = true; } }
            codec.binary.close();
            result.ok = !codec.failed;
            result.status = codec.failed ? clone("Cannot save slot preset") : format!("Saved slot preset: {}", actual);
            free(actual); return result;
        }
        if codec.reader.remaining() != 0 { codec.failed = true; } codec.reader.close();
        if codec.failed {
            let decoded: list<AudioClip> = result.clips; for unused in decoded { unused.release(); }
            result.clips = []; result.keys = []; result.values = [];
            free(actual); result.status = clone("Invalid/incompatible slot preset; slot unchanged"); return result;
        }
        result.ok = true; result.status = format!("Loaded slot preset: {}", actual);
        free(actual); return result;
    }
    pub fn learn_suggestion(name: str8) -> str8 {
        let safe: str8 = file_safe(name);
        let suggested: str8 = format!("{} - ", safe == "" && name != "" ? "Instrument" : safe);
        free(safe); return suggested;
    }
    /// Portable, per-plugin MIDI mappings. Validate completely before replacing.
    pub fn learn_file(path: str8, output: AudioController, slot: i64, saving: bool) -> str8 {
        if slot < 1 || output.parameter_info(slot, 0, 0) < 0.0 { return clone("Select a loaded instrument first"); }
        let actual: str8 = saving && !tui::table::table_matches(".*\\.[mM][lL][aA][lL][eE][aA][rR][nN]", path) ? format!("{}.mlalearn", path) : clone(path);
        var codec: SessionCodec = SessionCodec { reading: !saving };
        if saving {
            let created: result<SessionBuffer, str8> = SessionBuffer::new(4096);
            if created.is_err() { free(actual); return clone("Cannot allocate MIDI learn file"); }
            codec.binary = created.unwrap();
        } else {
            let opened: result<File, str8> = File::open(actual);
            if opened.is_err() { free(actual); return clone("Cannot open MIDI learn file"); }
            let file: File = opened.unwrap(); let size: result<i64, str8> = file.size(); file.close();
            if size.is_err() { free(actual); return clone("Cannot read MIDI learn file"); }
            if size.unwrap() > 65536 { free(actual); return clone("MIDI learn file exceeds 64 KiB"); }
            let read: result<SessionReader, str8> = SessionReader::from_file(actual);
            if read.is_err() { free(actual); return clone("Cannot read MIDI learn file"); }
            codec.reader = read.unwrap();
        }
        let magic: str8 = codec.text("MLALEARN");
        if magic != "MLALEARN" { codec.failed = true; } if !saving { free(magic); }
        codec.number(1, 1, 1); codec.number(0, 0, 0);
        let plugin_name: str8 = slot == 0 ? output.processor_name() : output.instrument_name(slot);
        let name: str8 = codec.text(plugin_name);
        if name != plugin_name { codec.failed = true; } if !saving { free(name); }
        var keys: list<i64> = []; var ids: list<i64> = []; var indices: list<i64> = [];
        if saving {
            for key in 0..2048 {
                let destination: i64 = output.midi_learn_info(key, 2);
                if destination % 64 == slot {
                    let id: i64 = output.parameter_info(slot, destination / 64, 4);
                    keys.push(key); ids.push(id);
                }
            }
        }
        let count: i32 = codec.number(i32(keys.len()), 0, 2048);
        var previous: i64 = -1;
        let parameters: i64 = output.parameter_info(slot, 0, 0);
        for i in 0..count {
            if codec.failed { break; }
            let key: i64 = codec.integer(saving ? keys[i] : 0, previous + 1, 2047); previous = key;
            let id: i64 = codec.integer(saving ? ids[i] : 0, 0, 4294967295);
            if !saving {
                var found: i64 = -1;
                for index in 0..parameters { if output.parameter_info(slot, index, 4) == f64(id) { found = index; } }
                if found < 0 { codec.failed = true; }
                else { if output.parameter_info(slot, found, 3) != 0.0 { codec.failed = true; } }
                let owner: i64 = output.midi_learn_info(key, 0);
                if owner != 0 && owner != slot { codec.failed = true; }
                keys.push(key); indices.push(found);
            }
        }
        if !saving { if codec.reader.remaining() != 0 { codec.failed = true; } codec.reader.close(); }
        var status: str8 = "";
        if saving {
            if !codec.failed { let written: result<i32, str8> = codec.binary.write_atomic(actual); if written.is_err() { codec.failed = true; } }
            codec.binary.close();
            status = codec.failed ? clone("Cannot save MIDI learn file") : format!("Saved MIDI learn: {}", actual);
        } else {
            if codec.failed { status = clone("Invalid/incompatible MIDI learn file or CC assigned to another instrument; mappings unchanged"); }
            else {
                output.midi_learn(-1, 0, 0);
                for key in 0..2048 { if output.midi_learn_info(key, 0) == slot { output.midi_learn(key, 0, 0); } }
                for i in 0..keys.len() { output.midi_learn(keys[i], slot, indices[i]); }
                status = format!("Loaded MIDI learn: {}", actual);
            }
        }
        free(actual); return status;
    }
    fn integer(self: &mut Self, value: i64, minimum: i64, maximum: i64) -> i64 {
        if !self.reading && self.binary.len() > 268431352 { self.failed = true; }
        if self.failed { return 0; }
        var number: i64 = value;
        if self.reading { let result: result<i64, str8> = self.reader.read_i64(); if result.is_err() { self.failed = true; return 0; } number = result.unwrap(); }
        if number < minimum || number > maximum { self.failed = true; return 0; }
        if !self.reading { let result: result<i32, str8> = self.binary.write_i64(number); if result.is_err() { self.failed = true; } }
        return number;
    }
    fn number(self: &mut Self, value: i32, minimum: i32, maximum: i32) -> i32 { return i32(self.integer(wide(value), wide(minimum), wide(maximum))); }
    fn flag(self: &mut Self, value: bool) -> bool { return self.number(value ? 1 : 0, 0, 1) == 1; }
    fn real(self: &mut Self, value: f64, low: f64, high: f64) -> f64 {
        if !self.reading && self.binary.len() > 268431352 { self.failed = true; }
        if self.failed { return 0.0; }
        var number: f64 = value;
        if self.reading { let result: result<f64, str8> = self.reader.read_f64(); if result.is_err() { self.failed = true; return 0.0; } number = result.unwrap(); }
        if !(number >= low && number <= high) { self.failed = true; return 0.0; }
        if !self.reading { let result: result<i32, str8> = self.binary.write_f64(number); if result.is_err() { self.failed = true; } }
        return number;
    }
    fn text(self: &mut Self, value: str8) -> str8 {
        if !self.reading && self.binary.len() > 268431352 { self.failed = true; }
        if self.reading {
            if self.failed { return clone(""); }
            let result: result<str8, str8> = self.reader.read_string();
            if result.is_err() { self.failed = true; return clone(""); }
            let text: str8 = result.unwrap();
            if len(text) > 4096 { self.failed = true; }
            return text;
        }
        if len(value) > 4096 { self.failed = true; return value; }
        if !self.failed { let result: result<i32, str8> = self.binary.write_string(value); if result.is_err() { self.failed = true; } }
        return value;
    }
    fn clip(self: &mut Self, source: AudioClip) -> AudioClip {
        var clip: AudioClip = AudioClip {}; clip = source;
        clip.source = self.text(self.reading ? "" : clip.source);
        clip.channels = self.integer(clip.channels, 1, 2); clip.sample_rate = self.integer(clip.sample_rate, 1000, 768000);
        clip.frames = self.integer(clip.frames, 1, 16777216); clip.frames_per_row = self.integer(clip.frames_per_row, 1, 16777216);
        let count: i64 = clip.frames * clip.channels;
        if self.reading && count > self.reader.remaining() / 8 { self.failed = true; }
        if !self.reading && clip.samples.len() != count { self.failed = true; }
        var samples: list<f32> = [];
        for i in 0..count {
            if self.failed { break; }
            let value: f64 = self.real(self.reading ? 0.0 : f64(clip.samples[i]), -1.0, 1.0);
            if self.reading { samples.push(f32(value)); }
        }
        if self.reading { clip.samples = samples; }
        let peaks: i32 = self.number(i32(clip.peaks.len()), 1, 16384);
        var output: list<WavePeak> = [];
        for i in 0..peaks {
            var peak: WavePeak = WavePeak {}; if !self.reading { peak = clip.peaks[i]; }
            peak.left = self.number(peak.left, 0, 1000); peak.right = self.number(peak.right, 0, 1000);
            peak.left_body = self.number(peak.left_body, 0, 1000); peak.right_body = self.number(peak.right_body, 0, 1000);
            output.push(peak);
        }
        if self.reading { clip.peaks = output; }
        let details: i32 = self.number(i32(clip.detail_peaks.len()), 0, 65536);
        var detail: list<WavePeak> = [];
        for i in 0..details {
            var peak: WavePeak = WavePeak {}; if !self.reading { peak = clip.detail_peaks[i]; }
            peak.left = self.number(peak.left, 0, 1000); peak.right = self.number(peak.right, 0, 1000); detail.push(peak);
        }
        if self.reading { clip.detail_peaks = detail; }
        if !self.failed {
            if peaks != (clip.frames + clip.frames_per_row - 1) / clip.frames_per_row || details != peaks * 4 { self.failed = true; }
        }
        // Even a partially decoded clip owns its source string.
        if self.reading && clip.peaks.len() == 0 { clip.peaks.push(WavePeak {}); }
        return clip;
    }
    fn fail_with(self: &mut Self, problem: str8) -> void {
        if !self.failed && self.problem == "" { self.problem = problem; } else { free(problem); }
        self.failed = true;
    }
    /// Owned project folder of Audio-list group `group` (see
    /// project_group_folder), created when saving.
    fn group_folder(self: &mut Self, group: str8) -> str8 {
        let folder: str8 = project_group_folder(group);
        if !self.reading && !self.failed && folder != "Audio" {
            let full: str8 = format!("{}/{}", self.root, folder);
            let made: result<i32, str8> = std::fs::mkdir_p(full);
            if made.is_err() { self.fail_with(format!("Cannot create {}", folder)); }
            free(full);
        }
        return folder;
    }
    /// Owned `folder/stem extension` path that is still free under the
    /// project root; later files with the same stem are numbered.
    fn unique_file(self: &mut Self, folder: str8, stem: str8, extension: str8) -> str8 {
        var name: str8 = format!("{}/{}{}", folder, stem, extension);
        for n in 2..100000 {
            let full: str8 = format!("{}/{}", self.root, name);
            let taken: bool = std::fs::file_exists(full) == 1; free(full);
            if !taken { break; }
            free(name); name = format!("{}/{} {}{}", folder, stem, n, extension);
        }
        return name;
    }
    /// Project sample: the PCM is a float WAV in Audio/ and the session keeps
    /// its relative path, format and row size. Peaks are rebuilt on load.
    /// A sample in group `group` is written to that group's folder, e.g.
    /// Audio/Drums/Kicks/kick.wav for "Drums/Kicks".
    fn clip_file(self: &mut Self, source: AudioClip, index: i64, group: str8) -> AudioClip {
        var clip: AudioClip = AudioClip {}; clip = source;
        var name: str8 = clone("");
        if !self.reading && !self.failed {
            let folder: str8 = self.group_folder(group);
            let label: str8 = audio_label(clip.source); let base: str8 = audio_stem(label); free(label);
            let safe: str8 = file_safe(base); free(base);
            let stem: str8 = safe == "" ? format!("Sample {}", index + 1) : clone(safe); free(safe);
            free(name); name = self.unique_file(folder, stem, ".wav"); free(stem); free(folder);
            let full: str8 = format!("{}/{}", self.root, name);
            if !clip.write_wav(full) {
                self.fail_with(format!("Cannot write {}", name));
            }
            free(full);
        }
        let path: str8 = self.text(name);
        clip.channels = self.integer(clip.channels, 1, 2); clip.sample_rate = self.integer(clip.sample_rate, 1000, 768000);
        clip.frames = self.integer(clip.frames, 1, 16777216); clip.frames_per_row = self.integer(clip.frames_per_row, 1, 16777216);
        if !self.reading { free(name); return clip; }
        free(name);
        var decoded: AudioClip = AudioClip { source: clone("") };
        if !self.failed && (clip.frames + clip.frames_per_row - 1) / clip.frames_per_row > 16384 { self.failed = true; }
        if !self.failed && !content_path(path, "Audio") { self.fail_with(format!("Invalid audio path: {}", path)); }
        if !self.failed {
            let full: str8 = format!("{}/{}", self.root, path);
            let loaded: result<PcmAudio, str8> = PcmAudio::load(full);
            if loaded.is_err() { self.fail_with(format!("Missing or unreadable audio file: {}", path)); }
            else {
                let audio: PcmAudio = loaded.unwrap();
                if audio.channels() != clip.channels || audio.sample_rate() != clip.sample_rate || audio.frame_count() != clip.frames {
                    self.fail_with(format!("Audio file changed since the project was saved: {}", path));
                } else {
                    let template: AudioClip = AudioClip { source: full, channels: clip.channels, sample_rate: clip.sample_rate, frames_per_row: clip.frames_per_row };
                    free(decoded.source); decoded = template.with_samples(audio.samples());
                }
                audio.close();
            }
            free(full);
        }
        free(path);
        // Even a failed clip owns its source string.
        if decoded.peaks.len() == 0 { decoded.peaks.push(WavePeak {}); }
        return decoded;
    }
    /// Project plugin state: a preset in Presets/ named by relative path in
    /// place of inline parameters. `effect` selects the .mlafxpre format.
    fn preset_reference(self: &mut Self, source: PluginSnapshot, output: AudioController, effect: bool) -> PluginSnapshot {
        var plugin: PluginSnapshot = PluginSnapshot {}; plugin = source;
        var name: str8 = clone("");
        if !self.reading && !self.failed && plugin.path != "" {
            let label: str8 = slot_label(plugin.slot);
            let safe: str8 = file_safe(plugin.slot == 0 ? output.processor_name() : output.instrument_name(plugin.slot));
            let stem: str8 = safe == "" ? clone(label) : format!("{} - {}", label, safe); free(label); free(safe);
            free(name); name = self.unique_file("Presets", stem, effect ? ".mlafxpre" : ".mlapre"); free(stem);
            let full: str8 = format!("{}/{}", self.root, name);
            let saved: PresetResult = SessionCodec::preset_body(full, output, plugin.slot, true, [], [], effect);
            if !saved.ok { self.fail_with(format!("Cannot write {}", name)); }
            free(saved.status); free(full);
        }
        let path: str8 = self.text(name);
        if self.reading && !self.failed {
            if plugin.path == "" { if path != "" { self.failed = true; } }
            else if !content_path(path, "Presets") { self.fail_with(format!("Invalid preset path: {}", path)); }
            else {
                let full: str8 = format!("{}/{}", self.root, path);
                let values: result<PluginSnapshot, str8> = SessionCodec::preset_values(full, effect);
                if values.is_err() { self.fail_with(format!("{}: {}", values.unwrap_err(), path)); }
                else { let read: PluginSnapshot = values.unwrap(); plugin.ids = read.ids; plugin.values = read.values; }
                free(full);
            }
        }
        if self.reading { free(path); }
        free(name); return plugin;
    }
    /// Parameter IDs and values of a plugin preset, without applying them.
    fn preset_values(path: str8, effect: bool) -> result<PluginSnapshot, str8> {
        let opened: result<File, str8> = File::open(path);
        if opened.is_err() { return Err<PluginSnapshot, str8>("Missing preset file"); }
        let file: File = opened.unwrap(); let size: result<i64, str8> = file.size(); file.close();
        if size.is_err() || size.unwrap() > 268435456 { return Err<PluginSnapshot, str8>("Unreadable preset file"); }
        let read: result<SessionReader, str8> = SessionReader::from_file(path);
        if read.is_err() { return Err<PluginSnapshot, str8>("Unreadable preset file"); }
        var codec: SessionCodec = SessionCodec { reading: true, reader: read.unwrap() };
        let expected: str8 = effect ? "MLAFXPRE" : "MLAPRE";
        let magic: str8 = codec.text(""); if magic != expected { codec.failed = true; } free(magic);
        codec.number(1, 1, 1);
        let minor: i32 = codec.number(0, 0, effect ? 0 : 1);
        let name: str8 = codec.text(""); free(name);
        var plugin: PluginSnapshot = PluginSnapshot { path: "" };
        let count: i32 = codec.number(0, 0, 16384);
        for _i in 0..count {
            if codec.failed { break; }
            let id: i64 = codec.integer(0, 0, 4294967295);
            let value: f64 = codec.real(0.0, 0.0, 1.0);
            let ids: list<i64> = plugin.ids; for old in ids { if old == id { codec.failed = true; } }
            plugin.ids.push(id); plugin.values.push(value);
        }
        // A kit preset's pads belong to the session; skip them.
        if minor == 1 && !codec.failed {
            let tag: str8 = codec.text(""); if tag != "SAMPLER_PADS" { codec.failed = true; } free(tag);
            let pads: i32 = codec.number(0, 0, 64);
            var previous: i32 = -1;
            for _i in 0..pads {
                if codec.failed { break; }
                previous = codec.number(0, previous + 1, 127);
                let clip: AudioClip = codec.clip(AudioClip {}); clip.release();
            }
        }
        if codec.reader.remaining() != 0 { codec.failed = true; } codec.reader.close();
        if codec.failed { return Err<PluginSnapshot, str8>("Invalid or incompatible preset file"); }
        return Ok<PluginSnapshot, str8>(plugin);
    }
    /// AUDIO_PROPERTIES of one pattern: a track count matching it, then per
    /// track a count matching its audio placements and per placement its
    /// exclusive frame end (0 = none), original BPM (0 or 20-400), sync mode
    /// (0-5), pitch (-24..24, 0 below Stretch), resampling (0-3) and
    /// Transients 2 loop mode (0-2). Returns the pattern with them applied.
    fn audio_properties(self: &mut Self, source: &SequenceTable) -> SequenceTable {
        var table: SequenceTable = SequenceTable {}; table = source;
        let track_count: i32 = self.number(i32(table.tracks.len()), 0, 64);
        if track_count != table.tracks.len() { self.failed = true; return table; }
        var tracks: list<SequenceTrack> = [];
        for t in 0..track_count {
            var track: SequenceTrack = table.tracks[t];
            let count: i32 = self.number(i32(track.instances.len()), 0, 16384);
            if count != track.instances.len() { self.failed = true; return table; }
            var placements: list<AudioInstance> = [];
            for j in 0..count {
                var instance: AudioInstance = AudioInstance {}; instance = track.instances[j];
                instance.frame_end = self.integer(instance.frame_end, 0, 16777216);
                if instance.frame_end != 0 && (instance.frame_end <= instance.offset_frames || instance.frame_end > instance.clip.frames) { self.failed = true; }
                instance.original_bpm = self.number(instance.original_bpm, 0, 400);
                if instance.original_bpm > 0 && instance.original_bpm < 20 { self.failed = true; }
                instance.stretch_algorithm = self.number(instance.stretch_algorithm, 0, 5);
                instance.pitch = self.number(instance.pitch, -24, 24);
                if instance.pitch != 0 && instance.stretch_algorithm < 2 { self.failed = true; }
                instance.resample = self.number(instance.resample, 0, 3);
                instance.loop_mode = self.number(instance.loop_mode, 0, 2);
                placements.push(instance);
            }
            track.instances = placements; tracks.push(track);
        }
        if self.reading { table.tracks = tracks; }
        return table;
    }
    fn sequence_data(self: &mut Self, source: &SequenceTable, samples: list<AudioClip>) -> SequenceTable {
        var table: SequenceTable = SequenceTable {}; table = source;
        if self.reading {
            table = SequenceTable::empty();
            let old: list<TableRow> = table.rows; for row in old { let cells: list<str8> = row.cells; for cell in cells { free(cell); } }
            table.rows = [];
        }
        table.next_track_id = self.number(table.next_track_id, 1, 1000000);
        table.selected_row = self.number(table.selected_row, -1, 16383); table.selected_column = self.number(table.selected_column, -1, 20000);
        table.scroll_x = self.number(table.scroll_x, 0, 1000000); table.scroll_y = self.number(table.scroll_y, 0, 16383);
        table.horizontal_scrollbar = self.flag(table.horizontal_scrollbar); table.vertical_scrollbar = self.flag(table.vertical_scrollbar);
        table.alternate_group_text = self.flag(table.alternate_group_text);
        let tracks: i32 = self.number(i32(table.tracks.len()), 0, 64); var track_list: list<SequenceTrack> = [];
        for i in 0..tracks {
            var track: SequenceTrack = SequenceTrack {}; if !self.reading { track = table.tracks[i]; }
            track.name = self.text(self.reading ? "" : track.name); track.muted = self.flag(track.muted);
            track.volume = self.number(track.volume, 0, 127); track.pan = self.number(track.pan, -100, 100);
            track.audio = self.flag(track.audio); track.instrument = self.flag(track.instrument);
            track.instrument_id = self.number(track.instrument_id, 0, 32);
            track.note_lines = self.number(track.note_lines, 1, 64);
            // The TEXT column flag takes the retired waveform-zoom flag's
            // place, which older versions wrote as 0.
            track.comment = self.flag(track.comment); if track.audio && track.comment { self.failed = true; }
            track.zoom_stage = self.number(track.zoom_stage, 0, 2);
            // 1.0 documents always carry two slots.
            let slots: i32 = self.minor == 0 ? 2 : self.number(i32(track.automation.len()), 0, automation_limit());
            var automation: list<AutomationSlot> = [];
            for s in 0..slots {
                var slot: AutomationSlot = AutomationSlot { parameter: "" }; if !self.reading { slot = track.automation[s]; }
                let parameter: str8 = self.text(self.reading ? "" : slot.parameter);
