                let entry: PatternEntry = library.patterns[library.index_of(library.active_id)];
                library.table.release(); library.table = entry.data.copy_pattern();
            }
        }
        // Optional MATRIX_GRID extension: how many pattern rows one matrix row
        // holds. Missing means 64, which is what every 1.0 session played.
        let grid_extension: bool = self.reading ? self.reader.remaining() > 0 : gridded || mastered;
        var grid_read: bool = false;
        if grid_extension && !self.failed {
            let tag: str8 = self.text("MATRIX_GRID"); if tag != "MATRIX_GRID" { self.failed = true; } if self.reading { free(tag); }
            let steps: i32 = self.number(library.matrix_steps, 1, 16384);
            if self.reading { library.matrix_steps = steps; grid_read = true; }
        }
        // A session saved before matrix rows had a length takes one from its
        // own patterns, so a song of 16-row patterns plays them one per row.
        if self.reading && !grid_read { library.matrix_steps = library.derive_matrix_steps(); }
        // Optional MASTER_BUS extension: spectrum analyzer view (visible,
        // detail, FPS) and the master high-pass, four EQ bands and volume.
        let master_extension: bool = self.reading ? self.reader.remaining() > 0 : mastered;
        if master_extension && !self.failed {
            let tag: str8 = self.text("MASTER_BUS"); if tag != "MASTER_BUS" { self.failed = true; } if self.reading { free(tag); }
            var bus: MasterBus = MasterBus {}; if !self.reading { bus = state.master; }
            state.spectrum = self.flag(state.spectrum);
            state.spectrum_detail = self.number(state.spectrum_detail, 0, 2);
            state.spectrum_fps = self.number(state.spectrum_fps, 1, 60);
            bus.hp_hz = self.number(bus.hp_hz, 0, 1000); bus.volume = self.number(bus.volume, 0, 150);
            for band in 0..4 {
                let b: i32 = i32(band);
                let hz: i32 = self.number(bus.band_hz(b), 20, 20000);
                let gain: i32 = self.number(bus.band_gain(b), -120, 120);
                let q: i32 = self.number(bus.band_q(b), 30, 1000);
                bus.set_band(b, hz, gain, q);
            }
            // EQ in/out came later: a file ending before it has the EQ in.
            if !self.reading || self.reader.remaining() > 0 { bus.eq_on = self.flag(bus.eq_on); }
            if !bus.valid() { self.failed = true; }
            if self.reading { state.master = bus; state.master_saved = true; }
        }
        // Optional MATRIX_LOOPS extension: cells whose pattern loops down its
        // lane (kind 1) and splits that end a loop or long pattern (kind 2),
        // as lane, row, kind. The lanes above store these cells' plain IDs.
        let loops_extension: bool = self.reading ? self.reader.remaining() > 0 : looped || aux_routed;
        if loops_extension && !self.failed {
            let tag: str8 = self.text("MATRIX_LOOPS"); if tag != "MATRIX_LOOPS" { self.failed = true; } if self.reading { free(tag); }
            var cells: list<i32> = [];
            if !self.reading {
                for l in 0..library.song_lanes() {
                    for r in 0..library.song.len() {
                        if library.song_loops(i32(r), i32(l)) { cells.push(i32(l)); cells.push(i32(r)); cells.push(1); }
                        if library.song_split(i32(r), i32(l)) { cells.push(i32(l)); cells.push(i32(r)); cells.push(2); }
                    }
                }
            }
            let count: i32 = self.number(i32(cells.len()) / 3, 0, 1048576);
            for i in 0..count {
                if self.failed { break; }
                let lane: i32 = self.number(self.reading ? 0 : cells[i * 3], 0, 15);
                let row: i32 = self.number(self.reading ? 0 : cells[i * 3 + 1], 0, 65535);
                let kind: i32 = self.number(self.reading ? 0 : cells[i * 3 + 2], 1, 2);
                if !self.reading { continue; }
                // A loop needs a pattern in its cell; a split needs an empty one.
                if lane >= library.song_lanes() || row >= library.song.len() { self.failed = true; break; }
                let id: i32 = library.song_at(row, lane);
                if (kind == 1) != (id > 0) || library.song_raw(row, lane) != id { self.failed = true; break; }
                library.set_song_raw(row, lane, kind == 1 ? id + song_loop_flag() : song_end_marker());
            }
        }
        // Optional AUX_OUTPUTS extension: per pattern track, the routes of its
        // instrument's aux output buses (Out 2 first): -1 = with the main
        // output, 0 = master, otherwise a track index + 1. A route to a track
        // that is not an AUDIO track reads as -1 when played.
        let aux_extension: bool = self.reading ? self.reader.remaining() > 0 : aux_routed;
        if aux_extension && !self.failed {
            let tag: str8 = self.text("AUX_OUTPUTS"); if tag != "AUX_OUTPUTS" { self.failed = true; } if self.reading { free(tag); }
            let patterns: list<PatternEntry> = library.patterns; var updated: list<PatternEntry> = [];
            for p in 0..patterns.len() {
                if self.failed { break; }
                var entry: PatternEntry = patterns[p]; if !self.reading && entry.id == library.active_id { entry.data = library.table; }
                let track_count: i32 = self.number(i32(entry.data.tracks.len()), 0, 64);
                if track_count != entry.data.tracks.len() { self.failed = true; break; }
                var tracks: list<SequenceTrack> = [];
                for t in 0..track_count {
                    var track: SequenceTrack = entry.data.tracks[t];
                    let buses: i32 = self.number(i32(track.aux_outputs.len()), 0, 15);
                    var aux: list<i32> = [];
                    for b in 0..buses {
                        // -2 .. -9 feed an aux effect channel, -10 nowhere.
                        let destination: i32 = self.number(self.reading ? 0 : track.aux_outputs[b], -10, track_count);
                        if destination - 1 == i32(t) { self.failed = true; }
                        aux.push(destination);
                    }
                    if self.reading { track.aux_outputs = aux; }
                    tracks.push(track);
                }
                if self.reading { entry.data.tracks = tracks; updated.push(entry); }
            }
            if self.reading && !self.failed {
                library.patterns = updated;
                let entry: PatternEntry = library.patterns[library.index_of(library.active_id)];
                library.table.release(); library.table = entry.data.copy_pattern();
            }
        }
        // Optional PAD_MARKERS extension: slice markers set by hand, per
        // sampler pad (which must be one of the pads above), as frames
        // ascending from 0.
        var markers: list<PadMarkers> = [];
        let markers_extension: bool = self.reading ? self.reader.remaining() > 0 : marked;
        if markers_extension && !self.failed {
            let tag: str8 = self.text("PAD_MARKERS"); if tag != "PAD_MARKERS" { self.failed = true; } if self.reading { free(tag); }
            let count: i32 = self.number(i32(audio.pad_markers.len()), 0, 4096);
            for i in 0..count {
                if self.failed { break; }
                var entry: PadMarkers = PadMarkers {}; if !self.reading { entry = audio.pad_markers[i]; }
                let marker_slot: i32 = self.number(entry.slot, 1, 32);
                let marker_pad: i32 = self.number(entry.pad, 0, 127);
                var known: bool = false; for pad in pads { if pad.slot == marker_slot && pad.pad == marker_pad { known = true; } }
                if !known { self.failed = true; break; }
                let frame_count: i32 = self.number(i32(entry.frames.len()), 1, 65536);
                var frames: list<i64> = [];
                var previous: i64 = -1;
                for f in 0..frame_count {
                    let frame: i64 = self.integer(self.reading ? 0 : entry.frames[f], 0, 16777216);
                    if (f == 0 && frame != 0) || frame <= previous { self.failed = true; break; }
                    previous = frame; frames.push(frame);
                }
                markers.push(PadMarkers { slot: marker_slot, pad: marker_pad, frames: frames });
            }
        }
        // Optional INSTRUMENT_INPUTS extension: per pattern track, the AUDIO
        // track (index + 1) feeding its instrument's audio input, -1 for the
        // live audio input, or 0.
        let inputs_extension: bool = self.reading ? self.reader.remaining() > 0 : inputs_routed;
        if inputs_extension && !self.failed {
            let tag: str8 = self.text("INSTRUMENT_INPUTS"); if tag != "INSTRUMENT_INPUTS" { self.failed = true; } if self.reading { free(tag); }
            let patterns: list<PatternEntry> = library.patterns; var updated: list<PatternEntry> = [];
            for p in 0..patterns.len() {
                if self.failed { break; }
                var entry: PatternEntry = patterns[p]; if !self.reading && entry.id == library.active_id { entry.data = library.table; }
                let track_count: i32 = self.number(i32(entry.data.tracks.len()), 0, 64);
                if track_count != entry.data.tracks.len() { self.failed = true; break; }
                var tracks: list<SequenceTrack> = [];
                for t in 0..track_count {
                    var track: SequenceTrack = entry.data.tracks[t];
                    let source: i32 = self.number(track.input, -1, track_count);
                    if source - 1 == i32(t) { self.failed = true; }
                    if self.reading { track.input = source; }
                    tracks.push(track);
                }
                if self.reading { entry.data.tracks = tracks; updated.push(entry); }
            }
            if self.reading && !self.failed {
                library.patterns = updated;
                let entry: PatternEntry = library.patterns[library.index_of(library.active_id)];
                library.table.release(); library.table = entry.data.copy_pattern();
            }
        }
        // Optional AUDIO_PROPERTIES extension: per pattern, the Sample
        // properties of every audio placement.
        let properties_extension: bool = self.reading ? self.reader.remaining() > 0 : propertied;
        if properties_extension && !self.failed {
            let tag: str8 = self.text("AUDIO_PROPERTIES"); if tag != "AUDIO_PROPERTIES" { self.failed = true; } if self.reading { free(tag); }
            let patterns: list<PatternEntry> = library.patterns; var updated: list<PatternEntry> = [];
            for p in 0..patterns.len() {
                if self.failed { break; }
                var entry: PatternEntry = patterns[p]; if !self.reading && entry.id == library.active_id { entry.data = library.table; }
                let restored: SequenceTable = self.audio_properties(entry.data);
                if self.reading { entry.data = restored; updated.push(entry); }
            }
            if self.reading && !self.failed {
                library.patterns = updated;
                let entry: PatternEntry = library.patterns[library.index_of(library.active_id)];
                library.table.release(); library.table = entry.data.copy_pattern();
            }
        }
        // Optional AUDIO_GROUPS extension: the Audio-list groups, as paths
        // ("Drums", "Drums/Kicks"; each parent listed before its children),
        // then each sample's group path ("" for none). A project also keeps
        // every group as a folder below Audio/, empty ones included.
        let groups_extension: bool = self.reading ? self.reader.remaining() > 0 : grouped;
        var groups_read: bool = false;
        if groups_extension && !self.failed {
            let tag: str8 = self.text("AUDIO_GROUPS"); if tag != "AUDIO_GROUPS" { self.failed = true; } if self.reading { free(tag); }
            let group_count: i32 = self.number(i32(library.audio.groups.len()), 0, 4096);
            var listed: list<str8> = [];
            for g in 0..group_count {
                if self.failed { break; }
                let path: str8 = self.text(self.reading ? "" : library.audio.groups[g]);
                if !self.reading { if project { let folder: str8 = self.group_folder(path); free(folder); } continue; }
                let parent: str8 = group_parent(path);
                var known: bool = parent == "";
                for other in listed { if other == parent { known = true; } }
                free(parent);
                if path == "" || !known || !group_path_valid(path) { self.failed = true; free(path); break; }
                listed.push(path);
            }
            let assigned: i32 = self.number(i32(library.audio.samples.len()), 0, 256);
            if self.reading && assigned != library.audio.samples.len() { self.failed = true; }
            for i in 0..assigned {
                if self.failed { break; }
                let path: str8 = self.text(self.reading ? "" : library.audio.group_of(i));
                if !self.reading { continue; }
                var known: bool = path == "";
                for other in listed { if other == path { known = true; } }
                if !known { self.failed = true; } else { library.audio.set_group(i, path); }
                free(path);
            }
            // The listed groups replace those taken from project folders
            // (a folder may differ from its group's name, see group_folder).
            if self.reading && !self.failed {
                let old: list<str8> = library.audio.groups; for path in old { free(path); }
                library.audio.groups = [];
                for path in listed { library.audio.ensure_group(path); }
                groups_read = true;
            }
            for path in listed { free(path); }
        }
        // Sessions from before groups: generated slices ("kick.wav/kick.wav -
        // 1") sit in a group named after their original.
        if self.reading && !groups_read && !project && !self.failed {
            for i in 0..library.audio.samples.len() {
                let clip: AudioClip = library.audio.samples[i];
                let group: str8 = audio_group(clip.source);
                if group != "" { library.audio.set_group(i32(i), group); }
                free(group);
            }
        }
        // Optional PROJECT_OPTIONS extension: flags of a project session.
        let options_extension: bool = self.reading ? self.reader.remaining() > 0 : optioned;
        if options_extension && !self.failed {
            let tag: str8 = self.text("PROJECT_OPTIONS"); if tag != "PROJECT_OPTIONS" { self.failed = true; } if self.reading { free(tag); }
            state.move_unasked = self.flag(state.move_unasked);
            // Full-screen editor came later: a file ending before it opens
            // the editor full screen.
            if !self.reading || self.reader.remaining() > 0 { state.editor_fullscreen = self.flag(state.editor_fullscreen); }
        }
        if self.reading { library.audio.rebuild(); }
        if state.editor_slot > 32 {
            var found: bool = false; for plugin in plugins { if plugin.slot == state.editor_slot { found = true; } }
            if !found { self.failed = true; }
        }
        return SessionData { library: library, plugins: plugins, view: state, midi_learn: mappings, effect_volumes: effect_volumes, pads: pads, markers: markers };
    }
    pub fn save_pattern(path: str8, name: str8, source: &SequenceTable) -> bool {
        let created: result<SessionBuffer, str8> = SessionBuffer::new(4096);
        if created.is_err() { return false; }
        var codec: SessionCodec = SessionCodec { binary: created.unwrap() };
        var table: SequenceTable = SequenceTable {}; table = source;
        // Collect only clips placed in this pattern, including detached placements.
        var clips: list<AudioClip> = []; let tracks: list<SequenceTrack> = table.tracks;
        for track in tracks {
            let instances: list<AudioInstance> = track.instances;
            for instance in instances {
                var found: bool = false;
                for clip in clips {
                    if clip.source == instance.clip.source && clip.frames == instance.clip.frames && clip.frames_per_row == instance.clip.frames_per_row { found = true; }
                }
                if !found { clips.push(instance.clip); }
            }
        }
        codec.text("MLAPATT"); codec.number(1, 1, 1); codec.minor = codec.number(2, 0, 2); codec.audio_off = true; codec.text(name);
        codec.number(i32(clips.len()), 0, 256);
        for clip in clips { codec.clip(clip); }
        codec.sequence_data(table, clips);
        // Optional trailing AUDIO_PROPERTIES of the pattern.
        if table.has_audio_properties() { codec.text("AUDIO_PROPERTIES"); codec.audio_properties(table); }
        let actual: str8 = tui::table::table_matches(".*\\.[mM][lL][aA][pP][aA][tT][tT]", path) ? clone(path) : format!("{}.mlapatt", path);
        if !codec.failed { let written: result<i32, str8> = codec.binary.write_atomic(actual); if written.is_err() { codec.failed = true; } }
        free(actual); codec.binary.close(); return !codec.failed;
    }
    pub fn load_pattern(path: str8) -> result<PatternData, str8> {
        let opened: result<File, str8> = File::open(path);
        if opened.is_err() { return Err<PatternData, str8>("Cannot open pattern file"); }
        let file: File = opened.unwrap(); let size: result<i64, str8> = file.size(); file.close();
        if size.is_err() { return Err<PatternData, str8>("Cannot read pattern file"); }
        if size.unwrap() < 31 || size.unwrap() > 268435456 { return Err<PatternData, str8>("Pattern exceeds 256 MiB or is truncated"); }
        let read: result<SessionReader, str8> = SessionReader::from_file(path);
        if read.is_err() { return Err<PatternData, str8>("Cannot read pattern file"); }
        var codec: SessionCodec = SessionCodec { reading: true, reader: read.unwrap() };
        let magic: str8 = codec.text(""); if magic != "MLAPATT" { codec.failed = true; } free(magic);
        codec.number(1, 1, 1); codec.minor = codec.number(0, 0, 2); codec.audio_off = codec.minor >= 2;
        var data: PatternData = PatternData { name: codec.text("") };
        let count: i32 = codec.number(0, 0, 256);
        for i in 0..count { if codec.failed { break; } data.clips.push(codec.clip(AudioClip {})); }
        data.table = codec.sequence_data(data.table, data.clips);
        if codec.reader.remaining() > 0 && !codec.failed {
            let tag: str8 = codec.text(""); if tag != "AUDIO_PROPERTIES" { codec.failed = true; } free(tag);
            if !codec.failed { data.table = codec.audio_properties(data.table); }
        }
        if codec.reader.remaining() != 0 { codec.failed = true; } codec.reader.close();
        if codec.failed { data.release(); return Err<PatternData, str8>("Invalid, truncated or unsupported .mlapatt pattern"); }
        // Instance IDs and effect buses belong to the originating session.
        let tracks: list<SequenceTrack> = data.table.tracks; var detached: list<SequenceTrack> = [];
        for item in tracks {
            var track: SequenceTrack = SequenceTrack {}; track = item;
            track.instrument_id = 0; track.inserts = []; track.sends = []; track.output = 0;
            detached.push(track);
        }
        data.table.tracks = detached;
        return Ok<PatternData, str8>(data);
    }
    pub fn save(self: &mut Self, path: str8, library: &PatternLibrary, view: SessionView, audio: &AudioSystem) -> bool {
        let created: result<SessionBuffer, str8> = SessionBuffer::new(4096); if created.is_err() { return false; }
        var codec: SessionCodec = SessionCodec { binary: created.unwrap() };
        codec.contents(library, view, audio);
        var ok: bool = !codec.failed && codec.binary.len() <= 268435456;
        if ok { let written: result<i32, str8> = codec.binary.write_atomic(path); ok = written.is_ok(); }
        codec.binary.close(); return ok;
    }
    /// Save the project folder `path` (`.mlaproj` appended when missing):
    /// Project.mlack, Audio/ and Presets/. It is written beside the target and
    /// swapped in only when complete, so a failed save keeps the previous
    /// project. Returns the owned folder path.
    pub fn save_project(self: &mut Self, path: str8, library: &PatternLibrary, view: SessionView, audio: &AudioSystem) -> result<str8, str8> {
        let folder: str8 = project_folder(path);
        let existing: bool = std::fs::file_exists(folder) == 1;
        if existing {
            let session: str8 = format!("{}/{}", folder, project_session());
            let project: bool = std::fs::is_dir(folder) == 1 && std::fs::file_exists(session) == 1; free(session);
            if !project { free(folder); return Err<str8, str8>("Save failed: the target exists but is not an mlacker project"); }
        }
        let staging: str8 = format!("{}.saving", folder); let previous: str8 = format!("{}.previous", folder);
        if std::fs::file_exists(staging) == 1 { std::fs::remove_tree(staging); }
        let audio_dir: str8 = format!("{}/Audio", staging); let presets_dir: str8 = format!("{}/Presets", staging);
        let audio_made: result<i32, str8> = std::fs::mkdir_p(audio_dir);
        let presets_made: result<i32, str8> = std::fs::mkdir_p(presets_dir);
        let made: bool = audio_made.is_ok() && presets_made.is_ok();
        free(audio_dir); free(presets_dir);
        var status: str8 = "";
        if made {
            let created: result<SessionBuffer, str8> = SessionBuffer::new(4096);
            if created.is_ok() {
                var codec: SessionCodec = SessionCodec { binary: created.unwrap(), root: staging };
                codec.contents(library, view, audio);
                var ok: bool = !codec.failed && codec.binary.len() <= 268435456;
                let session: str8 = format!("{}/{}", staging, project_session());
                if ok { let written: result<i32, str8> = codec.binary.write_atomic(session); ok = written.is_ok(); }
                codec.binary.close(); free(session);
                if !ok { status = codec.problem != "" ? format!("Save failed: {}", codec.problem) : "Save failed: invalid state, size limit or unwritable path"; }
                if codec.problem != "" { free(codec.problem); }
            } else { status = "Save failed: cannot allocate the session"; }
        } else { status = "Save failed: cannot create the project folder"; }
        if status == "" && existing {
            if std::fs::file_exists(previous) == 1 { std::fs::remove_tree(previous); }
            if rename(folder, previous) != 0 { status = "Save failed: cannot replace the existing project; it is unchanged"; }
        }
        if status == "" && rename(staging, folder) != 0 {
            if existing { rename(previous, folder); }
            status = "Save failed: cannot move the project into place; previous project retained";
        }
        if status != "" { std::fs::remove_tree(staging); }
        else if existing { std::fs::remove_tree(previous); }
        free(staging); free(previous);
        if status != "" { free(folder); return Err<str8, str8>(status); }
        return Ok<str8, str8>(folder);
    }
    /// Open a project folder; content paths resolve against it wherever it is.
    pub fn load_project(path: str8) -> result<SessionData, str8> {
        let folder: str8 = project_folder(path);
        if std::fs::is_dir(folder) == 0 { free(folder); return Err<SessionData, str8>("Project folder not found"); }
        let session: str8 = format!("{}/{}", folder, project_session());
        let loaded: result<SessionData, str8> = SessionCodec::load_file(session, folder);
        free(session); free(folder); return loaded;
    }
    pub fn load(path: str8) -> result<SessionData, str8> { return SessionCodec::load_file(path, ""); }
    fn load_file(path: str8, root: str8) -> result<SessionData, str8> {
        let opened: result<File, str8> = File::open(path); if opened.is_err() { return Err<SessionData, str8>("Cannot open session file"); }
        let file: File = opened.unwrap(); let length: result<i64, str8> = file.size(); file.close();
        if length.is_err() { return Err<SessionData, str8>("Cannot read session size"); }
        if length.unwrap() < 21 || length.unwrap() > 268435456 { return Err<SessionData, str8>("Session exceeds 256 MiB limit or is truncated"); }
        let read: result<SessionReader, str8> = SessionReader::from_file(path); if read.is_err() { return Err<SessionData, str8>("Cannot read session file"); }
        var codec: SessionCodec = SessionCodec { reading: true, reader: read.unwrap(), root: root };
        var dummy: PatternLibrary = PatternLibrary {};
        var audio: AudioSystem = AudioSystem {};
        var data: SessionData = codec.contents(dummy, SessionView {}, audio);
        if codec.reader.remaining() != 0 { codec.failed = true; }
        codec.reader.close();
        if codec.failed {
            data.release();
            if codec.problem != "" { return Err<SessionData, str8>(codec.problem); }
            return Err<SessionData, str8>(root != "" ? "Invalid, truncated or unsupported mlacker project" : "Invalid, truncated or unsupported .mlack session (expected version 1.0)");
        }
        return Ok<SessionData, str8>(data);
    }
}
