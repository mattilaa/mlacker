mod mlacker_ui::audio_clip;
mod mlacker_ui::sample_view;
mod tui::widgets;
mod tui::dialog;
use mlacker_ui::audio_clip::AudioClip;
use mlacker_ui::audio_clip::base_name;
use mlacker_ui::sample_view::SampleView;
use tui::geometry::*;
use tui::surface::*;
use tui::theme::*;
use tui::widgets::Panel;
use tui::dialog::Dialog;
use tui::textfield::TextField;
use tui::button::PushButton;
use tui::focus::PaneFocus;
use tui::layout::Alignment;
use tui::input::*;
use tui::menu::Key;
use std::strbuf::clone;
use std::strbuf::free;
use std::strbuf::len;
use std::strbuf::sub;
use std::strbuf::rfind;
use std::strbuf::find;
use std::strbuf::byte_at;

// Destructive edits on interleaved PCM. Each returns a new list; the source is
// never modified because clips share sample data between placements. Frame
// ranges are [from, to) and clamped to the sample.

fn clamp_frames(value: i64, frames: i64) -> i64 { return value < 0 ? 0 : (value > frames ? frames : value); }

/// Keep only frames [from, to).
pub fn pcm_crop(samples: &list<f32>, channels: i64, from: i64, to: i64) -> list<f32> {
    var source: list<f32> = []; source = samples;
    let frames: i64 = source.len() / channels;
    let a: i64 = clamp_frames(from, frames); let b: i64 = clamp_frames(to, frames);
    var out: list<f32> = [];
    let lo: i64 = a * channels; let hi: i64 = b * channels;
    for i in lo..hi { out.push(source[i]); }
    return out;
}
/// Remove frames [from, to), closing the gap.
pub fn pcm_delete(samples: &list<f32>, channels: i64, from: i64, to: i64) -> list<f32> {
    var source: list<f32> = []; source = samples;
    let frames: i64 = source.len() / channels;
    let a: i64 = clamp_frames(from, frames) * channels; let b: i64 = clamp_frames(to, frames) * channels;
    var out: list<f32> = [];
    for i in 0..source.len() { if i < a || i >= b { out.push(source[i]); } }
    return out;
}
/// Reverse frames [from, to), keeping channel order within each frame.
pub fn pcm_reverse(samples: &list<f32>, channels: i64, from: i64, to: i64) -> list<f32> {
    var source: list<f32> = []; source = samples;
    let frames: i64 = source.len() / channels;
    let a: i64 = clamp_frames(from, frames); let b: i64 = clamp_frames(to, frames);
    var out: list<f32> = [];
    for f in 0..frames {
        let src: i64 = f >= a && f < b ? a + b - 1 - f : f;
        for c in 0..channels { out.push(source[src * channels + c]); }
    }
    return out;
}
/// Multiply frames [from, to) by a linear ramp and clip to -1..1. `shape`
/// 0 = constant `gain`, 1 = fade in (0 -> 1), 2 = fade out (1 -> 0).
pub fn pcm_scale(samples: &list<f32>, channels: i64, from: i64, to: i64, gain: f32, shape: i32) -> list<f32> {
    var source: list<f32> = []; source = samples;
    let frames: i64 = source.len() / channels;
    let a: i64 = clamp_frames(from, frames); let b: i64 = clamp_frames(to, frames);
    let span: i64 = b - a > 1 ? b - a - 1 : 1;
    var out: list<f32> = [];
    for f in 0..frames {
        var g: f32 = 1.0f;
        if f >= a && f < b {
            g = gain;
            if shape == 1 { g = f32(f - a) / f32(span); }
            if shape == 2 { g = f32(b - 1 - f) / f32(span); }
        }
        for c in 0..channels {
            // Hard clip: sessions and 16-bit exports only hold -1..1.
            let v: f32 = source[f * channels + c] * g;
            out.push(v > 1.0f ? 1.0f : (v < -1.0f ? -1.0f : v));
        }
    }
    return out;
}
/// Largest absolute value in frames [from, to).
pub fn pcm_peak(samples: &list<f32>, channels: i64, from: i64, to: i64) -> f32 {
    var source: list<f32> = []; source = samples;
    let frames: i64 = source.len() / channels;
    let a: i64 = clamp_frames(from, frames) * channels; let b: i64 = clamp_frames(to, frames) * channels;
    var peak: f32 = 0.0f;
    for i in a..b { let v: f32 = source[i] < 0.0f ? -source[i] : source[i]; if v > peak { peak = v; } }
    return peak;
}


/// Owned file name stem of `source`: no folder, no extension, and no
/// " - Trim N" or " - Edit N" suffix, so editing an edit numbers on from the
/// original.
fn trim_stem(source: str8) -> str8 {
    let name: str8 = base_name(source);
    let dot: i64 = rfind(name, ".");
    var stem: str8 = dot > 0 ? sub(name, 0, dot) : clone(name); free(name);
    // Both suffixes are 8 bytes before the number.
    var mark: i64 = rfind(stem, " - Trim ");
    let edit: i64 = rfind(stem, " - Edit ");
    if edit > mark { mark = edit; }
    if mark > 0 {
        let first: i64 = mark + 8; let size: i64 = len(stem); var digits: bool = first < size;
        for i in first..size { let b: i32 = byte_at(stem, i); if b < 48 || b > 57 { digits = false; } }
        if digits { let bare: str8 = sub(stem, 0, mark); free(stem); stem = bare; }
    }
    return stem;
}
/// Owned `Name - Trim N.wav` for a trim of `source`, with the first N no
/// sample in `samples` is named yet.
pub fn trim_name(source: str8, samples: &list<AudioClip>) -> str8 { return numbered_name(source, samples, "Trim"); }
/// Owned `Name - <word> N.wav` (word "Trim" or "Edit"), with the first N no
/// sample in `samples` is named yet.
pub fn numbered_name(source: str8, samples: &list<AudioClip>, word: str8) -> str8 {
    var clips: list<AudioClip> = []; clips = samples;
    let stem: str8 = trim_stem(source);
    var name: str8 = clone("");
    for n in 1..100000 {
        free(name); name = format!("{} - {} {}.wav", stem, word, n);
        var taken: bool = false;
        for clip in clips { let other: str8 = base_name(clip.source); if other == name { taken = true; } free(other); }
        if !taken { break; }
    }
    free(stem);
    return name;
}
/// Owned path of file `name` in the folder of `source` (bare when it has none).
pub fn sibling_path(source: str8, name: str8) -> str8 {
    let slash: i64 = rfind(source, "/");
    if slash < 0 { return clone(name); }
    let folder: str8 = sub(source, 0, slash + 1);
    let path: str8 = format!("{}{}", folder, name); free(folder);
    return path;
}

/// Ctrl+S in the sample editor: the new clip's file name, whether it
/// replaces the original (destructive) or is added beside it, and the
/// Audio-list group it goes in. Focus: 0 name, 1 mode, 2 group, 3 buttons.
pub struct TrimSaveDialog : Dialog {
    var name: TextField; var destructive: bool; var error: str8;
    /// Owned group paths to choose from; `group` is the chosen one's index
    /// + 1, 0 for no group.
    var groups: list<str8>; var group: i32;
};
impl TrimSaveDialog {
    pub fn new() -> TrimSaveDialog {
        return TrimSaveDialog { title: "Save clip", width: 60, height: 17, name: TextField::new(""), error: "",
            focus: PaneFocus::new(0), button_alignment: Alignment::Center,
            buttons: [PushButton { label: "Save", action: 1 }, PushButton { label: "Cancel", action: 2 }] };
    }
    /// Open suggesting `name`, with `groups` to choose from and `current`
    /// (one of them, or "") chosen.
    pub fn open(self: &mut Self, name: str8, groups: &list<str8>, current: str8) -> void {
        var paths: list<str8> = []; paths = groups;
        let old: list<str8> = self.groups; for path in old { free(path); }
        var copied: list<str8> = []; self.group = 0;
        for i in 0..paths.len() { copied.push(clone(paths[i])); if paths[i] == current { self.group = i32(i) + 1; } }
        self.groups = copied;
        self.name.set_text(name); self.error = ""; self.reset_buttons();
        self.focus.selected = 0; self.active = true; self.result = 0;
    }
    /// The chosen group's path (borrowed), "" for none.
    pub fn chosen_group(self: TrimSaveDialog) -> str8 {
        return self.group > 0 && self.group <= self.groups.len() ? self.groups[self.group - 1] : "";
    }
    /// Show `error` and keep the dialog open, e.g. when the name is taken.
    pub fn reject(self: &mut Self, error: str8) -> void {
        self.error = error; self.reset_buttons(); self.focus.selected = 0; self.active = true; self.result = 0;
    }
    fn accept(self: &mut Self) -> i32 {
        let name: str8 = std::strbuf::trim(self.name.text);
        let bad: bool = name == "" || find(name, "/") >= 0 || find(name, "\\") >= 0;
        if bad { free(name); self.error = "Enter a file name without folders"; return 0; }
        let lower: str8 = len(name) > 4 ? sub(name, len(name) - 4, 4) : clone("");
        let wav: bool = lower == ".wav" || lower == ".WAV"; free(lower);
        if !wav { let named: str8 = format!("{}.wav", name); free(name); self.name.set_text(named); free(named); }
        else { self.name.set_text(name); free(name); }
        self.active = false; self.result = 1; return 1;
    }
    /// 0 while open, 1 saved (the name is in `name.text`), 2 cancelled.
    pub fn on_event(self: &mut Self, event: InputEvent) -> i32 {
        if self.pressed_button >= 0 { return 0; }
        if event.kind == InputKind::Menu && event.key == Key::Escape && event.code < 32 {
            self.active = false; self.result = 2; return 2;
        }
        if event.kind == InputKind::Pane || (event.kind == InputKind::Menu && event.key == Key::Toggle) {
            let back: bool = (event.kind == InputKind::Pane && (event.key == Key::Up || event.key == Key::Left)) || event.modifiers == 2;
            let s: i32 = self.focus.selected;
            self.focus.selected = back ? (s == 0 ? 3 : (s == 3 ? 2 : s - 1)) : (s == 3 ? 0 : (s == 2 ? 3 : s + 1));
            return 0;
        }
        if self.focus.selected == 3 { self.on_button_event(event); return 0; }
        if event.kind == InputKind::Menu && event.key == Key::Enter { return self.accept(); }
        if self.focus.selected == 1 {
            if (event.kind == InputKind::Menu && (event.key == Key::Left || event.key == Key::Right || event.key == Key::Up || event.key == Key::Down)) ||
               event.code == 32 { self.destructive = !self.destructive; }
            return 0;
        }
        if self.focus.selected == 2 {
            // Left/Right (h/l) or Space step through no group and the groups.
            let count: i32 = i32(self.groups.len()) + 1;
            if event.kind == InputKind::Menu && (event.key == Key::Left || event.key == Key::Up) { self.group = (self.group + count - 1) % count; }
            else if (event.kind == InputKind::Menu && (event.key == Key::Right || event.key == Key::Down)) || event.code == 32 { self.group = (self.group + 1) % count; }
            return 0;
        }
        self.name.on_event(event);
        return 0;
    }
    /// Call once per 10ms UI tick; returns a completed button press for the
    /// caller to replay as Enter (Save) or Escape (Cancel).
    pub fn tick(self: &mut Self) -> i32 {
        let action: i32 = self.tick_buttons();
        if action != 0 { self.focus.selected = 0; }
        return action;
    }
    pub fn paint(self: TrimSaveDialog, surface: Surface, viewport: Rect, theme: Theme) -> void {
        if !self.active { return; }
        let body: Rect = self.paint_frame(surface, viewport, theme);
        surface.text(body, "File name (a new clip in the Audio list)", theme.foreground, theme.panel);
        self.name.paint(surface, Rect::new(body.x, body.y + 1, body.width, 1), theme.foreground, theme.selection, self.focus.selected == 0);
        surface.text(Rect::new(body.x, body.y + 3, body.width, 1), "Save mode", theme.foreground, theme.panel);
        let focused: bool = self.focus.selected == 1;
        let keep: Rect = Rect::new(body.x, body.y + 4, body.width, 1);
        let replace: Rect = Rect::new(body.x, body.y + 5, body.width, 1);
        surface.text(keep, self.destructive ? "( ) Non-destructive: keep the original" : "(*) Non-destructive: keep the original",
            theme.foreground, focused && !self.destructive ? theme.selection : theme.panel);
        surface.text(replace, self.destructive ? "(*) Destructive: replace the original everywhere" : "( ) Destructive: replace the original everywhere",
            theme.foreground, focused && self.destructive ? theme.selection : theme.panel);
        surface.text(Rect::new(body.x, body.y + 7, body.width, 1), "Group (Left/Right to choose)", theme.foreground, theme.panel);
        let chosen: str8 = self.chosen_group();
        let shown: str8 = format!("< {} >", chosen == "" ? "No group" : chosen);
        surface.text(Rect::new(body.x, body.y + 8, body.width, 1), shown, theme.foreground, self.focus.selected == 2 ? theme.selection : theme.panel); free(shown);
        surface.text(Rect::new(body.x, body.y + 10, body.width, 1), self.error, theme.accent, theme.panel);
    }
    pub fn release(self: &mut Self) -> void {
        self.name.release();
        let old: list<str8> = self.groups; for path in old { free(path); }
        self.groups = [];
    }
}

/// Sample editor for one Audio-list sample: the cursor, zoom and selection
/// keys of its `SampleView` (see `SampleView::on_key`), `t` to trim the
/// working copy to the selection and `x` to delete it, with up to 16 undo steps, Ctrl+P to play,
/// and Ctrl+S to save the result as a new clip through `save`.
/// on_event results: 0 handled/ignored, 1 save accepted (`saved_name`,
/// `save_destructive`), 2 close, 3 play/stop, 4 the save dialog wants its
/// suggested name (`open_save`).
pub struct SampleEditor {
    var active: bool; var index: i32; var clip: AudioClip; var history: list<AudioClip>;
    var view: SampleView; var modified: bool; var status: str8{""};
    var save: TrimSaveDialog; var save_ready: bool; var save_destructive: bool;
    /// Esc once more closes without saving.
    var close_pending: bool;
    /// A range to watch (a sampler slot's loop, see `select`), and whether
    /// the only change of length so far is a trim to exactly that range.
    var watch_from: i64{-1}; var watch_to: i64{-1};
    var length_changed: bool; var cropped_to_watch: bool;
};
impl SampleEditor {
    pub fn open(self: &mut Self, source: &AudioClip, index: i32) -> void {
        self.release();
        var clip: AudioClip = AudioClip {}; clip = source;
        self.clip = clip.copy(); self.clip.offset = 0; self.index = index;
        self.view = SampleView { grainy: true, zoom: 0 };
        self.view.clear_selection(self.clip.frames, 0);
        self.close_pending = false;
        self.save = TrimSaveDialog::new(); self.save_ready = true;
        self.modified = false; self.status = ""; self.active = true;
        self.watch_from = -1; self.watch_to = -1; self.length_changed = false; self.cropped_to_watch = false;
    }
    /// Select frames `from` .. `to` (clamped) and watch that range: after a
    /// trim to exactly it, `cropped_to_watch` says so.
    pub fn select(self: &mut Self, from: i64, to: i64) -> void {
        let start: i64 = from < 0 ? 0 : from;
        let end: i64 = to > self.clip.frames ? self.clip.frames : to;
        if end <= start { return; }
        self.view.select(start, end, self.clip.frames);
        self.watch_from = start; self.watch_to = end;
    }
    pub fn cursor(self: SampleEditor) -> i64 { return self.view.cursor(self.clip, 0); }
    /// Selection in frames; the whole sample when nothing narrower is selected.
    pub fn selection_start(self: SampleEditor) -> i64 { return self.view.selection_start(self.clip.frames); }
    pub fn selection_end(self: SampleEditor) -> i64 { return self.view.selection_end(self.clip.frames); }
    pub fn has_selection(self: SampleEditor) -> bool { return self.view.has_selection(self.clip.frames); }
    fn push_history(self: &mut Self, next: AudioClip) -> void {
        self.history.push(self.clip);
        if self.history.len() > 16 {
            let old: list<AudioClip> = self.history; var kept: list<AudioClip> = [];
            for i in 0..old.len() { let item: AudioClip = old[i]; if i == 0 { item.release(); } else { kept.push(item); } }
            self.history = kept;
        }
        self.clip = next; self.modified = true;
        self.view.clear_selection(self.clip.frames, 0); self.view.zoom = 0;
    }
    /// Trim the working copy to the selection. Returns false with `status` set
    /// when nothing narrower than the whole sample is selected.
    pub fn trim(self: &mut Self) -> bool {
        if !self.has_selection() { self.status = "Select a range first: v, then move to its other end"; return false; }
        let ch: i64 = self.clip.channels < 1 ? 1 : self.clip.channels;
        let from: i64 = self.selection_start(); let to: i64 = self.selection_end();
        self.cropped_to_watch = !self.length_changed && from == self.watch_from && to == self.watch_to;
        self.length_changed = true;
        self.push_history(self.clip.with_samples(pcm_crop(self.clip.samples, ch, from, to)));
        self.status = "Trimmed to the selection"; return true;
    }
    /// Delete the selection from the working copy, closing the gap.
    pub fn delete(self: &mut Self) -> bool {
        if !self.has_selection() { self.status = "Select a range first: v, then move to its other end"; return false; }
        let ch: i64 = self.clip.channels < 1 ? 1 : self.clip.channels;
        self.length_changed = true; self.cropped_to_watch = false;
        self.push_history(self.clip.with_samples(pcm_delete(self.clip.samples, ch, self.selection_start(), self.selection_end())));
        self.status = "Deleted the selection"; return true;
    }
    pub fn undo(self: &mut Self) -> bool {
        if self.history.len() == 0 { self.status = "Nothing to undo"; return false; }
        // Undo may take back the trim: stop trusting it.
        self.length_changed = true; self.cropped_to_watch = false;
        let old: list<AudioClip> = self.history; var kept: list<AudioClip> = [];
        for i in 0..old.len() - 1 { kept.push(old[i]); }
        self.clip.release(); self.clip = old[old.len() - 1]; self.history = kept;
        self.modified = self.history.len() > 0; self.status = "Undone";
        self.view.clear_selection(self.clip.frames, 0); self.view.zoom = 0;
        return true;
    }
    pub fn on_event(self: &mut Self, event: InputEvent, width: i32) -> i32 {
        if self.save.active {
            let result: i32 = self.save.on_event(event);
            if result == 1 { self.save_destructive = self.save.destructive; return 1; }
            return 0;
        }
        if event.released || (event.kind == InputKind::None && event.code == 0) { return 0; }
        let escape: bool = event.kind == InputKind::Menu && event.key == Key::Escape && event.code < 32;
        let pending: bool = self.close_pending; self.close_pending = false;
        if escape {
            if self.view.selecting || self.has_selection() {
                self.view.clear_selection(self.clip.frames, self.cursor()); self.status = "Unselected"; return 0;
            }
            if self.modified && !pending { self.close_pending = true; self.status = "Unsaved trim: Esc again closes without saving, Ctrl+S saves"; return 0; }
            return 2;
        }
        let code: i32 = event.code; let mods: i32 = (event.modifiers - 1) % 64 + 1;
        if (code == 16 && mods == 1) || (code == 112 && mods == 5) { return 3; }
        if (code == 19 && mods == 1) || (code == 115 && mods == 5) { return 4; }
        if code == 116 && mods == 1 { self.trim(); return 0; }
        if code == 120 && mods == 1 { self.delete(); return 0; }
        if code == 117 && mods == 1 { self.undo(); return 0; }
        if self.view.on_key(event, self.clip, width, 0) { self.status = self.view.status; }
        return 0;
    }
    /// The audio Ctrl+P plays: the selection, or the whole working copy.
    pub fn play_clip(self: SampleEditor) -> AudioClip {
        let ch: i64 = self.clip.channels < 1 ? 1 : self.clip.channels;
        let from: i64 = self.selection_start(); let to: i64 = self.selection_end();
        return AudioClip { samples: pcm_crop(self.clip.samples, ch, from, to), channels: self.clip.channels,
            sample_rate: self.clip.sample_rate, frames: to - from };
    }
    pub fn start_play(self: &mut Self, now: i64) -> void {
        self.view.start_play(self.selection_start(), self.selection_end(), self.clip.sample_rate, now);
        self.status = self.has_selection() ? "Playing the selection | Ctrl+P stops" : "Playing | Ctrl+P stops";
    }
    pub fn stop_play(self: &mut Self) -> void { self.view.stop_play(); self.status = ""; }
    pub fn playing(self: SampleEditor) -> bool { return self.view.playing; }
    /// Advance the play position to `now`; `previewing` false ends playback.
    pub fn follow(self: &mut Self, now: i64, previewing: bool) -> void {
        let was: bool = self.view.playing;
        self.view.follow(now, previewing);
        if was && !self.view.playing { self.status = ""; }
    }
    /// The file name accepted in the save dialog; valid until `take` or `release`.
    pub fn saved_name(self: SampleEditor) -> str8 { return self.save.name.text; }
    /// Open the Ctrl+S dialog suggesting `name`, with `groups` to choose from
    /// and `current` chosen.
    pub fn open_save(self: &mut Self, name: str8, groups: &list<str8>, current: str8) -> void { self.save.open(name, groups, current); }
    /// The save could not happen: show `error` in the still open dialog.
    pub fn save_failed(self: &mut Self, error: str8) -> void { self.save.reject(error); }
    /// True while a dialog button shows its press; `tick` then completes it.
    pub fn pressing(self: SampleEditor) -> bool { return self.save.active && self.save.pressed_button >= 0; }
    /// Call once per 10ms UI tick; returns 1 (Save) or 2 (Cancel) when a
    /// dialog button press completes, for the caller to replay as Enter or Escape.
    pub fn tick(self: &mut Self) -> i32 { return self.save.active ? self.save.tick() : 0; }
    pub fn paint(self: SampleEditor, surface: Surface, area: Rect, theme: Theme) -> void {
        if !self.active { return; }
        let panel: Panel = Panel { title: " Sample editor " };
        let body: Rect = panel.paint_focused(surface, area, theme, true);
        if body.height < 5 { return; }
        let wave: Rect = Rect::new(body.x, body.y, body.width, body.height - 3);
        self.view.paint_at(surface, wave, theme, self.clip, 0, 0);
        surface.text(Rect::new(body.x, body.y + body.height - 3, body.width, 1), sample_keys(), theme.muted, theme.panel);
        surface.text(Rect::new(body.x, body.y + body.height - 2, body.width, 1),
            "t trim  x delete  u undo  Ctrl+P play  Ctrl+S save as a new clip  Esc unselects, then closes", theme.muted, theme.panel);
        let name: str8 = base_name(self.clip.source);
        let label: str8 = format!("{}{}", name, self.modified ? " [modified]" : ""); free(name);
        let line: str8 = sample_info(self.view, self.clip, 0, label, self.status); free(label);
        paint_status_bar(surface, Rect::new(body.x, body.y + body.height - 1, body.width, 1), theme, line); free(line);
        self.save.paint(surface, area, theme);
    }
    /// Hand the edited clip to the caller (ownership moves); closes the editor.
    pub fn take(self: &mut Self) -> AudioClip {
        let clip: AudioClip = self.clip;
        self.clip = AudioClip {};
        self.release();
        return clip;
    }
    pub fn release(self: &mut Self) -> void {
        let old: list<AudioClip> = self.history; for item in old { item.release(); }
        self.history = [];
        self.clip.release();
        self.clip = AudioClip {}; self.active = false; self.modified = false; self.view.playing = false;
        self.view.transients = []; self.view.transients_key = -1;
        if self.save_ready { self.save.release(); self.save = TrimSaveDialog {}; self.save_ready = false; }
    }
}

/// Key help shared by the sample editor and the Sample pane.
pub fn sample_keys() -> str8 { return "h/l move  H/L fast  T transient mode  Ctrl+H/L transient  B/E start/end  v select  +/- zoom  = fit"; }

/// Owned "s.mmm" text of `frames` at `rate`.
fn seconds(frames: i64, rate: i64) -> str8 {
    let ms: i64 = frames * 1000 / (rate > 0 ? rate : 1);
    let part: str8 = std::strbuf::zpad_i64(ms % 1000, 3);
    let text: str8 = format!("{}.{}", ms / 1000, part); free(part);
    return text;
}
/// Owned status bar text of a sample view: `name`, the cursor position, the
/// selection, transient mode, `status`, length and format.
pub fn sample_info(shown: &SampleView, source: &AudioClip, row: i32, name: str8, status: str8) -> str8 {
    var view: SampleView = SampleView {}; view = shown;
    var clip: AudioClip = AudioClip {}; clip = source;
    let rate: i64 = clip.sample_rate > 0 ? clip.sample_rate : 1;
    let cursor: i64 = view.cursor(clip, row);
    let at: str8 = seconds(cursor, rate); let length: str8 = seconds(clip.frames, rate);
    var selection: str8 = clone(view.selecting ? "Selecting | " : "");
    if view.has_selection(clip.frames) {
        let from: str8 = seconds(view.sel_start, rate); let to: str8 = seconds(view.sel_end, rate);
        free(selection); selection = format!("Sel {}-{} s | ", from, to); free(from); free(to);
    }
    // Length and format come last: on a narrow pane they are cut off first.
    let line: str8 = format!(" {} | {} s ({}) | {}Transients {}{}{} | {} s {} ch {} Hz", name, at, cursor, selection,
        view.transient_mode ? "on" : "off", status == "" ? "" : " | ", status, length, clip.channels, clip.sample_rate);
    free(at); free(length); free(selection);
    return line;
}
/// Paint `text` as a status bar across `area`'s first row.
pub fn paint_status_bar(surface: Surface, area: Rect, theme: Theme, text: str8) -> void {
    let bar: Rect = Rect::new(area.x, area.y, area.width, 1);
    surface.fill(bar, Cell { glyph: 32, foreground: theme.foreground, background: theme.selection });
    surface.text(bar, text, theme.foreground, theme.selection);
}
