mod tui::surface;
mod tui::theme;
use tui::geometry::*;
use tui::surface::*;
use tui::theme::*;
use std::strbuf::free;
use std::strbuf::len;

/// Pattern transport. Integer phase keeps fractional row timing without drift.
pub struct TransportStatus {
    var bpm: i32{120};
    var elapsed_ms: i32;
    var beats_per_bar: i32{4};
    var beat_unit: i32{4};
    var midi_received: bool;
    var recording: bool;
    var playing: bool; var row: i32; var phase: i64; var clock_ms: i64;
    var ticks: i64;
    var count_in: i64; var click_ticks: i64; var last_click: i64{-1};
    /// Process CPU use across all cores, shown at the right end; -1 hides it.
    var cpu_percent: i32{-1};
    /// Last MIDI message received, shown after the document name when it
    /// fits: a MidiInputEvent kind (0 none), its channel and data.
    var midi_kind: i64; var midi_channel: i64; var midi_data: i64; var midi_value: i64;
};
/// Status text of a received MIDI message (see MidiInputEvent kinds), or "".
pub fn midi_message_text(kind: i64, channel: i64, data: i64, value: i64) -> str8 {
    let names: array<str8, 12> = {"C-", "C#", "D-", "D#", "E-", "F-", "F#", "G-", "G#", "A-", "A#", "B-"};
    if kind == 1 { return format!("CH{} {}{} v{}", channel + 1, names[data % 12], data / 12 - 1, value); }
    if kind == 2 { return format!("CH{} {}{} off", channel + 1, names[data % 12], data / 12 - 1); }
    if kind == 6 && data == 128 { return format!("CH{} AT {}", channel + 1, value); }
    if kind == 6 { return format!("CH{} CC{}={}", channel + 1, data, value); }
    if kind == 7 { return format!("CH{} PB {}", channel + 1, value - 8192); }
    if kind == 8 { return format!("KNOB {}={}", data + 1, value); }
    return format!("");
}
impl TransportStatus {
    pub fn toggle(self: &mut Self, now: i64, selected: i32, count: i32) -> void {
        if self.playing { self.advance(now, count); self.playing = false; return; }
        if count <= 0 { return; }
        self.row = selected < 0 ? 0 : (selected >= count ? count - 1 : selected);
        self.phase = 0; self.clock_ms = now; self.playing = true;
        self.count_in = 0; self.click_ticks = 0; self.last_click = -1;
        self.ticks = wide(self.row) * 15000;
        self.elapsed_ms = i32(wide(self.row) * 15000 / wide(self.bpm));
    }
    pub fn advance(self: &mut Self, now: i64, count: i32) -> bool {
        if !self.playing { self.clock_ms = now; return false; }
        if count <= 0 { self.playing = false; self.row = -1; self.elapsed_ms = 0; return true; }
        let delta: i64 = now > self.clock_ms ? now - self.clock_ms : 0;
        self.clock_ms = now;
        var elapsed: i64 = delta * wide(self.bpm);
        self.click_ticks = self.click_ticks + elapsed;
        if self.count_in > 0 {
            let consumed: i64 = elapsed < self.count_in ? elapsed : self.count_in;
            self.count_in = self.count_in - consumed; elapsed = elapsed - consumed;
        }
        let phase: i64 = self.phase + elapsed;
        self.ticks = self.ticks + elapsed;
        self.row = i32((wide(self.row) + phase / 15000) % wide(count));
        self.phase = phase % 15000;
        self.elapsed_ms = i32((wide(self.row) * 15000 + self.phase) / wide(self.bpm));
        return delta > 0;
    }
    pub fn begin_count_in(self: &mut Self) -> void {
        self.count_in = wide(self.beats_per_bar) * 240000 / wide(self.beat_unit);
    }
    /// One click per signature beat, independent of pattern looping.
    pub fn metronome_beat(self: &mut Self) -> i32 {
        if !self.playing { return -1; }
        let beat: i64 = self.click_ticks / (240000 / wide(self.beat_unit));
        if beat == self.last_click { return -1; }
        self.last_click = beat; return i32(beat % wide(self.beats_per_bar));
    }
    pub fn set_bpm(self: &mut Self, value: i32) -> bool {
        if value < 20 || value > 400 { return false; }
        self.bpm = value; return true;
    }
    /// While stopped, mirror the pattern cursor row so the status-bar time keeps
    /// up with navigation instead of freezing at the last played position.
    pub fn follow_row(self: &mut Self, row: i32) -> void {
        if self.playing { return; }
        self.row = row < 0 ? 0 : row; self.phase = 0;
        self.ticks = wide(self.row) * 15000;
        self.elapsed_ms = i32(wide(self.row) * 15000 / wide(self.bpm));
    }
    /// `document` names the open project or session ("Untitled" before the
    /// first save); it follows the play state.
    pub fn paint(self: TransportStatus, surface: Surface, area: Rect, theme: Theme, document: str8) -> void {
        if area.width <= 0 || area.height <= 0 { return; }
        let row: Rect = Rect::new(area.x, area.y, area.width, 1);
        surface.fill(row, Cell { glyph: 32, foreground: theme.foreground, background: theme.panel });
        let elapsed: i32 = self.elapsed_ms < 0 ? 0 : self.elapsed_ms;
        let minutes: i32 = elapsed / 60000;
        let seconds: i32 = (elapsed / 1000) % 60;
        let millis: i32 = elapsed % 1000;
        let text: str8 = format!(" BPM {} | Time {}{}:{}{}.{}{} | {}/{} | MIDI IN ",
            self.bpm, minutes < 10 ? "0" : "", minutes,
            seconds < 10 ? "0" : "", seconds,
            millis < 10 ? "00" : (millis < 100 ? "0" : ""), millis,
            self.beats_per_bar, self.beat_unit);
        surface.text(row, text, theme.foreground, theme.panel);
        // ASCII status text gives a predictable cell offset; the LED is separate.
        let offset: i32 = i32(len(text));
        if offset < area.width {
            surface.text(Rect::new(area.x + offset, area.y, area.width - offset, 1),
                self.midi_received ? "●" : "○", self.midi_received ? 0x5adc8c : theme.muted, theme.panel);
        }
        let state: str8 = self.playing && self.count_in > 0 ? "COUNT IN" : (self.recording ? "REC" : (self.playing ? "PLAY" : "STOP"));
        if offset + 2 < area.width {
            surface.text(Rect::new(area.x + offset + 2, area.y, area.width - offset - 2, 1),
                state, self.playing ? theme.accent : theme.muted, theme.panel);
        }
        var state_end: i32 = offset + 2 + i32(len(state));
        let name: str8 = format!(" | {}", document);
        if state_end < area.width {
            surface.text(Rect::new(area.x + state_end, area.y, area.width - state_end, 1), name, theme.foreground, theme.panel);
        }
        state_end = state_end + i32(len(name));
        free(name);
        let cpu: str8 = self.cpu_percent >= 0 ? format!("CPU {}{} ", self.cpu_percent, "%") : format!("");
        let message: str8 = midi_message_text(self.midi_kind, self.midi_channel, self.midi_data, self.midi_value);
        if message != "" {
            // Only where it clears the transport text and the CPU meter.
            let shown: str8 = format!(" | {}", message);
            if state_end + i32(len(shown)) + i32(len(cpu)) + 1 <= area.width {
                surface.text(Rect::new(area.x + state_end, area.y, area.width - state_end, 1), shown,
                    self.midi_received ? 0x5adc8c : theme.muted, theme.panel);
                state_end = state_end + i32(len(shown));
            }
            free(shown);
        }
        free(message);
        if self.cpu_percent >= 0 {
            let width: i32 = i32(len(cpu));
            // Right-aligned, and only where it clears the transport text.
            if area.width - width > state_end + 1 {
                surface.text(Rect::new(area.x + area.width - width, area.y, width, 1), cpu,
                    self.cpu_percent >= 80 ? theme.accent : theme.foreground, theme.panel);
            }
        }
        free(cpu); free(text);
    }
}
