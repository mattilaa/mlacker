mod std::audio::controller;
mod std::audio;
use std::audio::PcmAudio;
mod mlacker_ui::midi_controller;
mod mlacker_ui::note_playback;
mod mlacker_ui::sequence;
mod mlacker_ui::bounce;
use mlacker_ui::bounce::Bounce;
use mlacker_ui::bounce::BounceOptions;
use mlacker_ui::bounce::bounce_block;
use mlacker_ui::bounce::keep_tracks;
use std::audio::PcmBlock;
use mlacker_ui::note_playback::NotePlayback;
use mlacker_ui::sequence::SequenceTable;
use mlacker_ui::sequence::SequenceTrack;
use mlacker_ui::sequence::AudioInstance;
use tui::table::TableRow;
use mlacker_ui::audio_clip::AudioClip;
use mlacker_ui::audio_clip::base_name;
mod mlacker_ui::time_stretch;
use mlacker_ui::time_stretch::render_synced;
use std::audio::controller::*;
use std::audio::detail::__mlang_std_audio_last_error;
use std::midi::input_count;
use mlacker_ui::midi_controller::MidiController;
use mlacker_ui::note_playback::NoteEvent;
use std::strbuf::clone;
use std::strbuf::free;

/// Control-thread owner. AUHAL owns rendering; MIDI uses its separate lane.
pub struct EffectChannel { var path: str8{""}; var volume: i32{100}; };
/// Sampler-instrument pad (0-based) filled from the session sample list.
pub struct PadAssignment { var slot: i32; var pad: i32; var sample: i32; };
/// Slice markers set by hand for a sampler pad (frames, ascending, the first
/// 0); pads without an entry use the ones the instrument detects.
pub struct PadMarkers { var slot: i32; var pad: i32; var frames: list<i64>; };
pub struct SamplePlacement { var sample: i64; var track: i64; var start: i64; var duration: i64; var rate: i64; var next: i64; var head: i64; };
/// PCM already registered with the controller. Clips are matched by content,
/// so re-arming a pattern reuses the registration instead of stopping the
/// device to upload the same audio again.
pub struct RegisteredClip { var id: i64; var frames: i64; var channels: i64; var rate: i64; var fingerprint: i64; };
/// A tempo-synced placement rendered at `bpm` (see AudioInstance::synced) and
/// registered as `id` with `frames` frames; the rest is what it was made from.
pub struct SyncedClip {
    var id: i64; var frames: i64;
    var fingerprint: i64; var source_frames: i64; var from: i64; var to: i64;
    var original_bpm: i32; var algorithm: i32; var bpm: i32;
};
/// Cheap content key: enough spread to separate two clips of equal geometry,
/// including one a destructive edit rewrote in place.
pub fn clip_fingerprint(samples: list<f32>) -> i64 {
    let count: i64 = samples.len();
    let step: i64 = count > 64 ? count / 64 : 1;
    var hash: i64 = count % 1000000007;
    var i: i64 = 0;
    while i < count {
        hash = (hash * 131 + wide(i32(samples[i] * 32767.0f)) + 2147483648) % 1000000007;
        i = i + step;
    }
    return hash;
}
pub struct AudioSystem {
    var output: AudioController; var midi: MidiController;
    var click_output: i64; var click_high: i64{-1}; var click_low: i64{-1};
    var midi_id: i64{-1}; var output_id: i64{-1};
    /// Live audio input device: -2 disabled, -1 system default, else an
    /// input device index (see `set_input`).
    var input_id: i64{-2};
    var hardware_requested: bool;
    var requested_buffer_frames: i64{128};
    var requested_sample_rate: i64{0};
    var processor_path: str8{""};
    var instrument_paths: list<str8>;
    var last_instrument_id: i32;
    var instrument_output_failed: bool;
    var effects: list<EffectChannel>;
    var insert_paths: list<str8>;
    var pads: list<PadAssignment>;
    var pad_markers: list<PadMarkers>;
    var sample_placements: list<SamplePlacement>; var samples_running: bool;
    var sample_output: i64; var sample_last: i64;
    /// Tick where row 0 of the pattern holding the placements falls, and the
    /// row it starts on (-1 takes it from the tick, which is right while one
    /// pattern keeps playing). Both mirror NotePlayback, so clips and notes
    /// share a pattern's grid.
    var sample_epoch: i64; var sample_start_row: i32{-1};
    var registered_clips: list<RegisteredClip>;
    /// Renders of the registered clips' synced placements.
    var synced_clips: list<SyncedClip>;
    /// Next slot of the instruments' phrase ring (TEXT cells, 0-255).
    var next_phrase: i32;
    /// Transport last handed to `output` for tempo-synced plugins.
    var transport_output: i64; var transport_bpm: i32; var transport_playing: bool;
    /// Sequencer timing: while `scheduling`, tick `schedule_tick` sounds on
    /// audio frame `schedule_frame` at `schedule_bpm`, so notes carry the
    /// exact frame they belong to however late the UI posts them.
    var scheduling: bool; var schedule_output: i64; var schedule_tick: i64;
    var schedule_frame: i64; var schedule_bpm: i32; var schedule_rate: i64;
    /// Offline bounce: `sample_playback` is called with the tick the next
    /// block starts on and stamps each clip with the exact frame it starts
    /// on, from its first sample, instead of starting it late on a block.
    var stamp_samples: bool;
};
impl AudioSystem {
    pub fn adopt(self: &mut Self, source: &AudioSystem) -> void {
        var next: AudioSystem = AudioSystem {}; next = source;
        self.release();
        self.output = next.output; self.midi = next.midi; self.midi_id = next.midi_id; self.output_id = next.output_id;
        self.input_id = next.input_id;
        self.hardware_requested = next.hardware_requested;
        self.requested_buffer_frames = next.requested_buffer_frames;
        self.requested_sample_rate = next.requested_sample_rate;
        self.processor_path = next.processor_path; self.instrument_paths = next.instrument_paths;
        self.last_instrument_id = next.last_instrument_id; self.instrument_output_failed = next.instrument_output_failed;
        self.effects = next.effects;
        self.insert_paths = next.insert_paths;
        self.pads = next.pads;
        self.pad_markers = next.pad_markers;
        self.samples_running = false; self.sample_placements = []; self.sample_output = 0;
        self.sample_epoch = 0; self.sample_start_row = -1; self.registered_clips = []; self.synced_clips = [];
        self.click_output = 0; self.click_high = -1; self.click_low = -1;
    }
    pub fn start(hardware: bool) -> AudioSystem {
        var system: AudioSystem = AudioSystem { hardware_requested: hardware };
        if hardware {
            let opened: result<AudioController, str8> = AudioController::open(-1, 128);
            if opened.is_ok() {
                system.output = opened.unwrap();
                if system.output.start() != 0 { system.output.close(); system.output.handle = 0; }
            }
            system.midi = MidiController::start_selected(-1, system.output.handle);
        }
        return system;
    }
    /// Prepare new output before retiring old resources. Failure leaves old output.
    /// `samples` is the session sample list; sampler pads live inside their
    /// plugin instances and are re-sent after the instruments reload.
    pub fn configure(self: &mut Self, midi_id: i64, output_id: i64, samples: &list<AudioClip>) -> result<i32, str8> {
        return self.configure_buffer(midi_id, output_id, self.requested_buffer_frames, samples);
    }
    pub fn configure_buffer(self: &mut Self, midi_id: i64, output_id: i64, frames: i64, samples: &list<AudioClip>) -> result<i32, str8> {
        return self.configure_audio(midi_id, output_id, frames, self.requested_sample_rate, samples);
    }
    pub fn configure_audio(self: &mut Self, midi_id: i64, output_id: i64, frames: i64, rate: i64, samples: &list<AudioClip>) -> result<i32, str8> {
        if rate != 0 && rate != 44100 && rate != 48000 && rate != 96000 { return Err<i32, str8>("Select 44.1, 48 or 96 kHz"); }
        if frames < 32 || frames > 4096 { return Err<i32, str8>("Buffer size must be 32..4096 frames"); }
        if midi_id < -2 || output_id < -2 { return Err<i32, str8>("Invalid device selection"); }
        if midi_id >= std::midi::input_count() { return Err<i32, str8>("MIDI adapter unavailable; reopen Settings"); }
        var next: AudioController = AudioController {};
        if output_id != -2 {
            let opened: result<AudioController, str8> = AudioController::open_at_rate(output_id, frames, rate);
            if opened.is_err() { return Err<i32, str8>(__mlang_std_audio_last_error()); }
            next = opened.unwrap();
        }
        if output_id == -2 && (self.instrument_paths.len() > 0 || self.processor_path != "" || self.effects.len() > 0 || self.insert_paths.len() > 0) {
            let created: result<AudioController, str8> = AudioController::new(rate == 0 ? 48000 : rate, frames);
            if created.is_err() { return Err<i32, str8>(__mlang_std_audio_last_error()); }
            next = created.unwrap();
        }
        if next.handle != 0 {
            if self.processor_path != "" {
                if next.load_processor(self.processor_path) != 0 { next.close(); return Err<i32, str8>(__mlang_std_audio_last_error()); }
                if next.copy_parameters_from(self.output, 0) != 0 { next.close(); return Err<i32, str8>("Cannot preserve master plugin parameters; settings unchanged"); }
            }
            for i in 0..self.instrument_paths.len() {
                if self.instrument_paths[i] != "" {
                    if next.load_instrument(i + 1, self.instrument_paths[i]) != 0 { next.close(); return Err<i32, str8>(__mlang_std_audio_last_error()); }
                    if next.copy_parameters_from(self.output, i + 1) != 0 { next.close(); return Err<i32, str8>("Cannot preserve instrument parameters; settings unchanged"); }
                }
            }
            let pads: list<PadAssignment> = self.pads;
            for entry in pads {
                let clip: AudioClip = samples[entry.sample];
                let name: str8 = base_name(clip.source);
                let sent: i32 = next.instrument_pad(entry.slot, entry.pad, clip.samples, clip.channels, clip.sample_rate, name);
                free(name);
                if sent != 0 { next.close(); return Err<i32, str8>("Cannot preserve sampler pads; settings unchanged"); }
            }
            if next.copy_midi_learn_from(self.output) != 0 { next.close(); return Err<i32, str8>("Cannot preserve MIDI learn; settings unchanged"); }
            for i in 0..self.effects.len() {
                let effect: EffectChannel = self.effects[i];
                if effect.path != "" {
                    if next.load_effect(i, effect.path) != 0 { next.close(); return Err<i32, str8>("Cannot reload effect; settings unchanged"); }
                    if next.copy_parameters_from(self.output, i + 33) != 0 { next.close(); return Err<i32, str8>("Cannot preserve effect parameters; settings unchanged"); }
                }
                next.effect_volume(i, effect.volume);
            }
            for i in 0..self.insert_paths.len() {
                if next.load_insert(i + 1, self.insert_paths[i]) != 0 || next.copy_parameters_from(self.output, i + 41) != 0 {
                    next.close(); return Err<i32, str8>("Cannot preserve insert plugin; settings unchanged");
                }
            }
            if output_id != -2 { if next.start() != 0 { next.close(); return Err<i32, str8>(__mlang_std_audio_last_error()); } }
        }
        // Never free an audio handle while the MIDI producer still borrows it.
        self.midi.release();
        if self.output.handle != 0 {
            if self.output.close() != 0 {
                if next.handle != 0 { next.close(); }
                self.midi = MidiController::start_selected(self.midi_id, self.output.handle);
                return Err<i32, str8>("Could not stop previous output; settings unchanged");
            }
        }
        self.output = next; self.midi_id = midi_id; self.output_id = output_id;
        self.hardware_requested = output_id != -2;
        self.requested_buffer_frames = frames;
        self.requested_sample_rate = rate;
        self.midi = MidiController::start_selected(midi_id, self.output.handle);
        // The live input belongs to the controller: reopen it on the new one.
        if self.input_id != -2 && self.output.handle != 0 && self.output.input_open(self.input_id) != 0 { self.input_id = -2; }
        return Ok<i32, str8>(0);
    }
    /// Open the live audio input on device `input_id` (-1 = system default),
    /// or close it (-2). Returns "" or the reason it could not open; the
    /// input then stays disabled.
    pub fn set_input(self: &mut Self, input_id: i64) -> str8 {
        if input_id < -2 { return "Invalid audio input"; }
        if self.output.handle == 0 {
            self.input_id = -2;
            return input_id == -2 ? "" : "Audio input needs audio enabled (Settings > Master output)";
        }
        if self.output.input_open(input_id) != 0 { self.input_id = -2; return __mlang_std_audio_last_error(); }
        self.input_id = input_id; return "";
    }
    // --- Offline bounce (see bounce.mla) ---------------------------------------
    /// Stop the device and prepare to render at `bpm`. On failure `error`
    /// says why and nothing was changed.
    pub fn bounce_begin(self: &mut Self, bpm: i32) -> Bounce {
        var job: Bounce = Bounce { bpm: bpm };
        if self.output.handle == 0 { job.error = "Bouncing needs audio enabled (File > Settings)"; return job; }
        if bpm <= 0 { job.error = "Invalid tempo"; return job; }
        let allocated: result<PcmBlock, str8> = PcmBlock::new(bounce_block());
        if allocated.is_err() { job.error = "Cannot allocate a render block"; return job; }
        job.block = allocated.unwrap();
        job.rate = self.output.sample_rate();
        // The device and its MIDI producer pause; the render runs here.
        job.worker = self.midi.worker.raw != 0;
        job.restart = self.output.hardware_output();
        self.midi.release();
        if job.restart && self.output.stop() != 0 {
            if job.worker { self.midi = MidiController::start_selected(self.midi_id, self.output.handle); }
            job.block.close();
            job.error = "Could not stop the audio device"; return job;
        }
        // Start from silence: no voices, notes or clips left from before.
        self.output.panic();
        self.output.process(job.block, bounce_block());
        // Ticks map to frames for the whole job, so notes are frame-exact
        // and segments follow each other seamlessly.
        self.stamp_samples = true;
        self.scheduling = true; self.schedule_tick = 0; self.schedule_frame = self.output.frame_clock();
        self.schedule_bpm = bpm; self.schedule_rate = job.rate; self.schedule_output = self.output.handle;
        return job;
    }
    fn bounce_block_render(self: &mut Self, job: &mut Bounce) -> void {
        // Fields of a borrowed struct are reached through a local copy.
        var b: Bounce = Bounce {}; b = job;
        self.output.process(b.block, bounce_block());
        let size: i64 = bounce_block();
        for f in 0..size {
            b.samples.push(b.block.left(f)); b.samples.push(b.block.right(f));
        }
        job = b;
    }

    /// Render rows `from_row` .. `to_row` (exclusive) of `source`, right after
    /// the previous segment. `tracks` lists the track indexes that play
    /// (empty = all); the others stay silent.
    pub fn bounce_segment(self: &mut Self, job: &mut Bounce, source: &SequenceTable, from_row: i32, to_row: i32, tracks: list<i32>) -> void {
        // Fields of a borrowed struct are reached through a local copy.
        var b: Bounce = Bounce {}; b = job;
        if !b.ok() { return; }
        var table: SequenceTable = SequenceTable {}; table = source;
        if to_row <= from_row || table.rows.len() == 0 { return; }
        // Muted copies silence the tracks left out (their clips and the
        // instruments only they play); their notes are dropped below.
        var played: SequenceTable = table.copy_pattern();
        if tracks.len() > 0 {
            for t in 0..played.tracks.len() {
                var keep: bool = false; for index in tracks { if index == i32(t) { keep = true; } }
                if !keep { played.set_muted(i32(t), true); }
            }
        }
        self.sync_volumes(played);
        // The segment's first row falls where the previous one ended; the
        // block in progress may already be a little past it.
        let start: i64 = b.next_start;
        let end: i64 = start + wide(to_row - from_row) * 15000;
        var playback: NotePlayback = NotePlayback { start_row: from_row };
        playback.carry_voices(b.playback);
        // Tempo-synced plugins follow the beat of the area, from its start
        // on each pass (60000 ticks per beat).
        if b.pass_base < 0 { b.pass_base = wide(from_row) * 15000; }
        self.output.transport(f64(b.bpm), f64(b.pass_base + start - b.pass_start) / 60000.0, true);
        self.restart_samples(from_row);
        self.samples_running = false;
        while b.tick < end {
            let block_ticks: i64 = b.tick_at(b.frames + bounce_block()) - b.tick;
            // Send ahead up to the next block, never past the segment.
            var ahead: i64 = block_ticks + 1;
            if b.tick + ahead > end - 1 { ahead = end - 1 - b.tick; }
            playback.lookahead = ahead < 0 ? 0 : ahead;
            playback.update(played, b.tick < start ? start : b.tick, true);
            self.sequencer_events(keep_tracks(playback.events, tracks), played);
            // Clips starting before the next block are stamped onto their frame.
            let next_tick: i64 = b.tick_at(b.frames + bounce_block());
            self.sample_playback(played, next_tick > end ? end : next_tick, true, b.bpm);
            self.bounce_block_render(&mut b);
            b.frames = b.frames + bounce_block();
            b.tick = b.tick_at(b.frames);
        }
        // The segment ends: notes still held go on into the next one (or are
        // released by `finish`); its clips stop here.
        self.sample_playback(played, end, false, b.bpm);
        b.playback = playback;
        b.next_start = end;
        played.release();
        job = b;
    }

    /// Release held notes, render the tail until the mix is quiet (at most
    /// `tail_seconds`; 0 = no tail), restore playback state and restart the
    /// device. Returns the interleaved stereo frames kept (from the last pass
    /// started with `bounce_next_pass`, or all of them).
    /// Start another pass over the same area: plugins, held notes and tails
    /// carry on from the last one (nothing is reset), the transport beat
    /// restarts at the area's start, and only audio from here on is kept.
    pub fn bounce_next_pass(self: &mut Self, job: &mut Bounce) -> void {
        var b: Bounce = Bounce {}; b = job;
        b.pass_start = b.next_start; b.pass_base = -1;
        // Keep from the frame the area restarts on (frame 0 is tick 0); the
        // block in progress may already have run a little past it.
        let frame: i64 = b.next_start * b.rate / (wide(b.bpm) * 1000);
        b.capture_from = frame * 2 < b.samples.len() ? frame * 2 : b.samples.len();
        job = b;
    }
    pub fn bounce_finish(self: &mut Self, job: &mut Bounce, source: &SequenceTable, tail_seconds: i64) -> list<f32> {
        // Fields of a borrowed struct are reached through a local copy.
        var b: Bounce = Bounce {}; b = job;
        if !b.ok() { return []; }
        b.playback.update(source, b.tick, false);
        self.sequencer_events(b.playback.events, source);
        self.scheduling = false;
        let limit: i64 = tail_seconds * b.rate;
        // Quiet = below about -90 dBFS for half a second.
        let quiet_needed: i64 = b.rate / 2;
        var quiet: i64 = 0; var rendered: i64 = 0;
        while rendered < limit && quiet < quiet_needed {
            self.bounce_block_render(&mut b);
            rendered = rendered + bounce_block();
            var peak: f32 = 0.0f;
            let size: i64 = bounce_block();
            for f in 0..size {
                let l: f32 = b.block.left(f); let r: f32 = b.block.right(f);
                if l > peak { peak = l; } if 0.0f - l > peak { peak = 0.0f - l; }
                if r > peak { peak = r; } if 0.0f - r > peak { peak = 0.0f - r; }
            }
            quiet = peak < 0.0000316f ? quiet + bounce_block() : 0;
        }
        // Drop the quiet end the tail search rendered.
        var keep: i64 = b.samples.len() - (quiet > 0 ? quiet - quiet % bounce_block() : 0) * 2;
        if keep < 0 { keep = 0; }
        var out: list<f32> = [];
        let first: i64 = b.capture_from < keep ? b.capture_from : keep;
        for i in first..keep { out.push(b.samples[i]); }
        // The next sync_transport resends the sequencer's own position.
        self.output.transport(f64(b.bpm), 0.0, false);
        self.transport_output = 0;
        b.samples = [];
        self.output.panic();
        self.samples_running = false; self.stamp_samples = false;
        b.block.close();
        if b.restart { self.output.start(); }
        if b.worker { self.midi = MidiController::start_selected(self.midi_id, self.output.handle); }
        job = b;
        return out;
    }
    pub fn poll(self: &mut Self, now: i64) -> bool { return self.midi.poll(now); }
    /// Register embedded PCM off the audio thread, then send only bounded events.
    pub fn sample_playback(self: &mut Self, source: &SequenceTable, tick: i64, playing: bool, bpm: i32) -> bool {
        var table: SequenceTable = SequenceTable {}; table = source;
        if !playing || table.rows.len() == 0 {
            if self.samples_running {
                let placements: list<SamplePlacement> = self.sample_placements;
                for placement in placements {
                    self.output.post(AudioEvent { kind: AudioEventKind::StopSource, source: placement.track }, 0);
                }
            }
            self.samples_running = false; return true;
        }
        if self.output.handle == 0 { return true; }
        if bpm <= 0 { return false; }
        let period: i64 = table.rows.len() * 15000;
        if !self.samples_running || self.sample_output != self.output.handle || tick < self.sample_last {
            // The pattern starts on this row now; its clips repeat on its own
            // length from there, whatever the previous pattern's length was.
            let row_start: i64 = tick - tick % 15000;
            let row: i64 = self.sample_start_row >= 0 ? wide(self.sample_start_row) : tick / 15000 % wide(i32(table.rows.len()));
            self.sample_epoch = row_start - row * 15000;
            self.sample_start_row = -1;
            // Arming a pattern never stops the device: registration appends
            // while it renders, so effect tails and instrument voices survive a
            // matrix row change. Only a full cache (256 clips) reloads.
            if self.sample_output != self.output.handle { self.registered_clips = []; self.synced_clips = []; }
            var valid: bool = false;
            for attempt in 0..2 {
                if valid { break; }
                if attempt == 1 {
                    // Every slot is taken by clips this session no longer uses.
                    // Emptying them is the one case that needs a stopped device.
                    let worker: bool = self.midi.worker.raw != 0;
                    let restart: bool = self.output.hardware_output();
                    self.midi.release();
                    if self.output.stop() != 0 {
                        if worker { self.midi = MidiController::start_selected(self.midi_id, self.output.handle); }
                        return false;
                    }
                    self.output.clear_samples(); self.registered_clips = []; self.synced_clips = []; self.click_high = -1; self.click_low = -1;
                    if restart { if self.output.start() != 0 { return false; } }
                    if worker { self.midi = MidiController::start_selected(self.midi_id, self.output.handle); }
                }
                self.sample_placements = []; valid = true;
                for t in 0..table.tracks.len() {
                    let track: SequenceTrack = table.tracks[t];
                    if !track.audio { continue; }
                    let instances: list<AudioInstance> = track.instances;
                    for instance in instances {
                        let rc: AudioClip = instance.render_clip();
                        // A synced placement plays its own render from frame 0.
                        var id: i64 = -1; var head: i64 = rc.offset; var frames: i64 = rc.frames;
                        if instance.synced() && rc.frames > 0 {
                            let synced: SyncedClip = self.register_synced(instance, rc, bpm);
                            id = synced.id; head = 0; frames = synced.frames;
                        } else { id = self.register_clip(instance.clip); }
                        if id < 0 { valid = false; continue; }
                        let start: i64 = wide(instance.start_row) * 15000 + table.audio_timing_offset(i32(t), instance.start_row);
                        let duration: i64 = frames * wide(bpm) * 1000 / instance.clip.sample_rate;
                        var next: i64 = self.sample_epoch + (tick - self.sample_epoch) / period * period + start;
                        if next + duration <= tick { next = next + period; }
                        self.sample_placements.push(SamplePlacement { sample: id, track: t, start: start, duration: duration,
                            rate: instance.clip.sample_rate, next: next, head: head });
                    }
                }
            }
            self.sample_output = self.output.handle; self.samples_running = true;
            if !valid { self.samples_running = false; return false; }
        }
        let previous: list<SamplePlacement> = self.sample_placements;
        var updated: list<SamplePlacement> = [];
        // Stamped starts are posted in frame order (one lane, nondecreasing).
        var stamped: list<SamplePlacement> = []; var frames: list<i64> = [];
        for item in previous {
            var placement: SamplePlacement = item;
            if self.stamp_samples && self.scheduling && placement.next < tick {
                if tick - placement.next < placement.duration {
                    let at: i64 = self.frame_of(placement.next);
                    var index: i64 = 0;
                    while index < frames.len() && frames[index] <= at { index = index + 1; }
                    var kept: list<SamplePlacement> = []; var kept_frames: list<i64> = [];
                    for i in 0..stamped.len() {
                        if i == index { kept.push(placement); kept_frames.push(at); }
                        kept.push(stamped[i]); kept_frames.push(frames[i]);
                    }
                    if index == stamped.len() { kept.push(placement); kept_frames.push(at); }
                    stamped = kept; frames = kept_frames;
                }
                placement.next = placement.next + period;
            }
            else if !self.stamp_samples && placement.next <= tick {
                if tick - placement.next >= period { placement.next = placement.next + (tick - placement.next) / period * period; }
                let elapsed: i64 = tick - placement.next;
                if elapsed < placement.duration {
                    let offset: i64 = placement.head + elapsed * placement.rate / (wide(bpm) * 1000);
                    let length: i64 = (placement.duration - elapsed) * placement.rate / (wide(bpm) * 1000);
                    if length > 0 { self.output.play_sample(placement.sample, placement.track, offset, length); }
                }
                placement.next = placement.next + period;
            }
            updated.push(placement);
        }
        for i in 0..stamped.len() {
            let placement: SamplePlacement = stamped[i];
            let length: i64 = placement.duration * placement.rate / (wide(bpm) * 1000);
            if length > 0 {
                self.output.post(AudioEvent { kind: AudioEventKind::PlaySample, sample: placement.sample, source: placement.track,
                    midi: AudioMidiEvent { note: placement.head, velocity: length }, frame: frames[i] }, 0);
            }
        }
        self.sample_placements = updated; self.sample_last = tick; return true;
    }
    /// Tell tempo-synced plugins the sequencer BPM and beat (60000 ticks per
    /// quarter note). The audio thread runs the beat on by itself, so only a
    /// start, stop, tempo change or new device resends the position.
    pub fn sync_transport(self: &mut Self, bpm: i32, tick: i64, playing: bool) -> void {
        if self.output.handle == 0 || bpm <= 0 { return; }
        if self.transport_output == self.output.handle && self.transport_bpm == bpm && self.transport_playing == playing { return; }
        let beat: f64 = f64(tick < 0 ? 0 : tick) / 60000.0;
        if self.output.transport(f64(bpm), beat, playing) != 0 { return; }
        self.transport_output = self.output.handle; self.transport_bpm = bpm; self.transport_playing = playing;
    }
    /// Keep sequencer ticks mapped to audio frames while the transport runs on
    /// a hardware output. `tick` is the transport position now. The mapping
    /// starts over on start, a tempo change or a new device, and whenever the
    /// UI clock and the audio clock drift apart by more than two buffers.
    pub fn schedule_transport(self: &mut Self, tick: i64, bpm: i32, playing: bool) -> void {
        if !playing || bpm <= 0 || self.output.handle == 0 || !self.output.hardware_output() { self.scheduling = false; return; }
        let rate: i64 = self.output.sample_rate(); let buffer: i64 = self.output.buffer_frames();
        if rate <= 0 { self.scheduling = false; return; }
        // Posted now, an event is heard from the next buffer on.
        let now_frame: i64 = self.output.frame_clock() + buffer;
        if self.scheduling && self.schedule_output == self.output.handle && self.schedule_bpm == bpm && self.schedule_rate == rate {
            let drift: i64 = self.frame_of(tick) - now_frame;
            let limit: i64 = 2 * buffer + rate / 100;
            if drift >= -limit && drift <= limit { return; }
        }
        self.scheduling = true; self.schedule_output = self.output.handle; self.schedule_bpm = bpm;
        self.schedule_rate = rate; self.schedule_tick = tick; self.schedule_frame = now_frame;
    }
    /// Audio frame a sequencer tick sounds on (15000 ticks per sixteenth).
    pub fn frame_of(self: AudioSystem, tick: i64) -> i64 {
        return self.schedule_frame + (tick - self.schedule_tick) * self.schedule_rate / (wide(self.schedule_bpm) * 1000);
    }
    /// How far ahead of the transport sequencer events may be posted: 60 ms
    /// while notes are frame-stamped, none otherwise (they would sound early).
    pub fn lookahead_ticks(self: AudioSystem, bpm: i32) -> i64 { return self.scheduling ? 60 * wide(bpm) : 0; }
    /// Short decaying clicks use the existing realtime PCM mixer, outside track routing.
    pub fn metronome(self: &mut Self, accent: bool) -> void {
        if self.output.handle == 0 { return; }
        if self.click_output != self.output.handle {
            self.click_output = self.output.handle; self.click_high = -1; self.click_low = -1;
        }
        if self.click_high < 0 || self.click_low < 0 {
            var high: list<f32> = []; var low: list<f32> = [];
            for i in 0..1440 {
                let envelope: f32 = 0.18f * f32(1440 - i) / 1440.0f;
                high.push((i % 24 < 12 ? 1.0f : -1.0f) * envelope);
                low.push((i % 48 < 24 ? 1.0f : -1.0f) * envelope);
            }
            if self.click_high < 0 { self.click_high = self.output.add_sample_data(high, 1, 48000); }
            if self.click_low < 0 { self.click_low = self.output.add_sample_data(low, 1, 48000); }
        }
        let sample: i64 = accent ? self.click_high : self.click_low;
        if sample >= 0 { self.output.post(AudioEvent { kind: AudioEventKind::PlaySample, sample: sample, source: 32767 }, 0); }
    }
    /// Controller-side PCM id for a clip, uploading it only the first time.
    /// Returns -1 when the controller is full or refuses the data.
    fn register_clip(self: &mut Self, clip: AudioClip) -> i64 {
        let fingerprint: i64 = clip_fingerprint(clip.samples);
        let known: list<RegisteredClip> = self.registered_clips;
        for entry in known {
            if entry.fingerprint == fingerprint && entry.frames == clip.frames
                && entry.channels == clip.channels && entry.rate == clip.sample_rate { return entry.id; }
        }
        let id: i64 = self.output.add_sample_data(clip.samples, clip.channels, clip.sample_rate);
        if id < 0 { return -1; }
        self.registered_clips.push(RegisteredClip { id: id, frames: clip.frames, channels: clip.channels,
            rate: clip.sample_rate, fingerprint: fingerprint });
        return id;
    }
    /// Render placement `instance` (window `rc`) at `bpm` with its sync mode
    /// and register it, or reuse an earlier render. `id` is -1 on failure.
    fn register_synced(self: &mut Self, placement: &AudioInstance, rc: AudioClip, bpm: i32) -> SyncedClip {
        var instance: AudioInstance = AudioInstance {}; instance = placement;
        let fingerprint: i64 = clip_fingerprint(instance.clip.samples);
        let from: i64 = rc.offset; let to: i64 = rc.offset + rc.frames;
        let known: list<SyncedClip> = self.synced_clips;
        for entry in known {
            if entry.fingerprint == fingerprint && entry.source_frames == instance.clip.frames && entry.from == from && entry.to == to &&
                entry.original_bpm == instance.original_bpm && entry.algorithm == instance.stretch_algorithm && entry.bpm == bpm { return entry; }
        }
        // The window's length at `bpm` instead of at the original tempo.
        let frames: i64 = (rc.frames * wide(instance.original_bpm) + wide(bpm) - 1) / wide(bpm);
        var rendered: AudioClip = AudioClip {};
        rendered.channels = instance.clip.channels; rendered.sample_rate = instance.clip.sample_rate; rendered.frames = frames;
        rendered.samples = render_synced(instance.clip.samples, instance.clip.channels, instance.clip.sample_rate, from, to, frames, instance.stretch_algorithm);
        let entry: SyncedClip = SyncedClip { id: self.register_clip(rendered), frames: frames, fingerprint: fingerprint,
            source_frames: instance.clip.frames, from: from, to: to, original_bpm: instance.original_bpm,
            algorithm: instance.stretch_algorithm, bpm: bpm };
        if entry.id >= 0 { self.synced_clips.push(entry); }
        return entry;
    }
    /// The playing pattern changed: silence its clips and re-arm the next
    /// pattern's placements on the next `sample_playback`.
    pub fn restart_samples(self: &mut Self, row: i32) -> void {
        if self.samples_running {
            let placements: list<SamplePlacement> = self.sample_placements;
            for placement in placements {
                self.output.post(AudioEvent { kind: AudioEventKind::StopSource, source: placement.track }, 0);
            }
        }
        self.samples_running = false; self.sample_placements = []; self.sample_start_row = row;
    }
    /// The route aux bus `bus` of instrument `slot` takes (see
    /// SequenceTable::set_aux_output) when the track stores `destination`.
    /// A bus named "Send ..." (Mla Sampler's Send A and B) is a send: left
    /// unrouted, the n-th one feeds aux effect channel n instead of joining
    /// the main output.
    pub fn aux_route(self: AudioSystem, slot: i32, bus: i32, destination: i32) -> i32 {
        if destination != -1 { return destination; }
        var sends: i32 = 0;
        for b in 1..bus + 1 {
            let name: str8 = self.output.instrument_output_name(wide(slot), b);
            if !tui::table::table_matches("Send .*", name) { continue; }
            if b == wide(bus) { return sends < 8 ? -2 - sends : -10; }
            sends = sends + 1;
        }
        return -1;
    }
    pub fn sync_volumes(self: AudioSystem, source: &SequenceTable) -> void {
        var table: SequenceTable = SequenceTable {}; table = source;
        // Publish final routes directly: never transiently bypass active chains.
        for s in 0..96 {
            var selected: i32 = -1;
            for t in 0..table.tracks.len() {
                let track: SequenceTrack = table.tracks[t];
                if (!track.instrument && s == t) || (track.instrument && track.instrument_id > 0 && s == 63 + wide(track.instrument_id)) { selected = i32(t); }
            }
            for n in 0..4 {
                var id: i32 = 0; if selected >= 0 { let track: SequenceTrack = table.tracks[selected]; id = track.insert_id(i32(n)); }
                self.output.insert_route(s, n, id);
            }
        }
        // Output channels: a track feeds master (0) or another audio track,
        // which then applies its own inserts, fader and sends.
        for s in 0..96 {
            var destination: i32 = 0;
            for t in 0..table.tracks.len() {
                let track: SequenceTrack = table.tracks[t];
                if (!track.instrument && s == t) || (track.instrument && track.instrument_id > 0 && s == 63 + wide(track.instrument_id)) {
                    destination = table.track_output(i32(t));
                }
            }
            self.output.output_route(s, wide(destination));
        }
        // Audio inputs of instruments (a vocoder's modulator) follow the
        // track that plays the instance.
        for slot in 1..33 {
            var source: i32 = 0;
            for t in 0..table.tracks.len() {
                let track: SequenceTrack = table.tracks[t];
                if track.instrument && wide(track.instrument_id) == slot { source = table.track_input(i32(t)); }
            }
            // The controller numbers the live input 65.
            self.output.instrument_input(slot, source == -1 ? 65 : wide(source));
        }
        // Aux output buses of multi-output instruments (e.g. Mla Sampler's Out
        // 2-8) follow the routes of the track that plays the instance.
        for slot in 1..33 {
            let outputs: i64 = self.output.instrument_outputs(slot);
            if outputs <= 1 { continue; }
            var selected: i32 = -1;
            for t in 0..table.tracks.len() {
                let track: SequenceTrack = table.tracks[t];
                if track.instrument && wide(track.instrument_id) == slot { selected = i32(t); }
            }
            for bus in 1..outputs {
                let stored: i32 = selected >= 0 ? table.track_aux_output(selected, i32(bus)) : -1;
                let destination: i32 = self.aux_route(i32(slot), i32(bus), stored);
                // The controller's numbering: effect channels 65-72, nowhere 73.
                let host: i32 = destination == -10 ? 73 : (destination <= -2 ? 65 + (-2 - destination) : destination);
                self.output.instrument_output_route(slot, bus, wide(host));
            }
        }
        for i in 0..table.tracks.len() {
            let track: SequenceTrack = table.tracks[i];
            self.output.track_volume(i, track.instrument ? track.instrument_id : 0, track.muted ? 0 : track.volume);
            for fx in 0..8 { self.output.effect_send(i, track.instrument ? track.instrument_id : 0, fx, track.muted ? 0 : track.send_level(i32(fx))); }
        }
        // A muted assignment must not silence other tracks using the same instance.
        for i in 0..table.tracks.len() {
            let track: SequenceTrack = table.tracks[i];
            if track.instrument && !track.muted {
                self.output.track_volume(i, track.instrument_id, track.volume);
                for fx in 0..8 { self.output.effect_send(i, track.instrument_id, fx, track.send_level(i32(fx))); }
            }
        }
        for fx in 0..self.effects.len() { let effect: EffectChannel = self.effects[fx]; self.output.effect_volume(fx, effect.volume); }
    }
    pub fn add_effect(self: &mut Self) -> bool {
        if self.effects.len() >= 8 { return false; }
        self.effects.push(EffectChannel {}); return true;
    }
    pub fn effect_level(self: &mut Self, index: i32, value: i32) -> void {
        if index < 0 || index >= self.effects.len() || value < 0 || value > 100 { return; }
        let old: list<EffectChannel> = self.effects; var next: list<EffectChannel> = [];
        for i in 0..old.len() { var effect: EffectChannel = old[i]; if i == index { effect.volume = value; } next.push(effect); }
        self.effects = next;
    }
    pub fn load_effect(self: &mut Self, index: i32, path: str8) -> str8 {
        if index < 0 || index >= self.effects.len() { return clone("Select an effect channel in Mixer first"); }
        if self.output.handle == 0 {
            let created: result<AudioController, str8> = AudioController::new(self.requested_sample_rate == 0 ? 48000 : self.requested_sample_rate, self.requested_buffer_frames);
            if created.is_err() { return clone("Cannot create effect output"); } self.output = created.unwrap(); self.reconnect_midi();
        }
        let worker: bool = self.midi.worker.raw != 0; self.midi.release();
        let restart: bool = self.output.hardware_output();
        if self.output.stop() != 0 { self.resume_midi(worker); return clone("Cannot stop output; effect unchanged"); }
        let loaded: i32 = self.output.load_effect(index, path);
        var message: str8 = loaded == 0 ? clone(path == "" ? "Effect plugin removed" : "Effect loaded; set the plugin wet mix to 100% for aux use") : clone(__mlang_std_audio_last_error());
        if loaded == 0 {
            let old: list<EffectChannel> = self.effects; var next: list<EffectChannel> = [];
            for i in 0..old.len() { var effect: EffectChannel = old[i]; if i == index { if effect.path != "" { free(effect.path); } effect.path = path == "" ? "" : clone(path); } next.push(effect); }
            self.effects = next;
        }
        if restart { if self.output.start() != 0 { free(message); message = clone("Effect processed but audio restart failed; reopen Settings"); } }
        self.resume_midi(worker); return message;
    }
    pub fn route_selected(self: AudioSystem, source: &SequenceTable) -> void {
        if self.output.handle == 0 { return; }
        let target: i64 = AudioSystem::live_target(source);
        if target < 0 { self.output.midi_target(0, -1); return; }
        self.output.midi_target(target % 64, target / 64);
    }
    /// Where live notes go: instrument slot * 64 + track (slot 0 = preview
    /// synth), or -1 when the armed/selected track is audio, muted or unassigned.
    pub fn live_target(source: &SequenceTable) -> i64 {
        var table: SequenceTable = SequenceTable {}; table = source;
        let index: i32 = table.recording_track >= 0 ? table.recording_track : table.active_track();
        if index < 0 || index >= 64 { return -1; }
        let track: SequenceTrack = table.tracks[index];
        if track.audio || track.muted { return -1; }
        if track.instrument { return track.instrument_id > 0 ? wide(track.instrument_id) * 64 + wide(index) : -1; }
        return wide(index);
    }
    /// Virtual keyboard note on the main lane, tagged as live input like a
    /// MIDI keyboard's notes. A note-off must use the target of its note-on.
    pub fn keyboard_note(self: AudioSystem, target: i64, on: bool, note: i32, velocity: i32) -> void {
        if self.output.handle == 0 || target < 0 || note < 0 || note > 127 { return; }
        let slot: i64 = target / 64;
        var kind: AudioEventKind = on ? AudioEventKind::NoteOn : AudioEventKind::NoteOff;
        if slot > 0 { kind = on ? AudioEventKind::InstrumentNoteOn : AudioEventKind::InstrumentNoteOff; }
        self.output.post(AudioEvent { kind: kind, sample: slot, source: target % 64 + 65536,
            midi: AudioMidiEvent { channel: 0, note: wide(note), velocity: on ? wide(velocity) : 0 } }, 0);
    }
    // A device worker may already exist when loading creates an offline output.
    pub fn resume_midi(self: &mut Self, was_running: bool) -> void {
        if was_running && self.midi.worker.raw == 0 { self.midi = MidiController::start_selected(self.midi_id, self.output.handle); }
    }
    fn reconnect_midi(self: &mut Self) -> void {
        if self.midi.worker.raw != 0 {
            self.midi.release(); self.midi = MidiController::start_selected(self.midi_id, self.output.handle);
        }
    }
    /// Returns owned error text, or empty literal on success. IDs remain stable.
    pub fn add_instrument(self: &mut Self, path: str8) -> str8 {
        self.instrument_output_failed = false;
        var slot: i32 = i32(self.instrument_paths.len()) + 1;
        for i in 0..self.instrument_paths.len() { if self.instrument_paths[i] == "" && slot > self.instrument_paths.len() { slot = i32(i) + 1; } }
        if slot > 32 { return clone("Maximum 32 loaded instruments"); }
        if self.output.handle == 0 {
            let created: result<AudioController, str8> = AudioController::new(self.requested_sample_rate == 0 ? 48000 : self.requested_sample_rate, self.requested_buffer_frames);
            if created.is_err() { return clone(__mlang_std_audio_last_error()); }
            self.output = created.unwrap();
            self.reconnect_midi();
        }
        let restart: bool = self.output.hardware_output();
        if self.output.stop() != 0 { return clone(__mlang_std_audio_last_error()); }
        if self.output.load_instrument(slot, path) != 0 {
            let error: str8 = format!("Instrument load failed: {}", __mlang_std_audio_last_error());
            if restart { self.output.start(); } return error;
        }
        if slot > self.instrument_paths.len() { self.instrument_paths.push(clone(path)); }
        else {
            let old: list<str8> = self.instrument_paths; var next: list<str8> = [];
            for i in 0..old.len() { next.push(i + 1 == slot ? clone(path) : old[i]); }
            self.instrument_paths = next;
        }
        self.last_instrument_id = slot;
        // The loaded slot remains valid even if hardware cannot restart.
        if restart { self.instrument_output_failed = self.output.start() != 0; }
        return "";
    }
    pub fn remove_instrument(self: &mut Self, slot: i32) -> str8 {
        if slot < 1 || slot > self.instrument_paths.len() { return clone("Select a loaded instrument"); }
        if self.instrument_paths[slot - 1] == "" { return clone("Select a loaded instrument"); }
        let restart: bool = self.output.hardware_output();
        let worker: bool = self.midi.worker.raw != 0;
        self.output.midi_target(0, -1);
        self.midi.release();
        if self.output.stop() != 0 {
            if worker { self.midi = MidiController::start_selected(self.midi_id, self.output.handle); }
            return clone("Could not stop audio; instrument retained");
        }
        self.output.panic();
        if self.output.unload_instrument(slot) != 0 {
            if restart { self.output.start(); }
            if worker { self.midi = MidiController::start_selected(self.midi_id, self.output.handle); }
            return clone("Instrument unload failed");
        }
        let old: list<str8> = self.instrument_paths; var next: list<str8> = [];
        for i in 0..old.len() { if i + 1 == slot { free(old[i]); next.push(""); } else { next.push(old[i]); } }
        self.instrument_paths = next;
        self.forget_pads(slot);
        self.instrument_output_failed = restart && self.output.start() != 0;
        if worker { self.midi = MidiController::start_selected(self.midi_id, self.output.handle); }
        return "";
    }
    /// Send interleaved PCM to a sampler instrument pad and remember the
    /// sample-list index for sessions. Audio keeps running; the plugin swaps
    /// the pad on its audio thread. Returns owned error text, or "" on success.
    pub fn assign_pad(self: &mut Self, slot: i32, pad: i32, sample: i32, samples: list<f32>, channels: i64, rate: i64, name: str8) -> str8 {
        if slot < 1 || slot > self.instrument_paths.len() { return clone("Select a loaded instrument in Instruments first"); }
        if self.instrument_paths[slot - 1] == "" { return clone("Select a loaded instrument in Instruments first"); }
        if self.output.instrument_pad(slot, pad, samples, channels, rate, name) != 0 {
            return format!("Pad sample failed: {}", __mlang_std_audio_last_error());
        }
        let old: list<PadAssignment> = self.pads; var next: list<PadAssignment> = [];
        var placed: bool = false;
        // Keep ascending (slot, pad) order; the session format requires it.
        for entry in old {
            let key: i32 = entry.slot * 128 + entry.pad;
            if !placed && key >= slot * 128 + pad { next.push(PadAssignment { slot: slot, pad: pad, sample: sample }); placed = true; }
            if key != slot * 128 + pad { next.push(entry); }
        }
        if !placed { next.push(PadAssignment { slot: slot, pad: pad, sample: sample }); }
        self.pads = next;
        self.forget_markers(slot, pad);
        return "";
    }
    /// After a destructive edit of session sample `sample`, re-send every pad
    /// that uses it. Returns the number of pads refreshed, or -1 on failure.
    /// Their hand-set slice markers go: the instrument detects new ones.
    pub fn refresh_pads(self: &mut Self, sample: i32, clip: &AudioClip) -> i32 {
        var source: AudioClip = AudioClip {}; source = clip;
        let name: str8 = base_name(source.source);
        var count: i32 = 0;
        let pads: list<PadAssignment> = self.pads;
        for entry in pads {
            if entry.sample != sample { continue; }
            if self.output.instrument_pad(entry.slot, entry.pad, source.samples, source.channels, source.sample_rate, name) != 0 { count = -1; break; }
            self.forget_markers(entry.slot, entry.pad);
            count = count + 1;
        }
        free(name);
        return count;
    }
    /// Empty a sampler pad and forget its session assignment. Owned error or "".
    pub fn clear_pad(self: &mut Self, slot: i32, pad: i32) -> str8 {
        if self.output.instrument_clear_pad(slot, pad) != 0 { return format!("Cannot clear pad: {}", __mlang_std_audio_last_error()); }
        let old: list<PadAssignment> = self.pads; var next: list<PadAssignment> = [];
        for entry in old { if entry.slot != slot || entry.pad != pad { next.push(entry); } }
        self.pads = next;
        self.forget_markers(slot, pad);
        return "";
    }
    /// Session sample index loaded into a pad, or -1.
    pub fn pad_sample(self: AudioSystem, slot: i32, pad: i32) -> i32 {
        let pads: list<PadAssignment> = self.pads;
        for entry in pads { if entry.slot == slot && entry.pad == pad { return entry.sample; } }
        return -1;
    }
    /// A removed session sample invalidates the pads playing it: those pads are
    /// emptied, and later sample indexes shift down. Returns pads cleared.
    pub fn drop_sample_pads(self: &mut Self, sample: i32) -> i32 {
        var cleared: i32 = 0;
        let old: list<PadAssignment> = self.pads; var next: list<PadAssignment> = [];
        for entry in old {
            if entry.sample == sample {
                if self.output.instrument_clear_pad(entry.slot, entry.pad) == 0 { cleared = cleared + 1; }
                self.forget_markers(entry.slot, entry.pad);
            } else {
                next.push(PadAssignment { slot: entry.slot, pad: entry.pad,
                    sample: entry.sample > sample ? entry.sample - 1 : entry.sample });
            }
        }
        self.pads = next;
        return cleared;
    }
    fn forget_pads(self: &mut Self, slot: i32) -> void {
        let old: list<PadAssignment> = self.pads; var next: list<PadAssignment> = [];
        for entry in old { if entry.slot != slot { next.push(entry); } }
        self.pads = next;
        self.forget_markers(slot, -1);
    }
    /// Drop hand-set markers of `slot`'s pad `pad` (every pad for -1): a new
    /// sample brings its own.
    fn forget_markers(self: &mut Self, slot: i32, pad: i32) -> void {
        let old: list<PadMarkers> = self.pad_markers; var next: list<PadMarkers> = [];
        for entry in old { if entry.slot != slot || (pad >= 0 && entry.pad != pad) { next.push(entry); } }
        self.pad_markers = next;
    }
    /// A sampler pad's slice markers as the instrument plays them (empty for
    /// an empty pad or an instrument without markers).
    pub fn markers(self: AudioSystem, slot: i32, pad: i32) -> list<i64> {
        let frames: list<f64> = self.output.instrument_markers(wide(slot), wide(pad));
        var out: list<i64> = [];
        for frame in frames { out.push(wide(i32(frame))); }
        return out;
    }
    /// Set a pad's markers by hand (kept with the session), or with `detect`
    /// let the instrument find them again. The markers as the instrument now
    /// has them.
    pub fn set_markers(self: &mut Self, slot: i32, pad: i32, frames: list<i64>, detect: bool) -> list<i64> {
        var sent: list<f64> = [];
        for frame in frames { sent.push(f64(frame)); }
        if self.output.instrument_set_markers(wide(slot), wide(pad), sent, detect) != 0 { return self.markers(slot, pad); }
        self.forget_markers(slot, pad);
        let now: list<i64> = self.markers(slot, pad);
        if !detect { self.pad_markers.push(PadMarkers { slot: slot, pad: pad, frames: now }); }
        return self.markers(slot, pad);
    }
    /// Returns an owned status string. Load outside the audio callback; retain
    /// the old processor if the new bundle cannot initialize.
    pub fn set_processor(self: &mut Self, path: str8) -> str8 {
        if self.output.handle == 0 {
            let created: result<AudioController, str8> = AudioController::new(self.requested_sample_rate == 0 ? 48000 : self.requested_sample_rate, self.requested_buffer_frames);
            if created.is_err() { return clone(__mlang_std_audio_last_error()); }
            self.output = created.unwrap();
            self.reconnect_midi();
        }
        let restart: bool = self.output.hardware_output();
        if self.output.stop() != 0 { return clone(__mlang_std_audio_last_error()); }
        let loaded: i32 = self.output.load_processor(path);
        if loaded != 0 {
            let error: str8 = format!("VST3 load failed: {}", __mlang_std_audio_last_error());
            if restart { self.output.start(); }
            return error;
        }
        if self.processor_path != "" { free(self.processor_path); }
        self.processor_path = path == "" ? "" : clone(path);
        if restart { if self.output.start() != 0 { return clone(__mlang_std_audio_last_error()); } }
        if path == "" { return clone("Master VST3 unloaded; preview synth restored."); }
        return format!("Master VST3: {}{}", self.output.processor_name(), restart ? "" : " (audio output disabled)");
    }
    /// Auditions a WAV/AIFF file on the master output, replacing any preview.
    /// Returns a static error text, or "" once it plays.
    pub fn preview_file(self: AudioSystem, path: str8) -> str8 {
        if self.output.handle == 0 { return "No audio output to preview on (File > Settings)"; }
        let loaded: result<PcmAudio, str8> = PcmAudio::load(path);
        if loaded.is_err() { return "Cannot decode: use mono/stereo PCM16/float32 WAV, or 8-32-bit/float32/float64 AIFF"; }
        let audio: PcmAudio = loaded.unwrap();
        let channels: i64 = audio.channels(); let rate: i64 = audio.sample_rate();
        let samples: list<f32> = audio.samples(); audio.close();
        if self.output.preview(samples, channels, rate) != 0 { return "Cannot preview this file"; }
        return "";
    }
    /// Auditions a loaded sample on the master output, replacing any preview.
    /// Returns a static error text, or "" once it plays.
    pub fn preview_clip(self: AudioSystem, source: &AudioClip) -> str8 {
        var clip: AudioClip = AudioClip {}; clip = source;
        if self.output.handle == 0 { return "No audio output to preview on (File > Settings)"; }
        if self.output.preview(clip.samples, clip.channels, clip.sample_rate) != 0 { return "Cannot preview this sample"; }
        return "";
    }
    pub fn stop_preview(self: AudioSystem) -> void { if self.output.handle != 0 { self.output.stop_preview(); } }
    pub fn previewing(self: AudioSystem) -> bool { return self.output.handle != 0 && self.output.preview_playing(); }
    /// Post the sequencer's events. `source` is the pattern they were
    /// scheduled from: a note-on that speaks its row's TEXT cell sends the
    /// text to the instrument first (see `speak`).
    pub fn sequencer_events(self: &mut Self, events: list<NoteEvent>, source: &SequenceTable) -> void {
        if self.output.handle == 0 { return; }
        for event in events {
            if event.on == 1 && event.text > 0 && event.instrument > 0 { self.speak(event, source); }
            var kind: AudioEventKind = event.on == 1 ? AudioEventKind::NoteOn : AudioEventKind::NoteOff;
            if event.instrument != 0 { kind = event.on == 1 ? AudioEventKind::InstrumentNoteOn : AudioEventKind::InstrumentNoteOff; }
            if event.on == 2 { kind = event.instrument == 0 ? AudioEventKind::ControlChange : AudioEventKind::InstrumentControlChange; }
            // The sequencer has lane 2 to itself, so a note stamped ahead
            // never holds back clips, clicks or live input.
            var frame: i64 = self.scheduling ? self.frame_of(event.tick) : -1;
            if self.scheduling && frame < 0 { frame = 0; }
            self.output.post(AudioEvent { kind: kind, sample: event.instrument > 0 ? event.instrument : 0,
                midi: AudioMidiEvent { channel: event.track % 16, note: event.note, velocity: event.velocity }, source: event.track,
                frame: frame }, 2);
        }
    }
    /// Hand the TEXT cell of `event`'s row to its instrument as the next
    /// phrase of the ring and post the InstrumentText event that attaches it
    /// to the note-on posted right after. Instruments that take no text
    /// (anything but a speech synth) just play the note.
    fn speak(self: &mut Self, event: NoteEvent, table: &SequenceTable) -> void {
        var source: SequenceTable = SequenceTable {}; source = table;
        let column: i32 = source.comment_column(i32(event.track));
        let row: i64 = event.text - 1;
        if column < 0 || row < 0 || row >= source.rows.len() { return; }
        let data: TableRow = source.rows[row];
        if column >= data.cells.len() || data.cells[column] == "" { return; }
        let phrase: i64 = wide(self.next_phrase);
        if self.output.instrument_text(event.instrument, phrase, data.cells[column]) != 0 { return; }
        self.next_phrase = (self.next_phrase + 1) % 256;
        var frame: i64 = self.scheduling ? self.frame_of(event.tick) : -1;
        if self.scheduling && frame < 0 { frame = 0; }
        self.output.post(AudioEvent { kind: AudioEventKind::InstrumentText, sample: event.instrument,
            midi: AudioMidiEvent { channel: event.track % 16, note: phrase, velocity: 0 }, source: event.track,
            frame: frame }, 2);
    }
    pub fn add_insert(self: &mut Self, path: str8, id: i32) -> i32 {
        if id < 1 || id > 256 || id > self.insert_paths.len() + 1 { return -1; }
        if self.output.handle == 0 {
            let created: result<AudioController, str8> = AudioController::new(self.requested_sample_rate == 0 ? 48000 : self.requested_sample_rate, self.requested_buffer_frames);
            if created.is_err() { return -1; } self.output = created.unwrap(); self.reconnect_midi();
        }
        let worker: bool = self.midi.worker.raw != 0; let restart: bool = self.output.hardware_output();
        self.midi.release();
        if self.output.stop() != 0 { self.resume_midi(worker); return -1; }
        let loaded: i32 = self.output.load_insert(id, path);
        if loaded == 0 {
            if id > self.insert_paths.len() { self.insert_paths.push(clone(path)); }
            else {
                let old: list<str8> = self.insert_paths; var paths: list<str8> = [];
                for i in 0..old.len() { if i + 1 == id { free(old[i]); paths.push(clone(path)); } else { paths.push(old[i]); } }
                self.insert_paths = paths;
            }
        }
        if restart { self.output.start(); } self.resume_midi(worker);
        return loaded == 0 ? id : -1;
    }
    pub fn release(self: &mut Self) -> void {
        self.midi.release();
        if self.output.handle != 0 { if self.output.close() == 0 { self.output.handle = 0; } }
        if self.processor_path != "" { free(self.processor_path); }
        self.processor_path = "";
        let paths: list<str8> = self.instrument_paths; for path in paths { if path != "" { free(path); } }
        self.instrument_paths = [];
        let insert_paths: list<str8> = self.insert_paths; for path in insert_paths { free(path); } self.insert_paths = [];
        let effects: list<EffectChannel> = self.effects; for effect in effects { if effect.path != "" { free(effect.path); } } self.effects = [];
        self.pads = []; self.pad_markers = [];
    }
}
