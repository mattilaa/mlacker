mod tui::listview;
mod mlacker_ui::sequence;
mod tui::dialog;
mod mlacker_ui::dialog_buttons;
mod mlacker_ui::audio_library;
use mlacker_ui::audio_library::*;
use mlacker_ui::audio_clip::*;
use tui::listview::*;
use mlacker_ui::sequence::SequenceTable;
use mlacker_ui::sequence::SequenceTrack;
use mlacker_ui::sequence::AudioInstance;
use tui::textfield::TextField;
use tui::dialog::Dialog;
use mlacker_ui::dialog_buttons::TextPrompt;
use tui::geometry::*;
use tui::surface::*;
use tui::theme::*;
use tui::input::*;
use tui::menu::Key;
use tui::table::table_matches;
use std::strbuf::clone;
use std::strbuf::free;

pub struct PatternEntry { var id: i32; var name: str8; var data: SequenceTable; };
/// One parallel column of the song matrix: a pattern ID per song row, 0 = empty.
/// Lane 0 is the plain `song` list, so 1.0 sessions keep working.
pub struct SongLane { var slots: list<i32>; };
/// Owns independent saved patterns plus the current editable pattern.
/// Song order uses stable pattern IDs; repeated occurrences share a pattern.
pub struct PatternLibrary {
    var patterns: list<PatternEntry>; var song: list<i32>; var active_id: i32; var next_id: i32;
    var table: SequenceTable; var view: ListView;
    var renaming: bool; var editor: TextField; var error: str8;
    var audio: AudioLibrary; var audio_mode: bool;
    var instruments: ListView; var instruments_mode: bool;
    /// Columns 2..N of the song matrix; `song` itself is column 1.
    var extra_lanes: list<SongLane>;
    /// Instance the user tried to assign while another track already uses it;
    /// the application asks whether to share it or load a new instance.
    var share_request: i32;
    /// Rows of pattern time in one matrix row. A pattern longer than this
    /// occupies several matrix rows and plays a slice in each, so lanes holding
    /// shorter patterns move on without waiting for it.
    var matrix_steps: i32{64};
    /// Pattern a matrix take is recording into, or 0. Matrix rows leave it
    /// out: the take is heard from the MIDI input, not played back again.
    var recording_pattern: i32;
};
/// Pattern covering a matrix cell: `offset` counts the matrix rows since it
/// started, so 0 is the row it was placed on. id 0 means the cell is silent.
pub struct SongCover { var id: i32; var offset: i32; };
/// A matrix cell stores a pattern ID, the ID plus `SONG_LOOP` when the
/// pattern keeps looping down its lane, or `SONG_END` where a loop (or a long
/// pattern) is split off. IDs stay below 1000000, so the bit never collides.
pub fn song_loop_flag() -> i32 { return 2097152; }
pub fn song_end_marker() -> i32 { return -1; }
/// Pattern ID stored in a raw matrix cell value (0 for empty or a split).
pub fn song_cell_id(raw: i32) -> i32 { return raw <= 0 ? 0 : raw % song_loop_flag(); }
impl PatternLibrary {
    /// True when any track in any pattern feeds a channel other than master;
    /// the session writes its TRACK_OUTPUTS extension only for those.
    pub fn has_output_routes(self: &Self) -> bool {
        for p in 0..self.patterns.len() {
            if self.patterns[p].id == self.active_id {
                for t in 0..self.table.tracks.len() { if self.table.tracks[t].output > 0 { return true; } }
            } else {
                for t in 0..self.patterns[p].data.tracks.len() {
                    if self.patterns[p].data.tracks[t].output > 0 { return true; }
                }
            }
        }
        return false;
    }
    /// True when any instrument track in any pattern takes an audio input;
    /// the session then writes INSTRUMENT_INPUTS.
    /// True when any audio placement in any pattern has Sample properties
    /// (frame end, original BPM, sync mode, pitch, resampling, loop); the
    /// session then writes AUDIO_PROPERTIES.
    pub fn has_audio_properties(self: &Self) -> bool {
        for p in 0..self.patterns.len() {
            if self.patterns[p].id == self.active_id {
                if self.table.has_audio_properties() { return true; }
            } else if self.patterns[p].data.has_audio_properties() { return true; }
        }
        return false;
    }
    pub fn has_input_routes(self: &Self) -> bool {
        for p in 0..self.patterns.len() {
            if self.patterns[p].id == self.active_id {
                for t in 0..self.table.tracks.len() { if self.table.tracks[t].input != 0 { return true; } }
            } else {
                for t in 0..self.patterns[p].data.tracks.len() {
                    if self.patterns[p].data.tracks[t].input != 0 { return true; }
                }
            }
        }
        return false;
    }
    /// True when any instrument track in any pattern routes an aux output bus
    /// away from its main output; the session then writes AUX_OUTPUTS.
    pub fn has_aux_routes(self: &Self) -> bool {
        for p in 0..self.patterns.len() {
            if self.patterns[p].id == self.active_id {
                for t in 0..self.table.tracks.len() { if self.table.tracks[t].aux_outputs.len() > 0 { return true; } }
            } else {
                for t in 0..self.patterns[p].data.tracks.len() {
                    if self.patterns[p].data.tracks[t].aux_outputs.len() > 0 { return true; }
                }
            }
        }
        return false;
    }
    /// Reuse only plugin IDs no longer referenced by any committed/live pattern.
    pub fn free_insert_id(self: &Self, count: i32) -> i32 {
        for id in 1..count + 1 {
            var used: bool = false;
            for p in 0..self.patterns.len() {
                if self.patterns[p].id == self.active_id {
                    for t in 0..self.table.tracks.len() {
                        for n in 0..4 { if self.table.tracks[t].insert_id(i32(n)) == id { used = true; } }
                    }
                } else {
                    for t in 0..self.patterns[p].data.tracks.len() {
                        for n in 0..4 { if self.patterns[p].data.tracks[t].insert_id(i32(n)) == id { used = true; } }
                    }
                }
            }
            if !used { return i32(id); }
        }
        return count + 1;
    }
    pub fn adopt(self: &mut Self, source: &PatternLibrary) -> void {
        var next: PatternLibrary = PatternLibrary {}; next = source;
        self.release();
        self.patterns = next.patterns; self.song = next.song; self.active_id = next.active_id; self.next_id = next.next_id;
        self.extra_lanes = next.extra_lanes; self.matrix_steps = next.matrix_steps;
        self.table = next.table; self.view = next.view;
        self.renaming = false; self.editor = next.editor; self.error = next.error;
        self.audio = next.audio; self.audio_mode = next.audio_mode;
        self.instruments = next.instruments; self.instruments_mode = next.instruments_mode;
    }
    pub fn empty() -> PatternLibrary {
        var library: PatternLibrary = PatternLibrary { active_id: 1, next_id: 2,
            table: SequenceTable::empty(), editor: TextField::new(""), error: "" };
        library.patterns.push(PatternEntry { id: 1, name: clone("Untitled"), data: SequenceTable::empty() });
        library.refresh(); return library;
    }
    pub fn new() -> PatternLibrary {
        var library: PatternLibrary = PatternLibrary { active_id: 1, next_id: 4,
            table: SequenceTable::new(), editor: TextField::new(""), error: "" };
        let names: list<str8> = ["Intro", "Verse", "Chorus"];
        for i in 0..3 {
            var data: SequenceTable = SequenceTable::new();
            let steps: i32 = i32(i) * 4;
            for _j in 0..steps { data.edit_event(InputEvent { kind: InputKind::Text, key: Key::Escape, code: 75 }, Rect::new(0, 0, 80, 24)); }
            library.patterns.push(PatternEntry { id: i32(i) + 1, name: clone(names[i]), data: data });
        }
        let order: list<i32> = [1, 2, 2, 3];
        library.song = order; library.refresh(); return library;
    }
    pub fn index_of(self: &Self, id: i32) -> i32 {
        for i in 0..self.patterns.len() { if self.patterns[i].id == id { return i32(i); } }
        return -1;
    }
    pub fn active_name(self: &Self) -> str8 {
        let index: i32 = self.index_of(self.active_id); if index < 0 { return ""; }
        return clone(self.patterns[index].name);
    }
    fn save_active(self: &mut Self) -> void {
        var entries: list<PatternEntry> = [];
        let previous: list<PatternEntry> = self.patterns;
        for entry in previous {
            var next: PatternEntry = PatternEntry {};
            next = entry;
            if next.id == self.active_id { next.data.release(); next.data = self.table.copy_pattern(); }
            entries.push(next);
        }
        self.patterns = entries;
    }
    pub fn select(self: &mut Self, id: i32) -> void {
        if id == self.active_id || self.index_of(id) < 0 { return; }
        self.save_active();
        var replacement: SequenceTable = self.patterns[self.index_of(id)].data.copy_pattern();
        replacement.clipboard = self.table.clipboard; replacement.clipboard_kinds = self.table.clipboard_kinds;
        replacement.clipboard_rows = self.table.clipboard_rows; replacement.clipboard_spacing = self.table.clipboard_spacing;
        self.table.clipboard = []; self.table.clipboard_kinds = [];
        self.table.release(); self.table = replacement; self.active_id = id;
        self.error = "";
    }
    /// Browsing the matrix shows the cell's pattern everywhere else: the
    /// sidebar highlight, the pattern editor behind the matrix and the mixer
    /// channels with their sends, inserts and output routing. Empty cells keep
    /// the current pattern. True when the selection moved.
    pub fn follow_matrix_cell(self: &mut Self, row: i32, lane: i32) -> bool {
        return self.follow_pattern(self.song_at(row, lane));
    }
    /// Show a pattern everywhere: editor, sidebar highlight and mixer channels.
    /// False when it is already shown or does not exist.
    pub fn follow_pattern(self: &mut Self, id: i32) -> bool {
        if id <= 0 || id == self.active_id || self.index_of(id) < 0 { return false; }
        self.select(id);
        for i in 0..self.view.items.len() {
            let item: ListItem = self.view.items[i];
            if item.id == id { self.view.selected = i32(i); }
        }
        return true;
    }
    /// Local playing row of the displayed pattern, or -1 when it is not
    /// in this song row. Long patterns continue across matrix rows; short
    /// patterns and loop repeats wrap exactly like `copy_slice` does.
    pub fn playing_pattern_row(self: &Self, song_row: i32, row: i32) -> i32 {
        let count: i32 = i32(self.table.rows.len());
        if row < 0 || count <= 0 || self.active_id == self.recording_pattern { return -1; }
        let unit: i32 = self.matrix_steps < 1 ? 1 : self.matrix_steps;
        for lane in 0..self.song_lanes() {
            let cover: SongCover = self.song_cover(song_row, i32(lane));
            if cover.id == self.active_id {
                return i32((wide(cover.offset) * wide(unit) + wide(row)) % wide(count));
            }
        }
        return -1;
    }
    /// Pattern a song row starts from: its lowest lane holding one, or 0.
    pub fn song_row_pattern(self: &Self, row: i32) -> i32 {
        for lane in 0..self.song_lanes() {
            let cover: SongCover = self.song_cover(row, i32(lane));
            if cover.id > 0 && self.index_of(cover.id) >= 0 { return cover.id; }
        }
        return 0;
    }
    /// Matrix row length for a song that never set one: the length most of its
    /// patterns have, and the shortest of those when it is a tie. A song of
    /// 64-row patterns keeps 64; one built from 16-row patterns tiles them one
    /// per matrix row instead of repeating each to fill four of them.
    pub fn derive_matrix_steps(self: &Self) -> i32 {
        let entries: list<PatternEntry> = self.patterns;
        var best: i32 = 0; var best_count: i32 = 0;
        for entry in entries {
            let rows: i32 = i32(entry.data.rows.len());
            if rows < 1 { continue; }
            var count: i32 = 0;
            for other in entries { if i32(other.data.rows.len()) == rows { count = count + 1; } }
            if count > best_count || (count == best_count && rows < best) { best = rows; best_count = count; }
        }
        return best > 0 ? best : 64;
    }
    /// Matrix rows a pattern occupies: one per `matrix_steps` rows of its own,
    /// at least one.
    pub fn song_span(self: &Self, id: i32) -> i32 {
        let index: i32 = self.index_of(id);
        if id <= 0 || index < 0 { return 1; }
        let unit: i32 = self.matrix_steps < 1 ? 1 : self.matrix_steps;
        var rows: i32 = 0;
        rows = id == self.active_id ? i32(self.table.rows.len()) : i32(self.patterns[index].data.rows.len());
        let span: i32 = (rows + unit - 1) / unit;
        return span < 1 ? 1 : span;
    }
    /// What plays in a matrix cell: the pattern placed there, the one still
    /// running from a row above it, or a looping one repeating down the lane.
    pub fn song_cover(self: &Self, row: i32, lane: i32) -> SongCover {
        if row < 0 || row >= self.song.len() { return SongCover {}; }
        for back in 0..row + 1 {
            let at: i32 = row - i32(back);
            let raw: i32 = self.song_raw(at, lane);
            // A split ends whatever runs from above.
            if raw == song_end_marker() { return SongCover {}; }
            let id: i32 = song_cell_id(raw);
            if id <= 0 { continue; }
            // The nearest pattern above either reaches this row or leaves it
            // silent; a pattern never plays through one placed under it. A
            // looping one repeats until the next pattern or split in its lane.
            let reaches: bool = self.song_span(id) > i32(back) || raw >= song_loop_flag();
            return reaches ? SongCover { id: id, offset: i32(back) } : SongCover {};
        }
        return SongCover {};
    }
    /// True when a cell belongs to a pattern that started above it and is
    /// still inside that pattern's own rows (not a loop repeat).
    pub fn song_continues(self: &Self, row: i32, lane: i32) -> bool {
        let cover: SongCover = self.song_cover(row, lane);
        return cover.id > 0 && cover.offset > 0 && cover.offset < self.song_span(cover.id);
    }
    /// True when a cell plays a repeat of a looping pattern placed above it.
    pub fn song_loop_repeat(self: &Self, row: i32, lane: i32) -> bool {
        let cover: SongCover = self.song_cover(row, lane);
        return cover.id > 0 && cover.offset >= self.song_span(cover.id);
    }
    /// True when any matrix cell loops or splits; sessions then store them.
    pub fn has_song_loops(self: &Self) -> bool {
        for l in 0..self.song_lanes() {
            for r in 0..self.song.len() {
                let raw: i32 = self.song_raw(i32(r), i32(l));
                if raw < 0 || raw >= song_loop_flag() { return true; }
            }
        }
        return false;
    }
    /// True when the pattern placed at this cell loops down its lane.
    pub fn song_loops(self: &Self, row: i32, lane: i32) -> bool { return self.song_raw(row, lane) >= song_loop_flag(); }
    /// True when this cell splits off a loop or a long pattern.
    pub fn song_split(self: &Self, row: i32, lane: i32) -> bool { return self.song_raw(row, lane) == song_end_marker(); }
    /// Switch looping for the pattern covering a cell (placed there or above).
    /// Returns the pattern's row, or -1 when the cell plays nothing.
    pub fn toggle_song_loop(self: &mut Self, row: i32, lane: i32) -> i32 {
        let cover: SongCover = self.song_cover(row, lane);
        if cover.id <= 0 { return -1; }
        let origin: i32 = row - cover.offset;
        let raw: i32 = self.song_raw(origin, lane);
        self.set_song_raw(origin, lane, raw >= song_loop_flag() ? cover.id : cover.id + song_loop_flag());
        return origin;
    }
    /// Split a loop or a long pattern at `row`: from there down the lane is
    /// silent. A split cell is removed again with `set_song_at(row, lane, 0)`.
    pub fn split_song(self: &mut Self, row: i32, lane: i32) -> bool {
        let cover: SongCover = self.song_cover(row, lane);
        if cover.id <= 0 || cover.offset == 0 { return false; }
        self.set_song_raw(row, lane, song_end_marker()); return true;
    }
    /// Rows a placement needs, and whether they are free. `id` 0 (clearing) and
    /// a pattern that fits in one row always are.
    pub fn song_placement_blocked(self: &Self, row: i32, lane: i32, id: i32) -> i32 {
        if id <= 0 { return 0; }
        if self.song_continues(row, lane) { return -1; }
        let span: i32 = self.song_span(id);
        for ahead in 1..span {
            let at: i32 = row + i32(ahead);
            if at >= self.song.len() { break; }
            if self.song_at(at, lane) > 0 { return self.song_at(at, lane); }
        }
        return 0;
    }
    /// Columns in the song matrix, counting the base `song` column.
    /// Pattern highlighted in the sidebar list (song mode uses its row), or 0.
    pub fn selected_pattern(self: &Self) -> i32 {
        if self.view.selected < 0 || self.view.selected >= self.view.items.len() { return 0; }
        let item: ListItem = self.view.items[self.view.selected];
        return item.id;
    }
    pub fn song_lanes(self: &Self) -> i32 { return i32(self.extra_lanes.len()) + 1; }
    /// Pattern ID at a matrix cell, or 0 when empty, split or out of range.
    pub fn song_at(self: &Self, row: i32, lane: i32) -> i32 { return song_cell_id(self.song_raw(row, lane)); }
    /// Stored cell value: ID, ID plus the loop flag, split marker or 0.
    pub fn song_raw(self: &Self, row: i32, lane: i32) -> i32 {
        if row < 0 || row >= self.song.len() || lane < 0 { return 0; }
        if lane == 0 { return self.song[row]; }
        if lane - 1 >= self.extra_lanes.len() { return 0; }
        return row < self.extra_lanes[lane - 1].slots.len() ? self.extra_lanes[lane - 1].slots[row] : 0;
    }
    /// Put a pattern (or 0 to clear) into a matrix cell, adding lanes as needed.
    /// A new pattern starts without looping. Placing one over a loop repeat
    /// ends that loop there.
    pub fn set_song_at(self: &mut Self, row: i32, lane: i32, id: i32) -> bool {
        if row < 0 || row >= self.song.len() || lane < 0 || lane >= 16 { return false; }
        // A pattern owns every matrix row it spans, so it cannot start inside
        // another one or grow over a pattern already placed below it.
        if self.song_placement_blocked(row, lane, id) != 0 { return false; }
        self.set_song_raw(row, lane, id); return true;
    }
    /// Store a raw cell value without placement checks.
    pub fn set_song_raw(self: &mut Self, row: i32, lane: i32, id: i32) -> bool {
        if row < 0 || row >= self.song.len() || lane < 0 || lane >= 16 { return false; }
        if lane == 0 {
            var order: list<i32> = [];
            for i in 0..self.song.len() { order.push(i32(i) == row ? id : self.song[i]); }
            self.song = order; self.refresh(); return true;
        }
        while self.extra_lanes.len() < lane { self.extra_lanes.push(SongLane {}); }
        var lanes: list<SongLane> = [];
        for l in 0..self.extra_lanes.len() {
            let column: SongLane = self.extra_lanes[l];
            var slots: list<i32> = [];
            for r in 0..self.song.len() {
                let previous: i32 = r < column.slots.len() ? column.slots[r] : 0;
                slots.push(i32(l) == lane - 1 && i32(r) == row ? id : previous);
            }
            lanes.push(SongLane { slots: slots });
        }
        self.extra_lanes = lanes;
        // Drop trailing lanes that no longer hold anything.
        var kept: list<SongLane> = []; var last: i32 = -1;
        for l in 0..self.extra_lanes.len() {
            for r in 0..self.extra_lanes[l].slots.len() {
                if self.extra_lanes[l].slots[r] != 0 { last = i32(l); break; }
            }
        }
        for l in 0..self.extra_lanes.len() {
            if i32(l) <= last { kept.push(SongLane { slots: std::copy(self.extra_lanes[l].slots) }); }
        }
        self.extra_lanes = kept;
        return true;
    }
    /// Insert an empty matrix row above or below `row`.
    pub fn matrix_insert_row(self: &mut Self, row: i32, after: bool) -> bool {
        if self.song.len() >= 65536 { return false; }
        let at: i32 = self.song.len() == 0 ? 0 : (after ? row + 1 : row);
        if at < 0 || at > self.song.len() { return false; }
        var order: list<i32> = [];
        for i in 0..self.song.len() {
            if i32(i) == at { order.push(0); }
            order.push(self.song[i]);
        }
        if at >= self.song.len() { order.push(0); }
        self.song = order; self.sync_lanes(at, true);
        self.refresh(); return true;
    }
    /// Remove a whole matrix row, lanes included.
    pub fn matrix_remove_row(self: &mut Self, row: i32) -> bool {
        if row < 0 || row >= self.song.len() { return false; }
        var order: list<i32> = [];
        for i in 0..self.song.len() { if i32(i) != row { order.push(self.song[i]); } }
        self.song = order; self.sync_lanes(row, false);
        self.refresh(); return true;
    }
    /// Push one lane down from `row`, leaving that cell empty. The other lanes
    /// keep their rows, so only this column shifts.
    pub fn matrix_insert_cell(self: &mut Self, row: i32, lane: i32, after: bool) -> bool {
        if row < 0 || row >= self.song.len() || lane < 0 || lane >= 16 { return false; }
        let at: i32 = after ? row + 1 : row;
        if at > self.song.len() { return false; }
        // The last cell of the lane falls off unless a row is added for it.
        if self.song_raw(i32(self.song.len()) - 1, lane) != 0 && !self.matrix_insert_row(i32(self.song.len()) - 1, true) { return false; }
        var moved: i32 = 0;
        // Move stored values, so loop flags and splits travel with their cells.
        for i in 0..self.song.len() {
            let source: i32 = i32(self.song.len()) - 1 - i32(i);
            if source < at { break; }
            if source == at { self.set_song_raw(source, lane, 0); }
            else { self.set_song_raw(source, lane, self.song_raw(source - 1, lane)); }
            moved = moved + 1;
        }
        return moved > 0;
    }
    /// Keep every lane the same length as the song after a row insert/remove.
    fn sync_lanes(self: &mut Self, row: i32, inserted: bool) -> void {
        var lanes: list<SongLane> = [];
        for l in 0..self.extra_lanes.len() {
            let column: SongLane = self.extra_lanes[l];
            var slots: list<i32> = [];
            for r in 0..column.slots.len() {
                if i32(r) == row && inserted { slots.push(0); }
                if !(i32(r) == row && !inserted) { slots.push(column.slots[r]); }
            }
            if inserted && row >= column.slots.len() { slots.push(0); }
            lanes.push(SongLane { slots: slots });
        }
        self.extra_lanes = lanes;
    }
    /// Notes that two patterns would send to the same instrument at the same
    /// row: same instance, same row, same note. Returns how many collide.
    pub fn clashing_notes(self: &Self, first: i32, second: i32) -> i32 {
        let a: i32 = self.index_of(first); let b: i32 = self.index_of(second);
        if a < 0 || b < 0 || first == second { return 0; }
        var count: i32 = 0;
        let rows: i64 = self.patterns[a].data.rows.len() < self.patterns[b].data.rows.len()
            ? self.patterns[a].data.rows.len() : self.patterns[b].data.rows.len();
        for t in 0..self.patterns[a].data.tracks.len() {
            if self.patterns[a].data.tracks[t].audio || !self.patterns[a].data.tracks[t].instrument ||
               self.patterns[a].data.tracks[t].instrument_id <= 0 { continue; }
            for u in 0..self.patterns[b].data.tracks.len() {
                if self.patterns[b].data.tracks[u].audio || !self.patterns[b].data.tracks[u].instrument ||
                   self.patterns[b].data.tracks[u].instrument_id != self.patterns[a].data.tracks[t].instrument_id { continue; }
                for r in 0..rows {
                    for line in 0..self.patterns[a].data.tracks[t].note_lines {
                        let column: i32 = self.patterns[a].data.track_start(i32(t)) + i32(line) * 4;
                        let note: str8 = self.patterns[a].data.rows[r].cells[column];
                        if note == "" { continue; }
                        for other_line in 0..self.patterns[b].data.tracks[u].note_lines {
                            let other_column: i32 = self.patterns[b].data.track_start(i32(u)) + i32(other_line) * 4;
                            if self.patterns[b].data.rows[r].cells[other_column] == note { count = count + 1; }
                        }
                    }
                }
            }
        }
        return count;
    }
    /// Notes of `id` that clash with the patterns already in `row`, ignoring `lane`.
    pub fn song_row_clashes(self: &Self, row: i32, lane: i32, id: i32) -> i32 {
        var count: i32 = 0;
        for l in 0..self.song_lanes() {
            if i32(l) == lane { continue; }
            let other: i32 = self.song_at(row, i32(l));
            if other > 0 { count = count + self.clashing_notes(id, other); }
        }
        return count;
    }
    /// How many patterns in `row` already play instrument tracks, ignoring `lane`.
    fn row_occupants(self: &Self, row: i32, lane: i32) -> i32 {
        var count: i32 = 0;
        for l in 0..self.song_lanes() {
            if i32(l) != lane && self.song_at(row, i32(l)) > 0 { count = count + 1; }
        }
        return count;
    }
    /// Give the clashing instrument tracks of `id` their own note line, so the
    /// parallel patterns stop sharing one. Tracks are renamed "<name> - <n>",
    /// where n counts the patterns sharing that instrument in the row.
    /// Returns the number of tracks split.
    pub fn split_song_clashes(self: &mut Self, row: i32, lane: i32, id: i32, area: Rect) -> i32 {
        let index: i32 = self.index_of(id);
        if index < 0 { return 0; }
        let line: i32 = self.row_occupants(row, lane) + 1;
        if line < 2 { return 0; }
        var split: i32 = 0;
        for i in 0..self.patterns.len() {
            if self.patterns[i].id == id {
                for t in 0..self.patterns[i].data.tracks.len() {
                    if self.patterns[i].data.tracks[t].audio || !self.patterns[i].data.tracks[t].instrument ||
                        self.patterns[i].data.tracks[t].instrument_id <= 0 { continue; }
                    var clashes: bool = false;
                    for l in 0..self.song_lanes() {
                        if i32(l) == lane { continue; }
                        let other: i32 = self.song_at(row, i32(l));
                        if other > 0 && self.clashing_notes(id, other) > 0 { clashes = true; }
                    }
                    if !clashes { continue; }
                    if self.patterns[i].data.move_notes_to_line(i32(t), line - 1, area) { split = split + 1; }
                }
            }
        }
        if self.active_id == id {
            let active_index: i32 = self.index_of(id);
            self.table.release(); self.table = self.patterns[active_index].data.copy_pattern();
        }
        self.refresh();
        return split;
    }
    pub fn refresh(self: &mut Self) -> void {
        for i in 0..self.view.items.len() { free(self.view.items[i].label); }
        var items: list<ListItem> = [];
        for i in 0..self.patterns.len() {
            let id: i32 = self.patterns[i].id;
            items.push(ListItem { id: id, label: format!("{}{} {}", id < 10 ? "00" : (id < 100 ? "0" : ""), id, self.patterns[i].name) });
        }
        self.view.items = items; self.view.cancel_pending();
    }
    /// Show the pattern list in the sidebar (the song lives in the matrix).
    pub fn show_patterns(self: &mut Self) -> void {
        self.instruments_mode = false; self.instruments.cancel_pending();
        self.audio_mode = false; self.audio.view.cancel_pending();
        self.view.selected = 0; self.view.scroll = 0; self.refresh();
        for i in 0..self.view.items.len() {
            let item: ListItem = self.view.items[i];
            if item.id == self.active_id { self.view.selected = i32(i); return; }
        }
        self.choose_selected();
    }
    pub fn choose_selected(self: &mut Self) -> void {
        if self.view.selected < 0 || self.view.selected >= self.view.items.len() { return; }
        let item: ListItem = self.view.items[self.view.selected]; self.select(item.id);
    }
    /// Copy a validated pattern into this session without changing song order.
    pub fn import_pattern(self: &mut Self, name: str8, table: &SequenceTable, clips: &list<AudioClip>) -> bool {
        if self.patterns.len() >= 128 { self.error = "Maximum 128 patterns"; return false; }
        var missing: i32 = 0;
        for clip in clips { if self.audio.find_clip(clip) < 0 { missing = missing + 1; } }
        if self.audio.samples.len() + missing > 256 { self.error = "Pattern would exceed 256 loaded samples"; return false; }
        for clip in clips { self.audio.add_clip(clip.copy()); }
        let id: i32 = self.next_id; self.next_id = self.next_id + 1;
        var source: SequenceTable = SequenceTable {}; source = table;
        var imported: SequenceTable = source.copy_pattern();
        self.patterns.push(PatternEntry { id: id, name: clone(name), data: imported });
        self.select(id); self.show_patterns(); self.error = ""; return true;
    }
    pub fn add(self: &mut Self, duplicate: bool) -> void {
        if self.patterns.len() >= 128 { self.error = "Maximum 128 patterns"; return; }
        var data: SequenceTable = self.table.copy_pattern();
        if !duplicate {
            data.release(); data = SequenceTable::new();
            for i in 0..data.tracks.len() { data.selected_column = data.track_start(i32(i)); data.clear_track(); }
            data.selected_column = 1;
        }
        let id: i32 = self.next_id; self.next_id = self.next_id + 1;
        let name: str8 = duplicate ? format!("{} copy", self.active_name()) : format!("Pattern {}", id);
        self.patterns.push(PatternEntry { id: id, name: name, data: data });
        self.song.push(id); self.select(id); self.refresh();
        self.view.selected = i32(self.patterns.len()) - 1;
    }
    pub fn rename(self: &mut Self, name: str8) -> bool {
        if !table_matches("[A-Za-z0-9][A-Za-z0-9 _-]{0,47}", name) { self.error = "Name: 1-48 letters, digits, spaces, _ or -"; return false; }
        var entries: list<PatternEntry> = []; let previous: list<PatternEntry> = self.patterns;
        for entry in previous {
            var next: PatternEntry = PatternEntry {};
            next = entry;
            if next.id == self.active_id { let copy: str8 = clone(name); free(next.name); next.name = copy; }
            entries.push(next);
        }
        self.patterns = entries; self.refresh(); self.error = ""; return true;
    }
    pub fn remove_active(self: &mut Self, area: Rect) -> void {
        if self.patterns.len() <= 1 { self.error = "Keep at least one pattern"; return; }
        let removed: i32 = self.active_id;
        let index: i32 = self.index_of(removed);
        var entries: list<PatternEntry> = []; let previous: list<PatternEntry> = self.patterns;
        for entry in previous {
            var next: PatternEntry = PatternEntry {};
            next = entry;
            if next.id == removed { free(next.name); next.data.release(); }
            else { entries.push(next); }
        }
        var song: list<i32> = []; let order: list<i32> = self.song;
        var dropped: list<i32> = [];
        for i in 0..order.len() { if song_cell_id(order[i]) == removed { dropped.push(i32(i)); } else { song.push(order[i]); } }
        self.patterns = entries; self.song = song;
        // Same rows leave every lane, and the pattern clears from the others.
        var lanes: list<SongLane> = [];
        for l in 0..self.extra_lanes.len() {
            let column: SongLane = self.extra_lanes[l]; var slots: list<i32> = [];
            for r in 0..column.slots.len() {
                var gone: bool = false;
                for dropped_row in dropped { if dropped_row == i32(r) { gone = true; } }
                if !gone { slots.push(song_cell_id(column.slots[r]) == removed ? 0 : column.slots[r]); }
            }
            lanes.push(SongLane { slots: slots });
        }
        self.extra_lanes = lanes;
        let next_index: i32 = index >= self.patterns.len() ? i32(self.patterns.len()) - 1 : index;
        let next_id: i32 = self.patterns[next_index].id;
        var replacement: SequenceTable = self.patterns[next_index].data.copy_pattern();
        replacement.clipboard = self.table.clipboard; replacement.clipboard_kinds = self.table.clipboard_kinds;
        replacement.clipboard_rows = self.table.clipboard_rows; replacement.clipboard_spacing = self.table.clipboard_spacing;
        self.table.clipboard = []; self.table.clipboard_kinds = [];
        self.table.release(); self.table = replacement; self.active_id = next_id;
        self.view.selected = next_index;
        self.refresh(); self.view.reconcile(area); self.choose_selected(); self.error = "";
    }
    pub fn remove_song_occurrence(self: &mut Self, area: Rect) -> void {
        if self.view.selected < 0 || self.view.selected >= self.song.len() { return; }
        var order: list<i32> = [];
        for i in 0..self.song.len() { if i != self.view.selected { order.push(self.song[i]); } }
        self.song = order; self.sync_lanes(self.view.selected, false);
        self.refresh(); self.view.reconcile(area); self.choose_selected();
    }
    fn move_song_row(self: &mut Self, direction: i32, area: Rect) -> void {
        self.view.cancel_pending();
        let selected: i32 = self.view.selected; let target: i32 = selected + direction;
        if selected < 0 || selected >= self.song.len() || target < 0 || target >= self.song.len() { return; }
        var order: list<i32> = [];
        for i in 0..self.song.len() {
            if i == selected { order.push(self.song[target]); }
            else if i == target { order.push(self.song[selected]); }
            else { order.push(self.song[i]); }
        }
        self.song = order; self.view.selected = target;
        self.refresh(); self.view.reconcile(area); self.choose_selected();
    }
    fn insert_song_row(self: &mut Self, after: bool, area: Rect) -> void {
        self.view.cancel_pending();
        let selected: i32 = self.view.selected;
        if selected < 0 || selected >= self.song.len() { return; }
        var order: list<i32> = [];
        for i in 0..self.song.len() {
            if i == selected && !after { order.push(self.song[selected]); }
            order.push(self.song[i]);
            if i == selected && after { order.push(self.song[selected]); }
        }
        self.song = order; self.sync_lanes(after ? selected + 1 : selected, true);
        self.view.selected = after ? selected + 1 : selected;
        self.refresh(); self.view.reconcile(area); self.choose_selected();
    }
    fn change_song_pattern(self: &mut Self, direction: i32, area: Rect) -> void {
        self.view.cancel_pending();
        let selected: i32 = self.view.selected;
        if selected < 0 || selected >= self.song.len() { return; }
        let target: i32 = self.index_of(song_cell_id(self.song[selected])) + direction;
        if target < 0 || target >= self.patterns.len() { return; }
        var order: list<i32> = [];
        for i in 0..self.song.len() { order.push(i == selected ? self.patterns[target].id : self.song[i]); }
        self.song = order; self.refresh(); self.view.reconcile(area); self.choose_selected();
    }
    pub fn on_event(self: &mut Self, event: InputEvent, area: Rect) -> bool {
        if self.instruments_mode {
            let action: i32 = self.instruments.on_event(event, area);
            if action == 2 {
                let id: i32 = self.selected_instrument();
                let index: i32 = self.table.active_track();
                if index >= 0 && id > 0 && self.table.instrument_used_by_other(id, index) { self.share_request = id; }
                else { self.table.assign_instrument(id); }
            }
            return action != 0;
        }
        if self.audio_mode {
            let action: i32 = self.audio.view.on_event(event, area);
            if action == 2 && !self.audio.toggle_group() { self.insert_selected_audio(area); }
            return action != 0;
        }
        let action: i32 = self.view.on_event(event, area);
        if action == 3 { self.choose_selected(); self.remove_active(area); }
        else if action != 0 { self.choose_selected(); }
        return action != 0;
    }
    pub fn rename_event(self: &mut Self, event: InputEvent) -> void {
        if event.kind == InputKind::Menu && event.key == Key::Escape && event.code < 32 { self.renaming = false; self.error = ""; return; }
        if event.kind == InputKind::Menu && event.key == Key::Enter {
            if self.rename(self.editor.text) { self.renaming = false; }
        } else { self.editor.on_event(event); }
    }
    pub fn show_audio(self: &mut Self) -> void {
        self.instruments_mode = false; self.instruments.cancel_pending();
        self.audio_mode = true; self.view.cancel_pending(); self.audio.view.cancel_pending();
    }
    pub fn selected_instrument(self: &Self) -> i32 {
        if self.instruments.selected < 0 || self.instruments.selected >= self.instruments.items.len() { return 0; }
        let item: ListItem = self.instruments.items[self.instruments.selected]; return item.id;
    }
    pub fn remove_instrument(self: &mut Self, id: i32, area: Rect) -> void {
        self.table.detach_instrument(id);
        let old: list<PatternEntry> = self.patterns; var next: list<PatternEntry> = [];
        for item in old { var entry: PatternEntry = PatternEntry {}; entry = item; entry.data.detach_instrument(id); next.push(entry); }
        self.patterns = next;
        let items: list<ListItem> = self.instruments.items; var kept: list<ListItem> = [];
        for item in items { if item.id == id { free(item.label); } else { kept.push(item); } }
        self.instruments.items = kept; self.instruments.marks = []; self.instruments.cancel_pending(); self.instruments.reconcile(area);
    }
    pub fn show_instruments(self: &mut Self) -> void {
        self.instruments_mode = true; self.audio_mode = false;
        self.view.cancel_pending(); self.audio.view.cancel_pending(); self.instruments.cancel_pending();
    }
    pub fn add_instrument(self: &mut Self, id: i32, name: str8) -> void {
        self.instruments.items.push(ListItem { id: id, label: format!("{}{} {}", id < 10 ? "00" : "0", id, name) });
        self.instruments.selected = i32(self.instruments.items.len()) - 1;
        self.show_instruments();
        let index: i32 = self.table.active_track();
        if index >= 0 {
            if self.table.tracks[index].instrument { self.table.assign_instrument(id); }
        }
    }
    pub fn name_instrument(self: &mut Self, id: i32, name: str8) -> void {
        let items: list<ListItem> = self.instruments.items; var next: list<ListItem> = [];
        for item in items {
            if item.id == id {
                free(item.label);
                next.push(ListItem { id: id, label: format!("{}{} {}", id < 10 ? "00" : "0", id, name) });
            } else { next.push(item); }
        }
        self.instruments.items = next;
    }
    /// One playable table for a song-matrix row: the lowest lane's pattern with
    /// every other lane's tracks appended, each looping to the longest pattern.
    /// Empty rows give an empty table.
    /// Merge a song row's lanes into one table. `shared_once` keeps a channel
    /// both patterns carry only once, for the mixer's view of the row; playback
    /// passes false so every lane's notes are there.
    pub fn merge_song_row(self: &Self, row: i32, area: Rect, shared_once: bool) -> SequenceTable {
        var merged: SequenceTable = SequenceTable {};
        let unit: i32 = self.matrix_steps < 1 ? 1 : self.matrix_steps;
        var base: i32 = -1;
        // A lane plays the slice of its pattern that belongs to this matrix
        // row, so a pattern twice as long simply takes two rows while the lane
        // beside it moves on to its next pattern.
        var recording: bool = false;
        for l in 0..self.song_lanes() {
            let cover: SongCover = self.song_cover(row, i32(l));
            if cover.id > 0 && cover.id == self.recording_pattern { recording = true; continue; }
            if cover.id > 0 && base < 0 { base = i32(l); }
        }
        if base < 0 {
            // A take on a row nothing else plays still needs the row's time.
            if recording { merged = SequenceTable::empty(); merged.set_length(unit, area); }
            return merged;
        }
        let lead: SongCover = self.song_cover(row, base);
        // The pattern being edited lives in `table`; its stored copy is only
        // written back when the selection moves, so read the live one.
        merged = lead.id == self.active_id
            ? self.table.copy_slice(lead.offset * unit, unit)
            : self.patterns[self.index_of(lead.id)].data.copy_slice(lead.offset * unit, unit);
        if i32(merged.rows.len()) < unit { merged.set_length(unit, area); }
        for l in base + 1..self.song_lanes() {
            let cover: SongCover = self.song_cover(row, i32(l));
            let index: i32 = self.index_of(cover.id);
            if cover.id <= 0 || index < 0 || cover.id == self.recording_pattern { continue; }
            if cover.id == self.active_id {
                merged.append_tracks_from(&self.table, area, shared_once, cover.offset * unit);
            } else {
                merged.append_tracks_from(&self.patterns[index].data, area, shared_once, cover.offset * unit);
            }
        }
        return merged;
    }
    /// What `merge_song_row` reads for a row, folded into one number: the
    /// pattern and slice each lane plays, and the matrix row length. It
    /// changes when a cell of the row is placed, cleared, looped or split.
    pub fn song_row_signature(self: &Self, row: i32) -> i64 {
        var hash: i64 = wide(self.matrix_steps);
        for l in 0..self.song_lanes() {
            let cover: SongCover = self.song_cover(row, i32(l));
            hash = (hash * 1000003 + wide(cover.id)) % 1099511627776;
            hash = (hash * 1000003 + wide(cover.offset)) % 1099511627776;
        }
        return hash;
    }
    /// Next matrix row holding at least one pattern, wrapping. -1 when empty.
    pub fn next_song_row(self: &Self, row: i32) -> i32 {
        for step in 1..self.song.len() + 1 {
            let candidate: i32 = i32((wide(row) + wide(i32(step))) % self.song.len());
            for l in 0..self.song_lanes() {
                let cover: SongCover = self.song_cover(candidate, i32(l));
                if cover.id > 0 { return candidate; }
            }
        }
        for l in 0..self.song_lanes() {
            let cover: SongCover = self.song_cover(row, i32(l));
            if cover.id > 0 { return row; }
        }
        return -1;
    }
    /// Placements of Audio-list sample `index` across every pattern.
    pub fn sample_usage(self: &Self, index: i32) -> i32 {
        if index < 0 || index >= self.audio.samples.len() { return 0; }
        let sample: AudioClip = self.audio.samples[index];
        var count: i32 = self.table.clip_usage(sample);
        let entries: list<PatternEntry> = self.patterns;
        for entry in entries { if entry.id != self.active_id { count = count + entry.data.clip_usage(sample); } }
        return count;
    }
    /// Remove Audio-list sample `index`, dropping every placement of it.
    /// Returns the number of placements removed, or -1 for an invalid index.
    pub fn remove_sample(self: &mut Self, index: i32, area: Rect) -> i32 {
        if index < 0 || index >= self.audio.samples.len() { return -1; }
        let sample: AudioClip = self.audio.samples[index].copy();
        var removed: i32 = self.table.remove_clips_of(sample);
        for i in 0..self.patterns.len() {
            let count: i32 = self.patterns[i].data.remove_clips_of(sample);
            if self.patterns[i].id != self.active_id { removed = removed + count; }
        }
        self.audio.forget_sample(index);
        var reversed: list<AudioClip> = [];
        while self.audio.samples.len() > 0 {
            let position: i64 = self.audio.samples.len() - 1;
            let clip: AudioClip = self.audio.samples.pop();
            if position == index { clip.release(); }
            else { reversed.push(clip); }
        }
        while reversed.len() > 0 { self.audio.samples.push(reversed.pop()); }
        self.audio.view.marks = [];
        sample.release();
        self.audio.rebuild();
        if self.audio.view.selected >= self.audio.view.items.len() { self.audio.view.selected = i32(self.audio.view.items.len()) - 1; }
        self.audio.view.cancel_pending(); self.audio.view.reconcile(area);
        self.table.reconcile(area);
        return removed;
    }
    /// Remove Audio-list group `path`, the groups inside it and every sample
    /// in them (with their placements). Returns the number of samples removed.
    pub fn remove_group(self: &mut Self, path: str8, area: Rect) -> i32 {
        let owned: str8 = clone(path);
        let doomed: list<i32> = self.audio.samples_in_group(owned);
        // From the last, so the earlier indexes stay valid.
        var n: i64 = doomed.len();
        while n > 0 { n = n - 1; self.remove_sample(doomed[n], area); }
        self.audio.drop_group(owned); free(owned);
        self.audio.rebuild();
        if self.audio.view.selected >= self.audio.view.items.len() { self.audio.view.selected = i32(self.audio.view.items.len()) - 1; }
        self.audio.view.reconcile(area);
        return i32(doomed.len());
    }
    /// Tracks assigned to instrument instance `id` across every pattern.
    pub fn instrument_usage(self: &Self, id: i32) -> i32 {
        var count: i32 = self.table.instrument_usage(id);
        let entries: list<PatternEntry> = self.patterns;
        for entry in entries { if entry.id != self.active_id { count = count + entry.data.instrument_usage(id); } }
        return count;
    }
    /// Delete every track using instrument instance `id`, in every pattern.
    pub fn remove_tracks_using_instrument(self: &mut Self, id: i32, area: Rect) -> i32 {
        var removed: i32 = self.table.remove_tracks_using_instrument(id, area);
        let entries: list<PatternEntry> = self.patterns; var next: list<PatternEntry> = [];
        for item in entries {
            var entry: PatternEntry = PatternEntry {}; entry = item;
            let count: i32 = entry.data.remove_tracks_using_instrument(id, area);
            if entry.id != self.active_id { removed = removed + count; }
            next.push(entry);
        }
        self.patterns = next;
        return removed;
    }
    /// Destructively replace Audio-list sample `index` with `edited` (ownership
    /// moves in) and update every placement in every pattern. Returns the
    /// number of placements updated, or -1 for an invalid index.
    pub fn replace_sample(self: &mut Self, index: i32, edited: AudioClip) -> i32 {
        if index < 0 || index >= self.audio.samples.len() { edited.release(); return -1; }
        let old: AudioClip = self.audio.samples[index].copy();
        var count: i32 = self.table.replace_clip(old, edited);
        for i in 0..self.patterns.len() {
            // The live copy of the active pattern was counted above.
            let placed: i32 = self.patterns[i].data.replace_clip(old, edited);
            if self.patterns[i].id != self.active_id { count = count + placed; }
        }
        var reversed: list<AudioClip> = [];
        while self.audio.samples.len() > 0 {
            let position: i64 = self.audio.samples.len() - 1;
            let clip: AudioClip = self.audio.samples.pop();
            if position == index { clip.release(); reversed.push(edited); }
            else { reversed.push(clip); }
        }
        while reversed.len() > 0 { self.audio.samples.push(reversed.pop()); }
        self.audio.view.marks = [];
        old.release();
        return count;
    }
    /// Audio > Move to group: put samples `indices` in group `group` ("" for
    /// none). A sample stored in project folder `root` (its path is below
    /// `root`/Audio/) gets the path of its file in the group's project folder
    /// `folder` ("Audio/Drums" for "Drums"), where saving the project writes
    /// it; every placement takes the new path. Returns how many samples moved.
    pub fn move_samples_to_group(self: &mut Self, indices: list<i32>, group: str8, root: str8, folder: str8) -> i32 {
        let audio_dir: str8 = format!("{}/Audio/", root);
        var moved: i32 = 0; var last: i32 = -1;
        for index in indices {
            if index < 0 || index >= self.audio.samples.len() { continue; }
            let current: str8 = self.audio.group_of(index);
            if current == group { continue; }
            let old: AudioClip = self.audio.samples[index].copy();
            if root != "" && std::strbuf::starts_with(old.source, audio_dir) == 1 {
                let name: str8 = base_name(old.source);
                let source: str8 = format!("{}/{}/{}", root, folder, name); free(name);
                if source != old.source {
                    self.table.rename_clip_source(old, source);
                    for i in 0..self.patterns.len() {
                        self.patterns[i].data.rename_clip_source(old, source);
                    }
                    free(self.audio.samples[index].source);
                    self.audio.samples[index].source = source;
                } else { free(source); }
            }
            old.release();
            self.audio.set_group(index, group);
            moved = moved + 1; last = index;
        }
        free(audio_dir);
        self.audio.view.marks = [];
        if last >= 0 { self.audio.reveal_sample(last); } else { self.audio.rebuild(); }
        return moved;
    }
    pub fn insert_selected_audio(self: &mut Self, area: Rect) -> bool {
        let index: i32 = self.audio.selected_sample();
        if index < 0 || index >= self.audio.samples.len() { self.error = "Select a loaded sample"; return false; }
        let clip: AudioClip = self.audio.samples[index];
        self.error = ""; return self.table.insert_audio(clip, area);
    }
    pub fn load_audio(self: &mut Self, path: str8, bpm: i32, area: Rect) -> bool {
        if !self.audio.load(path, bpm) { self.error = self.audio.error; return false; }
        self.error = ""; self.table.error = "";
        let index: i32 = self.table.active_track();
        if index >= 0 {
            if self.table.tracks[index].audio { self.insert_selected_audio(area); return true; }
        }
        self.show_audio(); return true;
    }
    /// Crop every placement on the active AUDIO track into its own sample,
    /// replace the placements with those independent samples, and put them in
    /// expandable Audio-pane groups named after their original source files.
    pub fn make_audio_track_destructive(self: &mut Self, area: Rect) -> i32 {
        let index: i32 = self.table.active_track();
        if index < 0 || !self.table.tracks[index].audio { self.error = "Select an AUDIO track first"; return 0; }
        if self.table.tracks[index].instances.len() == 0 { self.error = "The AUDIO track has no clips"; return 0; }
        if self.audio.samples.len() + self.table.tracks[index].instances.len() > 256 { self.error = "Maximum 256 samples"; return 0; }
        var groups: list<str8> = [];
        var made: i32 = 0; var last_sample: i32 = -1;
        var reversed: list<AudioInstance> = [];
        while self.table.tracks[index].instances.len() > 0 {
            reversed.push(self.table.tracks[index].instances.pop());
        }
        while reversed.len() > 0 {
            let instance: AudioInstance = reversed.pop();
            // Named after the clip (a slice keeps its original's name), the
            // new group goes inside the group of the clip's sample.
            var name: str8 = audio_group(instance.clip.source);
            if name == "" { free(name); name = base_name(instance.clip.source); }
            var parent: str8 = clone("");
            for i in 0..self.audio.samples.len() {
                if self.audio.samples[i].source == instance.clip.source && self.audio.samples[i].frames == instance.clip.frames {
                    free(parent); parent = clone(self.audio.group_of(i32(i)));
                }
            }
            let slash: i64 = rfind(parent, "/");
            let last: str8 = slash < 0 ? clone(parent) : sub(parent, slash + 1, len(parent) - slash - 1);
            var group: str8 = parent == "" ? clone(name) : (last == name ? clone(parent) : format!("{}/{}", parent, name));
            free(last); free(parent);
            var known: bool = false; for existing in groups { if existing == group { known = true; } }
            if !known { groups.push(clone(group)); }
            var number: i32 = 1;
            for i in 0..self.audio.samples.len() { let member: str8 = self.audio.group_of(i32(i)); if member == group { number = number + 1; } }
            let label: str8 = format!("{} - {}", name, number);
            let source: str8 = format!("{}/{}", name, label);
            let end: i64 = instance.render_end(); var clip: AudioClip = instance.clip.slice_frames(instance.offset_frames, end);
            free(clip.source); clip.source = source;
            last_sample = self.audio.add_clip_in(clip.copy(), group);
            instance.clip.release();
            self.table.tracks[index].instances.push(AudioInstance { clip: clip, start_row: instance.start_row, length_ticks: instance.length_ticks,
                original_bpm: instance.original_bpm, stretch_algorithm: instance.stretch_algorithm, pitch: instance.pitch, resample: instance.resample, loop_mode: instance.loop_mode });
            free(label); free(group); free(name); made = made + 1;
        }
        self.table.rebuild_columns(); self.table.reconcile(area); self.table.error = "";
        // Open every affected group and its parents, then leave the final
        // generated clip selected.
        for group in groups {
            var open: str8 = clone(group);
            while open != "" {
                if !self.audio.group_open(open) { self.audio.expanded.push(clone(open)); }
                let up: str8 = group_parent(open); free(open); open = up;
            }
            free(open); free(group);
        }
        self.audio.rebuild(); if last_sample >= 0 { self.audio.select_sample(last_sample); }
        self.error = ""; return made;
    }
    /// `frame` supplies the OK/Cancel buttons and their focus.
    pub fn paint_rename(self: &Self, surface: Surface, area: Rect, theme: Theme, frame: &TextPrompt) -> void {
        if !self.renaming { return; }
        var dialog: TextPrompt = TextPrompt {}; dialog = frame; dialog.title = "Rename pattern";
        let content: Rect = dialog.paint_frame(surface, area, theme);
        surface.text(content, "Pattern name:", theme.foreground, theme.panel);
        if content.height > 2 { self.editor.paint(surface, Rect::new(content.x, content.y + 2, content.width, 1), theme.foreground, theme.selection, dialog.focus.selected == 0); }
        if content.height > 4 { surface.text(Rect::new(content.x, content.y + 4, content.width, 1), self.error, theme.accent, theme.panel); }
    }
    pub fn release(self: &mut Self) -> void {
        let instruments: list<ListItem> = self.instruments.items; for item in instruments { free(item.label); }
        self.audio.release();
        self.table.release(); self.editor.release();
        let entries: list<PatternEntry> = self.patterns;
        for entry in entries { var owned: PatternEntry = PatternEntry {}; owned = entry; owned.data.release(); free(owned.name); }
        let items: list<ListItem> = self.view.items; for item in items { free(item.label); }
    }
}
