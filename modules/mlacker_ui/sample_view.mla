mod mlacker_ui::audio_clip;
mod tui::surface;
mod tui::theme;
mod tui::input;
mod tui::menu;
use mlacker_ui::audio_clip::AudioClip;
use tui::geometry::*;
use tui::surface::*;
use tui::theme::*;
use tui::input::*;
use tui::menu::Key;
use std::strbuf::free;

/// Frames of `clip`'s window (from its `offset`) where the mono level rises
/// sharply: onsets of hits and notes, at least 30 ms apart. Each is the first
/// frame of the rising window that reaches 30% of its peak, moved back to the
/// quietest of the 64 frames before.
pub fn transient_frames(source: &AudioClip) -> list<i64> { return transients_above(source, 15); }
/// The transients whose rise in level is at least `percent` of the strongest
/// one: the hits that stand out, like bass drums, from about 50.
pub fn transients_above(source: &AudioClip, percent: i32) -> list<i64> {
    var clip: AudioClip = AudioClip {}; clip = source;
    var out: list<i64> = [];
    let channels: i64 = clip.channels < 1 ? 1 : clip.channels;
    let frames: i64 = clip.frames; let base: i64 = clip.offset < 0 ? 0 : clip.offset;
    if frames <= 0 || clip.samples.len() < (base + frames) * channels { return out; }
    let samples: list<f32> = clip.samples;
    // Levels of 256-frame windows every 64 frames, so a hit is measured the
    // same wherever it falls; each rise compares a window with the one just
    // before it.
    let win: i64 = 256; let hop: i64 = 64; let back: i64 = win / hop;
    let hops: i64 = frames < win ? 0 : (frames - win) / hop + 1;
    var levels: list<f32> = [];
    for h in 0..hops {
        var sum: f32 = 0.0f; let from: i64 = h * hop; let to: i64 = from + win;
        for f in from..to { let v: f32 = mono_value(samples, channels, base + f); sum = sum + v * v; }
        levels.push(std::math::sqrt(sum / f32(win)));
    }
    var rises: list<f32> = []; var strongest: f32 = 0.0f;
    for h in 0..hops {
        let rise: f32 = h < back ? levels[h] : levels[h] - levels[h - back];
        rises.push(rise > 0.0f ? rise : 0.0f);
        if rise > strongest { strongest = rise; }
    }
    let ratio: f32 = f32(percent) / 100.0f;
    let floor: f32 = strongest * ratio > 0.005f ? strongest * ratio : 0.005f;
    let rate: i64 = clip.sample_rate < 1 ? 48000 : clip.sample_rate;
    let spacing: i64 = (rate * 30 / 1000 + hop - 1) / hop;
    // Local maxima above the floor; of two too close, the stronger stays.
    var picked: list<i64> = [];
    for h in 0..hops {
        let rise: f32 = rises[h];
        if rise < floor { continue; }
        if h > 0 && rises[h - 1] > rise { continue; }
        if h + 1 < hops && rises[h + 1] >= rise { continue; }
        let count: i64 = picked.len();
        if count > 0 && h - picked[count - 1] < spacing {
            if rises[picked[count - 1]] >= rise { continue; }
            var kept: list<i64> = []; for i in 0..count - 1 { kept.push(picked[i]); } picked = kept;
        }
        picked.push(h);
    }
    for h in picked {
        // The onset lies in the window whose level rose (or just before it).
        let lo: i64 = h * hop - hop < 0 ? 0 : h * hop - hop;
        let far: i64 = h * hop + win; let hi: i64 = far < frames ? far : frames;
        var peak: f32 = 0.0f;
        for f in lo..hi { let a: f32 = mono_level(samples, channels, base + f); if a > peak { peak = a; } }
        var onset: i64 = h * hop;
        for f in lo..hi { if mono_level(samples, channels, base + f) >= peak * 0.3f { onset = f; break; } }
        let earliest: i64 = onset - 64 < lo ? lo : onset - 64; let through: i64 = onset + 1;
        var quiet: i64 = onset; var level: f32 = 2.0f;
        for f in earliest..through { let a: f32 = mono_level(samples, channels, base + f); if a <= level { level = a; quiet = f; } }
        if out.len() == 0 || quiet > out[out.len() - 1] { out.push(quiet); }
    }
    return out;
}
fn mono_value(samples: &list<f32>, channels: i64, f: i64) -> f32 {
    var pcm: list<f32> = []; pcm = samples;
    return channels < 2 ? pcm[f] : (pcm[f * channels] + pcm[f * channels + 1]) * 0.5f;
}
fn mono_level(samples: &list<f32>, channels: i64, f: i64) -> f32 {
    let v: f32 = mono_value(samples, channels, f);
    return v < 0.0f ? -v : v;
}

/// True for a key the Sample pane acts on: the `SampleView::on_key` keys, and
/// t (trim), x (delete), Ctrl+P (play) and Ctrl+S (save as a new clip).
pub fn sample_pane_key(event: InputEvent) -> bool {
    if event.released { return false; }
    let code: i32 = event.code; let mods: i32 = (event.modifiers - 1) % 64 + 1;
    if mods == 1 {
        if code == 104 || code == 108 || code == 72 || code == 76 || code == 118 || code == 66 || code == 69 || code == 8 || code == 12 || code == 84 ||
           code == 116 || code == 43 || code == 45 || code == 61 || code == 120 || code == 16 || code == 19 { return true; }
        if code == 0 && event.kind == InputKind::Menu && (event.key == Key::Left || event.key == Key::Right) { return true; }
    }
    if mods == 2 { return code == 104 || code == 108 || code == 98 || code == 101 || code == 116 || code == 72 || code == 76 || code == 66 || code == 69 || code == 84 || code == 43 || code == 61; }
    return mods == 5 && (code == 112 || code == 115 || code == 104 || code == 108);
}

/// Waveform of one clip window with a cursor, a selection and the keys that
/// move them (`on_key`). The view stays centred on the cursor while zooming.
/// `v` starts a selection at the cursor; it then spans from there to wherever
/// the cursor moves, until Esc drops it.
pub struct SampleView { var grainy: bool{true}; var wave: bool; var zoom: i32; var visible: bool;
    var sel_start: i64; var sel_end: i64; var sel_frames: i64;
    /// The cursor, once a key moved it; until then it follows the pattern row.
    var anchor_frame: i64; var anchor_active: bool;
    /// While selecting, the selection spans `sel_anchor` (where `v` was
    /// pressed) to the cursor.
    var selecting: bool; var sel_anchor: i64;
    /// Ctrl+H/L jump between transients, found once per clip window; the
    /// strong ones (`transients_strong`) stand out like bass drums. In
    /// `transient_mode` (Shift+T) h/l step between transients and H/L
    /// between the strong ones.
    var transients: list<i64>; var transients_strong: list<i64>; var transients_key: i64{-1}; var transient_mode: bool;
    /// A Ctrl+P preview of frames `play_from`..`play_to` started at
    /// `play_started` (ms), now at `play_frame`.
    var playing: bool; var play_from: i64; var play_to: i64; var play_started: i64; var play_frame: i64; var play_rate: i64;
    /// What the last key did (static text), or "".
    var status: str8{""}; };
impl SampleView {
    /// Reset the selection to cover the whole clip of `frames` frames.
    pub fn reset_selection(self: &mut Self, frames: i64) -> void {
        self.sel_start = 0; self.sel_end = frames; self.sel_frames = frames; self.anchor_active = false; self.selecting = false;
    }
    /// The cursor frame: where a key put it, else at pattern row `row`.
    pub fn cursor(self: SampleView, source: &AudioClip, row: i32) -> i64 {
        var clip: AudioClip = AudioClip {}; clip = source;
        var at: i64 = self.anchor_active ? self.anchor_frame : wide(row) * clip.frames_per_row;
        if at > clip.frames { at = clip.frames; } if at < 0 { at = 0; }
        return at;
    }
    fn set_cursor(self: &mut Self, frame: i64) -> void { self.anchor_frame = frame; self.anchor_active = true; }
    /// True when a range narrower than the whole clip of `frames` is selected.
    pub fn has_selection(self: SampleView, frames: i64) -> bool {
        return self.sel_frames == frames && self.sel_end > self.sel_start && (self.sel_start > 0 || self.sel_end < frames);
    }
    /// Selection in frames; the whole clip when nothing narrower is selected.
    pub fn selection_start(self: SampleView, frames: i64) -> i64 { return self.has_selection(frames) ? self.sel_start : 0; }
    pub fn selection_end(self: SampleView, frames: i64) -> i64 { return self.has_selection(frames) ? self.sel_end : frames; }
    /// Drop the selection, keeping the cursor at `cursor`.
    pub fn clear_selection(self: &mut Self, frames: i64, cursor: i64) -> void {
        self.reset_selection(frames); self.set_cursor(cursor);
    }
    /// Select `from`..`to` of a clip of `frames` frames, the cursor at the end;
    /// moving the cursor then changes the end, `from` staying put.
    pub fn select(self: &mut Self, from: i64, to: i64, frames: i64) -> void {
        self.sel_start = from; self.sel_end = to; self.sel_frames = frames;
        self.selecting = true; self.sel_anchor = from; self.set_cursor(to);
    }
    /// Start selecting at `cursor`.
    fn begin_select(self: &mut Self, frames: i64, cursor: i64) -> void {
        self.sel_start = 0; self.sel_end = frames; self.sel_frames = frames;
        self.selecting = true; self.sel_anchor = cursor; self.set_cursor(cursor);
        self.status = "Selecting: move to the other end, t trims to it, x deletes it, Esc drops it";
    }
    /// Put the cursor at `frame` (clamped); while selecting, the selection
    /// follows it.
    fn move_to(self: &mut Self, frame: i64, frames: i64) -> void {
        let at: i64 = frame < 0 ? 0 : (frame > frames ? frames : frame);
        if self.selecting {
            let lo: i64 = self.sel_anchor < at ? self.sel_anchor : at;
            let hi: i64 = self.sel_anchor < at ? at : self.sel_anchor;
            // An empty range shows as nothing selected yet.
            self.sel_start = hi > lo ? lo : 0; self.sel_end = hi > lo ? hi : frames; self.sel_frames = frames;
        }
        self.set_cursor(at);
    }
    /// The nearest transient before (`forward` false) or after `cursor`, or
    /// the clip's start or end when there is none.
    fn next_transient(self: &mut Self, source: &AudioClip, cursor: i64, forward: bool, strong: bool) -> i64 {
        var clip: AudioClip = AudioClip {}; clip = source;
        self.find_transients(clip);
        let points: list<i64> = strong ? self.transients_strong : self.transients;
        if forward { for p in points { if p > cursor { return p; } } return clip.frames; }
        var found: i64 = 0;
        for p in points { if p < cursor { found = p; } }
        return found;
    }
    /// Find the clip window's transients unless they are already known.
    fn find_transients(self: &mut Self, source: &AudioClip) -> void {
        var clip: AudioClip = AudioClip {}; clip = source;
        let key: i64 = clip.offset * 1000003 + clip.frames;
        if key == self.transients_key { return; }
        self.transients = transient_frames(clip); self.transients_strong = transients_above(clip, 50); self.transients_key = key;
    }
    pub fn span(self: SampleView, source: &AudioClip, pixels: i32) -> i64 {
        var clip: AudioClip = AudioClip {}; clip = source;
        var frames: i64 = clip.frames;
        for _i in 0..self.zoom { frames = frames / 2; }
        if frames < wide(pixels) { frames = wide(pixels); }
        return frames > clip.frames ? clip.frames : frames;
    }
    pub fn start(self: SampleView, source: &AudioClip, row: i32, pixels: i32) -> i64 {
        var clip: AudioClip = AudioClip {}; clip = source;
        let span: i64 = self.span(clip, pixels);
        var start: i64 = wide(row) * clip.frames_per_row - span / 2;
        if start < 0 { start = 0; }
        if start + span > clip.frames { start = clip.frames - span; }
        return start;
    }
    /// Cursor, zoom and selection keys for a pane `width` columns wide
    /// (panel border included) showing `clip` at pattern row `row`. Returns
    /// true when the key was one of them.
    ///   h/l          cursor one column back/forward (transient mode: the
    ///                previous/next transient)
    ///   H/L          an eighth of the view back/forward (transient mode: the
    ///                previous/next strong transient)
    ///   Shift+T      toggle transient mode
    ///   Ctrl+H/L     the previous/next transient
    ///   Shift+B/E    the clip's beginning/end
    ///   v            select from the cursor (the selection follows it)
    ///   + - =        zoom in / out around the cursor / fit the clip
    pub fn on_key(self: &mut Self, event: InputEvent, source: &AudioClip, width: i32, row: i32) -> bool {
        var clip: AudioClip = AudioClip {}; clip = source;
        if event.released || clip.frames <= 0 { return false; }
        if self.sel_frames != clip.frames { self.reset_selection(clip.frames); }
        // Caps/Num Lock bits (64, 128) are not modifiers here.
        let code: i32 = event.code; let mods: i32 = (event.modifiers - 1) % 64 + 1;
        let plain: bool = mods == 1;
        // Shift+letter: an uppercase letter, or the letter with the Shift mask.
        let shift_h: bool = (code == 72 && plain) || ((code == 104 || code == 72) && mods == 2);
        let shift_l: bool = (code == 76 && plain) || ((code == 108 || code == 76) && mods == 2);
        let shift_b: bool = (code == 66 && plain) || ((code == 98 || code == 66) && mods == 2);
        let shift_e: bool = (code == 69 && plain) || ((code == 101 || code == 69) && mods == 2);
        // Ctrl+letter: the control byte, or the letter with the Ctrl mask.
        let shift_t: bool = (code == 84 && plain) || ((code == 116 || code == 84) && mods == 2);
        let ctrl_h: bool = (code == 8 && plain) || (code == 104 && mods == 5);
        let ctrl_l: bool = (code == 12 && plain) || (code == 108 && mods == 5);
        let pixels: i32 = (width > 2 ? width - 2 : 1) * (self.grainy ? 2 : 1);
        let span: i64 = self.span(clip, pixels);
        let columns: i64 = wide(width > 2 ? width - 2 : 1);
        let cursor: i64 = self.cursor(clip, row);
        let left: bool = (code == 104 && plain) || (code == 0 && event.kind == InputKind::Menu && event.key == Key::Left);
        let right: bool = (code == 108 && plain) || (code == 0 && event.kind == InputKind::Menu && event.key == Key::Right);
        self.status = "";
        if shift_t {
            self.transient_mode = !self.transient_mode;
            if self.transient_mode { self.find_transients(clip); }
            self.status = self.transient_mode ? "Transient mode: h/l step between transients, H/L between strong ones" : "Transient mode off";
            return true;
        }
        if left || right {
            if self.transient_mode { self.move_to(self.next_transient(clip, cursor, right, false), clip.frames); return true; }
            let step: i64 = span / columns;
            self.move_to(cursor + (right ? 1 : -1) * (step < 1 ? 1 : step), clip.frames); return true;
        }
        if shift_h || shift_l {
            if self.transient_mode { self.move_to(self.next_transient(clip, cursor, shift_l, true), clip.frames); return true; }
            let step: i64 = span / 8;
            self.move_to(cursor + (shift_l ? 1 : -1) * (step < 1 ? 1 : step), clip.frames); return true;
        }
        if ctrl_h || ctrl_l { self.move_to(self.next_transient(clip, cursor, ctrl_l, false), clip.frames); return true; }
        if shift_b { self.move_to(0, clip.frames); return true; }
        if shift_e { self.move_to(clip.frames, clip.frames); return true; }
        if code == 118 && plain { self.begin_select(clip.frames, cursor); return true; }
        // '+' arrives with or without Shift depending on the terminal; so may
        // '=' with Shift.
        if code == 43 || (code == 61 && mods == 2) {
            self.set_cursor(cursor);
            if self.zoom < 30 && span > wide(pixels) { self.zoom = self.zoom + 1; }
            return true;
        }
        if code == 45 && plain { self.set_cursor(cursor); if self.zoom > 0 { self.zoom = self.zoom - 1; } return true; }
        if code == 61 && plain { self.zoom = 0; return true; }
        return false;
    }
    /// Start showing a preview of frames `from`..`to` played at `rate` from `now` (ms).
    pub fn start_play(self: &mut Self, from: i64, to: i64, rate: i64, now: i64) -> void {
        self.play_from = from; self.play_to = to; self.play_rate = rate > 0 ? rate : 1;
        self.play_started = now; self.play_frame = from; self.playing = true;
    }
    pub fn stop_play(self: &mut Self) -> void { self.playing = false; }
    /// Advance the play position to `now`; `previewing` false ends it.
    pub fn follow(self: &mut Self, now: i64, previewing: bool) -> void {
        if !self.playing { return; }
        if !previewing { self.playing = false; return; }
        let at: i64 = self.play_from + (now - self.play_started) * self.play_rate / 1000;
        self.play_frame = at > self.play_to ? self.play_to : at;
    }
    pub fn paint(self: SampleView, surface: Surface, area: Rect, theme: Theme, source: &AudioClip, row: i32) -> void {
        self.paint_at(surface, area, theme, source, row, 0);
    }
    pub fn paint_at(self: SampleView, surface: Surface, area: Rect, theme: Theme, source: &AudioClip, row: i32, phase: i64) -> void {
        var clip: AudioClip = AudioClip {}; clip = source;
        surface.fill(area, Cell { glyph: 32, foreground: theme.foreground, background: theme.panel });
        if area.width <= 2 || area.height < 2 || clip.frames <= 0 || clip.channels < 1 || clip.channels > 2 ||
            clip.sample_rate <= 0 || clip.samples.len() < (clip.offset + clip.frames) * clip.channels { return; }
        let pixels: i32 = (area.width - 2) * (self.grainy ? 2 : 1);
        let span: i64 = self.span(clip, pixels);
        var cursor: i64 = wide(row) * clip.frames_per_row + phase * clip.frames_per_row / 15000;
        if self.anchor_active { cursor = self.anchor_frame; }
        if cursor >= clip.frames { cursor = clip.frames - 1; } if cursor < 0 { cursor = 0; }
        var start: i64 = cursor - span / 2;
        if start < 0 { start = 0; } if start + span > clip.frames { start = clip.frames - span; }
        let info: str8 = format!("{} {} | {}..{} ms | {} frames/px", self.grainy ? "Grainy" : "Normal",
            self.wave ? "Wave" : "Filled", start * 1000 / clip.sample_rate,
            (start + span) * 1000 / clip.sample_rate, span / wide(pixels) > 0 ? span / wide(pixels) : 1);
        surface.text(Rect::new(area.x, area.y, area.width, 1), info, theme.muted, theme.panel); free(info);
        // Trim selection window in absolute frames; only a proper subset shades.
        var sel0: i64 = self.sel_start; var sel1: i64 = self.sel_end;
        if self.sel_frames != clip.frames || sel1 <= sel0 { sel0 = 0; sel1 = clip.frames; }
        if sel0 < 0 { sel0 = 0; } if sel1 > clip.frames { sel1 = clip.frames; }
        if sel0 <= 0 && sel1 >= clip.frames { sel0 = -1; sel1 = -1; }
        let height: i32 = area.height - 1;
        let top_height: i32 = clip.channels == 2 ? height / 2 : height;
        self.paint_channel(surface, Rect::new(area.x + 2, area.y + 1, area.width - 2, top_height), theme, clip, 0, start, span, cursor, sel0, sel1, 0x5adc8c);
        surface.text(Rect::new(area.x, area.y + 1, 1, 1), clip.channels == 1 ? "M" : "L", 0x5adc8c, theme.panel);
        if clip.channels == 2 {
            self.paint_channel(surface, Rect::new(area.x + 2, area.y + 1 + top_height, area.width - 2, height - top_height), theme, clip, 1, start, span, cursor, sel0, sel1, 0xef6575);
            surface.text(Rect::new(area.x, area.y + 1 + top_height, 1, 1), "R", 0xef6575, theme.panel);
        }
        self.paint_marks(surface, Rect::new(area.x + 2, area.y + 1, area.width - 2, height), theme, clip, start, span);
    }
    /// Transient ticks (once Ctrl+H/L found them) and the play position.
    fn paint_marks(self: SampleView, surface: Surface, lane: Rect, theme: Theme, source: &AudioClip, start: i64, span: i64) -> void {
        var clip: AudioClip = AudioClip {}; clip = source;
        if lane.width <= 0 || lane.height <= 0 || span <= 0 { return; }
        if self.transients_key == clip.offset * 1000003 + clip.frames {
            let points: list<i64> = self.transients; let strong: list<i64> = self.transients_strong;
            for p in points {
                if p < start || p >= start + span { continue; }
                var big: bool = false; for q in strong { if q == p { big = true; } }
                let x: i32 = lane.x + i32((p - start) * wide(lane.width) / span);
                surface.put(x, lane.y, Cell { glyph: big ? 0x25bc : 0x25bf, foreground: big ? theme.accent : theme.muted, background: theme.panel });
            }
        }
        if self.playing && self.play_frame >= start && self.play_frame < start + span {
            let x: i32 = lane.x + i32((self.play_frame - start) * wide(lane.width) / span);
            for r in 0..lane.height {
                let y: i32 = lane.y + i32(r);
                let old: Cell = surface.cell(x, y);
                surface.put(x, y, Cell { glyph: old.glyph == 32 ? 0x2502 : old.glyph, foreground: theme.accent, background: old.background });
            }
        }
    }
    fn paint_channel(self: SampleView, surface: Surface, area: Rect, theme: Theme, source: &AudioClip,
        channel: i64, start: i64, span: i64, cursor: i64, sel0: i64, sel1: i64, color: i32) -> void {
        var clip: AudioClip = AudioClip {}; clip = source;
        if area.width <= 0 || area.height <= 0 || span <= 0 { return; }
        let scale_x: i32 = self.grainy ? 2 : 1; let scale_y: i32 = self.grainy ? 4 : 1;
        let width: i32 = area.width * scale_x; let height: i32 = area.height * scale_y;
        if sel1 > sel0 {
            let shade: i32 = lighten(theme.panel, 22);
            for col in 0..area.width {
                let f: i64 = start + wide(col) * span / wide(area.width);
                if f >= sel0 && f < sel1 {
                    surface.fill(Rect::new(area.x + i32(col), area.y, 1, area.height), Cell { glyph: 32, foreground: color, background: shade });
                }
            }
        }
        if cursor >= start && cursor < start + span {
            let x: i32 = i32((cursor - start) * wide(area.width) / span);
            surface.fill(Rect::new(area.x + x, area.y, 1, area.height), Cell { glyph: 32, foreground: color, background: theme.selection });
        }
        var previous: i32 = -1;
        for x in 0..width {
            let first: i64 = start + x * span / wide(width);
            let next: i64 = start + (x + 1) * span / wide(width);
            let end: i64 = next > first ? next : first + 1;
            let base: i64 = clip.offset * clip.channels + channel;
            let initial: f32 = clip.samples[base + first * clip.channels];
            var low: f32 = initial; var high: f32 = initial; var last: f32 = initial;
            for frame in first..end {
                let sample: f32 = clip.samples[base + frame * clip.channels];
                if sample < low { low = sample; } if sample > high { high = sample; } last = sample;
            }
            var top: i32 = sample_y(high, height); var bottom: i32 = sample_y(low, height);
            if self.wave {
                if previous >= 0 { if previous < top { top = previous; } if previous > bottom { bottom = previous; } }
            } else {
                let zero: i32 = sample_y(0.0f, height);
                if zero < top { top = zero; } if zero > bottom { bottom = zero; }
            }
            previous = sample_y(last, height);
            let stop: i32 = bottom + 1;
            for y in top..stop { sample_pixel(surface, area, i32(x), i32(y), self.grainy, self.wave, color); }
        }
    }
}
fn sample_y(value: f32, height: i32) -> i32 {
    let sample: f32 = value < -1.0f ? -1.0f : (value > 1.0f ? 1.0f : value);
    return i32((1.0f - sample) * 0.5f * f32(height - 1));
}
fn sample_pixel(surface: Surface, area: Rect, x: i32, y: i32, grainy: bool, wave: bool, color: i32) -> void {
    let col: i32 = area.x + (grainy ? x / 2 : x); let row: i32 = area.y + (grainy ? y / 4 : y);
    if !area.contains(col, row) { return; }
    let old: Cell = surface.cell(col, row);
    var glyph: i32 = wave ? 0x25cf : 0x2588;
    if grainy {
        let bits: array<i32, 8> = {1, 8, 2, 16, 4, 32, 64, 128};
        let dot_mask: i32 = bits[(y % 4) * 2 + x % 2];
        var mask: i32 = old.glyph >= 0x2800 && old.glyph <= 0x28ff ? old.glyph - 0x2800 : 0;
        if mask / dot_mask % 2 == 0 { mask = mask + dot_mask; }
        glyph = 0x2800 + mask;
    }
    surface.put(col, row, Cell { glyph: glyph, foreground: color, background: old.background });
}
