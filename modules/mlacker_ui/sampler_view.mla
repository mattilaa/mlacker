mod std::audio::controller;
use tui::geometry::*;
use tui::surface::*;
use tui::theme::*;
use tui::input::*;
use tui::menu::Key;
use tui::menu::function_number;
use tui::piano::piano_note_name;
use std::audio::controller::AudioController;
use mlacker_ui::audio_clip::AudioClip;
use std::strbuf::clone;
use std::strbuf::free;

// Mla Sampler's layout (plugins/mla_sampler/src/plugin.cpp): 16 slots and 8
// outputs. Slot `s` parameter IDs are 200 + 7s + field (level, pan, tune,
// output, loop, loop start, loop end), 400 + 5s + field for its key zone
// (mode, low key, high key, zone root, key track), 500 + s for its loop
// crossfade, 600 + 2s + field for its velocity range (low, high) and
// 700 + 5s + field for its envelope (own, attack, decay, sustain, release)
// 800 + s for its sample start and 900 + s for its group (Off, 1-8); 950 is
// the instance's group mode (Round-robin, Random). The filter chain: 2000 +
// 32s + 8t + field for stage t (type, cutoff, resonance, env amount, key
// track, gain) and 1100 + 5s + field for the slot's filter envelope (own, attack,
// decay, sustain, release); 1200 + s is its choke group (Off, 1-8), 1300 + s
// reverse (Off, On), and
// 3000 + 32s + 16l + field its LFO l (shape, rate, sync, division, delay,
// pitch, cutoff, level, trigger), and 4000 + 32s + 4r + field its mod route r
// (source, target, amount).

/// Mla Sampler editor in the Pattern view's bottom pane (View menu / Shift+S),
/// sharing it with the virtual keyboard. It edits the instance on the selected
/// Instrument track through its VST3 parameters, so its edits are saved with
/// the session and the plugin state like any parameter. While the pane is
/// focused it keeps the keys for itself (see `handles`).
pub struct SamplerView {
    var visible: bool;
    /// Selected slot 0-15, first slot shown, and the selected column: 0 key
    /// mode, 1 low key, 2 high key, 3 zone root, 4 key track, 5 low velocity,
    /// 6 high velocity, 7 loop mode, 8 loop start, 9 loop end, 10 loop
    /// crossfade, 11 output. On the Sound page (`page` 1, key `e`): 0 level,
    /// 1 pan, 2 tune, 3 envelope (instance or own), 4-7 attack, decay,
    /// sustain, release, 8 sample start, 9 group, 10 choke group, 11 reverse. On the
    /// Filter page (`page`
    /// 2): 0-5 filter 1 type, cutoff, resonance, envelope amount, key track,
    /// gain, 6-11 the same for filter 2, 12 filter envelope (instance or
    /// own), 13-16 its attack, decay, sustain, release. On the LFO page
    /// (`page` 3): 0 shape, 1 rate, 2 sync, 3 division, 4 delay, 5 pitch
    /// depth, 6 cutoff depth, 7 level depth, 8 trigger; the LFO 2 page
    /// (`page` 4) the same for LFO 2. On the Mod page (`page` 5): per route
    /// r (0-3) 3r source, 3r + 1 target, 3r + 2 amount.
    var slot: i32; var column: i32; var scroll: i32; var page: i32;
    /// Wave view (`w`): the selected slot's waveform with its loop markers.
    /// `marker` 0 edits the loop start, 1 the loop end, 2 the sample start
    /// (where playback begins). `zoom` halves the
    /// frames shown per step, centred on the marker. `dots` is the dot
    /// columns the waveform last painted, for moving a marker one dot.
    var wave: bool; var marker: i32; var zoom: i32; var dots: i32{160};
    /// Audition (`p`): the note sounding (-1 for none) and the live target it
    /// went to. Like the virtual keyboard, it lasts until the key's release,
    /// or on terminals without key releases until the key stops repeating
    /// (`until`).
    var audition_note: i32{-1}; var audition_target: i64; var audition_until: i64;
    var releases_seen: bool;
};
impl SamplerView {
    /// Keys the focused pane keeps for itself: everything printable ("q"
    /// included), Enter, Backspace and the arrows. Pane moves, Tab, F-keys,
    /// Escape, control shortcuts, Space (transport) and the Shift+S / Shift+M
    /// / Shift+P view toggles still reach the application.
    pub fn handles(event: InputEvent) -> bool {
        if event.kind == InputKind::None || event.kind == InputKind::Pane { return false; }
        if event.modifiers != 1 && event.modifiers != 2 { return false; }
        if event.kind == InputKind::Menu && (event.key == Key::Toggle || event.key == Key::Escape || function_number(event.key) > 0) { return false; }
        if event.code == 32 || event.code == 77 || event.code == 80 || event.code == 83 { return false; }
        if event.modifiers == 2 && (event.code == 109 || event.code == 112 || event.code == 115) { return false; }
        if event.code == 13 || event.code == 10 || event.code == 8 || event.code == 127 { return true; }
        return event.code == 0 || event.code >= 33;
    }
    /// Instrument slot (1-32) of a loaded Mla Sampler, or 0 when `slot` holds
    /// something else.
    pub fn target(output: AudioController, slot: i32) -> i32 {
        if slot < 1 || output.instrument_sampler(slot, 1) < 0 { return 0; }
        let name: str8 = output.instrument_name(slot);
        return name == "Mla Sampler" ? slot : 0;
    }
    /// Parameter index of stable ID `id` in instrument `slot`, or -1.
    fn parameter_index(output: AudioController, slot: i32, id: i32) -> i32 {
        let count: i32 = i32(output.parameter_info(slot, 0, 0));
        for i in 0..count {
            if i32(output.parameter_info(slot, i, 4)) == id { return i32(i); }
        }
        return -1;
    }
    /// The selected column as `column_id` takes it: Sound page columns are
    /// 100 + column.
    fn col(self: SamplerView) -> i32 { return self.page * 100 + self.column; }
    /// Columns on a page: keys & loops, Sound, Filter.
    fn page_columns(page: i32) -> i32 {
        if page == 1 { return 12; }
        if page == 2 { return 17; }
        if page == 3 || page == 4 { return 9; }
        return 12;
    }
    /// Parameter ID of a column (see `column`; 100 + column on the Sound
    /// page) of sample slot `s`.
    fn column_id(s: i32, col: i32) -> i32 {
        if col >= 500 { return 4000 + s * 32 + (col - 500) / 3 * 4 + (col - 500) % 3; }
        if col >= 400 { return 3016 + s * 32 + col - 400; }
        if col >= 300 { return 3000 + s * 32 + col - 300; }
        if col >= 212 { return 1100 + s * 5 + col - 212; }
        if col >= 200 { return 2000 + s * 32 + (col - 200) / 6 * 8 + (col - 200) % 6; }
        if col == 108 { return 800 + s; }
        if col == 109 { return 900 + s; }
        if col == 110 { return 1200 + s; }
        if col == 111 { return 1300 + s; }
        if col >= 103 { return 700 + s * 5 + col - 103; }
        if col >= 100 { return 200 + s * 7 + col - 100; }
        if col < 5 { return 400 + s * 5 + col; }
        if col == 5 || col == 6 { return 600 + s * 2 + col - 5; }
        if col == 10 { return 500 + s; }
        if col == 11 { return 200 + s * 7 + 3; }
        return 200 + s * 7 + col - 3;
    }
    /// Normalized value of a slot's column, or -1 when the plugin lacks it.
    fn value(output: AudioController, slot: i32, s: i32, col: i32) -> f64 {
        let index: i32 = SamplerView::parameter_index(output, slot, SamplerView::column_id(s, col));
        return index < 0 ? -1.0 : output.parameter_info(slot, index, 2);
    }
    fn key_of(value: f64) -> i32 { return i32(std::math::floor(value * 127.0 + 0.5)); }
    fn is_zone(output: AudioController, slot: i32, s: i32) -> bool { return SamplerView::value(output, slot, s, 0) >= 0.5; }
    fn own_envelope(output: AudioController, slot: i32, s: i32) -> bool { return SamplerView::value(output, slot, s, 103) >= 0.5; }
    fn own_filter_envelope(output: AudioController, slot: i32, s: i32) -> bool { return SamplerView::value(output, slot, s, 212) >= 0.5; }
    /// Filter type number of a stage type column (200 or 206); 0 = off.
    fn filter_type(output: AudioController, slot: i32, s: i32, col: i32) -> i32 {
        let value: f64 = SamplerView::value(output, slot, s, col);
        return value < 0.0 ? 0 : i32(std::math::floor(value * 63.0 + 0.5));
    }
    /// Shown dim: an envelope that follows the instance's, the settings of a
    /// filter stage that is off, and gain except on peak and shelves (14-16).
    fn column_dim(output: AudioController, slot: i32, s: i32, col: i32) -> bool {
        // LFO: Rate without sync, Division with it.
        if col == 301 || col == 401 { return SamplerView::value(output, slot, s, col + 1) >= 0.5; }
        if col == 303 || col == 403 { return SamplerView::value(output, slot, s, col - 1) < 0.5; }
        // Mod: a route's target and amount while it has no source or target.
        if col >= 500 && (col - 500) % 3 > 0 {
            let first: i32 = col - (col - 500) % 3;
            return SamplerView::value(output, slot, s, first) < 0.03 || SamplerView::value(output, slot, s, first + 1) < 0.03;
        }
        if col >= 104 && col <= 107 { return !SamplerView::own_envelope(output, slot, s); }
        if col >= 213 { return !SamplerView::own_filter_envelope(output, slot, s); }
        if col >= 201 && col <= 211 && col != 206 {
            let kind: i32 = SamplerView::filter_type(output, slot, s, col < 206 ? 200 : 206);
            if col == 205 || col == 211 { return kind < 14 || kind > 16; }
            return kind == 0;
        }
        return false;
    }
    /// Normalized step of a continuous column: level 1 dB (6 with `big`),
    /// tune a semitone (an octave), everything else 1% (10%).
    fn continuous_step(col: i32, big: bool) -> f64 {
        // LFO 2's columns step as LFO 1's.
        if col >= 400 && col < 500 { return SamplerView::continuous_step(col - 100, big); }
        // Mod amounts span -100 .. +100 %: 1 % (10 %).
        if col >= 500 { return big ? 0.05 : 0.005; }
        if col == 100 { return (big ? 6.0 : 1.0) / 66.0; }
        if col == 102 { return (big ? 12.0 : 1.0) / 48.0; }
        // Cutoff: about a semitone (an octave) of its 20 Hz .. 20 kHz sweep.
        if col == 201 || col == 207 { return big ? 0.1 : 1.0 / 120.0; }
        // Resonance 0-36 dB: 1 dB (6 dB).
        if col == 202 || col == 208 { return (big ? 6.0 : 1.0) / 36.0; }
        // Envelope amount +-8 octaves: a tenth of an octave (an octave).
        if col == 203 || col == 209 { return big ? 1.0 / 16.0 : 1.0 / 160.0; }
        // Gain +-24 dB: 1 dB (6 dB).
        if col == 205 || col == 211 { return (big ? 6.0 : 1.0) / 48.0; }
        // LFO rate (0.05-20 Hz): about 6% (80%); pitch depth +-12 st: a tenth
        // of a semitone (a semitone); cutoff depth +-4 octaves: a tenth (one).
        if col == 301 { return big ? 0.1 : 0.01; }
        if col == 305 { return big ? 1.0 / 24.0 : 1.0 / 240.0; }
        if col == 306 { return big ? 1.0 / 8.0 : 1.0 / 80.0; }
        return big ? 0.1 : 0.01;
    }
    /// Steps the selected column by `delta`: choices and velocities by one,
    /// keys by a semitone, loop points by 1%. `big` steps keys by an octave,
    /// velocities by 10 and loop points by 10%. Each range's low end stays at
    /// or below its high end (velocities within 1-127), and the loop start
    /// below the loop end. False when nothing changed.
    fn adjust(self: SamplerView, output: AudioController, slot: i32, delta: i32, big: bool) -> bool {
        let col: i32 = self.col();
        let index: i32 = SamplerView::parameter_index(output, slot, SamplerView::column_id(self.slot, col));
        if index < 0 { return false; }
        let steps: f64 = output.parameter_info(slot, index, 1);
        let normalized: f64 = output.parameter_info(slot, index, 2);
        var value: f64 = 0.0;
        if steps > 0.0 {
            let current: f64 = std::math::floor(normalized * steps + 0.5);
            let key_column: bool = col >= 1 && col <= 3;
            let velocity_column: bool = col == 5 || col == 6;
            value = current + f64(delta) * (big && key_column ? 12.0 : (big && velocity_column ? 10.0 : 1.0));
            // Filter types stop at the last one the plugin knows.
            if (col == 200 || col == 206) && value > 21.0 { value = 21.0; }
            // LFO shapes and divisions likewise.
            if (col == 300 || col == 400) && value > 5.0 { value = 5.0; }
            if (col == 303 || col == 403) && value > 13.0 { value = 13.0; }
            // Mod sources and targets likewise.
            if col >= 500 && (col - 500) % 3 < 2 && value > 6.0 { value = 6.0; }
            if col == 1 || col == 5 { let high: f64 = f64(SamplerView::key_of(SamplerView::value(output, slot, self.slot, col + 1))); if value > high { value = high; } }
            if col == 2 || col == 6 { let low: f64 = f64(SamplerView::key_of(SamplerView::value(output, slot, self.slot, col - 1))); if value < low { value = low; } }
            if velocity_column && value < 1.0 { value = 1.0; }
            if value < 0.0 { value = 0.0; }
            if value > steps { value = steps; }
            if value == current { return false; }
        } else {
            value = normalized + f64(delta) * SamplerView::continuous_step(col, big);
            if col == 8 {
                let end: f64 = SamplerView::value(output, slot, self.slot, 9);
                if value > end - 0.01 { value = end - 0.01; }
            }
            if col == 9 {
                let start: f64 = SamplerView::value(output, slot, self.slot, 8);
                if value < start + 0.01 { value = start + 0.01; }
            }
            if value < 0.0 { value = 0.0; }
            if value > 1.0 { value = 1.0; }
            if value == normalized { return false; }
        }
        return output.set_parameter(slot, index, value) == 0;
    }
    /// A key press while the pane is focused. `slot` is the Mla Sampler
    /// instrument slot (0 when the selected track has none). Returns what the
    /// application should do for the selected slot: 0 nothing, 1 repaint,
    /// 2 load a file into it, 3 clear it, 4 route its output bus, 5 tell that
    /// its zone columns need Zone mode, 6 tell that it has no waveform, 7
    /// audition it (see `audition_key`), 8 tell that its envelope columns
    /// need Env set to Own, 9 that its filter envelope columns need FEnv set
    /// to Own. (An i32 rather than an enum: MLang
    /// before its let-enum fix ran an enum `let` initializer twice.)
    pub fn on_event(self: &mut Self, event: InputEvent, output: AudioController, slot: i32, clip: &AudioClip, has_clip: bool) -> i32 {
        if event.code == 119 && event.modifiers == 1 { self.wave = !self.wave; return 1; }
        if self.wave {
            let handled: i32 = self.wave_event(event, output, slot, clip, has_clip);
            if handled >= 0 { return handled; }
        }
        let up: bool = (event.kind == InputKind::Menu && event.key == Key::Up) || (event.code == 107 && event.modifiers == 1);
        let down: bool = (event.kind == InputKind::Menu && event.key == Key::Down) || (event.code == 106 && event.modifiers == 1);
        let left: bool = (event.kind == InputKind::Menu && event.key == Key::Left) || (event.code == 104 && event.modifiers == 1);
        let right: bool = (event.kind == InputKind::Menu && event.key == Key::Right) || (event.code == 108 && event.modifiers == 1);
        if up && self.slot > 0 { self.slot = self.slot - 1; return 1; }
        if down && self.slot < 15 { self.slot = self.slot + 1; return 1; }
        if left && self.column > 0 { self.column = self.column - 1; return 1; }
        if right && self.column < SamplerView::page_columns(self.page) - 1 { self.column = self.column + 1; return 1; }
        // e switches between the keys & loops page and the Sound page.
        if event.code == 101 && event.modifiers == 1 { self.page = (self.page + 1) % 6; self.column = 0; return 1; }
        if slot < 1 { return 0; }
        // Shift+J/K adjust, as everywhere else in the tracker; [ and ] take
        // octave / 10% steps.
        let lower: bool = (event.code == 74 && event.modifiers == 1) || (event.code == 106 && event.modifiers == 2);
        let raise: bool = (event.code == 75 && event.modifiers == 1) || (event.code == 107 && event.modifiers == 2);
        let big_lower: bool = event.code == 91 && event.modifiers == 1;
        let big_raise: bool = event.code == 93 && event.modifiers == 1;
        if lower || raise || big_lower || big_raise {
            if self.page == 0 && self.column >= 1 && self.column <= 4 && !SamplerView::is_zone(output, slot, self.slot) { return 5; }
            if self.page == 1 && self.column >= 4 && self.column <= 7 && !SamplerView::own_envelope(output, slot, self.slot) { return 8; }
            if self.page == 2 && self.column >= 13 && !SamplerView::own_filter_envelope(output, slot, self.slot) { return 9; }
            return self.adjust(output, slot, raise || big_raise ? 1 : -1, big_lower || big_raise) ? 1 : 0;
        }
        if event.kind == InputKind::Menu && event.key == Key::Enter { return 2; }
        if event.code == 13 || event.code == 10 { return 2; }
        if event.code == 127 || event.code == 8 || (event.kind == InputKind::Menu && event.key == Key::Backspace) { return 3; }
        if event.code == 111 && event.modifiers == 1 { return 4; }
        // G switches the instance's group mode: round-robin or random.
        if (event.code == 71 && event.modifiers == 1) || (event.code == 103 && event.modifiers == 2) {
            let index: i32 = SamplerView::parameter_index(output, slot, 950);
            if index < 0 { return 0; }
            return output.set_parameter(slot, index, output.parameter_info(slot, index, 2) >= 0.5 ? 0.0 : 1.0) == 0 ? 1 : 0;
        }
        if event.code == 112 && event.modifiers == 1 { return 7; }
        return 0;
    }
    /// Column a wave view marker edits: loop start, loop end, sample start.
    fn marker_column(marker: i32) -> i32 { return marker == 0 ? 8 : (marker == 1 ? 9 : 108); }
    /// A position column (loop start/end, sample start) of sample slot `s` in
    /// frames of a `frames`-long sample, as the plugin reads it (floor of
    /// value * frames).
    fn frame_at(output: AudioController, slot: i32, s: i32, col: i32, frames: i64) -> i64 {
        let value: f64 = SamplerView::value(output, slot, s, col);
        if value < 0.0 { return col == 9 ? frames : 0; }
        let frame: i64 = wide(i32(std::math::floor(value * f64(frames))));
        return frame < 0 ? 0 : (frame > frames ? frames : frame);
    }
    fn loop_frame(output: AudioController, slot: i32, s: i32, end: bool, frames: i64) -> i64 {
        return SamplerView::frame_at(output, slot, s, end ? 9 : 8, frames);
    }
    /// Set a position column to an exact frame. The value sits mid-frame so
    /// the plugin's floor lands on it; the end of the sample is exactly 1.
    fn set_frame(output: AudioController, slot: i32, s: i32, col: i32, frame: i64, frames: i64) -> bool {
        let index: i32 = SamplerView::parameter_index(output, slot, SamplerView::column_id(s, col));
        if index < 0 || frames < 1 { return false; }
        let value: f64 = frame >= frames ? 1.0 : (f64(frame) + 0.5) / f64(frames);
        return output.set_parameter(slot, index, value) == 0;
    }
    /// The zero crossing nearest `frame` (a frame whose sign differs from the
    /// one before it), searched up to 1 s of 48 kHz either way; `frame` when
    /// there is none.
    /// `reversed`: search the sample as a reversed slot plays it.
    fn zero_crossing(clip: &AudioClip, frame: i64, reversed: bool) -> i64 {
        var source: AudioClip = AudioClip {}; source = clip;
        let samples: list<f32> = source.samples; let channels: i64 = source.channels;
        for distance in 0..48000 {
            for side in 0..2 {
                let f: i64 = side == 0 ? frame - distance : frame + distance;
                if f < 1 || f >= source.frames { continue; }
                // Mono: the channel average.
                let fa: i64 = reversed ? source.frames - f : f - 1;
                let fb: i64 = reversed ? source.frames - 1 - f : f;
                let a: f32 = channels < 2 ? samples[fa] : (samples[fa * channels] + samples[fa * channels + 1]) * 0.5f;
                let b: f32 = channels < 2 ? samples[fb] : (samples[fb * channels] + samples[fb * channels + 1]) * 0.5f;
                if (a <= 0.0f && b > 0.0f) || (a >= 0.0f && b < 0.0f) { return f; }
            }
        }
        return frame;
    }
    /// Crossfade of sample slot `s` in frames, clamped as the plugin clamps it:
    /// to the loop length and to the frames before the loop start. 0 unless
    /// the loop is forward.
    fn crossfade_frames(output: AudioController, slot: i32, s: i32, frames: i64) -> i64 {
        if i32(std::math::floor(SamplerView::value(output, slot, s, 7) * 2.0 + 0.5)) != 1 { return 0; }
        let value: f64 = SamplerView::value(output, slot, s, 10);
        if value <= 0.0 { return 0; }
        var length: i64 = wide(i32(std::math::floor(value * f64(frames))));
        let start: i64 = SamplerView::loop_frame(output, slot, s, false, frames);
        let end: i64 = SamplerView::loop_frame(output, slot, s, true, frames);
        if length > end - start { length = end - start; }
        if length > start { length = start; }
        return length < 0 ? 0 : length;
    }
    /// Frames the wave view shows: the whole sample, halved per zoom step.
    fn span(self: SamplerView, frames: i64) -> i64 {
        var span: i64 = frames;
        for _z in 0..self.zoom { span = span / 2; }
        return span < 16 ? (frames < 16 ? frames : 16) : span;
    }
    /// First frame the wave view shows: the span centred on the marker.
    fn window_start(self: SamplerView, frames: i64, marker_frame: i64) -> i64 {
        let span: i64 = self.span(frames);
        var start: i64 = marker_frame - span / 2;
        if start > frames - span { start = frames - span; }
        return start < 0 ? 0 : start;
    }
    /// Wave view keys; -1 when the key is not one of them (the table's keys
    /// then apply: j/k slot, Enter, Backspace, o). 6 = no waveform to edit.
    fn wave_event(self: &mut Self, event: InputEvent, output: AudioController, slot: i32, clip: &AudioClip, has_clip: bool) -> i32 {
        let left: bool = (event.kind == InputKind::Menu && event.key == Key::Left) || (event.code == 104 && event.modifiers == 1);
        let right: bool = (event.kind == InputKind::Menu && event.key == Key::Right) || (event.code == 108 && event.modifiers == 1);
        let fine_left: bool = (event.code == 72 && event.modifiers == 1) || (event.code == 104 && event.modifiers == 2);
        let fine_right: bool = (event.code == 76 && event.modifiers == 1) || (event.code == 108 && event.modifiers == 2);
        let zoom_in: bool = event.code == 61 || event.code == 43;
        let zoom_out: bool = event.code == 45 && event.modifiers == 1;
        let toggle: bool = event.code == 109 && event.modifiers == 1;
        let snap: bool = event.code == 122 && event.modifiers == 1;
        let shorter: bool = event.code == 91 && event.modifiers == 1;
        let longer: bool = event.code == 93 && event.modifiers == 1;
        if !(left || right || fine_left || fine_right || zoom_in || zoom_out || toggle || snap || shorter || longer) { return -1; }
        if toggle { self.marker = (self.marker + 1) % 3; return 1; }
        if zoom_out { if self.zoom > 0 { self.zoom = self.zoom - 1; } return 1; }
        if zoom_in { if self.zoom < 20 { self.zoom = self.zoom + 1; } return 1; }
        if slot < 1 || !has_clip { return 6; }
        var source: AudioClip = AudioClip {}; source = clip;
        let frames: i64 = source.frames;
        if frames < 2 { return 6; }
        var probe: AudioClip = AudioClip {}; probe = source;
        if shorter || longer {
            // [ and ] change the crossfade by one dot of the waveform.
            let index: i32 = SamplerView::parameter_index(output, slot, SamplerView::column_id(self.slot, 10));
            if index < 0 { return 0; }
            let dots: i64 = self.dots > 0 ? wide(self.dots) : 160;
            var step: i64 = self.span(frames) / dots; if step < 1 { step = 1; }
            var length: i64 = SamplerView::crossfade_frames(output, slot, self.slot, frames) + (longer ? step : 0 - step);
            if length < 0 { length = 0; }
            let value: f64 = length == 0 ? 0.0 : (f64(length) + 0.5) / f64(frames);
            return output.set_parameter(slot, index, value > 1.0 ? 1.0 : value) == 0 ? 1 : 0;
        }
        let end: bool = self.marker == 1;
        let marker_col: i32 = SamplerView::marker_column(self.marker);
        let current: i64 = SamplerView::frame_at(output, slot, self.slot, marker_col, frames);
        var target: i64 = current;
        if snap { target = SamplerView::zero_crossing(probe, current, SamplerView::value(output, slot, self.slot, 111) >= 0.5); }
        else {
            // One dot of the waveform, or one frame with Shift.
            let dots: i64 = self.dots > 0 ? wide(self.dots) : 160;
            var step: i64 = fine_left || fine_right ? 1 : self.span(frames) / dots;
            if step < 1 { step = 1; }
            target = left || fine_left ? current - step : current + step;
        }
        if self.marker == 2 {
            // The sample start: anywhere in the sample.
            if target < 0 { target = 0; } if target > frames - 1 { target = frames - 1; }
        } else {
            // The loop keeps at least two frames.
            let other: i64 = SamplerView::loop_frame(output, slot, self.slot, !end, frames);
            if end { if target < other + 2 { target = other + 2; } if target > frames { target = frames; } }
            else { if target > other - 2 { target = other - 2; } if target < 0 { target = 0; } }
        }
        if target == current { return 0; }
        return SamplerView::set_frame(output, slot, self.slot, marker_col, target, frames) ? 1 : 0;
    }
    /// Key that auditions the selected slot at its recorded pitch: a pad's
    /// key, or a zone's root (moved into the zone when it lies outside, as
    /// the zone would not play it). -1 when unknown. Other slots whose key or
    /// zone holds that key sound with it.
    pub fn audition_key(self: SamplerView, output: AudioController, slot: i32) -> i32 {
        if slot < 1 { return -1; }
        if SamplerView::is_zone(output, slot, self.slot) {
            let low: i32 = SamplerView::key_of(SamplerView::value(output, slot, self.slot, 1));
            let high: i32 = SamplerView::key_of(SamplerView::value(output, slot, self.slot, 2));
            let root: i32 = SamplerView::key_of(SamplerView::value(output, slot, self.slot, 3));
            let bottom: i32 = low < high ? low : high; let top: i32 = low < high ? high : low;
            return root < bottom ? bottom : (root > top ? top : root);
        }
        let root: i64 = output.instrument_sampler(slot, 0);
        let key: i32 = root < 0 ? -1 : i32(root) + self.slot;
        return key > 127 ? -1 : key;
    }
    /// Velocity that auditions the selected slot: 100, moved into the slot's
    /// velocity range so the slot answers it.
    pub fn audition_velocity(self: SamplerView, output: AudioController, slot: i32) -> i32 {
        let low: i32 = SamplerView::key_of(SamplerView::value(output, slot, self.slot, 5));
        let high: i32 = SamplerView::key_of(SamplerView::value(output, slot, self.slot, 6));
        let bottom: i32 = low < high ? low : high; let top: i32 = low < high ? high : low;
        let velocity: i32 = 100 < bottom ? bottom : (100 > top ? top : 100);
        return velocity < 1 ? 1 : velocity;
    }
    /// Start an audition note, or keep a held one sounding on a key repeat.
    /// Returns the note to start, or -1 when it only extended the held one.
    pub fn audition(self: &mut Self, note: i32, target: i64, now: i64) -> i32 {
        self.audition_until = now + 400;
        if self.audition_note >= 0 { return -1; }
        self.audition_note = note; self.audition_target = target;
        return note;
    }
    /// The held audition note when it should end now: on the key's release
    /// (`released`), when the pane is hidden, or once the key stopped
    /// repeating on a terminal without key releases. -1 otherwise. Clears it.
    pub fn audition_due(self: &mut Self, now: i64, released: bool) -> i32 {
        if self.audition_note < 0 { return -1; }
        if released { self.releases_seen = true; }
        if !released && self.visible && (self.releases_seen || now < self.audition_until) { return -1; }
        let note: i32 = self.audition_note; self.audition_note = -1;
        return note;
    }
    /// Output bus (0 = Main, 1-7 = Out 2-8) of the selected slot, or -1.
    pub fn output_bus(self: SamplerView, output: AudioController, slot: i32) -> i32 {
        let value: f64 = SamplerView::value(output, slot, self.slot, 11);
        return value < 0.0 ? -1 : i32(std::math::floor(value * 7.0 + 0.5));
    }
    /// Pane title, e.g. " Sampler | Mla Sampler #2 | Groups: Round-robin ".
    pub fn title(self: SamplerView, output: AudioController, slot: i32) -> str8 {
        if slot < 1 { return clone(" Sampler "); }
        let index: i32 = SamplerView::parameter_index(output, slot, 950);
        let random: bool = index >= 0 && output.parameter_info(slot, index, 2) >= 0.5;
        return format!(" Sampler | {} #{} | Groups: {} ", output.instrument_name(slot), slot, random ? "Random" : "Round-robin");
    }
    /// Width of a column; the sample name takes the space left over.
    fn width(col: i32) -> i32 {
        if col == 4 || col == 5 || col == 6 { return 4; }
        if col < 4 { return 5; }
        if col == 7 || col == 10 { return 6; }
        if col == 11 { return 10; }
        return 7;
    }
    /// Left edge of a column: the key and velocity columns, the sample name,
    /// then the rest.
    fn column_x(area: Rect, col: i32, name_width: i32) -> i32 {
        var x: i32 = area.x + 1;
        for c in 0..col { x = x + SamplerView::width(i32(c)); if c == 6 { x = x + name_width; } }
        return x;
    }
    /// Paints into the pane's inner area: one row per slot (key mode and zone,
    /// sample name, loop mode, loop start/end, output), a key help line and
    /// `status` on the last row. `names[s]` is the session sample in slot `s`
    /// ("" when unknown), `routes[b]` where output bus `b` goes ("MAIN",
    /// "MST", "A3"; unused for Main); `slot` is the Mla Sampler instrument
    /// slot or 0. A pad slot shows its key under Low.
    pub fn paint(self: &mut Self, surface: Surface, area: Rect, theme: Theme, output: AudioController, slot: i32, names: &list<str8>, routes: &list<str8>, clip: &AudioClip, has_clip: bool, status: str8) -> void {
        if area.width < 20 || area.height < 3 { return; }
        let help_y: i32 = area.y + area.height - 2;
        surface.text(Rect::new(area.x, area.y + area.height - 1, area.width, 1), status, theme.foreground, theme.panel);
        if slot < 1 {
            surface.text(Rect::new(area.x, area.y, area.width, 1), "Select an Instrument track playing Mla Sampler", theme.muted, theme.panel);
            surface.text(Rect::new(area.x, help_y, area.width, 1), "Track > Create Instrument track, Instrument > Add instrument: MlaSampler.vst3 | Shift+S hide", theme.muted, theme.panel);
            return;
        }
        var labels: list<str8> = []; labels = names;
        var destinations: list<str8> = []; destinations = routes;
        if self.wave { self.paint_wave(surface, area, theme, output, slot, labels, clip, has_clip); return; }
        // Typed lists: a bare integer list literal would be i64.
        if self.page == 1 {
            let widths: list<i32> = [7, 5, 6, 5, 7, 7, 5, 7, 7, 4, 4, 4];
            self.paint_columns(surface, area, theme, output, slot, labels, widths,
                ["Level", "Pan", "Tune", "Env", "Atk", "Dec", "Sus%", "Rel", "Ofs%", "Grp", "Chk", "Rev"],
                "j/k slot  h/l col  J/K [ ] adjust  G group mode  e filter  w wave  p play  Enter load");
            return;
        }
        if self.page == 3 || self.page == 4 {
            let widths: list<i32> = [6, 7, 5, 6, 6, 6, 5, 5, 6];
            self.paint_columns(surface, area, theme, output, slot, labels, widths,
                ["Shape", "Rate", "Sync", "Div", "Delay", "Pitch", "Cut", "Lvl%", "Trig"],
                self.page == 3 ? "LFO 1 | j/k slot  h/l col  J/K [ ] adjust  e lfo 2  w wave  p play  Enter load"
                    : "LFO 2 | j/k slot  h/l col  J/K [ ] adjust  e mod  w wave  p play  Enter load");
            return;
        }
        if self.page == 5 {
            let widths: list<i32> = [6, 6, 6, 6, 6, 6, 6, 6, 6, 6, 6, 6];
            self.paint_columns(surface, area, theme, output, slot, labels, widths,
                ["Src1", "Tgt1", "Amt1", "Src2", "Tgt2", "Amt2", "Src3", "Tgt3", "Amt3", "Src4", "Tgt4", "Amt4"],
                "Mod | j/k slot  h/l col  J/K [ ] adjust  e keys & loops  w wave  p play  Enter load");
            return;
        }
        if self.page == 2 {
            let widths: list<i32> = [6, 6, 4, 5, 4, 5, 6, 6, 4, 5, 4, 5, 5, 6, 6, 5, 6];
            self.paint_columns(surface, area, theme, output, slot, labels, widths,
                ["F1", "Cut", "Res", "Env", "Key", "Gain", "F2", "Cut", "Res", "Env", "Key", "Gain", "FEnv", "Atk", "Dec", "Sus%", "Rel"],
                "j/k slot  h/l col  J/K [ ] adjust  e lfo 1  w wave  p play  Enter load  Bksp clear");
            return;
        }
        let root: i64 = output.instrument_sampler(slot, 0);
        let occupied: i64 = output.instrument_sampler(slot, 2);
        var fixed: i32 = 1;
        for c in 0..12 { fixed = fixed + SamplerView::width(i32(c)); }
        let name_width: i32 = area.width - fixed > 8 ? area.width - fixed : 8;
        let headings: array<str8, 12> = {"Mode", "Low", "High", "Root", "Trk", "VLo", "VHi", "Loop", "Start%", "End%", "Xf%", "Out"};
        for c in 0..12 {
            let col: i32 = i32(c);
            surface.text(Rect::new(SamplerView::column_x(area, col, name_width), area.y, SamplerView::width(col), 1), headings[c],
                col == self.column ? theme.accent : theme.muted, theme.panel);
        }
        surface.text(Rect::new(SamplerView::column_x(area, 7, name_width) - name_width, area.y, name_width, 1), "Sample", theme.muted, theme.panel);
        let rows: i32 = area.height - 3;
        if rows < 1 { return; }
        if self.slot < self.scroll { self.scroll = self.slot; }
        if self.slot >= self.scroll + rows { self.scroll = self.slot - rows + 1; }
        for r in 0..rows {
            let s: i32 = self.scroll + i32(r);
            if s >= 16 { break; }
            let y: i32 = area.y + 1 + i32(r);
            let selected: bool = s == self.slot;
            let background: i32 = selected ? theme.selection : theme.panel;
            surface.fill(Rect::new(area.x, y, area.width, 1), Cell { glyph: 32, foreground: theme.foreground, background: background });
            let zone: bool = SamplerView::is_zone(output, slot, s);
            for c in 0..12 {
                let col: i32 = i32(c);
                let value: f64 = SamplerView::value(output, slot, s, col);
                var text: str8 = clone("-");
                var dim: bool = false;
                if col == 1 && !zone { free(text); text = root >= 0 ? piano_note_name(i32(root) + s) : clone("-"); }
                else if col >= 2 && col <= 4 && !zone { dim = true; }
                else { free(text); text = SamplerView::field_text(col, value); }
                // An aux bus routed away from Main shows where: "Out 2>A3".
                let bus: i32 = col == 11 && value >= 0.0 ? i32(std::math::floor(value * 7.0 + 0.5)) : 0;
                if bus > 0 && bus < destinations.len() && destinations[bus] != "MAIN" {
                    let routed: str8 = format!("{}>{}", text, destinations[bus]); free(text); text = routed;
                }
                let focused: bool = selected && col == self.column;
                surface.text(Rect::new(SamplerView::column_x(area, col, name_width), y, SamplerView::width(col) - 1, 1), text,
                    focused ? theme.accent : (dim ? theme.muted : theme.foreground), background);
                free(text);
            }
            let loaded: bool = occupied >= 0 && ((occupied >> wide(s)) & 1) == 1;
            let label: str8 = s < labels.len() ? labels[s] : "";
            let name: str8 = loaded ? (label != "" ? label : "(loaded)") : "(empty)";
            surface.text(Rect::new(SamplerView::column_x(area, 7, name_width) - name_width, y, name_width - 1, 1), name,
                loaded ? theme.foreground : theme.muted, background);
        }
        surface.text(Rect::new(area.x, help_y, area.width, 1),
            "j/k slot  h/l col  J/K [ ] adjust  e sound  w wave  p play  Enter load  Bksp clear  o route", theme.muted, theme.panel);
    }
    /// Wave view: a summary line, the selected slot's waveform with the loop
    /// region highlighted and its start/end markers, and a key help line.
    /// `clip` is the slot's session sample when `has_clip`.
    fn paint_wave(self: &mut Self, surface: Surface, area: Rect, theme: Theme, output: AudioController, slot: i32, labels: &list<str8>, clip: &AudioClip, has_clip: bool) -> void {
        var names: list<str8> = []; names = labels;
        let help_y: i32 = area.y + area.height - 2;
        surface.text(Rect::new(area.x, help_y, area.width, 1),
            "m start/end/ofs  h/l dot  H/L frame  z zero  [ ] xfade  -/= zoom  j/k slot  p play  w table", theme.muted, theme.panel);
        let label: str8 = self.slot < names.len() ? names[self.slot] : "";
        var source: AudioClip = AudioClip {}; if has_clip { source = clip; }
        if !has_clip || source.frames < 2 {
            let why: str8 = format!("Slot {}: {}", self.slot + 1, label != "" ? "no waveform (not in the Audio list)" : "empty - Enter loads a sample");
            surface.text(Rect::new(area.x, area.y, area.width, 1), why, theme.muted, theme.panel); free(why);
            return;
        }
        let frames: i64 = source.frames;
        let samples: list<f32> = source.samples; let channels: i64 = source.channels;
        let reversed: bool = SamplerView::value(output, slot, self.slot, 111) >= 0.5;
        let start_frame: i64 = SamplerView::loop_frame(output, slot, self.slot, false, frames);
        let end_frame: i64 = SamplerView::loop_frame(output, slot, self.slot, true, frames);
        let mode: str8 = SamplerView::field_text(7, SamplerView::value(output, slot, self.slot, 7));
        let crossfade: i64 = SamplerView::crossfade_frames(output, slot, self.slot, frames);
        let offset_frame: i64 = SamplerView::frame_at(output, slot, self.slot, 108, frames);
        let info: str8 = format!("Slot {} {} | Loop {} | {}Start {}{} {}End {}{} | Len {}/{} | Xfade {} | {}Ofs {}{} | Zoom {}x",
            self.slot + 1, label, mode, self.marker == 0 ? "[" : "", start_frame, self.marker == 0 ? "]" : "",
            self.marker == 1 ? "[" : "", end_frame, self.marker == 1 ? "]" : "", end_frame - start_frame, frames, crossfade,
            self.marker == 2 ? "[" : "", offset_frame, self.marker == 2 ? "]" : "", 1 << self.zoom);
        surface.text(Rect::new(area.x, area.y, area.width, 1), info, theme.foreground, theme.panel);
        free(info); free(mode);
        let rows: i32 = area.height - 3;
        if rows < 1 || area.width < 4 { return; }
        let dot_rows: i32 = rows * 4;
        let columns: i32 = area.width * 2;
        self.dots = columns;
        let span: i64 = self.span(frames);
        let first: i64 = self.window_start(frames, self.marker == 1 ? end_frame : (self.marker == 2 ? offset_frame : start_frame));
        // Top and bottom dot row of each dot column, from its min and max.
        var tops: list<i32> = []; var bottoms: list<i32> = [];
        for px in 0..columns {
            let f0: i64 = first + span * wide(i32(px)) / wide(columns);
            var f1: i64 = first + span * (wide(i32(px)) + 1) / wide(columns);
            if f1 <= f0 { f1 = f0 + 1; }
            let stride: i64 = (f1 - f0) / 64 + 1;
            var low: f32 = 1.0f; var high: f32 = -1.0f;
            var f: i64 = f0;
            while f < f1 && f < frames {
                // A reversed slot's waveform is shown as it plays: mirrored.
                let fr: i64 = reversed ? frames - 1 - f : f;
                let v: f32 = channels < 2 ? samples[fr] : (samples[fr * channels] + samples[fr * channels + 1]) * 0.5f;
                if v < low { low = v; } if v > high { high = v; }
                f = f + stride;
            }
            if high < low { low = 0.0f; high = 0.0f; }
            if high > 1.0f { high = 1.0f; } if low < -1.0f { low = -1.0f; }
            tops.push(i32(std::math::floor(f64((1.0f - high) * 0.5f) * f64(dot_rows - 1) + 0.5)));
            bottoms.push(i32(std::math::floor(f64((1.0f - low) * 0.5f) * f64(dot_rows - 1) + 0.5)));
        }
        let left_bits: array<i32, 4> = {1, 2, 4, 64};
        let right_bits: array<i32, 4> = {8, 16, 32, 128};
        let start_x: i64 = (start_frame - first) * wide(area.width) / (span > 0 ? span : 1);
        let offset_x: i64 = offset_frame >= first && offset_frame < first + span ? (offset_frame - first) * wide(area.width) / (span > 0 ? span : 1) : -1;
        var end_x: i64 = (end_frame - first) * wide(area.width) / (span > 0 ? span : 1);
        // A loop ending at the window's right edge (e.g. the sample's end)
        // marks the last column.
        if end_x == wide(area.width) && end_frame == first + span { end_x = wide(area.width) - 1; }
        for r in 0..rows {
            let y: i32 = area.y + 1 + i32(r);
            for x in 0..area.width {
                var mask: i32 = 0;
                for dot in 0..4 {
                    let dy: i32 = i32(r) * 4 + i32(dot);
                    let a: i32 = i32(x) * 2; let b: i32 = a + 1;
                    if dy >= tops[a] && dy <= bottoms[a] { mask = mask + left_bits[dot]; }
                    if dy >= tops[b] && dy <= bottoms[b] { mask = mask + right_bits[dot]; }
                }
                let cell_frame: i64 = first + span * wide(i32(x)) / wide(area.width);
                let looped: bool = cell_frame >= start_frame && cell_frame < end_frame;
                // The crossfade region is shaded.
                let fading: bool = crossfade > 0 && cell_frame >= end_frame - crossfade && cell_frame < end_frame;
                let marker: bool = wide(i32(x)) == start_x || wide(i32(x)) == end_x;
                // The sample start is a dashed marker (under a loop marker
                // sharing its column).
                if wide(i32(x)) == offset_x && !marker {
                    surface.put(area.x + i32(x), y, Cell { glyph: 0x2506, foreground: self.marker == 2 ? theme.accent : theme.foreground, background: theme.panel });
                } else if marker {
                    let selected: bool = (self.marker == 0 && wide(i32(x)) == start_x) || (self.marker == 1 && wide(i32(x)) == end_x);
                    surface.put(area.x + i32(x), y, Cell { glyph: 0x2502, foreground: selected ? theme.accent : theme.foreground, background: theme.panel });
                } else if mask != 0 {
                    surface.put(area.x + i32(x), y, Cell { glyph: 0x2800 + mask, foreground: looped ? theme.accent : theme.muted, background: fading ? theme.selection : theme.panel });
                } else if fading {
                    surface.put(area.x + i32(x), y, Cell { glyph: 32, foreground: theme.foreground, background: theme.selection });
                }
            }
        }
    }
    /// The Sound and Filter pages: per slot its number, the page's columns
    /// (`widths`, `headings`; codes page * 100 + column), dim where
    /// `column_dim` says, then the sample name in what is left.
    fn paint_columns(self: &mut Self, surface: Surface, area: Rect, theme: Theme, output: AudioController, slot: i32,
        labels: &list<str8>, widths: list<i32>, headings: list<str8>, help: str8) -> void {
        var names: list<str8> = []; names = labels;
        let help_y: i32 = area.y + area.height - 2;
        surface.text(Rect::new(area.x, help_y, area.width, 1), help, theme.muted, theme.panel);
        let count: i32 = i32(widths.len());
        surface.text(Rect::new(area.x, area.y, 4, 1), " #", theme.muted, theme.panel);
        var x: i32 = area.x + 4;
        for c in 0..count {
            surface.text(Rect::new(x, area.y, widths[c], 1), headings[c], i32(c) == self.column ? theme.accent : theme.muted, theme.panel);
            x = x + widths[c];
        }
        if area.width - (x - area.x) > 6 { surface.text(Rect::new(x, area.y, area.width - (x - area.x), 1), "Sample", theme.muted, theme.panel); }
        let occupied: i64 = output.instrument_sampler(slot, 2);
        let rows: i32 = area.height - 3;
        if rows < 1 { return; }
        if self.slot < self.scroll { self.scroll = self.slot; }
        if self.slot >= self.scroll + rows { self.scroll = self.slot - rows + 1; }
        for r in 0..rows {
            let s: i32 = self.scroll + i32(r);
            if s >= 16 { break; }
            let y: i32 = area.y + 1 + i32(r);
            let selected: bool = s == self.slot;
            let background: i32 = selected ? theme.selection : theme.panel;
            surface.fill(Rect::new(area.x, y, area.width, 1), Cell { glyph: 32, foreground: theme.foreground, background: background });
            let number: str8 = format!(" {}", s + 1);
            surface.text(Rect::new(area.x, y, 4, 1), number, theme.muted, background); free(number);
            var cell_x: i32 = area.x + 4;
            for c in 0..count {
                let col: i32 = self.page * 100 + i32(c);
                let text: str8 = SamplerView::field_text(col, SamplerView::value(output, slot, s, col));
                let dim: bool = SamplerView::column_dim(output, slot, s, col);
                let focused: bool = selected && i32(c) == self.column;
                surface.text(Rect::new(cell_x, y, widths[c] - 1, 1), text, focused ? theme.accent : (dim ? theme.muted : theme.foreground), background);
                free(text);
                cell_x = cell_x + widths[c];
            }
            if area.width - (cell_x - area.x) > 6 {
                let loaded: bool = occupied >= 0 && ((occupied >> wide(s)) & 1) == 1;
                let label: str8 = s < names.len() ? names[s] : "";
                let name: str8 = loaded ? (label != "" ? label : "(loaded)") : "(empty)";
                surface.text(Rect::new(cell_x, y, area.width - (cell_x - area.x), 1), name, loaded ? theme.foreground : theme.muted, background);
            }
        }
    }
    /// Tenths as text, e.g. -35 -> "-3.5"; `plus` marks positive values.
    fn tenths_text(tenths: i32, plus: bool) -> str8 {
        let magnitude: i32 = tenths < 0 ? 0 - tenths : tenths;
        let sign: str8 = tenths < 0 ? "-" : (plus && tenths > 0 ? "+" : "");
        return format!("{}{}.{}", sign, magnitude / 10, magnitude % 10);
    }
    /// A duration in seconds as "35ms" or "1.2s".
    fn seconds_text(seconds: f64) -> str8 {
        let ms: i32 = i32(std::math::floor(seconds * 1000.0 + 0.5));
        if ms < 1000 { return format!("{}ms", ms); }
        return format!("{}s", SamplerView::tenths_text(i32(std::math::floor(seconds * 10.0 + 0.5)), false));
    }
    /// Owned display text of a column's normalized value.
    fn field_text(col: i32, value: f64) -> str8 {
        if value < 0.0 { return clone("-"); }
        // LFO 2's columns read as LFO 1's.
        if col >= 400 && col < 500 { return SamplerView::field_text(col - 100, value); }
        // Mod page: source and target names, and the amount in percent.
        if col >= 500 {
            let part: i32 = (col - 500) % 3;
            let index: i32 = i32(std::math::floor(value * 15.0 + 0.5));
            if part == 0 {
                let sources: array<str8, 7> = {"-", "LFO1", "LFO2", "AmpEn", "FltEn", "Veloc", "Key"};
                return index < 7 ? clone(sources[index]) : format!("#{}", index);
            }
            if part == 1 {
                let targets: array<str8, 7> = {"-", "Pitch", "Cut", "Reso", "Level", "Pan", "Start"};
                return index < 7 ? clone(targets[index]) : format!("#{}", index);
            }
            let percent: i32 = i32(std::math::floor((value * 2.0 - 1.0) * 100.0 + 0.5));
            return percent > 0 ? format!("+{}", percent) : format!("{}", percent);
        }
        // Sound page, as the plugin maps them (plugins/mla_sampler/src/plugin.cpp).
        if col == 100 {
            if value <= 0.0 { return clone("off"); }
            let db: str8 = SamplerView::tenths_text(i32(std::math::floor((value * 66.0 - 60.0) * 10.0 + 0.5)), true);
            return db;
        }
        if col == 101 {
            let percent: i32 = i32(std::math::floor((value * 2.0 - 1.0) * 100.0 + 0.5));
            return percent == 0 ? clone("C") : (percent < 0 ? format!("L{}", 0 - percent) : format!("R{}", percent));
        }
        if col == 102 { return SamplerView::tenths_text(i32(std::math::floor((value * 48.0 - 24.0) * 10.0 + 0.5)), true); }
        if col == 103 || col == 212 { return clone(value >= 0.5 ? "Own" : "Inst"); }
        if col == 111 { return clone(value >= 0.5 ? "On" : "Off"); }
        // LFO page, as the plugin maps them.
        if col == 300 {
            let shapes: array<str8, 6> = {"Sine", "Tri", "SawUp", "SawDn", "Sqr", "S&H"};
            let shape: i32 = i32(std::math::floor(value * 15.0 + 0.5));
            return shape < 6 ? clone(shapes[shape]) : format!("#{}", shape);
        }
        if col == 301 {
            let hz: f64 = 0.05 * std::math::pow(400.0, value);
            let cents: i32 = i32(std::math::floor(hz * 100.0 + 0.5));
            if cents < 100 { return format!("0.{}{}Hz", cents / 10, cents % 10); }
            return format!("{}Hz", SamplerView::tenths_text(i32(std::math::floor(hz * 10.0 + 0.5)), false));
        }
        if col == 302 { return clone(value >= 0.5 ? "On" : "Off"); }
        if col == 303 {
            let divisions: array<str8, 14> = {"1/1", "1/2", "1/4", "1/8", "1/16", "1/32", "1/2.", "1/4.", "1/8.", "1/16.",
                "1/2T", "1/4T", "1/8T", "1/16T"};
            let division: i32 = i32(std::math::floor(value * 15.0 + 0.5));
            return division < 14 ? clone(divisions[division]) : format!("#{}", division);
        }
        if col == 304 { return SamplerView::seconds_text(value * 2.0); }
        if col == 305 { return SamplerView::tenths_text(i32(std::math::floor((value * 2.0 - 1.0) * 120.0 + 0.5)), true); }
        if col == 306 { return SamplerView::tenths_text(i32(std::math::floor((value * 2.0 - 1.0) * 40.0 + 0.5)), true); }
        if col == 307 { return format!("{}", i32(std::math::floor(value * 100.0 + 0.5))); }
        if col == 308 { return clone(value >= 0.5 ? "Retrg" : "Free"); }
        // Filter page, as the plugin maps them.
        if col == 200 || col == 206 {
            let names: array<str8, 22> = {"Off", "LP12", "LP24", "HP12", "HP24", "BP12", "BP24", "Ldr12", "Ldr24", "Notch",
                "SvLP", "SvHP", "SvBP", "SvNt", "Peak", "LoShf", "HiShf", "Vowel", "Comb+", "Comb-", "Flang", "Phasr"};
            let kind: i32 = i32(std::math::floor(value * 63.0 + 0.5));
            return kind < 22 ? clone(names[kind]) : format!("#{}", kind);
        }
        if col == 201 || col == 207 {
            let hz: f64 = 20.0 * std::math::pow(1000.0, value);
            if hz < 1000.0 { return format!("{}", i32(std::math::floor(hz + 0.5))); }
            let tenths: i32 = i32(std::math::floor(hz / 100.0 + 0.5));
            return format!("{}.{}k", tenths / 10, tenths % 10);
        }
        if col == 202 || col == 208 { return format!("{}", i32(std::math::floor(value * 36.0 + 0.5))); }
        if col == 203 || col == 209 { return SamplerView::tenths_text(i32(std::math::floor((value * 2.0 - 1.0) * 80.0 + 0.5)), true); }
        if col == 204 || col == 210 { return format!("{}", i32(std::math::floor(value * 100.0 + 0.5))); }
        if col == 205 || col == 211 { return SamplerView::tenths_text(i32(std::math::floor((value * 2.0 - 1.0) * 240.0 + 0.5)), true); }
        if col == 213 { return SamplerView::seconds_text(2.0 * value * value * value); }
        if col == 214 || col == 216 { return SamplerView::seconds_text(0.001 * std::math::pow(10000.0, value)); }
        if col == 215 { return format!("{}", i32(std::math::floor(value * 100.0 + 0.5))); }
        if col == 109 || col == 110 {
            let group: i32 = i32(std::math::floor(value * 8.0 + 0.5));
            return group == 0 ? clone("-") : format!("{}", group);
        }
        if col == 104 { return SamplerView::seconds_text(2.0 * value * value * value); }
        if col == 105 || col == 107 { return SamplerView::seconds_text(0.001 * std::math::pow(10000.0, value)); }
        if col == 106 { return format!("{}", i32(std::math::floor(value * 100.0 + 0.5))); }
        if col == 0 { return clone(value >= 0.5 ? "Zone" : "Pad"); }
        if col >= 1 && col <= 3 { return piano_note_name(SamplerView::key_of(value)); }
        if col == 4 { return clone(value >= 0.5 ? "On" : "Off"); }
        if col == 5 || col == 6 { return format!("{}", SamplerView::key_of(value)); }
        if col == 7 {
            let mode: i32 = i32(std::math::floor(value * 2.0 + 0.5));
            return clone(mode == 1 ? "Fwd" : (mode == 2 ? "Bidir" : "Off"));
        }
        if col == 11 {
            let bus: i32 = i32(std::math::floor(value * 7.0 + 0.5));
            return bus == 0 ? clone("Main") : format!("Out {}", bus + 1);
        }
        let tenths: i32 = i32(std::math::floor(value * 1000.0 + 0.5));
        return format!("{}.{}", tenths / 10, tenths % 10);
    }
}
