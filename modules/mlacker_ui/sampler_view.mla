mod std::audio::controller;
use tui::geometry::*;
use tui::surface::*;
use tui::theme::*;
use tui::input::*;
use tui::menu::Key;
use tui::menu::function_number;
use tui::piano::piano_note_name;
use std::audio::controller::AudioController;
use std::strbuf::clone;
use std::strbuf::free;

// Mla Sampler's layout (plugins/mla_sampler/src/plugin.cpp): 16 slots and 8
// outputs. Slot `s` parameter IDs are 200 + 7s + field (level, pan, tune,
// output, loop, loop start, loop end) and 400 + 5s + field for its key zone
// (mode, low key, high key, zone root, key track).

/// Mla Sampler editor in the Pattern view's bottom pane (View menu / Shift+S),
/// sharing it with the virtual keyboard. It edits the instance on the selected
/// Instrument track through its VST3 parameters, so its edits are saved with
/// the session and the plugin state like any parameter. While the pane is
/// focused it keeps the keys for itself (see `handles`).
pub struct SamplerView {
    var visible: bool;
    /// Selected slot 0-15, first slot shown, and the selected column: 0 key
    /// mode, 1 low key, 2 high key, 3 zone root, 4 key track, 5 loop mode,
    /// 6 loop start, 7 loop end, 8 output.
    var slot: i32; var column: i32; var scroll: i32;
};
impl SamplerView {
    /// Keys the focused pane keeps for itself: everything printable ("q"
    /// included), Enter, Backspace and the arrows. Pane moves, Tab, F-keys,
    /// Escape, control shortcuts, Space (transport) and the Shift+S / Shift+M
    /// / Shift+P view toggles still reach the application.
    pub fn handles(event: InputEvent) -> bool {
        if event.kind == InputKind::None || event.kind == InputKind::Pane { return false; }
        if event.modifiers != 1 && event.modifiers != 2 { return false; }
        if event.kind == InputKind::Menu && (event.key == Key::Toggle || event.key == Key::Escape || function_number(event.key) > 0) { return false; }
        if event.code == 32 || event.code == 77 || event.code == 80 || event.code == 83 { return false; }
        if event.modifiers == 2 && (event.code == 109 || event.code == 112 || event.code == 115) { return false; }
        if event.code == 13 || event.code == 10 || event.code == 8 || event.code == 127 { return true; }
        return event.code == 0 || event.code >= 33;
    }
    /// Instrument slot (1-32) of a loaded Mla Sampler, or 0 when `slot` holds
    /// something else.
    pub fn target(output: AudioController, slot: i32) -> i32 {
        if slot < 1 || output.instrument_sampler(slot, 1) < 0 { return 0; }
        let name: str8 = output.instrument_name(slot);
        return name == "Mla Sampler" ? slot : 0;
    }
    /// Parameter index of stable ID `id` in instrument `slot`, or -1.
    fn parameter_index(output: AudioController, slot: i32, id: i32) -> i32 {
        let count: i32 = i32(output.parameter_info(slot, 0, 0));
        for i in 0..count {
            if i32(output.parameter_info(slot, i, 4)) == id { return i32(i); }
        }
        return -1;
    }
    /// Parameter ID of a column (see `column`) of sample slot `s`.
    fn column_id(s: i32, col: i32) -> i32 {
        if col < 5 { return 400 + s * 5 + col; }
        if col == 8 { return 200 + s * 7 + 3; }
        return 200 + s * 7 + col - 1;
    }
    /// Normalized value of a slot's column, or -1 when the plugin lacks it.
    fn value(output: AudioController, slot: i32, s: i32, col: i32) -> f64 {
        let index: i32 = SamplerView::parameter_index(output, slot, SamplerView::column_id(s, col));
        return index < 0 ? -1.0 : output.parameter_info(slot, index, 2);
    }
    fn key_of(value: f64) -> i32 { return i32(std::math::floor(value * 127.0 + 0.5)); }
    fn is_zone(output: AudioController, slot: i32, s: i32) -> bool { return SamplerView::value(output, slot, s, 0) >= 0.5; }
    /// Steps the selected column by `delta`: choices by one, keys by a
    /// semitone, loop points by 1%. `big` steps keys by an octave and loop
    /// points by 10%. The low key stays at or below the high key and the loop
    /// start below the loop end. False when nothing changed.
    fn adjust(self: SamplerView, output: AudioController, slot: i32, delta: i32, big: bool) -> bool {
        let col: i32 = self.column;
        let index: i32 = SamplerView::parameter_index(output, slot, SamplerView::column_id(self.slot, col));
        if index < 0 { return false; }
        let steps: f64 = output.parameter_info(slot, index, 1);
        let normalized: f64 = output.parameter_info(slot, index, 2);
        var value: f64 = 0.0;
        if steps > 0.0 {
            let current: f64 = std::math::floor(normalized * steps + 0.5);
            let key_column: bool = col >= 1 && col <= 3;
            value = current + f64(delta) * (big && key_column ? 12.0 : 1.0);
            if col == 1 { let high: f64 = f64(SamplerView::key_of(SamplerView::value(output, slot, self.slot, 2))); if value > high { value = high; } }
            if col == 2 { let low: f64 = f64(SamplerView::key_of(SamplerView::value(output, slot, self.slot, 1))); if value < low { value = low; } }
            if value < 0.0 { value = 0.0; }
            if value > steps { value = steps; }
            if value == current { return false; }
        } else {
            value = normalized + f64(delta) * (big ? 0.1 : 0.01);
            if col == 6 {
                let end: f64 = SamplerView::value(output, slot, self.slot, 7);
                if value > end - 0.01 { value = end - 0.01; }
            }
            if col == 7 {
                let start: f64 = SamplerView::value(output, slot, self.slot, 6);
                if value < start + 0.01 { value = start + 0.01; }
            }
            if value < 0.0 { value = 0.0; }
            if value > 1.0 { value = 1.0; }
            if value == normalized { return false; }
        }
        return output.set_parameter(slot, index, value) == 0;
    }
    /// A key press while the pane is focused. `slot` is the Mla Sampler
    /// instrument slot (0 when the selected track has none). Returns what the
    /// application should do for the selected slot: 0 nothing, 1 repaint,
    /// 2 load a file into it, 3 clear it, 4 route its output bus, 5 tell that
    /// its zone columns need Zone mode. (An i32 rather than an enum: MLang
    /// before its let-enum fix ran an enum `let` initializer twice.)
    pub fn on_event(self: &mut Self, event: InputEvent, output: AudioController, slot: i32) -> i32 {
        let up: bool = (event.kind == InputKind::Menu && event.key == Key::Up) || (event.code == 107 && event.modifiers == 1);
        let down: bool = (event.kind == InputKind::Menu && event.key == Key::Down) || (event.code == 106 && event.modifiers == 1);
        let left: bool = (event.kind == InputKind::Menu && event.key == Key::Left) || (event.code == 104 && event.modifiers == 1);
        let right: bool = (event.kind == InputKind::Menu && event.key == Key::Right) || (event.code == 108 && event.modifiers == 1);
        if up && self.slot > 0 { self.slot = self.slot - 1; return 1; }
        if down && self.slot < 15 { self.slot = self.slot + 1; return 1; }
        if left && self.column > 0 { self.column = self.column - 1; return 1; }
        if right && self.column < 8 { self.column = self.column + 1; return 1; }
        if slot < 1 { return 0; }
        // Shift+J/K adjust, as everywhere else in the tracker; [ and ] take
        // octave / 10% steps.
        let lower: bool = (event.code == 74 && event.modifiers == 1) || (event.code == 106 && event.modifiers == 2);
        let raise: bool = (event.code == 75 && event.modifiers == 1) || (event.code == 107 && event.modifiers == 2);
        let big_lower: bool = event.code == 91 && event.modifiers == 1;
        let big_raise: bool = event.code == 93 && event.modifiers == 1;
        if lower || raise || big_lower || big_raise {
            if self.column >= 1 && self.column <= 4 && !SamplerView::is_zone(output, slot, self.slot) { return 5; }
            return self.adjust(output, slot, raise || big_raise ? 1 : -1, big_lower || big_raise) ? 1 : 0;
        }
        if event.kind == InputKind::Menu && event.key == Key::Enter { return 2; }
        if event.code == 13 || event.code == 10 { return 2; }
        if event.code == 127 || event.code == 8 || (event.kind == InputKind::Menu && event.key == Key::Backspace) { return 3; }
        if event.code == 111 && event.modifiers == 1 { return 4; }
        return 0;
    }
    /// Output bus (0 = Main, 1-7 = Out 2-8) of the selected slot, or -1.
    pub fn output_bus(self: SamplerView, output: AudioController, slot: i32) -> i32 {
        let value: f64 = SamplerView::value(output, slot, self.slot, 8);
        return value < 0.0 ? -1 : i32(std::math::floor(value * 7.0 + 0.5));
    }
    /// Pane title, e.g. " Sampler | Mla Sampler #2 ".
    pub fn title(self: SamplerView, output: AudioController, slot: i32) -> str8 {
        if slot < 1 { return clone(" Sampler "); }
        return format!(" Sampler | {} #{} ", output.instrument_name(slot), slot);
    }
    /// Width of a column; the sample name takes the space left over.
    fn width(col: i32) -> i32 {
        if col == 4 { return 4; }
        if col < 5 { return 5; }
        if col == 5 { return 6; }
        if col == 8 { return 10; }
        return 7;
    }
    /// Left edge of a column: the key columns, the sample name, then the rest.
    fn column_x(area: Rect, col: i32, name_width: i32) -> i32 {
        var x: i32 = area.x + 1;
        for c in 0..col { x = x + SamplerView::width(i32(c)); if c == 4 { x = x + name_width; } }
        return x;
    }
    /// Paints into the pane's inner area: one row per slot (key mode and zone,
    /// sample name, loop mode, loop start/end, output), a key help line and
    /// `status` on the last row. `names[s]` is the session sample in slot `s`
    /// ("" when unknown), `routes[b]` where output bus `b` goes ("MAIN",
    /// "MST", "A3"; unused for Main); `slot` is the Mla Sampler instrument
    /// slot or 0. A pad slot shows its key under Low.
    pub fn paint(self: &mut Self, surface: Surface, area: Rect, theme: Theme, output: AudioController, slot: i32, names: &list<str8>, routes: &list<str8>, status: str8) -> void {
        if area.width < 20 || area.height < 3 { return; }
        let help_y: i32 = area.y + area.height - 2;
        surface.text(Rect::new(area.x, area.y + area.height - 1, area.width, 1), status, theme.foreground, theme.panel);
        if slot < 1 {
            surface.text(Rect::new(area.x, area.y, area.width, 1), "Select an Instrument track playing Mla Sampler", theme.muted, theme.panel);
            surface.text(Rect::new(area.x, help_y, area.width, 1), "Track > Create Instrument track, Instrument > Add instrument: MlaSampler.vst3 | Shift+S hide", theme.muted, theme.panel);
            return;
        }
        var labels: list<str8> = []; labels = names;
        var destinations: list<str8> = []; destinations = routes;
        let root: i64 = output.instrument_sampler(slot, 0);
        let occupied: i64 = output.instrument_sampler(slot, 2);
        var fixed: i32 = 1;
        for c in 0..9 { fixed = fixed + SamplerView::width(i32(c)); }
        let name_width: i32 = area.width - fixed > 8 ? area.width - fixed : 8;
        let headings: array<str8, 9> = {"Mode", "Low", "High", "Root", "Trk", "Loop", "Start%", "End%", "Out"};
        for c in 0..9 {
            let col: i32 = i32(c);
            surface.text(Rect::new(SamplerView::column_x(area, col, name_width), area.y, SamplerView::width(col), 1), headings[c],
                col == self.column ? theme.accent : theme.muted, theme.panel);
        }
        surface.text(Rect::new(SamplerView::column_x(area, 5, name_width) - name_width, area.y, name_width, 1), "Sample", theme.muted, theme.panel);
        let rows: i32 = area.height - 3;
        if rows < 1 { return; }
        if self.slot < self.scroll { self.scroll = self.slot; }
        if self.slot >= self.scroll + rows { self.scroll = self.slot - rows + 1; }
        for r in 0..rows {
            let s: i32 = self.scroll + i32(r);
            if s >= 16 { break; }
            let y: i32 = area.y + 1 + i32(r);
            let selected: bool = s == self.slot;
            let background: i32 = selected ? theme.selection : theme.panel;
            surface.fill(Rect::new(area.x, y, area.width, 1), Cell { glyph: 32, foreground: theme.foreground, background: background });
            let zone: bool = SamplerView::is_zone(output, slot, s);
            for c in 0..9 {
                let col: i32 = i32(c);
                let value: f64 = SamplerView::value(output, slot, s, col);
                var text: str8 = clone("-");
                var dim: bool = false;
                if col == 1 && !zone { free(text); text = root >= 0 ? piano_note_name(i32(root) + s) : clone("-"); }
                else if col >= 2 && col <= 4 && !zone { dim = true; }
                else { free(text); text = SamplerView::field_text(col, value); }
                // An aux bus routed away from Main shows where: "Out 2>A3".
                let bus: i32 = col == 8 && value >= 0.0 ? i32(std::math::floor(value * 7.0 + 0.5)) : 0;
                if bus > 0 && bus < destinations.len() && destinations[bus] != "MAIN" {
                    let routed: str8 = format!("{}>{}", text, destinations[bus]); free(text); text = routed;
                }
                let focused: bool = selected && col == self.column;
                surface.text(Rect::new(SamplerView::column_x(area, col, name_width), y, SamplerView::width(col) - 1, 1), text,
                    focused ? theme.accent : (dim ? theme.muted : theme.foreground), background);
                free(text);
            }
            let loaded: bool = occupied >= 0 && ((occupied >> wide(s)) & 1) == 1;
            let label: str8 = s < labels.len() ? labels[s] : "";
            let name: str8 = loaded ? (label != "" ? label : "(loaded)") : "(empty)";
            surface.text(Rect::new(SamplerView::column_x(area, 5, name_width) - name_width, y, name_width - 1, 1), name,
                loaded ? theme.foreground : theme.muted, background);
        }
        surface.text(Rect::new(area.x, help_y, area.width, 1),
            "j/k slot | h/l column | J/K adjust, [ ] octave/10% | Enter load | Backspace clear | o route Out | Shift+S hide", theme.muted, theme.panel);
    }
    /// Owned display text of a column's normalized value.
    fn field_text(col: i32, value: f64) -> str8 {
        if value < 0.0 { return clone("-"); }
        if col == 0 { return clone(value >= 0.5 ? "Zone" : "Pad"); }
        if col >= 1 && col <= 3 { return piano_note_name(SamplerView::key_of(value)); }
        if col == 4 { return clone(value >= 0.5 ? "On" : "Off"); }
        if col == 5 {
            let mode: i32 = i32(std::math::floor(value * 2.0 + 0.5));
            return clone(mode == 1 ? "Fwd" : (mode == 2 ? "Bidir" : "Off"));
        }
        if col == 8 {
            let bus: i32 = i32(std::math::floor(value * 7.0 + 0.5));
            return bus == 0 ? clone("Main") : format!("Out {}", bus + 1);
        }
        let tenths: i32 = i32(std::math::floor(value * 1000.0 + 0.5));
        return format!("{}.{}", tenths / 10, tenths % 10);
    }
}
