/// \file mla_06_dsp.mla
/// \brief C-ABI bridge: a TR-606 style analog drum machine.
///
/// One `M06` per plug-in instance, heap-allocated with `calloc` and handed to
/// the C++ VST3 layer as an opaque pointer. The C++ side maps MIDI keys to the
/// seven instruments and calls `mla06_trigger`; this file synthesizes them.
///
/// The voices follow the 606's circuits, with constants measured from
/// recordings of a TR-606 (pitches, sweeps, decay times, filter bands):
///
/// - **Bass drum, toms, snare tone.** The 606 rings a bridged-T resonator with
///   a trigger pulse. Here a `Resonator` (a decaying coupled-form sine) does
///   the same: a hit sets its amplitude, the decay is its damping, and its
///   frequency can sweep while it rings. Like the 606's, the decays speed up
///   at their end (`Decay`). The bass drum is a near-pure 58 Hz sine with a
///   trigger click. The low tom falls from 180 to 132 Hz (tau 34 ms) with a
///   second mode a fifth up; the high tom is a fifth above the low one. The
///   snare tone falls from 315 to 205 Hz (tau 8 ms).
/// - **Snare noise.** White noise, high-passed at 1.2 kHz and rolled off by
///   two 7 kHz one-poles, on its own envelope (tau 26 ms). Snappy sets its
///   level against the tone.
/// - **Metal.** Six free-running square oscillators (292, 373, 437, 509, 636
///   and 755 Hz, band-limited with PolyBLEP) feed the cymbal and both hi-hats.
///   The closed hat high-passes the bank at 5 kHz (4th order), the open hat at
///   5 kHz (2nd order); both then mix a Q 8 band-pass at 7 kHz with 0.3 of
///   the high-passed signal. The cymbal takes a lower, wider band. The closed
///   hat rises in 6 ms, decays with tau 50 ms and chokes the open hat. The
///   open hat drops fast, then rings on (tau 470 ms).
/// - **Accent** scales a hit's level and lengthens its decay a little, like
///   the 606's accent bus driving the trigger harder.
///
/// Parameter indexes for `mla06_set` are listed there; the C++ side maps
/// normalized VST3 values to these physical units.

mod dsp::detail;
use dsp::detail::expf;
use dsp::detail::sinf;
use dsp::detail::cosf;
use dsp::detail::tanf;

extern fn calloc(count: i64, size: i64) -> ptr<M06>;
extern fn free(block: ptr<M06>) -> void;
extern fn exp2f(value: f32) -> f32;
extern fn sqrtf(value: f32) -> f32;
extern fn fabsf(value: f32) -> f32;

/// Instruments (`mla06_trigger`), in the 606's panel order.
fn bass_drum() -> i32 { return 0; }
fn snare_drum() -> i32 { return 1; }
fn low_tom() -> i32 { return 2; }
fn high_tom() -> i32 { return 3; }
fn cymbal() -> i32 { return 4; }
fn open_hat() -> i32 { return 5; }
fn closed_hat() -> i32 { return 6; }

/// Below this an envelope counts as finished (-100 dB).
fn silent() -> f32 { return 0.00001f; }

fn pi() -> f32 { return 3.14159265358979323846f; }

fn sclamp(value: f32, low: f32, high: f32) -> f32 {
    if value < low { return low; }
    if value > high { return high; }
    return value;
}

fn smax(a: f32, b: f32) -> f32 { return a > b ? a : b; }
fn smin(a: f32, b: f32) -> f32 { return a < b ? a : b; }

/// Per-sample multiplier of an exponential decay with time constant `seconds`.
fn decay_coef(seconds: f32, rate: f32) -> f32 {
    let samples: f32 = seconds * rate;
    if samples < 1.0f { return 0.0f; }
    return expf(-1.0f / samples);
}

/// A two-stage exponential decay rate: `early` until `left` samples have
/// passed, then the faster `late`. The 606's envelopes close faster at
/// their end, which this follows.
struct Decay { var early: f32; var late: f32; var left: f32; };

impl Decay {
    fn new() -> Decay { return Decay { early: 0.0f, late: 0.0f, left: 0.0f }; }

    /// Time constants and the hold before the late stage, in seconds.
    fn start(self: &mut Self, early: f32, late: f32, hold: f32, rate: f32) -> void {
        self.early = decay_coef(early, rate);
        self.late = decay_coef(late, rate);
        self.left = hold * rate;
    }

    /// This sample's multiplier.
    fn next(self: &mut Self) -> f32 {
        if self.left > 0.0f { self.left = self.left - 1.0f; return self.early; }
        return self.late;
    }
}

/// A decaying sine, the bridged-T resonator of the 606's tonal voices: a
/// coupled-form oscillator whose state (c, s) rotates by the frequency and
/// shrinks by the damping every sample. Rotation keeps the amplitude while
/// the frequency sweeps, so pitch envelopes do not change the decay.
struct Resonator { var c: f32; var s: f32; };

impl Resonator {
    fn new() -> Resonator { return Resonator { c: 0.0f, s: 0.0f }; }
    fn reset(self: &mut Self) -> void { self.c = 0.0f; self.s = 0.0f; }

    /// Ring at amplitude `level`, continuing from the current output so a
    /// retrigger never clicks (a fresh hit starts at zero, rising). A softer
    /// hit on a louder ring keeps the ring's level.
    fn strike(self: &mut Self, level: f32) -> void {
        let amp: f32 = smax(level, fabsf(self.s));
        let s0: f32 = self.s;
        let c0: f32 = sqrtf(smax(amp * amp - s0 * s0, 0.0f));
        self.c = self.c < 0.0f && fabsf(s0) > 0.0f ? -c0 : c0;
    }

    /// One sample at `hz` with per-sample damping `damp`.
    fn tick(self: &mut Self, hz: f32, damp: f32, rate: f32) -> f32 {
        let w: f32 = 2.0f * pi() * sclamp(hz, 1.0f, rate * 0.45f) / rate;
        let cw: f32 = cosf(w);
        let sw: f32 = sinf(w);
        let c: f32 = (self.c * cw - self.s * sw) * damp;
        let s: f32 = (self.c * sw + self.s * cw) * damp;
        self.c = c;
        self.s = s;
        return s;
    }

    fn level(self: Resonator) -> f32 { return fabsf(self.c) + fabsf(self.s); }
}

/// Topology-preserving state-variable filter (Cytomic, A. Simper).
struct Svf { var ic1: f32; var ic2: f32; var a1: f32; var a2: f32; var a3: f32; var k: f32; };

impl Svf {
    fn new() -> Svf { return Svf { ic1: 0.0f, ic2: 0.0f, a1: 0.0f, a2: 0.0f, a3: 0.0f, k: 1.41421356f }; }
    fn reset(self: &mut Self) -> void { self.ic1 = 0.0f; self.ic2 = 0.0f; }
    fn configure(self: &mut Self, cutoff_hz: f32, q: f32, rate: f32) -> void {
        let g: f32 = tanf(pi() * sclamp(cutoff_hz, 10.0f, rate * 0.45f) / rate);
        self.k = 1.0f / q;
        self.a1 = 1.0f / (1.0f + g * (g + self.k));
        self.a2 = g * self.a1;
        self.a3 = g * self.a2;
    }
    /// `mode` 0 low-pass, 1 high-pass, 2 band-pass (peak gain 1).
    fn process(self: &mut Self, input: f32, mode: i32) -> f32 {
        let v3: f32 = input - self.ic2;
        let v1: f32 = self.a1 * self.ic1 + self.a2 * v3;
        let v2: f32 = self.ic2 + self.a2 * self.ic1 + self.a3 * v3;
        self.ic1 = 2.0f * v1 - self.ic1;
        self.ic2 = 2.0f * v2 - self.ic2;
        if mode == 0 { return v2; }
        if mode == 1 { return input - self.k * v1 - v2; }
        return self.k * v1;
    }
}

/// PolyBLEP residual for a step at phase 0 of a saw/square.
fn blep(t: f32, dt: f32) -> f32 {
    if t < dt { let x: f32 = t / dt; return x + x - x * x - 1.0f; }
    if t > 1.0f - dt { let x: f32 = (t - 1.0f) / dt; return x * x + x + x + 1.0f; }
    return 0.0f;
}

/// One of the six square oscillators of the metal bank.
struct Square { var phase: f32; var hz: f32; };

impl Square {
    fn tick(self: &mut Self, tune: f32, rate: f32) -> f32 {
        let dt: f32 = smin(self.hz * tune / rate, 0.45f);
        self.phase = self.phase + dt;
        if self.phase >= 1.0f { self.phase = self.phase - 1.0f; }
        var half: f32 = self.phase + 0.5f;
        if half >= 1.0f { half = half - 1.0f; }
        let naive: f32 = self.phase < 0.5f ? 1.0f : -1.0f;
        return naive + blep(self.phase, dt) - blep(half, dt);
    }
}

/// A hi-hat or cymbal filter: a 2nd- or 4th-order high-pass, then a resonant
/// band-pass mixed with some of the high-passed signal.
struct MetalFilter {
    var hp1: Svf;
    var hp2: Svf;
    var bp: Svf;
    var broad: f32;
    var steep: bool;
};

impl MetalFilter {
    fn new() -> MetalFilter {
        return MetalFilter { hp1: Svf::new(), hp2: Svf::new(), bp: Svf::new(), broad: 0.3f, steep: true };
    }
    fn reset(self: &mut Self) -> void { self.hp1.reset(); self.hp2.reset(); self.bp.reset(); }
    fn configure(self: &mut Self, highpass: f32, steep: bool, band: f32, q: f32, broad: f32, rate: f32) -> void {
        self.hp1.configure(highpass, 0.70710678f, rate);
        self.hp2.configure(highpass, 0.70710678f, rate);
        self.bp.configure(band, q, rate);
        self.broad = broad;
        self.steep = steep;
    }
    fn process(self: &mut Self, input: f32) -> f32 {
        var high: f32 = self.hp1.process(input, 1);
        if self.steep { high = self.hp2.process(high, 1); }
        return self.bp.process(high, 2) + self.broad * high;
    }
}

/// The whole machine.
struct M06 {
    var rate: f32;

    // --- Settings ----------------------------------------------------------
    /// Instrument levels (linear), tunes (semitones) and decay scales.
    var level_bd: f32;
    var level_sd: f32;
    var level_lt: f32;
    var level_ht: f32;
    var level_cy: f32;
    var level_oh: f32;
    var level_ch: f32;
    var tune_bd: f32;
    var tune_sd: f32;
    var tune_lt: f32;
    var tune_ht: f32;
    var decay_bd: f32;
    var decay_sd: f32;
    var decay_lt: f32;
    var decay_ht: f32;
    var decay_cy: f32;
    var decay_oh: f32;
    var decay_ch: f32;
    var snappy: f32;
    /// Metal bank tune as a frequency ratio.
    var metal_tune: f32;
    /// Accent amount 0..1 (0 = none, 1 = +9 dB).
    var accent: f32;
    /// 0: two levels (velocity above 100 accents); 1: velocity scales the level.
    var dynamics: i32;
    var output_target: f32;
    var output_gain: f32;

    // --- Tonal voices --------------------------------------------------------
    var bd: Resonator;
    var bd_decay: Decay;
    var bd_sweep: f32;
    /// Extra early body: a second, fast-decaying ring at the same pitch.
    var bd_body: Resonator;
    var sd: Resonator;
    var sd_decay: Decay;
    var sd_sweep: f32;
    var sd_noise: f32;
    var sd_noise_decay: Decay;
    var sd_hp: Svf;
    var sd_lp1: f32;
    var sd_lp2: f32;
    var sd_lp_coef: f32;
    var lt: Resonator;
    var lt2: Resonator;
    var lt_decay: Decay;
    var lt2_decay: Decay;
    var lt_sweep: f32;
    var ht: Resonator;
    var ht2: Resonator;
    var ht_decay: Decay;
    var ht2_decay: Decay;
    var ht_sweep: f32;
    /// Trigger clicks: one short high-passed noise burst per voice, summed.
    var bd_click: f32;
    var lt_click: f32;
    var ht_click: f32;
    var click_x: f32;
    var click_hp: f32;
    /// Fixed coefficients: sweeps, the bass drum's early body and clicks.
    var sweep_bd_coef: f32;
    var sweep_sd_coef: f32;
    var sweep_tom_coef: f32;
    var body_coef: f32;
    var click_coef: f32;

    // --- Metal -------------------------------------------------------------
    var sq1: Square;
    var sq2: Square;
    var sq3: Square;
    var sq4: Square;
    var sq5: Square;
    var sq6: Square;
    var cy_filter: MetalFilter;
    var oh_filter: MetalFilter;
    var ch_filter: MetalFilter;
    /// Cymbal and open hat: a fast and a slow part; closed hat: one envelope
    /// after a short rise.
    var cy_fast: f32;
    var cy_slow: f32;
    var cy_fast_decay: Decay;
    var cy_slow_decay: Decay;
    var oh_fast: f32;
    var oh_slow: f32;
    var oh_fast_decay: Decay;
    var oh_slow_decay: Decay;
    var oh_choked: bool;
    var choke_coef: f32;
    var ch_env: f32;
    var ch_rise: f32;
    var ch_decay: Decay;
    var rise_step: f32;

    var seed: i64;
};

impl M06 {
    fn new(sample_rate: f32) -> M06 {
        let rate: f32 = sclamp(sample_rate, 8000.0f, 384000.0f);
        var m: M06 = M06 {
            rate: rate,
            level_bd: 1.0f, level_sd: 1.0f, level_lt: 1.0f, level_ht: 1.0f,
            level_cy: 1.0f, level_oh: 1.0f, level_ch: 1.0f,
            tune_bd: 0.0f, tune_sd: 0.0f, tune_lt: 0.0f, tune_ht: 0.0f,
            decay_bd: 1.0f, decay_sd: 1.0f, decay_lt: 1.0f, decay_ht: 1.0f,
            decay_cy: 1.0f, decay_oh: 1.0f, decay_ch: 1.0f,
            snappy: 0.5f, metal_tune: 1.0f, accent: 0.5f, dynamics: 0,
            output_target: 1.0f, output_gain: 1.0f,
            bd: Resonator::new(), bd_decay: Decay::new(), bd_sweep: 0.0f, bd_body: Resonator::new(),
            sd: Resonator::new(), sd_decay: Decay::new(), sd_sweep: 0.0f,
            sd_noise: 0.0f, sd_noise_decay: Decay::new(), sd_hp: Svf::new(),
            sd_lp1: 0.0f, sd_lp2: 0.0f, sd_lp_coef: 1.0f,
            lt: Resonator::new(), lt2: Resonator::new(), lt_decay: Decay::new(), lt2_decay: Decay::new(), lt_sweep: 0.0f,
            ht: Resonator::new(), ht2: Resonator::new(), ht_decay: Decay::new(), ht2_decay: Decay::new(), ht_sweep: 0.0f,
            bd_click: 0.0f, lt_click: 0.0f, ht_click: 0.0f, click_x: 0.0f, click_hp: 0.0f,
            sweep_bd_coef: 0.0f, sweep_sd_coef: 0.0f, sweep_tom_coef: 0.0f, body_coef: 0.0f, click_coef: 0.0f,
            sq1: Square { phase: 0.00f, hz: 292.25f }, sq2: Square { phase: 0.31f, hz: 372.75f },
            sq3: Square { phase: 0.57f, hz: 437.20f }, sq4: Square { phase: 0.12f, hz: 508.95f },
            sq5: Square { phase: 0.83f, hz: 636.25f }, sq6: Square { phase: 0.44f, hz: 755.35f },
            cy_filter: MetalFilter::new(), oh_filter: MetalFilter::new(), ch_filter: MetalFilter::new(),
            cy_fast: 0.0f, cy_slow: 0.0f, cy_fast_decay: Decay::new(), cy_slow_decay: Decay::new(),
            oh_fast: 0.0f, oh_slow: 0.0f, oh_fast_decay: Decay::new(), oh_slow_decay: Decay::new(),
            oh_choked: false, choke_coef: 0.0f,
            ch_env: 0.0f, ch_rise: 1.0f, ch_decay: Decay::new(), rise_step: 1.0f,
            seed: 6060606
        };
        m.configure();
        return m;
    }

    /// Coefficients that depend only on the sample rate.
    fn configure(self: &mut Self) -> void {
        let r: f32 = self.rate;
        self.sweep_bd_coef = decay_coef(0.015f, r);
        self.sweep_sd_coef = decay_coef(0.008f, r);
        self.sweep_tom_coef = decay_coef(0.034f, r);
        self.body_coef = decay_coef(0.010f, r);
        self.click_coef = decay_coef(0.0011f, r);
        self.click_hp = expf(-2.0f * pi() * 300.0f / r);
        self.sd_hp.configure(1600.0f, 0.70710678f, r);
        self.sd_lp_coef = 1.0f - expf(-2.0f * pi() * smin(6000.0f, r * 0.45f) / r);
        self.choke_coef = decay_coef(0.003f, r);
        // The closed hat peaks about 6 ms after its trigger.
        self.rise_step = 1.0f / smax(1.0f, 0.006f * r);
        self.configure_metal();
    }

    fn configure_metal(self: &mut Self) -> void {
        let r: f32 = self.rate;
        let t: f32 = self.metal_tune;
        self.oh_filter.configure(5000.0f * t, false, 7000.0f * t, 8.0f, 0.3f, r);
        self.ch_filter.configure(5000.0f * t, true, 7000.0f * t, 8.0f, 0.3f, r);
        self.cy_filter.configure(2500.0f * t, true, 5200.0f * t, 3.0f, 0.6f, r);
    }

    fn reset(self: &mut Self) -> void {
        self.bd.reset(); self.sd.reset(); self.lt.reset(); self.lt2.reset(); self.ht.reset(); self.ht2.reset();
        self.bd_body.reset(); self.bd_click = 0.0f; self.lt_click = 0.0f; self.ht_click = 0.0f; self.click_x = 0.0f;
        self.sd_noise = 0.0f; self.sd_hp.reset(); self.sd_lp1 = 0.0f; self.sd_lp2 = 0.0f;
        self.cy_filter.reset(); self.oh_filter.reset(); self.ch_filter.reset();
        self.cy_fast = 0.0f; self.cy_slow = 0.0f; self.oh_fast = 0.0f; self.oh_slow = 0.0f; self.ch_env = 0.0f;
        self.oh_choked = false; self.ch_rise = 1.0f;
        self.output_gain = self.output_target;
    }

    fn white(self: &mut Self) -> f32 {
        self.seed = (self.seed * 1103515245 + 12345) % 2147483648;
        return f32(self.seed) / 1073741824.0f - 1.0f;
    }

    /// Accent amount 0..1 a hit at velocity 0..1 gets.
    fn accent_of(self: M06, velocity: f32) -> f32 {
        let v: f32 = sclamp(velocity, 0.0f, 1.0f);
        if self.dynamics == 1 { return v * self.accent; }
        return v > 100.5f / 127.0f ? self.accent : 0.0f;
    }

    /// Hit level for velocity 0..1: accent adds up to +9 dB; in Velocity
    /// mode, velocity also scales the level.
    fn hit_gain(self: M06, velocity: f32) -> f32 {
        let v: f32 = sclamp(velocity, 0.0f, 1.0f);
        if self.dynamics == 1 { return v * v * exp2f(self.accent * 1.5f); }
        return exp2f(self.accent_of(v) * 1.5f);
    }

    fn semis(value: f32) -> f32 { return exp2f(value / 12.0f); }

    /// Gentle cubic saturation, monotonic up to |x| = 1.
    fn soft(x: f32) -> f32 {
        let y: f32 = sclamp(x, -1.0f, 1.0f);
        return y - 0.3f * y * y * y;
    }

    /// Strike instrument `which` (0..6) at velocity 0..1.
    fn trigger(self: &mut Self, which: i32, velocity: f32) -> void {
        let gain: f32 = self.hit_gain(velocity);
        if gain <= 0.0f { return; }
        // Accent lengthens the ring by up to 15 %.
        let r: f32 = self.rate;
        if which == bass_drum() {
            let d: f32 = self.decay_bd * (1.0f + 0.15f * self.accent_of(velocity));
            self.bd_decay.start(0.054f * d, 0.028f * d, 0.14f * d, r);
            self.bd.strike(0.38f * gain); self.bd_body.strike(0.1f * gain);
            self.bd_sweep = 1.0f; self.bd_click = 0.055f * gain;
        } else if which == snare_drum() {
            let d: f32 = self.decay_sd * (1.0f + 0.15f * self.accent_of(velocity));
            self.sd_decay.start(0.021f * d, 0.021f * d, 0.0f, r);
            self.sd_noise_decay.start(0.026f * d, 0.026f * d, 0.0f, r);
            self.sd.strike(0.18f * gain * (1.4f - 0.8f * self.snappy));
            self.sd_sweep = 1.0f;
            self.sd_noise = smax(self.sd_noise, gain * 1.25f * self.snappy);
        } else if which == low_tom() {
            let d: f32 = self.decay_lt * (1.0f + 0.15f * self.accent_of(velocity));
            self.lt_decay.start(0.043f * d, 0.019f * d, 0.18f * d, r);
            self.lt2_decay.start(0.033f * d, 0.015f * d, 0.18f * d, r);
            self.lt.strike(0.33f * gain); self.lt2.strike(0.24f * gain);
            self.lt_sweep = 1.0f; self.lt_click = 0.22f * gain;
        } else if which == high_tom() {
            let d: f32 = self.decay_ht * (1.0f + 0.15f * self.accent_of(velocity));
            self.ht_decay.start(0.038f * d, 0.017f * d, 0.16f * d, r);
            self.ht2_decay.start(0.029f * d, 0.013f * d, 0.16f * d, r);
            self.ht.strike(0.31f * gain); self.ht2.strike(0.22f * gain);
            self.ht_sweep = 1.0f; self.ht_click = 0.2f * gain;
        } else if which == cymbal() {
            let d: f32 = self.decay_cy * (1.0f + 0.15f * self.accent_of(velocity));
            self.cy_fast_decay.start(0.045f * d, 0.045f * d, 0.0f, r);
            self.cy_slow_decay.start(0.5f * d, 0.15f * d, 1.0f * d, r);
            self.cy_fast = smax(self.cy_fast, 1.1f * gain);
            self.cy_slow = smax(self.cy_slow, 0.55f * gain);
        } else if which == open_hat() {
            let d: f32 = self.decay_oh * (1.0f + 0.15f * self.accent_of(velocity));
            self.oh_fast_decay.start(0.025f * d, 0.025f * d, 0.0f, r);
            self.oh_slow_decay.start(0.47f * d, 0.12f * d, 1.45f * d, r);
            self.oh_fast = smax(self.oh_fast, 2.0f * gain);
            self.oh_slow = smax(self.oh_slow, 1.2f * gain);
            self.oh_choked = false;
        } else if which == closed_hat() {
            let d: f32 = self.decay_ch * (1.0f + 0.15f * self.accent_of(velocity));
            self.ch_decay.start(0.05f * d, 0.016f * d, 0.21f * d, r);
            // Rises from the current level to the hit's level.
            self.ch_rise = 0.0f;
            self.ch_env = smax(self.ch_env, 3.9f * gain);
            // The closed hat cuts the open one.
            self.oh_choked = true;
        }
    }

    fn metal(self: &mut Self) -> f32 {
        let r: f32 = self.rate;
        let t: f32 = self.metal_tune;
        return (self.sq1.tick(t, r) + self.sq2.tick(t, r) + self.sq3.tick(t, r)
              + self.sq4.tick(t, r) + self.sq5.tick(t, r) + self.sq6.tick(t, r)) * 0.17f;
    }

    fn tonal_active(self: M06) -> bool {
        return self.bd.level() > silent() || self.bd_body.level() > silent() || self.sd.level() > silent() || self.sd_noise > silent()
            || self.lt.level() > silent() || self.lt2.level() > silent()
            || self.ht.level() > silent() || self.ht2.level() > silent()
            || self.bd_click > silent() || self.lt_click > silent() || self.ht_click > silent();
    }

    fn metal_active(self: M06) -> bool {
        return self.cy_fast + self.cy_slow > silent() || self.oh_fast + self.oh_slow > silent() || self.ch_env > silent();
    }

    /// Ringing resonators: all of the tonal voices summed with their levels.
    fn tonal(self: &mut Self) -> f32 {
        let r: f32 = self.rate;
        var out: f32 = 0.0f;

        // Bass drum: 58 Hz with a slight drop and extra early body.
        let bd_hz: f32 = 58.0f * M06::semis(self.tune_bd) * (1.0f + 0.04f * self.bd_sweep);
        self.bd_sweep = self.bd_sweep * self.sweep_bd_coef;
        let bd: f32 = self.bd.tick(bd_hz, self.bd_decay.next(), r) + self.bd_body.tick(bd_hz, self.body_coef, r);

        // Snare: tone falling from 315 to 205 Hz, plus filtered noise.
        let sd_hz: f32 = (205.0f + 110.0f * self.sd_sweep) * M06::semis(self.tune_sd);
        self.sd_sweep = self.sd_sweep * self.sweep_sd_coef;
        var sd: f32 = self.sd.tick(sd_hz, self.sd_decay.next(), r);
        if self.sd_noise > silent() {
            let n: f32 = self.sd_hp.process(self.white(), 1);
            self.sd_lp1 = self.sd_lp1 + (n - self.sd_lp1) * self.sd_lp_coef;
            self.sd_lp2 = self.sd_lp2 + (self.sd_lp1 - self.sd_lp2) * self.sd_lp_coef;
            sd = sd + self.sd_lp2 * self.sd_noise;
            self.sd_noise = self.sd_noise * self.sd_noise_decay.next();
        }

        // Toms: falling pitch and a second mode a fifth up.
        let lt_base: f32 = 132.0f * M06::semis(self.tune_lt);
        let lt_hz: f32 = lt_base * (1.0f + 0.36f * self.lt_sweep);
        self.lt_sweep = self.lt_sweep * self.sweep_tom_coef;
        // The tom amplifier saturates softly (a 3rd harmonic at -40 dB).
        let lt: f32 = M06::soft(self.lt.tick(lt_hz, self.lt_decay.next(), r) + self.lt2.tick(lt_base * 1.515f, self.lt2_decay.next(), r));
        let ht_base: f32 = 198.0f * M06::semis(self.tune_ht);
        let ht_hz: f32 = ht_base * (1.0f + 0.36f * self.ht_sweep);
        self.ht_sweep = self.ht_sweep * self.sweep_tom_coef;
        let ht: f32 = M06::soft(self.ht.tick(ht_hz, self.ht_decay.next(), r) + self.ht2.tick(ht_base * 1.515f, self.ht2_decay.next(), r));

        // Trigger clicks: high-passed noise bursts.
        let clicks: f32 = self.bd_click * self.level_bd + self.lt_click * self.level_lt + self.ht_click * self.level_ht;
        if clicks > silent() {
            let x: f32 = self.white() * clicks;
            out = out + x - self.click_x;
            self.click_x = self.click_x + (x - self.click_x) * (1.0f - self.click_hp);
            self.bd_click = self.bd_click * self.click_coef;
            self.lt_click = self.lt_click * self.click_coef;
            self.ht_click = self.ht_click * self.click_coef;
        }
        return out + bd * self.level_bd + sd * self.level_sd + lt * self.level_lt + ht * self.level_ht;
    }

    /// The metal bank through the cymbal and hi-hat filters and envelopes.
    fn metallic(self: &mut Self) -> f32 {
        let source: f32 = self.metal();
        var out: f32 = 0.0f;
        let cy: f32 = self.cy_filter.process(source);
        if self.cy_fast + self.cy_slow > silent() {
            out = out + cy * (self.cy_fast + self.cy_slow) * self.level_cy;
            self.cy_fast = self.cy_fast * self.cy_fast_decay.next();
            self.cy_slow = self.cy_slow * self.cy_slow_decay.next();
        }
        let oh: f32 = self.oh_filter.process(source);
        if self.oh_fast + self.oh_slow > silent() {
            out = out + oh * (self.oh_fast + self.oh_slow) * self.level_oh;
            let fast: f32 = self.oh_fast_decay.next();
            let slow: f32 = self.oh_slow_decay.next();
            self.oh_fast = self.oh_fast * (self.oh_choked ? self.choke_coef : fast);
            self.oh_slow = self.oh_slow * (self.oh_choked ? self.choke_coef : slow);
        }
        let ch: f32 = self.ch_filter.process(source);
        if self.ch_env > silent() {
            out = out + ch * self.ch_env * self.ch_rise * self.level_ch;
            if self.ch_rise < 1.0f { self.ch_rise = smin(1.0f, self.ch_rise + self.rise_step); }
            else { self.ch_env = self.ch_env * self.ch_decay.next(); }
        }
        return out;
    }

    fn process(self: &mut Self, out_right: ptr<f32>) -> f32 {
        self.output_gain = self.output_gain + (self.output_target - self.output_gain) * 0.002f;
        var mix: f32 = 0.0f;
        if self.tonal_active() { mix = mix + self.tonal(); }
        else {
            self.bd.reset(); self.bd_body.reset(); self.sd.reset();
            self.lt.reset(); self.lt2.reset(); self.ht.reset(); self.ht2.reset();
        }
        if self.metal_active() { mix = mix + self.metallic(); }
        else {
            // The oscillators keep turning, so the next hit starts
            // mid-cycle like on the free-running hardware.
            self.metal();
        }
        let out: f32 = mix * self.output_gain;
        unsafe { *out_right = out; }
        return out;
    }
}

// --- C ABI -------------------------------------------------------------------

/// @brief Allocate an instance for a sample rate (8 kHz .. 384 kHz).
fn mla06_create(sample_rate: f32) -> ptr<M06> {
    let handle: ptr<M06> = calloc(1, size_of(M06));
    unsafe { *handle = M06::new(sample_rate); }
    return handle;
}

/// @brief Release an instance created by `mla06_create`.
fn mla06_destroy(handle: ptr<M06>) { free(handle); }

/// @brief Silence every voice and clear filters; settings stay.
fn mla06_reset(handle: ptr<M06>) { unsafe { (*handle).reset(); } }

/// @brief Strike instrument `which` (0 BD, 1 SD, 2 LT, 3 HT, 4 CY, 5 OH,
/// 6 CH) at velocity 0..1.
fn mla06_trigger(handle: ptr<M06>, which: i32, velocity: f32) {
    unsafe { (*handle).trigger(which, velocity); }
}

/// @brief 1 while any voice sounds, else 0.
fn mla06_active(handle: ptr<M06>) -> i32 {
    unsafe { return (*handle).tonal_active() || (*handle).metal_active() ? 1 : 0; }
}

/// @brief Set one parameter in physical units:
/// 0 output gain (linear), 1 accent 0..1, 2 dynamics (0 accent, 1 velocity),
/// 3..9 instrument levels (linear, BD SD LT HT CY OH CH),
/// 10..13 tunes in semitones (BD SD LT HT),
/// 14..20 decay scales (BD SD LT HT CY OH CH), 21 snappy 0..1,
/// 22 metal tune (semitones).
fn mla06_set(handle: ptr<M06>, index: i32, value: f32) {
    unsafe {
        if index == 0 {
            (*handle).output_target = smax(value, 0.0f);
            // Glide only while something sounds.
            if !(*handle).tonal_active() && !(*handle).metal_active() { (*handle).output_gain = (*handle).output_target; }
        }
        else if index == 1 { (*handle).accent = sclamp(value, 0.0f, 1.0f); }
        else if index == 2 { (*handle).dynamics = value > 0.5f ? 1 : 0; }
        else if index == 3 { (*handle).level_bd = smax(value, 0.0f); }
        else if index == 4 { (*handle).level_sd = smax(value, 0.0f); }
        else if index == 5 { (*handle).level_lt = smax(value, 0.0f); }
        else if index == 6 { (*handle).level_ht = smax(value, 0.0f); }
        else if index == 7 { (*handle).level_cy = smax(value, 0.0f); }
        else if index == 8 { (*handle).level_oh = smax(value, 0.0f); }
        else if index == 9 { (*handle).level_ch = smax(value, 0.0f); }
        else if index == 10 { (*handle).tune_bd = sclamp(value, -24.0f, 24.0f); }
        else if index == 11 { (*handle).tune_sd = sclamp(value, -24.0f, 24.0f); }
        else if index == 12 { (*handle).tune_lt = sclamp(value, -24.0f, 24.0f); }
        else if index == 13 { (*handle).tune_ht = sclamp(value, -24.0f, 24.0f); }
        else if index == 14 { (*handle).decay_bd = sclamp(value, 0.1f, 10.0f); }
        else if index == 15 { (*handle).decay_sd = sclamp(value, 0.1f, 10.0f); }
        else if index == 16 { (*handle).decay_lt = sclamp(value, 0.1f, 10.0f); }
        else if index == 17 { (*handle).decay_ht = sclamp(value, 0.1f, 10.0f); }
        else if index == 18 { (*handle).decay_cy = sclamp(value, 0.1f, 10.0f); }
        else if index == 19 { (*handle).decay_oh = sclamp(value, 0.1f, 10.0f); }
        else if index == 20 { (*handle).decay_ch = sclamp(value, 0.1f, 10.0f); }
        else if index == 21 { (*handle).snappy = sclamp(value, 0.0f, 1.0f); }
        else if index == 22 {
            (*handle).metal_tune = M06::semis(sclamp(value, -12.0f, 12.0f));
            (*handle).configure_metal();
        }
    }
}

/// @brief Process one sample: stereo out (left returned, right through `out_right`).
fn mla06_process(handle: ptr<M06>, out_right: ptr<f32>) -> f32 {
    unsafe { return (*handle).process(out_right); }
}
