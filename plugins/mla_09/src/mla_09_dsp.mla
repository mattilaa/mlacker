/// \file mla_09_dsp.mla
/// \brief C-ABI bridge: a TR-909 style drum machine.
///
/// One `M09` per plug-in instance, heap-allocated with `calloc` and handed to
/// the C++ VST3 layer as an opaque pointer. The C++ side maps MIDI keys to the
/// eleven instruments and calls `mla09_trigger`; this file sounds them.
///
/// Like the 909, the machine is a hybrid:
///
/// - **Analog voices.** Bass drum, snare, three toms, rim shot and hand clap
///   are synthesized, following the 909's circuits:
///   - *Bass drum.* A VCO shaped to a rounded sine, swept down from several
///     times its pitch to about 50 Hz by a pitch envelope (Tune sets how far
///     and how long it sweeps), through a VCA with Decay. Attack mixes in the
///     click: a short pulse and a burst of filtered noise.
///   - *Snare.* Two VCOs (about 180 and 330 Hz) with a short pitch drop, plus
///     white noise through a high-pass and a low-pass. Tune moves both VCOs,
///     Tone brightens the noise and lengthens it, Snappy sets its level.
///   - *Toms.* A VCO with a pronounced downward pitch bend, a little filtered
///     noise on the attack, and Tune and Decay.
///   - *Rim shot.* Three short rings, high-passed and driven.
///   - *Hand clap.* Band-passed noise struck by three sawtooth bursts and
///     then a longer tail.
/// - **Sampled voices.** The closed and open hi-hat, crash and ride play
///   6-bit samples from ROM. Roland's ROM data is not ours to ship, so
///   `M09::new` builds the four ROMs itself in the 909's format: metallic
///   recordings (inharmonic partials with frequency-dependent decays over
///   filtered noise and a stick transient) at a 32 kHz ROM clock, normalized
///   and quantized to 64 levels. Playback reads them like the 909: from the
///   start on every hit, through the 6-bit DAC (the quantization stays in),
///   then a VCA. The hats' VCA has Decay; the closed hat chokes the open hat.
///   The cymbals' Tune changes the ROM clock, so a lower tune is also longer.
/// - **Accent** scales a hit's level.
///
/// Parameter indexes for `mla09_set` are listed there. Knobs are 0..1, as on
/// the panel; the C++ side maps levels to linear gains.

mod dsp::detail;
mod std::vec;
use dsp::detail::expf;
use dsp::detail::logf;
use dsp::detail::sinf;
use dsp::detail::cosf;
use dsp::detail::tanf;
use dsp::detail::tanhf;
use dsp::detail::llroundf;
use std::vec::set_f32;

extern fn calloc(count: i64, size: i64) -> ptr<M09>;
extern fn free(block: ptr<M09>) -> void;
extern fn exp2f(value: f32) -> f32;
extern fn sqrtf(value: f32) -> f32;
extern fn fabsf(value: f32) -> f32;
extern fn powf(base: f32, exponent: f32) -> f32;

/// Instruments (`mla09_trigger`), in the 909's panel order.
fn bass_drum() -> i32 { return 0; }
fn snare_drum() -> i32 { return 1; }
fn low_tom() -> i32 { return 2; }
fn mid_tom() -> i32 { return 3; }
fn high_tom() -> i32 { return 4; }
fn rim_shot() -> i32 { return 5; }
fn hand_clap() -> i32 { return 6; }
fn closed_hat() -> i32 { return 7; }
fn open_hat() -> i32 { return 8; }
fn crash() -> i32 { return 9; }
fn ride() -> i32 { return 10; }

/// Below this an envelope counts as finished (-100 dB).
fn silent() -> f32 { return 0.00001f; }

fn pi() -> f32 { return 3.14159265358979323846f; }

/// The ROM clock the samples are stored at, in Hz.
fn rom_rate() -> f32 { return 32000.0f; }

/// ROM lengths in words: the hats are short, the cymbals long.
fn ch_words() -> i64 { return 8192; }
fn oh_words() -> i64 { return 32768; }
fn cymbal_words() -> i64 { return 65536; }

fn sclamp(value: f32, low: f32, high: f32) -> f32 {
    if value < low { return low; }
    if value > high { return high; }
    return value;
}

fn smax(a: f32, b: f32) -> f32 { return a > b ? a : b; }
fn smin(a: f32, b: f32) -> f32 { return a < b ? a : b; }

/// Per-sample multiplier of an exponential decay with time constant `seconds`.
fn decay_coef(seconds: f32, rate: f32) -> f32 {
    let samples: f32 = seconds * rate;
    if samples < 1.0f { return 0.0f; }
    return expf(-1.0f / samples);
}

/// One-pole low-pass coefficient for `hz`.
fn lp_coef(hz: f32, rate: f32) -> f32 {
    return 1.0f - expf(-2.0f * pi() * sclamp(hz, 1.0f, rate * 0.45f) / rate);
}

/// Geometric interpolation through three values at knob 0, 0.5, 1.
fn knob3(k: f32, v0: f32, v1: f32, v2: f32) -> f32 {
    let x: f32 = sclamp(k, 0.0f, 1.0f) * 2.0f;
    if x >= 1.0f { return v1 * expf((x - 1.0f) * logf(v2 / v1)); }
    return v0 * expf(x * logf(v1 / v0));
}

/// A two-stage exponential decay rate: `early` until `left` samples have
/// passed, then `late`.
struct Decay { var early: f32; var late: f32; var left: f32; };

impl Decay {
    fn new() -> Decay { return Decay { early: 0.0f, late: 0.0f, left: 0.0f }; }

    /// Time constants and the hold before the late stage, in seconds.
    fn start(self: &mut Self, early: f32, late: f32, hold: f32, rate: f32) -> void {
        self.early = decay_coef(early, rate);
        self.late = decay_coef(late, rate);
        self.left = hold * rate;
    }

    /// This sample's multiplier.
    fn next(self: &mut Self) -> f32 {
        if self.left > 0.0f { self.left = self.left - 1.0f; return self.early; }
        return self.late;
    }
}

/// Topology-preserving state-variable filter (Cytomic, A. Simper).
struct Svf { var ic1: f32; var ic2: f32; var a1: f32; var a2: f32; var a3: f32; var k: f32; };

impl Svf {
    fn new() -> Svf { return Svf { ic1: 0.0f, ic2: 0.0f, a1: 0.0f, a2: 0.0f, a3: 0.0f, k: 1.41421356f }; }
    fn reset(self: &mut Self) -> void { self.ic1 = 0.0f; self.ic2 = 0.0f; }
    fn configure(self: &mut Self, cutoff_hz: f32, q: f32, rate: f32) -> void {
        let g: f32 = tanf(pi() * sclamp(cutoff_hz, 10.0f, rate * 0.45f) / rate);
        self.k = 1.0f / q;
        self.a1 = 1.0f / (1.0f + g * (g + self.k));
        self.a2 = g * self.a1;
        self.a3 = g * self.a2;
    }
    /// `mode` 0 low-pass, 1 high-pass, 2 band-pass (peak gain 1).
    fn process(self: &mut Self, input: f32, mode: i32) -> f32 {
        let v3: f32 = input - self.ic2;
        let v1: f32 = self.a1 * self.ic1 + self.a2 * v3;
        let v2: f32 = self.ic2 + self.a2 * self.ic1 + self.a3 * v3;
        self.ic1 = 2.0f * v1 - self.ic1;
        self.ic2 = 2.0f * v2 - self.ic2;
        if mode == 0 { return v2; }
        if mode == 1 { return input - self.k * v1 - v2; }
        return self.k * v1;
    }
}

/// A decaying sine (the rim shot's bridged-T rings): a coupled-form
/// oscillator whose state rotates by the frequency and shrinks by the damping.
struct Resonator { var c: f32; var s: f32; };

impl Resonator {
    fn new() -> Resonator { return Resonator { c: 0.0f, s: 0.0f }; }
    fn reset(self: &mut Self) -> void { self.c = 0.0f; self.s = 0.0f; }

    /// Ring at amplitude `level`, continuing from the current output so a
    /// retrigger never clicks. A softer hit on a louder ring keeps its level.
    fn strike(self: &mut Self, level: f32) -> void {
        let amp: f32 = smax(level, fabsf(self.s));
        let s0: f32 = self.s;
        let c0: f32 = sqrtf(smax(amp * amp - s0 * s0, 0.0f));
        self.c = self.c < 0.0f && fabsf(s0) > 0.0f ? -c0 : c0;
    }

    fn tick(self: &mut Self, hz: f32, damp: f32, rate: f32) -> f32 {
        let w: f32 = 2.0f * pi() * sclamp(hz, 1.0f, rate * 0.45f) / rate;
        let cw: f32 = cosf(w);
        let sw: f32 = sinf(w);
        let c: f32 = (self.c * cw - self.s * sw) * damp;
        let s: f32 = (self.c * sw + self.s * cw) * damp;
        self.c = c;
        self.s = s;
        return s;
    }

    fn amplitude(self: Resonator) -> f32 { return sqrtf(self.c * self.c + self.s * self.s); }
}

/// A 909 VCO: a phase accumulator read through a sine, rounded towards a
/// square by `shape` (the 909 shapes a triangle core into a sine-like wave
/// with flattened tops). The phase runs on between hits, so a retrigger
/// continues the waveform instead of jumping.
struct Vco { var phase: f32; };

impl Vco {
    fn new() -> Vco { return Vco { phase: 0.0f }; }
    fn reset(self: &mut Self) -> void { self.phase = 0.0f; }
    fn tick(self: &mut Self, hz: f32, shape: f32, rate: f32) -> f32 {
        self.phase = self.phase + sclamp(hz, 1.0f, rate * 0.45f) / rate;
        if self.phase >= 1.0f { self.phase = self.phase - 1.0f; }
        let s: f32 = sinf(2.0f * pi() * self.phase);
        if shape <= 0.0f { return s; }
        return tanhf(shape * s) / tanhf(shape);
    }
}

/// An envelope that starts every hit from the level already sounding (a
/// softer hit on a louder ring keeps the ring).
fn restrike(current: f32, level: f32) -> f32 { return smax(current, level); }

/// A VCA envelope for the analog voices. A fresh hit starts at its level
/// (the VCO starts at phase 0, so there is no step); a harder hit on a
/// sounding voice rises to its level over about 0.4 ms instead of jumping
/// mid-cycle, so fast rolls do not click.
struct Vca { var level: f32; var peak: f32; var rising: bool; var rise_coef: f32; };

impl Vca {
    fn new() -> Vca { return Vca { level: 0.0f, peak: 0.0f, rising: false, rise_coef: 1.0f }; }
    fn configure(self: &mut Self, rate: f32) -> void { self.rise_coef = 1.0f - decay_coef(0.0004f, rate); }
    fn reset(self: &mut Self) -> void { self.level = 0.0f; self.peak = 0.0f; self.rising = false; }
    fn sounding(self: Vca) -> bool { return self.level > silent(); }

    fn strike(self: &mut Self, level: f32) -> void {
        if self.level < silent() { self.level = level; self.peak = level; self.rising = false; }
        else if level > self.level { self.peak = level; self.rising = true; }
    }

    /// This sample's gain; then the envelope moves on by the decay multiplier.
    fn tick(self: &mut Self, damp: f32) -> f32 {
        let out: f32 = self.level;
        if self.rising {
            self.peak = self.peak * damp;
            self.level = self.level + (self.peak - self.level) * self.rise_coef;
            if self.level >= self.peak * 0.995f { self.level = self.peak; self.rising = false; }
        } else {
            self.level = self.level * damp;
        }
        return out;
    }
}

/// One of the 909's toms: a VCO bent down from above its pitch, a VCA with
/// Decay, and a little low-passed noise on the attack.
struct Tom {
    var vco: Vco;
    var hz: f32;
    var env: Vca;
    var damp: f32;
    var bend: f32;
    var bend_coef: f32;
    var noise: f32;
    var noise_coef: f32;
    var noise_lp: Svf;
    var noise_hp: Svf;
};

impl Tom {
    fn new() -> Tom {
        return Tom { vco: Vco::new(), hz: 100.0f, env: Vca::new(), damp: 0.0f, bend: 0.0f, bend_coef: 0.0f,
                     noise: 0.0f, noise_coef: 0.0f, noise_lp: Svf::new(), noise_hp: Svf::new() };
    }

    fn configure(self: &mut Self, rate: f32) -> void {
        self.env.configure(rate);
        self.bend_coef = decay_coef(0.025f, rate);
        self.noise_coef = decay_coef(0.012f, rate);
    }

    /// Pitch and decay time constant.
    fn retune(self: &mut Self, hz: f32, tau: f32, rate: f32) -> void {
        self.hz = hz;
        self.damp = decay_coef(tau, rate);
        self.noise_hp.configure(hz * 1.5f, 0.70710678f, rate);
        self.noise_lp.configure(hz * 8.0f + 600.0f, 0.70710678f, rate);
    }

    fn reset(self: &mut Self) -> void {
        self.vco.reset(); self.env.reset(); self.bend = 0.0f; self.noise = 0.0f;
        self.noise_lp.reset(); self.noise_hp.reset();
    }

    fn strike(self: &mut Self, level: f32) -> void {
        if !self.env.sounding() { self.vco.reset(); }
        self.env.strike(level);
        self.bend = 1.0f;
        self.noise = restrike(self.noise, 0.35f * level);
    }

    fn active(self: Tom) -> bool { return self.env.sounding() || self.noise > silent(); }

    fn tick(self: &mut Self, white: f32, rate: f32) -> f32 {
        // The 909 tom starts about 60% above its pitch and bends down.
        let hz: f32 = self.hz * (1.0f + 0.6f * self.bend);
        self.bend = self.bend * self.bend_coef;
        var out: f32 = self.vco.tick(hz, 1.2f, rate) * self.env.tick(self.damp);
        if self.noise > silent() {
            out = out + self.noise_lp.process(self.noise_hp.process(white, 1), 0) * self.noise;
            self.noise = self.noise * self.noise_coef;
        }
        return out;
    }
}

/// A playback head on a ROM: its read position (in ROM words) and gain.
struct Head { var pos: f32; var gain: f32; var on: bool; };

impl Head {
    fn new() -> Head { return Head { pos: 0.0f, gain: 0.0f, on: false }; }

    /// The ROM word at `pos`, linearly interpolated (the DAC's output after
    /// the reconstruction filter); 0 past the end, then the head stops.
    fn read(self: &mut Self, rom: &list<f32>, words: i64, step: f32) -> f32 {
        if !self.on { return 0.0f; }
        let i: i64 = i32(self.pos);
        if i + 1 >= words { self.on = false; return 0.0f; }
        let f: f32 = self.pos - f32(i);
        let a: f32 = rom[i];
        let b: f32 = rom[i + 1];
        self.pos = self.pos + step;
        return a + (b - a) * f;
    }
}

/// A sampled voice: a ROM played from the start on every hit. A retrigger
/// hands the sounding head to a second one that fades out over 2 ms, so the
/// restart does not click.
struct RomVoice { var head: Head; var tail: Head; var fade_step: f32; };

impl RomVoice {
    fn new() -> RomVoice { return RomVoice { head: Head::new(), tail: Head::new(), fade_step: 0.0f }; }
    fn configure(self: &mut Self, rate: f32) -> void { self.fade_step = 1.0f / smax(1.0f, 0.002f * rate); }
    fn reset(self: &mut Self) -> void { self.head = Head::new(); self.tail = Head::new(); }

    /// Restart the ROM; `level_now` is the gain the sounding head has now
    /// (its VCA), which the fading tail keeps.
    fn strike(self: &mut Self, level_now: f32) -> void {
        if self.head.on && level_now > silent() {
            self.tail = self.head;
            self.tail.gain = level_now;
        }
        self.head = Head { pos: 0.0f, gain: 1.0f, on: true };
    }

    fn active(self: RomVoice) -> bool { return self.head.on || self.tail.on; }

    /// The head's sample (VCA applied by the caller) and the fading tail
    /// (already at its own gain), summed into `out_tail` by the caller.
    fn tick(self: &mut Self, rom: &list<f32>, words: i64, step: f32, out_tail: ptr<f32>) -> f32 {
        let x: f32 = self.head.read(rom, words, step);
        var t: f32 = 0.0f;
        if self.tail.on {
            t = self.tail.read(rom, words, step) * self.tail.gain;
            self.tail.gain = self.tail.gain - self.fade_step;
            if self.tail.gain <= 0.0f { self.tail.on = false; }
        }
        unsafe { *out_tail = t; }
        return x;
    }
}

/// Deterministic noise for building the ROMs (the same ROMs every time).
struct Rng { var seed: i64; };

impl Rng {
    /// 0..1.
    fn next(self: &mut Self) -> f32 {
        self.seed = (self.seed * 1103515245 + 12345) % 2147483648;
        return f32(self.seed) / 2147483648.0f;
    }
    /// -1..1.
    fn white(self: &mut Self) -> f32 { return self.next() * 2.0f - 1.0f; }
}

/// How one ROM's metallic recording is made.
struct MetalSpec {
    /// Inharmonic partials: how many, their band, base decay time constant,
    /// how much faster high ones decay (exponent), level.
    var partials: i32;
    var low_hz: f32;
    var high_hz: f32;
    var tau: f32;
    var tilt: f32;
    var partial_level: f32;
    /// Share of partials that swell in over tens of milliseconds (a crash's
    /// wash builds after the hit).
    var swell: f32;
    /// Filtered noise: level, decay, high-pass corner.
    var noise_level: f32;
    var noise_tau: f32;
    var noise_hz: f32;
    /// The stick's transient: level and decay.
    var stick_level: f32;
    var stick_tau: f32;
};

/// Render a metallic recording into `rom` at the ROM clock, then normalize it
/// and quantize it to 6 bits (64 levels, -32 .. 31), as the 909's ROMs hold.
fn build_rom(rom: &list<f32>, words: i64, spec: MetalSpec, seed: i64) -> void {
    let r: f32 = rom_rate();
    var rng: Rng = Rng { seed: seed };
    var i: i64 = 0;
    while i < words { set_f32(rom, i, 0.0f); i = i + 1; }

    // Partials, each a decaying sine (coupled form, one at a time).
    let span: f32 = logf(spec.high_hz / spec.low_hz);
    let norm: f32 = spec.partial_level / sqrtf(f32(spec.partials));
    var p: i32 = 0;
    while p < spec.partials {
        let hz: f32 = spec.low_hz * expf(rng.next() * span);
        let amp: f32 = norm * (0.3f + 0.7f * rng.next());
        let tau: f32 = spec.tau * powf(hz / spec.low_hz, -spec.tilt) * (0.6f + 0.8f * rng.next());
        let damp: f32 = decay_coef(tau, r);
        let w: f32 = 2.0f * pi() * hz / r;
        let cw: f32 = cosf(w);
        let sw: f32 = sinf(w);
        let phase: f32 = 2.0f * pi() * rng.next();
        var c: f32 = amp * cosf(phase);
        var s: f32 = amp * sinf(phase);
        // Swelling partials rise with a 20 .. 80 ms time constant.
        var rise: f32 = 0.0f;
        var rise_coef: f32 = 0.0f;
        if rng.next() < spec.swell { rise = 1.0f; rise_coef = decay_coef(0.02f + 0.06f * rng.next(), r); }
        i = 0;
        while i < words {
            let cn: f32 = (c * cw - s * sw) * damp;
            let sn: f32 = (c * sw + s * cw) * damp;
            c = cn;
            s = sn;
            set_f32(rom, i, rom[i] + s * (1.0f - rise));
            rise = rise * rise_coef;
            i = i + 1;
        }
        p = p + 1;
    }

    // Noise through a 4th-order high-pass, and the stick's broadband click.
    var hp: Svf = Svf::new();
    var hp2: Svf = Svf::new();
    hp.configure(spec.noise_hz, 0.70710678f, r);
    hp2.configure(spec.noise_hz, 0.70710678f, r);
    let noise_coef: f32 = decay_coef(spec.noise_tau, r);
    let stick_coef: f32 = decay_coef(spec.stick_tau, r);
    var noise: f32 = spec.noise_level;
    var stick: f32 = spec.stick_level;
    var stick_hp: Svf = Svf::new();
    stick_hp.configure(1500.0f, 0.70710678f, r);
    i = 0;
    while i < words {
        let w: f32 = rng.white();
        let n: f32 = hp2.process(hp.process(w, 1), 1) * noise + stick_hp.process(w, 1) * stick;
        set_f32(rom, i, rom[i] + n);
        noise = noise * noise_coef;
        stick = stick * stick_coef;
        i = i + 1;
    }

    // The recording fades out over its last quarter, so playback never stops
    // on a step.
    let fade_from: i64 = words - words / 4;
    i = fade_from;
    while i < words {
        let x: f32 = f32(words - i) / f32(words - fade_from);
        set_f32(rom, i, rom[i] * x * x);
        i = i + 1;
    }

    // Normalize to full scale and quantize to the 6-bit DAC's 64 levels.
    var top: f32 = 0.0f;
    i = 0;
    while i < words { top = smax(top, fabsf(rom[i])); i = i + 1; }
    let scale: f32 = top > 0.0f ? 31.0f / top : 0.0f;
    i = 0;
    while i < words {
        let q: i64 = llroundf(sclamp(rom[i] * scale, -32.0f, 31.0f));
        set_f32(rom, i, f32(q) / 32.0f);
        i = i + 1;
    }
}

/// The whole machine.
struct M09 {
    var rate: f32;

    // --- Settings ----------------------------------------------------------
    /// Instrument levels (linear).
    var level_bd: f32;
    var level_sd: f32;
    var level_lt: f32;
    var level_mt: f32;
    var level_ht: f32;
    var level_rs: f32;
    var level_cp: f32;
    var level_ch: f32;
    var level_oh: f32;
    var level_cr: f32;
    var level_rd: f32;
    /// Knobs, 0..1.
    var bd_tune: f32;
    var bd_attack: f32;
    var bd_decay: f32;
    var sd_tune: f32;
    var sd_tone: f32;
    var snappy: f32;
    var lt_tune: f32;
    var lt_decay: f32;
    var mt_tune: f32;
    var mt_decay: f32;
    var ht_tune: f32;
    var ht_decay: f32;
    var ch_decay: f32;
    var oh_decay: f32;
    var cr_tune: f32;
    var rd_tune: f32;
    /// Accent amount 0..1 (0 = none, 1 = +9 dB).
    var accent: f32;
    /// 0: two levels (velocity above 100 accents); 1: velocity scales the level.
    var dynamics: i32;
    var output_target: f32;
    var output_gain: f32;

    // --- Bass drum ---------------------------------------------------------
    var bd_vco: Vco;
    var bd_env: Vca;
    var bd_decay_env: Decay;
    /// Pitch envelope: a slow sweep and a fast kick at the very start.
    var bd_sweep: f32;
    var bd_sweep_coef: f32;
    var bd_sweep_depth: f32;
    var bd_kick: f32;
    var bd_kick_coef: f32;
    var bd_hz: f32;
    /// The click: a pulse (samples left), then a noise burst.
    var bd_pulse_left: f32;
    var bd_pulse_samples: f32;
    var bd_pulse_lp: f32;
    var bd_pulse_lp_coef: f32;
    var bd_click: f32;
    var bd_click_coef: f32;
    var bd_click_level: f32;
    var bd_click_hp: Svf;
    var bd_click_lp: Svf;

    // --- Snare -------------------------------------------------------------
    var sd_vco1: Vco;
    var sd_vco2: Vco;
    var sd_env1: Vca;
    var sd_env2: Vca;
    var sd_damp1: f32;
    var sd_damp2: f32;
    var sd_bend: f32;
    var sd_bend_coef: f32;
    var sd_noise: f32;
    var sd_noise_decay: Decay;
    var sd_hp: Svf;
    var sd_lp: Svf;

    // --- Toms --------------------------------------------------------------
    var lt: Tom;
    var mt: Tom;
    var ht: Tom;

    // --- Rim shot ------------------------------------------------------------
    var rs1: Resonator;
    var rs2: Resonator;
    var rs3: Resonator;
    var rs_damp1: f32;
    var rs_damp2: f32;
    var rs_damp3: f32;
    var rs_hp: Svf;
    var rs_gain: f32;

    // --- Hand clap -----------------------------------------------------------
    var cp_bp: Svf;
    var cp_hp: Svf;
    var cp_tail_bp: Svf;
    /// Samples since the hit (negative: idle).
    var cp_time: f32;
    var cp_level: f32;
    /// The current burst's sawtooth level, and the tail.
    var cp_burst: f32;
    var cp_burst_coef: f32;
    var cp_tail: f32;
    var cp_tail_coef: f32;

    // --- Sampled voices --------------------------------------------------------
    var rom_ch: list<f32>;
    var rom_oh: list<f32>;
    var rom_cr: list<f32>;
    var rom_rd: list<f32>;
    var ch: RomVoice;
    var oh: RomVoice;
    var cr: RomVoice;
    var rd: RomVoice;
    /// ROM words per output sample.
    var hat_step: f32;
    var cr_step: f32;
    var rd_step: f32;
    /// The hats' VCAs, with a short hold before the decay.
    var ch_env: f32;
    var ch_decay_env: Decay;
    var oh_env: f32;
    var oh_decay_env: Decay;
    var oh_choked: bool;
    var choke_coef: f32;
    var cr_env: f32;
    var rd_env: f32;
    /// The hat and cymbal outputs' high-pass (the mixer's coupling).
    var metal_hp: Svf;

    var seed: i64;
};

impl M09 {
    fn new(sample_rate: f32) -> M09 {
        let rate: f32 = sclamp(sample_rate, 8000.0f, 384000.0f);
        var m: M09 = M09 {
            rate: rate,
            level_bd: 1.0f, level_sd: 1.0f, level_lt: 1.0f, level_mt: 1.0f, level_ht: 1.0f, level_rs: 1.0f,
            level_cp: 1.0f, level_ch: 1.0f, level_oh: 1.0f, level_cr: 1.0f, level_rd: 1.0f,
            bd_tune: 0.5f, bd_attack: 0.5f, bd_decay: 0.5f, sd_tune: 0.5f, sd_tone: 0.5f, snappy: 0.5f,
            lt_tune: 0.5f, lt_decay: 0.5f, mt_tune: 0.5f, mt_decay: 0.5f, ht_tune: 0.5f, ht_decay: 0.5f,
            ch_decay: 0.5f, oh_decay: 0.5f, cr_tune: 0.5f, rd_tune: 0.5f,
            accent: 0.5f, dynamics: 0, output_target: 1.0f, output_gain: 1.0f,
            bd_vco: Vco::new(), bd_env: Vca::new(), bd_decay_env: Decay::new(),
            bd_sweep: 0.0f, bd_sweep_coef: 0.0f, bd_sweep_depth: 0.0f, bd_kick: 0.0f, bd_kick_coef: 0.0f, bd_hz: 50.0f,
            bd_pulse_left: 0.0f, bd_pulse_samples: 1.0f, bd_pulse_lp: 0.0f, bd_pulse_lp_coef: 0.0f,
            bd_click: 0.0f, bd_click_coef: 0.0f, bd_click_level: 0.0f, bd_click_hp: Svf::new(), bd_click_lp: Svf::new(),
            sd_vco1: Vco::new(), sd_vco2: Vco::new(), sd_env1: Vca::new(), sd_env2: Vca::new(), sd_damp1: 0.0f, sd_damp2: 0.0f,
            sd_bend: 0.0f, sd_bend_coef: 0.0f, sd_noise: 0.0f, sd_noise_decay: Decay::new(), sd_hp: Svf::new(), sd_lp: Svf::new(),
            lt: Tom::new(), mt: Tom::new(), ht: Tom::new(),
            rs1: Resonator::new(), rs2: Resonator::new(), rs3: Resonator::new(),
            rs_damp1: 0.0f, rs_damp2: 0.0f, rs_damp3: 0.0f, rs_hp: Svf::new(), rs_gain: 1.0f,
            cp_bp: Svf::new(), cp_hp: Svf::new(), cp_tail_bp: Svf::new(), cp_time: -1.0f, cp_level: 0.0f,
            cp_burst: 0.0f, cp_burst_coef: 0.0f, cp_tail: 0.0f, cp_tail_coef: 0.0f,
            rom_ch: [0.0f; ch_words()], rom_oh: [0.0f; oh_words()],
            rom_cr: [0.0f; cymbal_words()], rom_rd: [0.0f; cymbal_words()],
            ch: RomVoice::new(), oh: RomVoice::new(), cr: RomVoice::new(), rd: RomVoice::new(),
            hat_step: 1.0f, cr_step: 1.0f, rd_step: 1.0f,
            ch_env: 0.0f, ch_decay_env: Decay::new(), oh_env: 0.0f, oh_decay_env: Decay::new(), oh_choked: false,
            choke_coef: 0.0f, cr_env: 0.0f, rd_env: 0.0f, metal_hp: Svf::new(),
            seed: 9090909
        };
        m.build_roms();
        m.configure();
        return m;
    }

    /// The four ROMs, built once per instance.
    fn build_roms(self: &mut Self) -> void {
        // Closed hat: a tight, noisy sizzle high up.
        build_rom(self.rom_ch, ch_words(), MetalSpec {
            partials: 36, low_hz: 5200.0f, high_hz: 14500.0f, tau: 0.05f, tilt: 0.5f, partial_level: 0.9f,
            swell: 0.0f, noise_level: 0.7f, noise_tau: 0.035f, noise_hz: 6500.0f, stick_level: 0.5f, stick_tau: 0.0015f
        }, 909001);
        // Open hat: the same metal ringing on.
        build_rom(self.rom_oh, oh_words(), MetalSpec {
            partials: 56, low_hz: 4600.0f, high_hz: 14500.0f, tau: 0.45f, tilt: 0.6f, partial_level: 1.0f,
            swell: 0.1f, noise_level: 0.6f, noise_tau: 0.3f, noise_hz: 5500.0f, stick_level: 0.4f, stick_tau: 0.0015f
        }, 909002);
        // Crash: a broad wash that swells after the hit and fades for seconds.
        build_rom(self.rom_cr, cymbal_words(), MetalSpec {
            partials: 72, low_hz: 2400.0f, high_hz: 15000.0f, tau: 0.75f, tilt: 0.75f, partial_level: 1.0f,
            swell: 0.45f, noise_level: 0.9f, noise_tau: 0.55f, noise_hz: 3200.0f, stick_level: 0.5f, stick_tau: 0.002f
        }, 909003);
        // Ride: a clear ping from lower, longer partials over a quiet hiss.
        build_rom(self.rom_rd, cymbal_words(), MetalSpec {
            partials: 72, low_hz: 1900.0f, high_hz: 13000.0f, tau: 0.95f, tilt: 0.45f, partial_level: 1.0f,
            swell: 0.0f, noise_level: 0.3f, noise_tau: 0.5f, noise_hz: 5000.0f, stick_level: 0.6f, stick_tau: 0.001f
        }, 909004);
    }

    /// Coefficients that depend only on the sample rate.
    fn configure(self: &mut Self) -> void {
        let r: f32 = self.rate;
        self.bd_env.configure(r);
        self.bd_kick_coef = decay_coef(0.0025f, r);
        self.bd_pulse_samples = smax(1.0f, 0.0006f * r);
        self.bd_pulse_lp_coef = lp_coef(4000.0f, r);
        self.bd_click_coef = decay_coef(0.0018f, r);
        self.bd_click_hp.configure(800.0f, 0.70710678f, r);
        self.bd_click_lp.configure(7000.0f, 0.70710678f, r);

        self.sd_env1.configure(r);
        self.sd_env2.configure(r);
        self.sd_damp1 = decay_coef(0.045f, r);
        self.sd_damp2 = decay_coef(0.028f, r);
        self.sd_bend_coef = decay_coef(0.008f, r);
        self.sd_hp.configure(1100.0f, 0.70710678f, r);

        self.lt.configure(r);
        self.mt.configure(r);
        self.ht.configure(r);

        self.rs_damp1 = decay_coef(0.006f, r);
        self.rs_damp2 = decay_coef(0.004f, r);
        self.rs_damp3 = decay_coef(0.0025f, r);
        self.rs_hp.configure(420.0f, 0.7f, r);

        self.cp_bp.configure(1150.0f, 1.6f, r);
        self.cp_hp.configure(700.0f, 0.70710678f, r);
        self.cp_tail_bp.configure(1050.0f, 1.2f, r);
        self.cp_burst_coef = decay_coef(0.0032f, r);
        self.cp_tail_coef = decay_coef(0.075f, r);

        self.ch.configure(r);
        self.oh.configure(r);
        self.cr.configure(r);
        self.rd.configure(r);
        self.hat_step = rom_rate() / r;
        self.choke_coef = decay_coef(0.003f, r);
        self.metal_hp.configure(250.0f, 0.70710678f, r);
        self.configure_knobs();
    }

    /// Coefficients that follow the knobs.
    fn configure_knobs(self: &mut Self) -> void {
        let r: f32 = self.rate;
        // BD Tune: the pitch sweep's depth (2x .. 5x the pitch at the hit)
        // and length, and a little of the resting pitch.
        let t: f32 = sclamp(self.bd_tune, 0.0f, 1.0f);
        self.bd_hz = 47.0f + 9.0f * t;
        self.bd_sweep_depth = 1.0f + 3.0f * t;
        self.bd_sweep_coef = decay_coef(0.018f + 0.03f * t, r);
        self.bd_click_level = sclamp(self.bd_attack, 0.0f, 1.0f);
        // SD Tone: the noise low-pass, 4 .. 14 kHz.
        self.sd_lp.configure(knob3(self.sd_tone, 4000.0f, 7500.0f, 14000.0f), 0.70710678f, r);
        // Toms: Tune over about a fifth, Decay about 0.05 .. 0.4 s time constant.
        self.lt.retune(knob3(self.lt_tune, 72.0f, 90.0f, 112.0f), knob3(self.lt_decay, 0.06f, 0.14f, 0.38f), r);
        self.mt.retune(knob3(self.mt_tune, 105.0f, 130.0f, 162.0f), knob3(self.mt_decay, 0.05f, 0.12f, 0.32f), r);
        self.ht.retune(knob3(self.ht_tune, 150.0f, 185.0f, 230.0f), knob3(self.ht_decay, 0.045f, 0.1f, 0.27f), r);
        // Cymbal Tune runs the ROM clock from 0.7x to 1.4x.
        self.cr_step = rom_rate() * exp2f((self.cr_tune - 0.5f)) / r;
        self.rd_step = rom_rate() * exp2f((self.rd_tune - 0.5f)) / r;
    }

    fn reset(self: &mut Self) -> void {
        self.bd_vco.reset(); self.bd_env.reset(); self.bd_sweep = 0.0f; self.bd_kick = 0.0f;
        self.bd_pulse_left = 0.0f; self.bd_pulse_lp = 0.0f; self.bd_click = 0.0f;
        self.bd_click_hp.reset(); self.bd_click_lp.reset();
        self.sd_vco1.reset(); self.sd_vco2.reset(); self.sd_env1.reset(); self.sd_env2.reset(); self.sd_bend = 0.0f;
        self.sd_noise = 0.0f; self.sd_hp.reset(); self.sd_lp.reset();
        self.lt.reset(); self.mt.reset(); self.ht.reset();
        self.rs1.reset(); self.rs2.reset(); self.rs3.reset(); self.rs_hp.reset();
        self.cp_bp.reset(); self.cp_hp.reset(); self.cp_tail_bp.reset(); self.cp_time = -1.0f;
        self.cp_burst = 0.0f; self.cp_tail = 0.0f;
        self.ch.reset(); self.oh.reset(); self.cr.reset(); self.rd.reset();
        self.ch_env = 0.0f; self.oh_env = 0.0f; self.oh_choked = false; self.cr_env = 0.0f; self.rd_env = 0.0f;
        self.metal_hp.reset();
        self.output_gain = self.output_target;
    }

    fn white(self: &mut Self) -> f32 {
        self.seed = (self.seed * 1103515245 + 12345) % 2147483648;
        return f32(self.seed) / 1073741824.0f - 1.0f;
    }

    /// Hit level for velocity 0..1: accent adds up to +9 dB; in Velocity
    /// mode, velocity also scales the level.
    fn hit_gain(self: M09, velocity: f32) -> f32 {
        let v: f32 = sclamp(velocity, 0.0f, 1.0f);
        if self.dynamics == 1 { return v * v * exp2f(self.accent * 1.5f); }
        return v > 100.5f / 127.0f ? exp2f(self.accent * 1.5f) : 1.0f;
    }

    /// Strike instrument `which` (0..10) at velocity 0..1.
    fn trigger(self: &mut Self, which: i32, velocity: f32) -> void {
        let gain: f32 = self.hit_gain(velocity);
        if gain <= 0.0f { return; }
        let r: f32 = self.rate;
        if which == bass_drum() {
            if !self.bd_env.sounding() { self.bd_vco.reset(); }
            self.bd_env.strike(gain);
            // Decay: a short hold, then the VCA's time constant, 40 dB down
            // after about 0.2 s .. 1.3 s.
            let d: f32 = knob3(self.bd_decay, 0.04f, 0.11f, 0.28f);
            self.bd_decay_env.start(d * 2.5f, d, 0.012f, r);
            self.bd_sweep = 1.0f;
            self.bd_kick = 1.0f;
            self.bd_pulse_left = self.bd_pulse_samples;
            self.bd_click = gain;
        } else if which == snare_drum() {
            if !self.sd_env1.sounding() && !self.sd_env2.sounding() { self.sd_vco1.reset(); self.sd_vco2.reset(); }
            self.sd_env1.strike(gain);
            self.sd_env2.strike(0.55f * gain);
            self.sd_bend = 1.0f;
            // Tone also lengthens the noise: 60 .. 150 ms time constant.
            let tau: f32 = knob3(self.sd_tone, 0.06f, 0.095f, 0.15f);
            self.sd_noise_decay.start(tau * 0.5f, tau, 0.01f, r);
            self.sd_noise = restrike(self.sd_noise, gain * 2.4f * sclamp(self.snappy, 0.0f, 1.0f));
        } else if which == low_tom() { self.lt.strike(gain); }
        else if which == mid_tom() { self.mt.strike(gain); }
        else if which == high_tom() { self.ht.strike(gain); }
        else if which == rim_shot() {
            self.rs1.strike(gain);
            self.rs2.strike(0.7f * gain);
            self.rs3.strike(0.35f * gain);
            self.rs_gain = gain;
        } else if which == hand_clap() {
            self.cp_time = 0.0f;
            self.cp_level = gain;
        } else if which == closed_hat() {
            // CH Decay: 6 .. 40 ms time constant after a 2 ms hold.
            self.ch.strike(self.ch_env);
            self.ch_env = gain;
            self.ch_decay_env.start(1.0f, knob3(self.ch_decay, 0.006f, 0.015f, 0.04f), 0.002f, r);
            // The closed hat cuts the open one.
            self.oh_choked = true;
        } else if which == open_hat() {
            // OH Decay: 40 .. 450 ms time constant after a 5 ms hold.
            self.oh.strike(self.oh_env);
            self.oh_env = gain;
            self.oh_decay_env.start(1.0f, knob3(self.oh_decay, 0.04f, 0.14f, 0.45f), 0.005f, r);
            self.oh_choked = false;
        } else if which == crash() {
            self.cr.strike(self.cr_env);
            self.cr_env = gain;
        } else if which == ride() {
            self.rd.strike(self.rd_env);
            self.rd_env = gain;
        }
    }

    fn bd_active(self: M09) -> bool {
        return self.bd_env.sounding() || self.bd_click > silent() || self.bd_pulse_left > 0.0f
            || fabsf(self.bd_pulse_lp) > silent();
    }

    /// Bass drum: the swept VCO through the VCA, plus the click.
    fn bass(self: &mut Self) -> f32 {
        let r: f32 = self.rate;
        let hz: f32 = self.bd_hz * (1.0f + self.bd_sweep_depth * self.bd_sweep + 3.0f * self.bd_kick);
        self.bd_sweep = self.bd_sweep * self.bd_sweep_coef;
        self.bd_kick = self.bd_kick * self.bd_kick_coef;
        // The 909's kick is a rounded sine with flattened tops.
        var out: f32 = self.bd_vco.tick(hz, 1.6f, r) * self.bd_env.tick(self.bd_decay_env.next());
        // Click: a 0.6 ms pulse through a 4 kHz low-pass and a noise burst.
        var pulse: f32 = 0.0f;
        if self.bd_pulse_left > 0.0f { pulse = self.bd_click; self.bd_pulse_left = self.bd_pulse_left - 1.0f; }
        self.bd_pulse_lp = self.bd_pulse_lp + (pulse - self.bd_pulse_lp) * self.bd_pulse_lp_coef;
        let n: f32 = self.bd_click_lp.process(self.bd_click_hp.process(self.white(), 1), 0);
        out = out + self.bd_click_level * (1.2f * self.bd_pulse_lp + 1.5f * n * self.bd_click);
        self.bd_click = self.bd_click * self.bd_click_coef;
        return out;
    }

    fn sd_active(self: M09) -> bool { return self.sd_env1.sounding() || self.sd_env2.sounding() || self.sd_noise > silent(); }

    /// Snare: two bent VCOs and filtered noise.
    fn snare(self: &mut Self) -> f32 {
        let r: f32 = self.rate;
        let tune: f32 = exp2f((self.sd_tune - 0.5f) * 0.6f);
        let bend: f32 = 1.0f + 0.5f * self.sd_bend;
        self.sd_bend = self.sd_bend * self.sd_bend_coef;
        var out: f32 = self.sd_vco1.tick(180.0f * tune * bend, 1.0f, r) * self.sd_env1.tick(self.sd_damp1)
                     + self.sd_vco2.tick(330.0f * tune * bend, 1.0f, r) * self.sd_env2.tick(self.sd_damp2);
        // The noise filters run every sample, so the noise never starts on a
        // resting filter.
        let n: f32 = self.sd_lp.process(self.sd_hp.process(self.white(), 1), 0);
        if self.sd_noise > silent() {
            out = out + n * self.sd_noise;
            self.sd_noise = self.sd_noise * self.sd_noise_decay.next();
        }
        return out;
    }

    fn rs_active(self: M09) -> bool {
        return self.rs1.amplitude() > silent() || self.rs2.amplitude() > silent() || self.rs3.amplitude() > silent();
    }

    /// Rim shot: three rings, high-passed and driven.
    fn rim(self: &mut Self) -> f32 {
        let r: f32 = self.rate;
        let x: f32 = self.rs1.tick(495.0f, self.rs_damp1, r) + self.rs2.tick(1720.0f, self.rs_damp2, r)
                   + self.rs3.tick(3350.0f, self.rs_damp3, r);
        return tanhf(4.0f * self.rs_hp.process(x, 1) / self.rs_gain) * self.rs_gain * 0.6f;
    }

    fn cp_active(self: M09) -> bool { return self.cp_time >= 0.0f; }

    /// Hand clap: noise band-passed around 1.15 kHz, struck by three sawtooth
    /// bursts 10 ms apart, then the tail (around 1 kHz) from 30 ms on.
    fn clap(self: &mut Self) -> f32 {
        let ms: f32 = 1000.0f / self.rate;
        let now: f32 = self.cp_time * ms;
        let next: f32 = (self.cp_time + 1.0f) * ms;
        if (now <= 0.0f && next > 0.0f) || (now <= 10.0f && next > 10.0f) || (now <= 20.0f && next > 20.0f) {
            self.cp_burst = self.cp_level;
        }
        if now <= 30.0f && next > 30.0f { self.cp_tail = self.cp_level * 0.85f; self.cp_burst = self.cp_level * 0.8f; }
        let h: f32 = self.cp_hp.process(self.white(), 1);
        let out: f32 = self.cp_bp.process(h, 2) * self.cp_burst + self.cp_tail_bp.process(h, 2) * self.cp_tail;
        self.cp_burst = self.cp_burst * self.cp_burst_coef;
        if now > 30.0f { self.cp_tail = self.cp_tail * self.cp_tail_coef; }
        self.cp_time = self.cp_time + 1.0f;
        if now > 40.0f && self.cp_tail < silent() { self.cp_time = -1.0f; }
        return out;
    }

    fn rom_active(self: M09) -> bool {
        return self.ch.active() || self.oh.active() || self.cr.active() || self.rd.active();
    }

    /// The ROM voices: each head through its VCA; fading tails at their own gain.
    fn samples(self: &mut Self) -> f32 {
        var tail: f32 = 0.0f;
        var out: f32 = 0.0f;
        if self.ch.active() {
            let x: f32 = self.ch.tick(self.rom_ch, ch_words(), self.hat_step, &mut tail);
            out = out + (x * self.ch_env + tail) * self.level_ch;
            self.ch_env = self.ch_env * self.ch_decay_env.next();
            if self.ch_env < silent() { self.ch.head.on = false; }
        }
        if self.oh.active() {
            let x: f32 = self.oh.tick(self.rom_oh, oh_words(), self.hat_step, &mut tail);
            out = out + (x * self.oh_env + tail) * self.level_oh;
            let d: f32 = self.oh_decay_env.next();
            self.oh_env = self.oh_env * (self.oh_choked ? self.choke_coef : d);
            if self.oh_env < silent() { self.oh.head.on = false; }
        }
        if self.cr.active() {
            let x: f32 = self.cr.tick(self.rom_cr, cymbal_words(), self.cr_step, &mut tail);
            out = out + (x * self.cr_env + tail) * self.level_cr * 0.8f;
        }
        if self.rd.active() {
            let x: f32 = self.rd.tick(self.rom_rd, cymbal_words(), self.rd_step, &mut tail);
            out = out + (x * self.rd_env + tail) * self.level_rd * 0.6f;
        }
        return out;
    }

    fn toms_active(self: M09) -> bool { return self.lt.active() || self.mt.active() || self.ht.active(); }

    fn active(self: M09) -> bool {
        return self.bd_active() || self.sd_active() || self.toms_active() || self.rs_active() || self.cp_active()
            || self.rom_active();
    }

    fn process(self: &mut Self, out_right: ptr<f32>) -> f32 {
        let r: f32 = self.rate;
        self.output_gain = self.output_gain + (self.output_target - self.output_gain) * 0.002f;
        var mix: f32 = 0.0f;
        if self.bd_active() { mix = mix + self.bass() * self.level_bd * 0.55f; }
        if self.sd_active() { mix = mix + self.snare() * self.level_sd * 0.45f; }
        if self.toms_active() {
            let n: f32 = self.white();
            if self.lt.active() { mix = mix + self.lt.tick(n, r) * self.level_lt * 0.6f; }
            if self.mt.active() { mix = mix + self.mt.tick(n, r) * self.level_mt * 0.6f; }
            if self.ht.active() { mix = mix + self.ht.tick(n, r) * self.level_ht * 0.6f; }
        }
        if self.rs_active() { mix = mix + self.rim() * self.level_rs; }
        else { self.rs1.reset(); self.rs2.reset(); self.rs3.reset(); }
        if self.cp_active() { mix = mix + self.clap() * self.level_cp * 1.6f; }
        // The ROM voices share the mixer's coupling high-pass, which runs all
        // the time so a hit never strikes a resting filter.
        let metal: f32 = self.rom_active() ? self.samples() : 0.0f;
        mix = mix + self.metal_hp.process(metal, 1) * 0.5f;
        let out: f32 = mix * self.output_gain;
        unsafe { *out_right = out; }
        return out;
    }
}

// --- C ABI -------------------------------------------------------------------

/// @brief Allocate an instance for a sample rate (8 kHz .. 384 kHz). Builds
/// the sample ROMs, so call it off the audio thread.
fn mla09_create(sample_rate: f32) -> ptr<M09> {
    let handle: ptr<M09> = calloc(1, size_of(M09));
    unsafe { *handle = M09::new(sample_rate); }
    return handle;
}

/// @brief Release an instance created by `mla09_create`.
fn mla09_destroy(handle: ptr<M09>) {
    // Move the value out so its ROM lists are dropped, then free the block.
    unsafe { var dead: M09 = *handle; dead.reset(); }
    unsafe { free(handle); }
}

/// @brief Silence every voice and clear filters; settings stay.
fn mla09_reset(handle: ptr<M09>) { unsafe { (*handle).reset(); } }

/// @brief Strike instrument `which` (0 BD, 1 SD, 2 LT, 3 MT, 4 HT, 5 RS,
/// 6 CP, 7 CH, 8 OH, 9 CR, 10 RD) at velocity 0..1.
fn mla09_trigger(handle: ptr<M09>, which: i32, velocity: f32) {
    unsafe { (*handle).trigger(which, velocity); }
}

/// @brief 1 while any voice sounds, else 0.
fn mla09_active(handle: ptr<M09>) -> i32 {
    unsafe { return (*handle).active() ? 1 : 0; }
}

/// @brief Set one parameter (the VST3 parameter ID minus 100):
/// 0 output gain (linear), 1 accent 0..1, 2 dynamics (0 accent, 1 velocity),
/// then levels (linear) and knobs (0..1) in panel order:
/// 3 BD level, 4 BD tune, 5 BD attack, 6 BD decay,
/// 7 SD level, 8 SD tune, 9 SD tone, 10 SD snappy,
/// 11 LT level, 12 LT tune, 13 LT decay, 14 MT level, 15 MT tune, 16 MT decay,
/// 17 HT level, 18 HT tune, 19 HT decay, 20 RS level, 21 CP level,
/// 22 CH level, 23 CH decay, 24 OH level, 25 OH decay,
/// 26 CR level, 27 CR tune, 28 RD level, 29 RD tune.
fn mla09_set(handle: ptr<M09>, index: i32, value: f32) {
    unsafe {
        let k: f32 = sclamp(value, 0.0f, 1.0f);
        let level: f32 = smax(value, 0.0f);
        if index == 0 {
            (*handle).output_target = level;
            // Glide only while something sounds.
            if !(*handle).active() { (*handle).output_gain = (*handle).output_target; }
        }
        else if index == 1 { (*handle).accent = k; }
        else if index == 2 { (*handle).dynamics = value > 0.5f ? 1 : 0; }
        else if index == 3 { (*handle).level_bd = level; }
        else if index == 4 { (*handle).bd_tune = k; (*handle).configure_knobs(); }
        else if index == 5 { (*handle).bd_attack = k; (*handle).configure_knobs(); }
        else if index == 6 { (*handle).bd_decay = k; }
        else if index == 7 { (*handle).level_sd = level; }
        else if index == 8 { (*handle).sd_tune = k; }
        else if index == 9 { (*handle).sd_tone = k; (*handle).configure_knobs(); }
        else if index == 10 { (*handle).snappy = k; }
        else if index == 11 { (*handle).level_lt = level; }
        else if index == 12 { (*handle).lt_tune = k; (*handle).configure_knobs(); }
        else if index == 13 { (*handle).lt_decay = k; (*handle).configure_knobs(); }
        else if index == 14 { (*handle).level_mt = level; }
        else if index == 15 { (*handle).mt_tune = k; (*handle).configure_knobs(); }
        else if index == 16 { (*handle).mt_decay = k; (*handle).configure_knobs(); }
        else if index == 17 { (*handle).level_ht = level; }
        else if index == 18 { (*handle).ht_tune = k; (*handle).configure_knobs(); }
        else if index == 19 { (*handle).ht_decay = k; (*handle).configure_knobs(); }
        else if index == 20 { (*handle).level_rs = level; }
        else if index == 21 { (*handle).level_cp = level; }
        else if index == 22 { (*handle).level_ch = level; }
        else if index == 23 { (*handle).ch_decay = k; }
        else if index == 24 { (*handle).level_oh = level; }
        else if index == 25 { (*handle).oh_decay = k; }
        else if index == 26 { (*handle).level_cr = level; }
        else if index == 27 { (*handle).cr_tune = k; (*handle).configure_knobs(); }
        else if index == 28 { (*handle).level_rd = level; }
        else if index == 29 { (*handle).rd_tune = k; (*handle).configure_knobs(); }
    }
}

/// @brief Process one sample: stereo out (left returned, right through `out_right`).
fn mla09_process(handle: ptr<M09>, out_right: ptr<f32>) -> f32 {
    unsafe { return (*handle).process(out_right); }
}
