/// \file mla_09_dsp.mla
/// \brief C-ABI bridge: a TR-909 style drum machine.
///
/// One `M09` per plug-in instance, heap-allocated with `calloc` and handed to
/// the C++ VST3 layer as an opaque pointer. The C++ side maps MIDI keys to the
/// eleven instruments and calls `mla09_trigger`; this file sounds them.
///
/// Like the 909, the machine is a hybrid:
///
/// - **Analog voices.** Bass drum, snare, three toms, rim shot and hand clap
///   are synthesized, following measurements of TR-909 recordings made
///   across their knobs (Tune, Attack, Decay, Tone, Snappy at panel positions
///   1, 3, 6, 9 and 11): pitch glides, VCA holds and decays, harmonics, noise
///   colour and lengths. Each voice's comment has its numbers.
/// - **Sampled voices.** The hi-hats (both from one ROM, as on the 909),
///   crash and ride play samples from ROM. Roland's ROM data is not ours to
///   ship, so `M09::new` builds the ROMs itself in the 909's format: metallic
///   recordings (inharmonic partials with frequency-dependent decays over
///   filtered noise and a stick transient) at a 32 kHz ROM clock, quantized to
///   64 levels, and fitted to the spectra and lengths of 909 recordings.
///   Recordings can replace them (`mla09_rom_begin`, `mla09_rom_write`; the
///   C++ side loads them from a folder). Playback reads a ROM from the start
///   on every hit, then a VCA. The hats' VCA has Decay; the closed hat chokes
///   the open hat. The cymbals' Tune changes the ROM clock, so a lower tune
///   is also longer.
/// - **Accent** scales a hit's level; **Drive** saturates the output.
///
/// Parameter indexes for `mla09_set` are listed there. Knobs are 0..1, as on
/// the panel; the C++ side maps levels to linear gains.

mod dsp::detail;
mod std::vec;
use dsp::detail::expf;
use dsp::detail::logf;
use dsp::detail::sinf;
use dsp::detail::cosf;
use dsp::detail::tanf;
use dsp::detail::tanhf;
use dsp::detail::llroundf;
use std::vec::set_f32;

extern fn calloc(count: i64, size: i64) -> ptr<M09>;
extern fn free(block: ptr<M09>) -> void;
extern fn exp2f(value: f32) -> f32;
extern fn sqrtf(value: f32) -> f32;
extern fn fabsf(value: f32) -> f32;
extern fn powf(base: f32, exponent: f32) -> f32;

/// Instruments (`mla09_trigger`), in the 909's panel order.
fn bass_drum() -> i32 { return 0; }
fn snare_drum() -> i32 { return 1; }
fn low_tom() -> i32 { return 2; }
fn mid_tom() -> i32 { return 3; }
fn high_tom() -> i32 { return 4; }
fn rim_shot() -> i32 { return 5; }
fn hand_clap() -> i32 { return 6; }
fn closed_hat() -> i32 { return 7; }
fn open_hat() -> i32 { return 8; }
fn crash() -> i32 { return 9; }
fn ride() -> i32 { return 10; }

/// Below this an envelope counts as finished (-100 dB).
fn silent() -> f32 { return 0.00001f; }

fn pi() -> f32 { return 3.14159265358979323846f; }

/// The ROM clock the samples are stored at, in Hz.
fn rom_rate() -> f32 { return 32000.0f; }

/// ROM capacities in words: the hi-hat ROM (both hats) and each cymbal.
fn hat_words() -> i64 { return 32768; }
fn cymbal_words() -> i64 { return 65536; }

fn sclamp(value: f32, low: f32, high: f32) -> f32 {
    if value < low { return low; }
    if value > high { return high; }
    return value;
}

fn smax(a: f32, b: f32) -> f32 { return a > b ? a : b; }
fn smin(a: f32, b: f32) -> f32 { return a < b ? a : b; }

/// Per-sample multiplier of an exponential decay with time constant `seconds`.
fn decay_coef(seconds: f32, rate: f32) -> f32 {
    let samples: f32 = seconds * rate;
    if samples < 1.0f { return 0.0f; }
    return expf(-1.0f / samples);
}

/// One-pole low-pass coefficient for `hz`.
fn lp_coef(hz: f32, rate: f32) -> f32 {
    return 1.0f - expf(-2.0f * pi() * sclamp(hz, 1.0f, rate * 0.45f) / rate);
}

/// Geometric interpolation through three values at knob 0, 0.5, 1.
fn knob3(k: f32, v0: f32, v1: f32, v2: f32) -> f32 {
    let x: f32 = sclamp(k, 0.0f, 1.0f) * 2.0f;
    if x >= 1.0f { return v1 * expf((x - 1.0f) * logf(v2 / v1)); }
    return v0 * expf(x * logf(v1 / v0));
}

/// A two-stage exponential decay rate: `early` until `left` samples have
/// passed, then `late`.
struct Decay { var early: f32; var late: f32; var left: f32; };

impl Decay {
    fn new() -> Decay { return Decay { early: 0.0f, late: 0.0f, left: 0.0f }; }

    /// Time constants and the hold before the late stage, in seconds.
    fn start(self: &mut Self, early: f32, late: f32, hold: f32, rate: f32) -> void {
        self.early = decay_coef(early, rate);
        self.late = decay_coef(late, rate);
        self.left = hold * rate;
    }

    /// This sample's multiplier.
    fn next(self: &mut Self) -> f32 {
        if self.left > 0.0f { self.left = self.left - 1.0f; return self.early; }
        return self.late;
    }
}

/// Topology-preserving state-variable filter (Cytomic, A. Simper).
struct Svf { var ic1: f32; var ic2: f32; var a1: f32; var a2: f32; var a3: f32; var k: f32; };

impl Svf {
    fn new() -> Svf { return Svf { ic1: 0.0f, ic2: 0.0f, a1: 0.0f, a2: 0.0f, a3: 0.0f, k: 1.41421356f }; }
    fn reset(self: &mut Self) -> void { self.ic1 = 0.0f; self.ic2 = 0.0f; }
    fn configure(self: &mut Self, cutoff_hz: f32, q: f32, rate: f32) -> void {
        let g: f32 = tanf(pi() * sclamp(cutoff_hz, 10.0f, rate * 0.45f) / rate);
        self.k = 1.0f / q;
        self.a1 = 1.0f / (1.0f + g * (g + self.k));
        self.a2 = g * self.a1;
        self.a3 = g * self.a2;
    }
    /// `mode` 0 low-pass, 1 high-pass, 2 band-pass (peak gain 1).
    fn process(self: &mut Self, input: f32, mode: i32) -> f32 {
        let v3: f32 = input - self.ic2;
        let v1: f32 = self.a1 * self.ic1 + self.a2 * v3;
        let v2: f32 = self.ic2 + self.a2 * self.ic1 + self.a3 * v3;
        self.ic1 = 2.0f * v1 - self.ic1;
        self.ic2 = 2.0f * v2 - self.ic2;
        if mode == 0 { return v2; }
        if mode == 1 { return input - self.k * v1 - v2; }
        return self.k * v1;
    }
}

/// A decaying sine (the rim shot's bridged-T rings): a coupled-form
/// oscillator whose state rotates by the frequency and shrinks by the damping.
struct Resonator { var c: f32; var s: f32; };

impl Resonator {
    fn new() -> Resonator { return Resonator { c: 0.0f, s: 0.0f }; }
    fn reset(self: &mut Self) -> void { self.c = 0.0f; self.s = 0.0f; }

    /// Ring at amplitude `level`, continuing from the current output so a
    /// retrigger never clicks. A softer hit on a louder ring keeps its level.
    fn strike(self: &mut Self, level: f32) -> void {
        let amp: f32 = smax(level, fabsf(self.s));
        let s0: f32 = self.s;
        let c0: f32 = sqrtf(smax(amp * amp - s0 * s0, 0.0f));
        self.c = self.c < 0.0f && fabsf(s0) > 0.0f ? -c0 : c0;
    }

    fn tick(self: &mut Self, hz: f32, damp: f32, rate: f32) -> f32 {
        let w: f32 = 2.0f * pi() * sclamp(hz, 1.0f, rate * 0.45f) / rate;
        let cw: f32 = cosf(w);
        let sw: f32 = sinf(w);
        let c: f32 = (self.c * cw - self.s * sw) * damp;
        let s: f32 = (self.c * sw + self.s * cw) * damp;
        self.c = c;
        self.s = s;
        return s;
    }

    fn amplitude(self: Resonator) -> f32 { return sqrtf(self.c * self.c + self.s * self.s); }
}

/// A 909 VCO: a phase accumulator read through a sine, rounded towards a
/// square by `shape` (the 909 shapes a triangle core into a sine-like wave
/// with flattened tops). The phase runs on between hits, so a retrigger
/// continues the waveform instead of jumping.
struct Vco { var phase: f32; };

impl Vco {
    fn new() -> Vco { return Vco { phase: 0.0f }; }
    fn reset(self: &mut Self) -> void { self.phase = 0.0f; }
    fn tick(self: &mut Self, hz: f32, shape: f32, rate: f32) -> f32 {
        self.phase = self.phase + sclamp(hz, 1.0f, rate * 0.45f) / rate;
        if self.phase >= 1.0f { self.phase = self.phase - 1.0f; }
        let s: f32 = sinf(2.0f * pi() * self.phase);
        if shape <= 0.0f { return s; }
        return tanhf(shape * s) / tanhf(shape);
    }
}

/// An envelope that starts every hit from the level already sounding (a
/// softer hit on a louder ring keeps the ring).
fn restrike(current: f32, level: f32) -> f32 { return smax(current, level); }

/// A VCA envelope for the analog voices. A fresh hit starts at its level
/// (the VCO starts at phase 0, so there is no step); a harder hit on a
/// sounding voice rises to its level over about 0.4 ms instead of jumping
/// mid-cycle, so fast rolls do not click.
struct Vca { var level: f32; var peak: f32; var rising: bool; var rise_coef: f32; };

impl Vca {
    fn new() -> Vca { return Vca { level: 0.0f, peak: 0.0f, rising: false, rise_coef: 1.0f }; }
    fn configure(self: &mut Self, rate: f32) -> void { self.rise_coef = 1.0f - decay_coef(0.0004f, rate); }
    fn reset(self: &mut Self) -> void { self.level = 0.0f; self.peak = 0.0f; self.rising = false; }
    fn sounding(self: Vca) -> bool { return self.level > silent(); }

    fn strike(self: &mut Self, level: f32) -> void {
        if self.level < silent() { self.level = level; self.peak = level; self.rising = false; }
        else if level > self.level { self.peak = level; self.rising = true; }
    }

    /// This sample's gain; then the envelope moves on by the decay multiplier.
    fn tick(self: &mut Self, damp: f32) -> f32 {
        let out: f32 = self.level;
        if self.rising {
            self.peak = self.peak * damp;
            self.level = self.level + (self.peak - self.level) * self.rise_coef;
            if self.level >= self.peak * 0.995f { self.level = self.peak; self.rising = false; }
        } else {
            self.level = self.level * damp;
        }
        return out;
    }
}


/// Geometric interpolation through five values at knob 0, 0.2, 0.5, 0.8, 1
/// (the 909 panel's positions 1, 3, 6, 9 and 11 of 1..11, where the
/// reference recordings were made).
fn knob5(k: f32, v0: f32, v1: f32, v2: f32, v3: f32, v4: f32) -> f32 {
    let x: f32 = sclamp(k, 0.0f, 1.0f);
    if x < 0.2f { return v0 * expf(x / 0.2f * logf(v1 / v0)); }
    if x < 0.5f { return v1 * expf((x - 0.2f) / 0.3f * logf(v2 / v1)); }
    if x < 0.8f { return v2 * expf((x - 0.5f) / 0.3f * logf(v3 / v2)); }
    return v3 * expf((x - 0.8f) / 0.2f * logf(v4 / v3));
}

/// Follow an amplitude target: rise to it over about 0.4 ms (`rise`), so a
/// harder hit on a sounding drum never jumps mid-cycle, fall with it at once.
fn follow(current: f32, target: f32, rise: f32) -> f32 {
    if target > current { return current + (target - current) * rise; }
    return target;
}

fn two_pi() -> f32 { return 6.28318530717958647692f; }

/// The 909 bass drum, fitted to recordings of a TR-909 across its Tune,
/// Attack and Decay knobs:
///
/// - The VCO glides down exponentially from about 250 Hz to 53.5 Hz. Tune sets
///   the glide's time constant: 5.2 ms at the minimum, 11 ms at the centre,
///   28 ms at the maximum.
/// - The wave is a nearly pure sine (2nd harmonic -29 dB, 3rd -26.5 dB),
///   starting downwards.
/// - The VCA holds the level for 50 ms, through the whole glide, then decays:
///   a time constant of 17 ms (Decay minimum) to 220 ms (extended maximum), over a
///   quiet tail 25 dB down. During the hold a decaying offset pushes one side
///   of the wave into the output stage's clip, which flattens those half
///   cycles, as on the recordings.
/// - Attack mixes in more of the click: a burst of band-passed noise on top
///   of the step the hit itself makes.
/// - Like analog hardware, the VCO runs freely between hits (each hit starts
///   wherever it is), and each hit drifts a little in pitch, level and decay.
struct BassDrum {
    var phase: f32;
    /// Seconds since the hit; negative while idle.
    var t: f32;
    var gain: f32;
    var amp: f32;
    var click: f32;
    var click_hp: Svf;
    var click_lp: Svf;
    var dt: f32;
    var rise: f32;
    var click_coef: f32;
    var glide_tau: f32;
    var rest_hz: f32;
    var decay_tau: f32;
    var attack: f32;
    /// This hit's analog drift: pitch and decay multipliers.
    var detune: f32;
    var stretch: f32;
};

impl BassDrum {
    fn new() -> BassDrum {
        return BassDrum { phase: 0.0f, t: -1.0f, gain: 0.0f, amp: 0.0f, click: 0.0f, click_hp: Svf::new(),
                          click_lp: Svf::new(), dt: 0.0f, rise: 1.0f, click_coef: 0.0f, glide_tau: 0.013f, rest_hz: 54.1f,
                          decay_tau: 0.062f, attack: 0.5f, detune: 1.0f, stretch: 1.0f };
    }

    fn configure(self: &mut Self, rate: f32) -> void {
        self.dt = 1.0f / rate;
        self.rise = 1.0f - decay_coef(0.0004f, rate);
        self.click_coef = decay_coef(0.0024f, rate);
        self.click_hp.configure(1000.0f, 0.70710678f, rate);
        self.click_lp.configure(7000.0f, 0.70710678f, rate);
    }

    fn knobs(self: &mut Self, tune: f32, attack: f32, decay: f32) -> void {
        self.glide_tau = knob5(tune, 0.0069f, 0.0081f, 0.013f, 0.0238f, 0.0305f);
        self.rest_hz = 53.0f + 2.2f * (1.0f - sclamp(decay, 0.0f, 1.0f));
        // Preserve the lower four fifths; reserve the top for long club tails.
        self.decay_tau = knob5(decay, 0.017f, 0.033f, 0.062f, 0.085f, 0.22f);
        self.attack = sclamp(attack, 0.0f, 1.0f);
    }

    fn reset(self: &mut Self) -> void {
        self.phase = 0.0f; self.t = -1.0f; self.amp = 0.0f; self.click = 0.0f;
        self.click_hp.reset(); self.click_lp.reset();
    }

    /// Strike at `gain`. The VCO runs freely between hits, as on analog
    /// hardware, so each hit starts wherever the oscillator is. `pitch`,
    /// `level` and `length` (-1 .. 1) are this hit's analog drift: about
    /// +-0.4% pitch, +-0.25 dB and +-4% decay.
    fn strike(self: &mut Self, gain: f32, pitch: f32, level: f32, length: f32) -> void {
        if self.t < 0.0f { self.amp = 0.0f; }
        self.t = 0.0f;
        self.gain = gain * (1.0f + 0.03f * level);
        self.click = self.gain;
        self.detune = 1.0f + 0.004f * pitch;
        self.stretch = 1.0f + 0.04f * length;
    }

    fn active(self: BassDrum) -> bool { return self.t >= 0.0f; }

    /// The VCA's shape since the hit: the hold, then the decay over its tail.
    fn shape(self: BassDrum) -> f32 {
        let hold: f32 = 0.05f;
        if self.t < hold { return 1.0f; }
        let u: f32 = self.t - hold;
        let tau: f32 = self.decay_tau * self.stretch;
        return 0.88f * expf(-u / tau) + 0.12f * expf(-u / (0.11f * self.stretch));
    }

    fn tick(self: &mut Self, white: f32) -> f32 {
        if self.t < 0.0f {
            // Idle, the VCO keeps running at its resting pitch.
            self.phase = self.phase + self.rest_hz * self.dt;
            if self.phase >= 1.0f { self.phase = self.phase - 1.0f; }
            return 0.0f;
        }
        let hz: f32 = (self.rest_hz + 216.0f * expf(-self.t / self.glide_tau)) * self.detune;
        self.phase = self.phase + hz * self.dt;
        if self.phase >= 1.0f { self.phase = self.phase - 1.0f; }
        let s: f32 = -sinf(two_pi() * self.phase);
        // A gently rounded sine: the 3rd harmonic at -26.5 dB, the 2nd at -29.
        let w: f32 = (s - 0.16f * s * s * s) / 0.84f + 0.07f * (s * s - 0.5f);
        self.amp = follow(self.amp, self.gain * self.shape(), self.rise);
        let offset: f32 = -0.3f * self.gain * expf(-self.t / 0.04f);
        var y: f32 = self.amp * w + offset;
        // The output stage's clip, with a hard knee at the hit's level.
        let u: f32 = fabsf(y) / smax(self.gain, 0.001f);
        let u2: f32 = u * u;
        let u4: f32 = u2 * u2;
        y = y / powf(1.0f + u4 * u4, 0.125f);
        // The click: band-passed noise, more of it with Attack.
        let n: f32 = self.click_lp.process(self.click_hp.process(white, 1), 0);
        y = y + n * self.click * (0.075f + 0.09f * self.attack);
        self.click = self.click * self.click_coef;
        self.t = self.t + self.dt;
        if self.t > 0.05f + 14.0f * self.decay_tau && self.amp < silent() { self.t = -1.0f; }
        if self.t > 4.0f { self.t = -1.0f; }
        return y;
    }
}

/// A two-oscillator snare body with parallel low- and high-pass snappy
/// paths, following Roland's TR-909 service notes (Analog Voice Generators).
/// The bright noise has its own short envelope; the low-pass noise carries
/// the wire rattle. Tone controls the noise contour, Snappy its amount.
/// The constants are a voicing approximation, not a component simulation.
struct Snare {
    var phase1: f32;
    var phase2: f32;
    var t: f32;
    var gain: f32;
    var amp: f32;
    var upper_amp: f32;
    var noise_amp: f32;
    var hp: Svf;
    var hp2: Svf;
    var lp: Svf;
    var lp2: Svf;
    var dt: f32;
    var rise: f32;
    var hz: f32;
    var hold: f32;
    var fade: f32;
    var snappy: f32;
    /// This hit's analog drift: pitch and noise multipliers.
    var detune: f32;
    var snap: f32;
    /// SD Decay: how long the tone body rings, 0.5x .. 2x the 909's.
    var body: f32;
};

impl Snare {
    fn new() -> Snare {
        return Snare { phase1: 0.0f, phase2: 0.0f, t: -1.0f, gain: 0.0f, amp: 0.0f, upper_amp: 0.0f, noise_amp: 0.0f,
                       hp: Svf::new(), hp2: Svf::new(), lp: Svf::new(), lp2: Svf::new(), dt: 0.0f, rise: 1.0f,
                       hz: 166.0f, hold: 0.11f, fade: 0.045f, snappy: 0.16f, detune: 1.0f, snap: 1.0f, body: 1.0f };
    }

    fn configure(self: &mut Self, rate: f32) -> void {
        self.dt = 1.0f / rate;
        self.rise = 1.0f - decay_coef(0.0004f, rate);
        self.hp.configure(3500.0f, 0.70710678f, rate);
        self.hp2.configure(700.0f, 0.70710678f, rate);
        self.lp.configure(3200.0f, 0.70710678f, rate);
        self.lp2.configure(11000.0f, 0.70710678f, rate);
    }

    fn knobs(self: &mut Self, tune: f32, tone: f32, snappy: f32, decay: f32) -> void {
        self.body = exp2f((sclamp(decay, 0.0f, 1.0f) - 0.5f) * 2.0f);
        self.hz = knob3(tune, 114.0f, 166.0f, 222.0f);
        self.hold = knob3(tone, 0.05f, 0.12f, 0.15f);
        self.fade = knob3(tone, 0.025f, 0.055f, 0.065f);
        self.snappy = sclamp(snappy, 0.0f, 1.0f) * knob3(snappy, 0.2f, 0.36f, 0.45f);
    }

    fn reset(self: &mut Self) -> void {
        self.phase1 = 0.0f; self.phase2 = 0.0f; self.t = -1.0f; self.amp = 0.0f; self.upper_amp = 0.0f; self.noise_amp = 0.0f;
        self.hp.reset(); self.hp2.reset(); self.lp.reset(); self.lp2.reset();
    }

    /// A fresh trigger phases the VCOs together. On an overlapping hit keep
    /// the phase and smooth the VCA rise to avoid a waveform discontinuity.
    /// `pitch`, `level` and `noise` add small component-like variations.
    fn strike(self: &mut Self, gain: f32, pitch: f32, level: f32, noise: f32) -> void {
        if self.t < 0.0f { self.phase1 = 0.0f; self.phase2 = 0.0f; self.amp = 0.0f; self.upper_amp = 0.0f; self.noise_amp = 0.0f; }
        self.t = 0.0f;
        self.gain = gain * (1.0f + 0.03f * level);
        self.detune = 1.0f + 0.005f * pitch;
        self.snap = 1.0f + 0.06f * noise;
    }

    fn active(self: Snare) -> bool { return self.t >= 0.0f; }

    fn tick(self: &mut Self, white: f32) -> f32 {
        // The noise filters run all the time, so a hit never starts on a
        // resting filter.
        let dark: f32 = self.lp.process(self.hp2.process(white, 1), 0);
        let bright: f32 = self.lp2.process(self.hp.process(white, 1), 0);
        let n: f32 = dark + bright * (0.25f + 0.75f * expf(-smax(self.t, 0.0f) / 0.018f));
        if self.t < 0.0f {
            // Idle, the VCOs keep running at their resting pitches.
            self.phase1 = self.phase1 + self.hz * self.dt;
            if self.phase1 >= 1.0f { self.phase1 = self.phase1 - 1.0f; }
            self.phase2 = self.phase2 + 1.5f * self.hz * self.dt;
            if self.phase2 >= 1.0f { self.phase2 = self.phase2 - 1.0f; }
            return 0.0f;
        }
        let bend: f32 = (1.0f + 0.65f * expf(-self.t / 0.0035f) + 0.12f * expf(-self.t / 0.012f)) * self.detune;
        self.phase1 = self.phase1 + self.hz * bend * self.dt;
        if self.phase1 >= 1.0f { self.phase1 = self.phase1 - 1.0f; }
        self.phase2 = self.phase2 + 1.5f * self.hz * bend * self.dt;
        if self.phase2 >= 1.0f { self.phase2 = self.phase2 - 1.0f; }
        let s1: f32 = sinf(two_pi() * self.phase1);
        // Two shell resonances need independent VCAs. Multiplying the upper
        // resonance by the lower VCA as well shortened its 35 ms envelope
        // to about 15 ms, leaving a single pitched thud under the noise.
        let tone: f32 = s1 + 0.2f * (s1 * s1 - 0.5f);
        let upper: f32 = sinf(two_pi() * self.phase2);
        self.upper_amp = follow(self.upper_amp, self.gain * 0.38f * expf(-self.t / (0.035f * self.body)), self.rise);
        // The short body falls into a quiet tonal tail.
        let te: f32 = 0.94f * expf(-self.t / (0.025f * self.body)) + 0.06f * expf(-self.t / (0.09f * self.body));
        self.amp = follow(self.amp, self.gain * te, self.rise);
        // The noise: a short burst, then a slow sag through the hold, then
        // the fade.
        var e: f32 = expf(-self.t / 0.3f);
        if self.t > self.hold { e = expf(-self.hold / 0.3f) * expf(-(self.t - self.hold) / self.fade); }
        e = e + 1.0f * expf(-self.t / 0.002f);
        self.noise_amp = follow(self.noise_amp, self.gain * self.snappy * self.snap * e, self.rise);
        let out: f32 = self.amp * tone + self.upper_amp * upper + self.noise_amp * n * 4.0f;
        self.t = self.t + self.dt;
        if self.t > 2.5f || (self.t > self.hold + 14.0f * self.fade && self.t > 2.0f * self.body && self.amp < silent()) {
            self.t = -1.0f;
        }
        return out;
    }
}

/// A pitched tom with a rounded VCO, a falling pitch envelope and a
/// separate filtered-noise attack. The VCA sags during its initial shoulder
/// and then releases; Decay controls the shoulder and release time.
/// Keep the oscillator mostly sinusoidal: heavy static saturation turns
/// the sustained body into a buzzy synth note.
struct Tom {
    var phase: f32;
    var t: f32;
    var gain: f32;
    var amp: f32;
    var asymmetry: f32;
    var attack_amp: f32;
    var hp: Svf;
    var lp: Svf;
    var coupling: Svf;
    var dt: f32;
    var rise: f32;
    var hz: f32;
    var hold: f32;
    var tau: f32;
};

impl Tom {
    fn new() -> Tom {
        return Tom { phase: 0.0f, t: -1.0f, gain: 0.0f, amp: 0.0f, asymmetry: 0.0f, attack_amp: 0.0f, hp: Svf::new(), lp: Svf::new(), coupling: Svf::new(), dt: 0.0f, rise: 1.0f,
                     hz: 100.0f, hold: 0.08f, tau: 0.1f };
    }

    fn configure(self: &mut Self, rate: f32) -> void {
        self.dt = 1.0f / rate;
        self.rise = 1.0f - decay_coef(0.0004f, rate);
        self.hp.configure(900.0f, 0.70710678f, rate);
        self.lp.configure(8500.0f, 0.70710678f, rate);
        self.coupling.configure(15.0f, 0.70710678f, rate);
    }

    /// Pitch, and the decay's hold and time constant.
    fn knobs(self: &mut Self, hz: f32, hold: f32, tau: f32) -> void { self.hz = hz; self.hold = hold; self.tau = tau; }

    fn reset(self: &mut Self) -> void { self.phase = 0.0f; self.t = -1.0f; self.amp = 0.0f; self.asymmetry = 0.0f; self.attack_amp = 0.0f; self.hp.reset(); self.lp.reset(); self.coupling.reset(); }

    fn strike(self: &mut Self, gain: f32) -> void {
        if self.t < 0.0f { self.phase = 0.0f; self.amp = 0.0f; self.asymmetry = 0.0f; self.attack_amp = 0.0f; }
        self.t = 0.0f;
        // A soft retrigger must not abruptly cut the ringing VCA.
        self.gain = smax(gain, self.amp);
    }

    fn active(self: Tom) -> bool { return self.t >= 0.0f; }

    fn tick(self: &mut Self, white: f32) -> f32 {
        let n: f32 = self.lp.process(self.hp.process(white, 1), 0);
        if self.t < 0.0f { return self.coupling.process(0.0f, 1); }
        self.phase = self.phase + self.hz * (1.0f + 0.3f * expf(-self.t / 0.04f)) * self.dt;
        if self.phase >= 1.0f { self.phase = self.phase - 1.0f; }
        let s: f32 = sinf(two_pi() * self.phase);
        // Transient asymmetry fades into a gently rounded sine. Remove DC
        // after the VCA: asymmetric shaping otherwise leaves a bass offset.
        let even: f32 = 0.2f + 1.3f * expf(-self.t / 0.03f);
        self.asymmetry = follow(self.asymmetry, even, self.rise);
        let x: f32 = s + self.asymmetry * (s * s - 0.5f);
        let w: f32 = tanhf(0.65f * x) / tanhf(0.65f);
        var e: f32 = expf(-self.t / 0.65f);
        if self.t > self.hold { e = expf(-self.hold / 0.65f) * expf(-(self.t - self.hold) / self.tau); }
        self.amp = follow(self.amp, self.gain * e, self.rise);
        // The stick's noisy onset needs a short, bright burst AND a quieter
        // skirt behind the pitched body. A single 9 ms decay disappeared
        // under the oscillator. Keep this contour independent of Tom Decay
        // so a long tom does not turn into sustained hiss.
        let noise_env: f32 = 0.55f * expf(-self.t / 0.01f) + 0.2f * expf(-self.t / 0.04f);
        self.attack_amp = follow(self.attack_amp, self.gain * noise_env, self.rise);
        let out: f32 = self.amp * (w + 0.005f * n) + n * self.attack_amp;
        self.t = self.t + self.dt;
        if self.t > self.hold + 14.0f * self.tau && self.amp < silent() { self.t = -1.0f; }
        return self.coupling.process(out, 1);
    }
}

/// The 909 rim shot, fitted to recordings: 485 Hz and 217 Hz driven hard
/// into an asymmetric clip, a nearly rectangular wave that starts on a
/// narrow negative pulse (about 29% of each cycle) with wide positive ones
/// at about half its height. It holds for 10.5 ms, then the drive falls and
/// it decays (time constants 12 ms, then 30 ms).
struct RimShot {
    var t: f32;
    var gain: f32;
    var phase1: f32;
    var phase2: f32;
    var hp: Svf;
    var dt: f32;
};

impl RimShot {
    fn new() -> RimShot { return RimShot { t: -1.0f, gain: 1.0f, phase1: 0.0f, phase2: 0.0f, hp: Svf::new(), dt: 0.0f }; }

    fn configure(self: &mut Self, rate: f32) -> void {
        self.dt = 1.0f / rate;
        self.hp.configure(8.0f, 0.70710678f, rate);
    }

    fn reset(self: &mut Self) -> void { self.t = -1.0f; self.hp.reset(); }

    fn strike(self: &mut Self, gain: f32) -> void {
        // The first negative pulse peaks 0.3 ms after the hit.
        if self.t < 0.0f { self.phase1 = 0.105f; self.phase2 = 0.5f; }
        self.t = 0.0f;
        self.gain = gain;
    }

    fn active(self: RimShot) -> bool { return self.t >= 0.0f; }

    fn tick(self: &mut Self) -> f32 {
        if self.t < 0.0f { return self.hp.process(0.0f, 1); }
        let v: f32 = -sinf(two_pi() * self.phase1) - 0.85f * sinf(two_pi() * self.phase2);
        self.phase1 = self.phase1 + 485.0f * self.dt;
        if self.phase1 >= 1.0f { self.phase1 = self.phase1 - 1.0f; }
        self.phase2 = self.phase2 + 217.0f * self.dt;
        if self.phase2 >= 1.0f { self.phase2 = self.phase2 - 1.0f; }
        let gate: f32 = 0.0105f;
        // Driven: the clipped, nearly rectangular wave.
        let u: f32 = tanhf(10.0f * (v + 0.55f)) / tanhf(10.0f);
        let clipped: f32 = u > 0.0f ? 0.55f * u : u;
        var y: f32 = clipped;
        if self.t >= gate {
            // After the gate the drive is gone: the rings decay on their own.
            let w: f32 = self.t - gate;
            let x: f32 = expf(-w / 0.0008f);
            let ring: f32 = v * 0.4f * (0.75f * expf(-w / 0.008f) + 0.25f * expf(-w / 0.03f));
            y = clipped * x + ring * (1.0f - x);
        }
        self.t = self.t + self.dt;
        if self.t > 0.3f { self.t = -1.0f; }
        return self.hp.process(y * self.gain, 1);
    }
}

/// The 909 hand clap, fitted to recordings: white noise struck by four
/// sawtooth bursts at 0, 10.5, 22.5 and 32.5 ms, band-passed bright around
/// 1.1 kHz with some air above 4 kHz. The fourth burst opens the "reverb"
/// tail: the same noise, starting bright and darkening to a band around
/// 1.05 kHz, that holds noisily, falls with a 17 ms time constant and rings
/// on quietly (120 ms), 30 dB down at 150 ms.
struct Clap {
    var t: f32;
    var gain: f32;
    var burst: f32;
    var tail: f32;
    var next: i32;
    var burst_bp: Svf;
    var air: Svf;
    var tail_bp: Svf;
    var tail_lp: Svf;
    var dt: f32;
    var burst_coef: f32;
};

impl Clap {
    fn new() -> Clap {
        return Clap { t: -1.0f, gain: 0.0f, burst: 0.0f, tail: 0.0f, next: 0, burst_bp: Svf::new(), air: Svf::new(),
                      tail_bp: Svf::new(), tail_lp: Svf::new(), dt: 0.0f, burst_coef: 0.0f };
    }

    fn configure(self: &mut Self, rate: f32) -> void {
        self.dt = 1.0f / rate;
        self.burst_coef = decay_coef(0.0028f, rate);
        self.burst_bp.configure(1100.0f, 0.9f, rate);
        self.air.configure(4000.0f, 0.70710678f, rate);
        self.tail_bp.configure(1050.0f, 1.1f, rate);
        self.tail_lp.configure(2000.0f, 0.70710678f, rate);
    }

    fn reset(self: &mut Self) -> void {
        self.t = -1.0f; self.burst = 0.0f; self.tail = 0.0f; self.next = 0;
        self.burst_bp.reset(); self.air.reset(); self.tail_bp.reset(); self.tail_lp.reset();
    }

    fn strike(self: &mut Self, gain: f32) -> void { self.t = 0.0f; self.gain = gain; self.next = 0; }

    fn active(self: Clap) -> bool { return self.t >= 0.0f; }

    /// Burst `n`'s time in seconds.
    fn burst_time(n: i32) -> f32 {
        if n == 0 { return 0.0f; }
        if n == 1 { return 0.0105f; }
        if n == 2 { return 0.0225f; }
        return 0.0325f;
    }

    fn tick(self: &mut Self, white: f32) -> f32 {
        // The filters run all the time, so a hit never strikes a resting one.
        let air: f32 = self.air.process(white, 1);
        let bright: f32 = self.burst_bp.process(white, 2) + 0.15f * air;
        let dark: f32 = self.tail_lp.process(self.tail_bp.process(white, 2), 0);
        if self.t < 0.0f { return 0.0f; }
        // The sawtooth bursts: each restarts at full level.
        if self.next < 4 && self.t >= Clap::burst_time(self.next) {
            self.burst = self.gain;
            self.next = self.next + 1;
        }
        var e: f32 = 0.0f;
        var sheen: f32 = 0.0f;
        let u: f32 = self.t - 0.0325f;
        if u >= 0.0f {
            // The tail holds a little, then falls fast into the quiet ring.
            // It starts bright and darkens: a bright part fades in 12 ms.
            let hold: f32 = 0.006f;
            let v: f32 = u > hold ? u - hold : 0.0f;
            // It swells in over a few milliseconds under the fourth burst.
            e = self.gain * (0.85f * expf(-v / 0.017f) + 0.1f * expf(-v / 0.115f)) * (1.0f - expf(-u / 0.004f));
            sheen = self.gain * 0.25f * expf(-u / 0.012f);
        }
        let out: f32 = bright * (self.burst + sheen) + (dark * 1.05f + 0.02f * air) * e;
        self.burst = self.burst * self.burst_coef;
        self.t = self.t + self.dt;
        if self.t > 1.2f { self.t = -1.0f; }
        return out;
    }
}

/// A playback head on a ROM: its read position (in ROM words) and gain.
struct Head { var pos: f32; var gain: f32; var on: bool; };

impl Head {
    fn new() -> Head { return Head { pos: 0.0f, gain: 0.0f, on: false }; }

    /// The ROM word at `pos`, linearly interpolated (the DAC's output after
    /// the reconstruction filter); 0 past the end, then the head stops.
    fn read(self: &mut Self, rom: &list<f32>, words: i64, step: f32) -> f32 {
        if !self.on { return 0.0f; }
        let i: i64 = i32(self.pos);
        if i + 1 >= words { self.on = false; return 0.0f; }
        let f: f32 = self.pos - f32(i);
        let a: f32 = rom[i];
        let b: f32 = rom[i + 1];
        self.pos = self.pos + step;
        return a + (b - a) * f;
    }
}

/// A sampled voice: a ROM played from the start on every hit. A retrigger
/// hands the sounding head to a second one that fades out over 2 ms, so the
/// restart does not click.
struct RomVoice { var head: Head; var tail: Head; var fade_step: f32; };

impl RomVoice {
    fn new() -> RomVoice { return RomVoice { head: Head::new(), tail: Head::new(), fade_step: 0.0f }; }
    fn configure(self: &mut Self, rate: f32) -> void { self.fade_step = 1.0f / smax(1.0f, 0.002f * rate); }
    fn reset(self: &mut Self) -> void { self.head = Head::new(); self.tail = Head::new(); }

    /// Restart the ROM; `level_now` is the gain the sounding head has now
    /// (its VCA), which the fading tail keeps.
    fn strike(self: &mut Self, level_now: f32) -> void {
        if self.head.on && level_now > silent() {
            self.tail = self.head;
            self.tail.gain = level_now;
        }
        self.head = Head { pos: 0.0f, gain: 1.0f, on: true };
    }

    fn active(self: RomVoice) -> bool { return self.head.on || self.tail.on; }

    /// The head's sample (VCA applied by the caller) and the fading tail
    /// (already at its own gain), summed into `out_tail` by the caller.
    fn tick(self: &mut Self, rom: &list<f32>, words: i64, step: f32, out_tail: ptr<f32>) -> f32 {
        let x: f32 = self.head.read(rom, words, step);
        var t: f32 = 0.0f;
        if self.tail.on {
            t = self.tail.read(rom, words, step) * self.tail.gain;
            self.tail.gain = self.tail.gain - self.fade_step;
            if self.tail.gain <= 0.0f { self.tail.on = false; }
        }
        unsafe { *out_tail = t; }
        return x;
    }
}

/// Deterministic noise for building the ROMs (the same ROMs every time).
struct Rng { var seed: i64; };

impl Rng {
    /// 0..1.
    fn next(self: &mut Self) -> f32 {
        self.seed = (self.seed * 1103515245 + 12345) % 2147483648;
        return f32(self.seed) / 2147483648.0f;
    }
    /// -1..1.
    fn white(self: &mut Self) -> f32 { return self.next() * 2.0f - 1.0f; }
}

/// How one ROM's metallic recording is made.
struct MetalSpec {
    /// Inharmonic partials: how many, their band, base decay time constant,
    /// how much faster high ones decay (exponent), level.
    var partials: i32;
    var low_hz: f32;
    var high_hz: f32;
    var tau: f32;
    var tilt: f32;
    var partial_level: f32;
    /// Share of partials that swell in over tens of milliseconds (a crash's
    /// wash builds after the hit).
    var swell: f32;
    /// Filtered noise: level, decay, high-pass corner.
    var noise_level: f32;
    var noise_tau: f32;
    var noise_hz: f32;
    /// The stick's transient: level and decay.
    var stick_level: f32;
    var stick_tau: f32;
};

/// Render a metallic recording into `rom` at the ROM clock, then normalize it
/// and quantize it to 6 bits (64 levels, -32 .. 31), as the 909's ROMs hold.
fn build_rom(rom: &list<f32>, words: i64, spec: MetalSpec, seed: i64) -> void {
    let r: f32 = rom_rate();
    var rng: Rng = Rng { seed: seed };
    var i: i64 = 0;
    while i < words { set_f32(rom, i, 0.0f); i = i + 1; }

    // Partials, each a decaying sine (coupled form, one at a time).
    let span: f32 = logf(spec.high_hz / spec.low_hz);
    let norm: f32 = spec.partial_level / sqrtf(f32(spec.partials));
    var p: i32 = 0;
    while p < spec.partials {
        let hz: f32 = spec.low_hz * expf(rng.next() * span);
        let amp: f32 = norm * (0.3f + 0.7f * rng.next());
        let tau: f32 = spec.tau * powf(hz / spec.low_hz, -spec.tilt) * (0.6f + 0.8f * rng.next());
        let damp: f32 = decay_coef(tau, r);
        let w: f32 = 2.0f * pi() * hz / r;
        let cw: f32 = cosf(w);
        let sw: f32 = sinf(w);
        let phase: f32 = 2.0f * pi() * rng.next();
        var c: f32 = amp * cosf(phase);
        var s: f32 = amp * sinf(phase);
        // Swelling partials rise with a 20 .. 80 ms time constant.
        var rise: f32 = 0.0f;
        var rise_coef: f32 = 0.0f;
        if rng.next() < spec.swell { rise = 1.0f; rise_coef = decay_coef(0.02f + 0.06f * rng.next(), r); }
        i = 0;
        while i < words {
            let cn: f32 = (c * cw - s * sw) * damp;
            let sn: f32 = (c * sw + s * cw) * damp;
            c = cn;
            s = sn;
            set_f32(rom, i, rom[i] + s * (1.0f - rise));
            rise = rise * rise_coef;
            i = i + 1;
        }
        p = p + 1;
    }

    // Noise through a 4th-order high-pass, and the stick's broadband click.
    var hp: Svf = Svf::new();
    var hp2: Svf = Svf::new();
    hp.configure(spec.noise_hz, 0.70710678f, r);
    hp2.configure(spec.noise_hz, 0.70710678f, r);
    let noise_coef: f32 = decay_coef(spec.noise_tau, r);
    let stick_coef: f32 = decay_coef(spec.stick_tau, r);
    var noise: f32 = spec.noise_level;
    var stick: f32 = spec.stick_level;
    var stick_hp: Svf = Svf::new();
    stick_hp.configure(1500.0f, 0.70710678f, r);
    i = 0;
    while i < words {
        let w: f32 = rng.white();
        let n: f32 = hp2.process(hp.process(w, 1), 1) * noise + stick_hp.process(w, 1) * stick;
        set_f32(rom, i, rom[i] + n);
        noise = noise * noise_coef;
        stick = stick * stick_coef;
        i = i + 1;
    }

    // The recording fades out over its last quarter, so playback never stops
    // on a step.
    let fade_from: i64 = words - words / 4;
    i = fade_from;
    while i < words {
        let x: f32 = f32(words - i) / f32(words - fade_from);
        set_f32(rom, i, rom[i] * x * x);
        i = i + 1;
    }

    // Normalize to full scale and quantize to the 6-bit DAC's 64 levels.
    var top: f32 = 0.0f;
    i = 0;
    while i < words { top = smax(top, fabsf(rom[i])); i = i + 1; }
    let scale: f32 = top > 0.0f ? 31.0f / top : 0.0f;
    i = 0;
    while i < words {
        let q: i64 = llroundf(sclamp(rom[i] * scale, -32.0f, 31.0f));
        set_f32(rom, i, f32(q) / 32.0f);
        i = i + 1;
    }
}


/// ROM indexes for `mla09_rom_*`.
fn rom_hat() -> i32 { return 0; }
fn rom_crash() -> i32 { return 1; }
fn rom_ride() -> i32 { return 2; }
/// An optional open-hat ROM: with it loaded the open hat plays it, otherwise
/// both hats play the hi-hat ROM.
fn rom_open_hat() -> i32 { return 3; }
/// An optional clap ROM: a recording of the 909's analog clap. With it loaded
/// the clap plays it, otherwise the synthesized clap sounds.
fn rom_clap() -> i32 { return 4; }
fn clap_words() -> i64 { return 32768; }

/// The whole machine.
struct M09 {
    var rate: f32;

    // --- Settings ----------------------------------------------------------
    /// Instrument levels (linear).
    var level_bd: f32;
    var level_sd: f32;
    var level_lt: f32;
    var level_mt: f32;
    var level_ht: f32;
    var level_rs: f32;
    var level_cp: f32;
    var level_ch: f32;
    var level_oh: f32;
    var level_cr: f32;
    var level_rd: f32;
    /// Knobs, 0..1.
    var bd_tune: f32;
    var bd_attack: f32;
    var bd_decay: f32;
    var sd_tune: f32;
    var sd_tone: f32;
    var snappy: f32;
    var lt_tune: f32;
    var lt_decay: f32;
    var mt_tune: f32;
    var mt_decay: f32;
    var ht_tune: f32;
    var ht_decay: f32;
    var ch_decay: f32;
    var oh_decay: f32;
    var cr_tune: f32;
    var rd_tune: f32;
    /// Beyond the 909's panel: the snare's tone decay (0.5 = the 909's) and
    /// the cymbals' VCA decays (1 = none: they ring for their sample, as on
    /// the 909).
    var sd_decay: f32;
    var cr_decay: f32;
    var rd_decay: f32;
    var cr_decay_coef: f32;
    var rd_decay_coef: f32;
    /// Output distortion, 0..1 (0 = clean).
    var drive: f32;
    /// Accent amount 0..1 (0 = none, 1 = +9 dB).
    var accent: f32;
    /// 0: two levels (velocity above 100 accents); 1: velocity scales the level.
    var dynamics: i32;
    var output_target: f32;
    var output_gain: f32;

    // --- Analog voices -------------------------------------------------------
    var bd: BassDrum;
    var sd: Snare;
    var lt: Tom;
    var mt: Tom;
    var ht: Tom;
    var rs: RimShot;

    var cp: Clap;

    // --- Sampled voices --------------------------------------------------------
    /// The ROMs: one hi-hat ROM that both hats play (as on the 909), the
    /// crash and the ride. Built in, or loaded with `mla09_rom_*`; the lengths
    /// in use are at most the lists' capacity.
    var rom_hat: list<f32>;
    var rom_cr: list<f32>;
    var rom_rd: list<f32>;
    var rom_oh: list<f32>;
    var oh_len: i64;
    var rom_cp: list<f32>;
    var cp_len: i64;
    var cp_rom: RomVoice;
    var cp_env: f32;
    /// Loaded hat recordings carry their own decay (recorded at full Decay),
    /// so their VCA times are solved to shorten them to the 909's lengths at
    /// lower Decay and leave them as recorded at full Decay.
    var hats_recorded: bool;
    var hat_len: i64;
    var cr_len: i64;
    var rd_len: i64;
    var ch: RomVoice;
    var oh: RomVoice;
    var cr: RomVoice;
    var rd: RomVoice;
    /// ROM words per output sample.
    var hat_step: f32;
    var cr_step: f32;
    var rd_step: f32;
    /// The hats' VCAs, with a short hold before the decay.
    var ch_env: f32;
    var ch_decay_env: Decay;
    var oh_env: f32;
    var oh_decay_env: Decay;
    /// The hats are one voice, as on the 909 (one ROM, one playback): either
    /// hat cuts the other within a few milliseconds.
    var oh_choked: bool;
    var ch_choked: bool;
    var choke_coef: f32;
    var cr_env: f32;
    var rd_env: f32;
    /// The hat and cymbal outputs' high-pass (the mixer's coupling).
    var metal_hp: Svf;

    /// Slow random walks (-1 .. 1): the kick's and snare's pitch drift.
    var bd_drift: f32;
    var sd_drift: f32;

    var seed: i64;
};

impl M09 {
    fn new(sample_rate: f32) -> M09 {
        let rate: f32 = sclamp(sample_rate, 8000.0f, 384000.0f);
        var m: M09 = M09 {
            rate: rate,
            level_bd: 1.0f, level_sd: 1.0f, level_lt: 1.0f, level_mt: 1.0f, level_ht: 1.0f, level_rs: 1.0f,
            level_cp: 1.0f, level_ch: 1.0f, level_oh: 1.0f, level_cr: 1.0f, level_rd: 1.0f,
            bd_tune: 0.5f, bd_attack: 0.5f, bd_decay: 0.5f, sd_tune: 0.5f, sd_tone: 0.5f, snappy: 0.5f,
            lt_tune: 0.5f, lt_decay: 0.5f, mt_tune: 0.5f, mt_decay: 0.5f, ht_tune: 0.5f, ht_decay: 0.5f,
            ch_decay: 0.5f, oh_decay: 0.5f, cr_tune: 0.5f, rd_tune: 0.5f, drive: 0.0f,
            sd_decay: 0.5f, cr_decay: 1.0f, rd_decay: 1.0f, cr_decay_coef: 1.0f, rd_decay_coef: 1.0f,
            accent: 0.5f, dynamics: 0, output_target: 1.0f, output_gain: 1.0f,
            bd: BassDrum::new(), sd: Snare::new(), lt: Tom::new(), mt: Tom::new(), ht: Tom::new(), rs: RimShot::new(),
            cp: Clap::new(),
            rom_hat: [0.0f; hat_words()], rom_cr: [0.0f; cymbal_words()], rom_rd: [0.0f; cymbal_words()],
            rom_oh: [0.0f; hat_words()], oh_len: 0, hats_recorded: false,
            rom_cp: [0.0f; clap_words()], cp_len: 0, cp_rom: RomVoice::new(), cp_env: 0.0f,
            hat_len: hat_words(), cr_len: cymbal_words(), rd_len: cymbal_words(),
            ch: RomVoice::new(), oh: RomVoice::new(), cr: RomVoice::new(), rd: RomVoice::new(),
            hat_step: 1.0f, cr_step: 1.0f, rd_step: 1.0f,
            ch_env: 0.0f, ch_decay_env: Decay::new(), oh_env: 0.0f, oh_decay_env: Decay::new(), oh_choked: false, ch_choked: false,
            choke_coef: 0.0f, cr_env: 0.0f, rd_env: 0.0f, metal_hp: Svf::new(),
            bd_drift: 0.0f, sd_drift: 0.0f,
            seed: 9090909
        };
        m.build_roms();
        m.configure();
        return m;
    }

    /// The built-in ROMs, fitted to the spectra and lengths of TR-909
    /// recordings (both hats from one ROM, as on the 909).
    fn build_roms(self: &mut Self) -> void {
        build_rom(self.rom_hat, hat_words(), MetalSpec {
            partials: 64, low_hz: 4500.0f, high_hz: 14500.0f, tau: 0.45f, tilt: 0.35f, partial_level: 1.0f,
            swell: 0.0f, noise_level: 0.6f, noise_tau: 0.35f, noise_hz: 900.0f, stick_level: 0.45f, stick_tau: 0.0012f
        }, 909002);
        build_rom(self.rom_cr, cymbal_words(), MetalSpec {
            partials: 72, low_hz: 1300.0f, high_hz: 9500.0f, tau: 0.3f, tilt: 0.55f, partial_level: 1.0f,
            swell: 0.3f, noise_level: 0.8f, noise_tau: 0.22f, noise_hz: 2200.0f, stick_level: 0.4f, stick_tau: 0.002f
        }, 909003);
        build_rom(self.rom_rd, cymbal_words(), MetalSpec {
            partials: 72, low_hz: 5000.0f, high_hz: 15500.0f, tau: 0.22f, tilt: 0.1f, partial_level: 1.0f,
            swell: 0.0f, noise_level: 0.4f, noise_tau: 0.16f, noise_hz: 3500.0f, stick_level: 0.5f, stick_tau: 0.001f
        }, 909004);
        self.hat_len = hat_words();
        self.cr_len = cymbal_words();
        self.rd_len = cymbal_words();
        self.oh_len = 0;
        self.cp_len = 0;
        self.hats_recorded = false;
    }

    /// Coefficients that depend only on the sample rate.
    fn configure(self: &mut Self) -> void {
        let r: f32 = self.rate;
        self.bd.configure(r);
        self.sd.configure(r);
        self.lt.configure(r);
        self.mt.configure(r);
        self.ht.configure(r);
        self.rs.configure(r);

        self.cp.configure(r);

        self.ch.configure(r);
        self.oh.configure(r);
        self.cp_rom.configure(r);
        self.cr.configure(r);
        self.rd.configure(r);
        self.hat_step = rom_rate() / r;
        self.choke_coef = decay_coef(0.003f, r);
        self.metal_hp.configure(250.0f, 0.70710678f, r);
        self.configure_knobs();
    }

    /// Coefficients that follow the knobs.
    fn configure_knobs(self: &mut Self) -> void {
        let r: f32 = self.rate;
        self.bd.knobs(self.bd_tune, self.bd_attack, self.bd_decay);
        self.sd.knobs(self.sd_tune, self.sd_tone, self.snappy, self.sd_decay);
        // Cymbal decays: a VCA time constant from 40 ms up; at the top the
        // cymbal rings for its whole sample.
        self.cr_decay_coef = self.cr_decay >= 0.999f ? 1.0f : decay_coef(knob3(self.cr_decay, 0.04f, 0.35f, 100.0f), r);
        self.rd_decay_coef = self.rd_decay >= 0.999f ? 1.0f : decay_coef(knob3(self.rd_decay, 0.04f, 0.35f, 100.0f), r);
        // Toms: pitch across Tune; Decay sets the hold and the time constant.
        // Centred, they are a root, its fifth and its minor seventh (94, 140.8
        // and 167.5 Hz); each Tune range spans the 909's around its centre.
        self.lt.knobs(knob3(self.lt_tune, 60.0f, 94.0f, 120.0f), knob3(self.lt_decay, 0.04f, 0.09f, 0.11f),
                      knob3(self.lt_decay, 0.1f, 0.119f, 0.141f));
        self.mt.knobs(knob3(self.mt_tune, 94.7f, 140.8f, 195.7f), knob3(self.mt_decay, 0.03f, 0.075f, 0.09f),
                      knob3(self.mt_decay, 0.058f, 0.088f, 0.105f));
        self.ht.knobs(knob3(self.ht_tune, 114.2f, 167.5f, 218.2f), knob3(self.ht_decay, 0.03f, 0.07f, 0.085f),
                      knob3(self.ht_decay, 0.055f, 0.085f, 0.1f));
        // Cymbal Tune runs the ROM clock: crash 0.76x .. 1.6x, ride 0.78x .. 1.52x.
        self.cr_step = rom_rate() * knob3(self.cr_tune, 0.76f, 1.0f, 1.6f) / r;
        self.rd_step = rom_rate() * knob3(self.rd_tune, 0.78f, 1.0f, 1.52f) / r;
    }

    fn reset(self: &mut Self) -> void {
        self.bd.reset(); self.sd.reset(); self.lt.reset(); self.mt.reset(); self.ht.reset(); self.rs.reset();
        self.cp.reset();
        self.ch.reset(); self.oh.reset(); self.cr.reset(); self.rd.reset(); self.cp_rom.reset(); self.cp_env = 0.0f;
        self.ch_env = 0.0f; self.oh_env = 0.0f; self.oh_choked = false; self.ch_choked = false; self.cr_env = 0.0f; self.rd_env = 0.0f;
        self.metal_hp.reset();
        self.output_gain = self.output_target;
    }

    /// White noise, -1 .. 1, from a 32-bit xorshift generator (every value
    /// is good noise, however the voices share it).
    fn white(self: &mut Self) -> f32 {
        var x: i64 = self.seed;
        x = (x ^ (x << 13)) & 0xFFFFFFFF;
        x = x ^ (x >> 17);
        x = (x ^ (x << 5)) & 0xFFFFFFFF;
        self.seed = x;
        return f32(x) / 2147483648.0f - 1.0f;
    }

    /// Hit level for velocity 0..1: accent adds up to +9 dB; in Velocity
    /// mode, velocity also scales the level.
    fn hit_gain(self: M09, velocity: f32) -> f32 {
        let v: f32 = sclamp(velocity, 0.0f, 1.0f);
        if self.dynamics == 1 { return v * v * exp2f(self.accent * 1.5f); }
        return v > 100.5f / 127.0f ? exp2f(self.accent * 1.5f) : 1.0f;
    }

    /// Strike instrument `which` (0..10) at velocity 0..1.
    fn trigger(self: &mut Self, which: i32, velocity: f32) -> void {
        let gain: f32 = self.hit_gain(velocity);
        if gain <= 0.0f { return; }
        let r: f32 = self.rate;
        if which == bass_drum() {
            self.bd_drift = sclamp(0.8f * self.bd_drift + 0.35f * self.white(), -1.0f, 1.0f);
            let level: f32 = self.white();
            let length: f32 = self.white();
            self.bd.strike(gain, self.bd_drift, level, length);
        } else if which == snare_drum() {
            self.sd_drift = sclamp(0.8f * self.sd_drift + 0.35f * self.white(), -1.0f, 1.0f);
            let level: f32 = self.white();
            let noise: f32 = self.white();
            self.sd.strike(gain, self.sd_drift, level, noise);
        }
        else if which == low_tom() { self.lt.strike(gain); }
        else if which == mid_tom() { self.mt.strike(gain); }
        else if which == high_tom() { self.ht.strike(gain); }
        else if which == rim_shot() { self.rs.strike(gain); }
        else if which == hand_clap() {
            if self.cp_len > 0 { self.cp_rom.strike(self.cp_env); self.cp_env = gain; }
            else { self.cp.strike(gain); }
        }
        else if which == closed_hat() {
            // CH Decay: the VCA's time constant after a 3 ms hold, so the
            // closed hat lasts 0.11 .. 0.2 s, as on the 909.
            self.ch.strike(self.ch_env);
            self.ch_env = gain;
            let ch: f32 = self.hats_recorded ? knob5(self.ch_decay, 0.065f, 0.1f, 0.3f, 1.0f, 10.0f)
                                             : knob5(self.ch_decay, 0.0255f, 0.034f, 0.044f, 0.047f, 0.049f);
            self.ch_decay_env.start(1.0f, ch, 0.003f, r);
            // The closed hat cuts the open one.
            self.oh_choked = true;
            self.ch_choked = false;
        } else if which == open_hat() {
            // OH Decay: after a 5 ms hold, so the open hat lasts 0.28 .. 0.52 s.
            self.oh.strike(self.oh_env);
            self.oh_env = gain;
            let oh: f32 = self.hats_recorded ? knob5(self.oh_decay, 0.123f, 0.265f, 0.66f, 3.0f, 10.0f)
                                             : knob5(self.oh_decay, 0.073f, 0.107f, 0.142f, 0.158f, 0.165f);
            self.oh_decay_env.start(1.0f, oh, 0.005f, r);
            self.oh_choked = false;
            // ... and the open hat cuts the closed one.
            self.ch_choked = true;
        } else if which == crash() {
            self.cr.strike(self.cr_env);
            self.cr_env = gain;
        } else if which == ride() {
            self.rd.strike(self.rd_env);
            self.rd_env = gain;
        }
    }

    /// Start replacing a ROM (see `mla09_rom_begin`).
    fn rom_begin(self: &mut Self, rom: i32, words: i64) -> void {
        if words <= 0 { self.build_roms(); return; }
        let n: i64 = words < mla09_rom_capacity(rom) ? words : mla09_rom_capacity(rom);
        var i: i64 = 0;
        if rom == rom_hat() {
            self.hat_len = n; self.hats_recorded = true;
            while i < hat_words() { set_f32(self.rom_hat, i, 0.0f); i = i + 1; }
        }
        else if rom == rom_open_hat() {
            self.oh_len = n; self.hats_recorded = true;
            while i < hat_words() { set_f32(self.rom_oh, i, 0.0f); i = i + 1; }
        }
        else if rom == rom_clap() { self.cp_len = n; while i < clap_words() { set_f32(self.rom_cp, i, 0.0f); i = i + 1; } }
        else if rom == rom_crash() { self.cr_len = n; while i < cymbal_words() { set_f32(self.rom_cr, i, 0.0f); i = i + 1; } }
        else if rom == rom_ride() { self.rd_len = n; while i < cymbal_words() { set_f32(self.rom_rd, i, 0.0f); i = i + 1; } }
    }

    /// One ROM word (see `mla09_rom_write`).
    fn rom_write(self: &mut Self, rom: i32, index: i64, value: f32) -> void {
        if index < 0 { return; }
        let v: f32 = sclamp(value, -1.0f, 1.0f);
        if rom == rom_hat() && index < self.hat_len { set_f32(self.rom_hat, index, v); }
        else if rom == rom_open_hat() && index < self.oh_len { set_f32(self.rom_oh, index, v); }
        else if rom == rom_clap() && index < self.cp_len { set_f32(self.rom_cp, index, v); }
        else if rom == rom_crash() && index < self.cr_len { set_f32(self.rom_cr, index, v); }
        else if rom == rom_ride() && index < self.rd_len { set_f32(self.rom_rd, index, v); }
    }

    fn rom_active(self: M09) -> bool {
        return self.ch.active() || self.oh.active() || self.cr.active() || self.rd.active();
    }

    /// The ROM voices: each head through its VCA; fading tails at their own gain.
    fn samples(self: &mut Self) -> f32 {
        var tail: f32 = 0.0f;
        var out: f32 = 0.0f;
        if self.ch.active() {
            let x: f32 = self.ch.tick(self.rom_hat, self.hat_len, self.hat_step, &mut tail);
            out = out + (x * self.ch_env + tail) * self.level_ch;
            let d: f32 = self.ch_decay_env.next();
            self.ch_env = self.ch_env * (self.ch_choked ? self.choke_coef : d);
            if self.ch_env < silent() { self.ch.head.on = false; }
        }
        if self.oh.active() {
            var x: f32 = 0.0f;
            if self.oh_len > 0 { x = self.oh.tick(self.rom_oh, self.oh_len, self.hat_step, &mut tail); }
            else { x = self.oh.tick(self.rom_hat, self.hat_len, self.hat_step, &mut tail); }
            out = out + (x * self.oh_env + tail) * self.level_oh;
            let d: f32 = self.oh_decay_env.next();
            self.oh_env = self.oh_env * (self.oh_choked ? self.choke_coef : d);
            if self.oh_env < silent() { self.oh.head.on = false; }
        }
        if self.cr.active() {
            let x: f32 = self.cr.tick(self.rom_cr, self.cr_len, self.cr_step, &mut tail);
            out = out + (x * self.cr_env + tail) * self.level_cr * 0.8f;
            self.cr_env = self.cr_env * self.cr_decay_coef;
            if self.cr_env < silent() { self.cr.head.on = false; }
        }
        if self.rd.active() {
            let x: f32 = self.rd.tick(self.rom_rd, self.rd_len, self.rd_step, &mut tail);
            out = out + (x * self.rd_env + tail) * self.level_rd * 0.6f;
            self.rd_env = self.rd_env * self.rd_decay_coef;
            if self.rd_env < silent() { self.rd.head.on = false; }
        }
        return out;
    }

    fn toms_active(self: M09) -> bool { return self.lt.active() || self.mt.active() || self.ht.active(); }

    fn active(self: M09) -> bool {
        return self.bd.active() || self.sd.active() || self.toms_active() || self.rs.active() || self.cp.active() || self.cp_rom.active()
            || self.rom_active();
    }

    /// The output stage's distortion: a tanh saturator whose drive rises
    /// with the knob (up to +28 dB into it), levelled so a loud hit keeps
    /// about its peak while quieter parts and tails come up. 0 is clean.
    fn distort(self: M09, x: f32) -> f32 {
        let k: f32 = self.drive;
        if k <= 0.0f { return x; }
        let g: f32 = 1.0f + 24.0f * k * k;
        let wet: f32 = tanhf(g * x) * 0.5f / tanhf(0.5f * g);
        let mix: f32 = smin(1.0f, k * 8.0f);
        return x + (wet - x) * mix;
    }

    fn process(self: &mut Self, out_right: ptr<f32>) -> f32 {
        let r: f32 = self.rate;
        self.output_gain = self.output_gain + (self.output_target - self.output_gain) * 0.002f;
        var mix: f32 = 0.0f;
        // The kick runs every sample: its VCO is free-running.
        let w: f32 = self.white();
        mix = mix + self.bd.tick(w) * self.level_bd * 0.8f;
        let n: f32 = self.white();
        // The snare's and toms' noise filters run all the time.
        mix = mix + self.sd.tick(n) * self.level_sd * 0.45f;
        mix = mix + self.lt.tick(n) * self.level_lt * 0.55f;
        mix = mix + self.mt.tick(n) * self.level_mt * 0.55f;
        mix = mix + self.ht.tick(n) * self.level_ht * 0.55f;
        mix = mix + self.rs.tick() * self.level_rs * 0.6f;
        mix = mix + self.cp.tick(n) * self.level_cp * 1.0f;
        // A loaded clap recording plays straight into the mix (no coupling
        // high-pass: the clap's tail has body below 500 Hz).
        if self.cp_rom.active() {
            var tail: f32 = 0.0f;
            let x: f32 = self.cp_rom.tick(self.rom_cp, self.cp_len, self.hat_step, &mut tail);
            mix = mix + (x * self.cp_env + tail) * self.level_cp * 0.62f;
        }
        // The ROM voices share the mixer's coupling high-pass, which runs all
        // the time so a hit never strikes a resting filter.
        let metal: f32 = self.rom_active() ? self.samples() : 0.0f;
        mix = mix + self.metal_hp.process(metal, 1) * 0.5f;
        let out: f32 = self.distort(mix) * self.output_gain;
        unsafe { *out_right = out; }
        return out;
    }
}

// --- C ABI -------------------------------------------------------------------

/// @brief Allocate an instance for a sample rate (8 kHz .. 384 kHz). Builds
/// the sample ROMs, so call it off the audio thread.
fn mla09_create(sample_rate: f32) -> ptr<M09> {
    let handle: ptr<M09> = calloc(1, size_of(M09));
    unsafe { *handle = M09::new(sample_rate); }
    return handle;
}

/// @brief Release an instance created by `mla09_create`.
fn mla09_destroy(handle: ptr<M09>) {
    // Move the value out so its ROM lists are dropped, then free the block.
    unsafe { var dead: M09 = *handle; dead.reset(); }
    unsafe { free(handle); }
}

/// @brief Silence every voice and clear filters; settings stay.
fn mla09_reset(handle: ptr<M09>) { unsafe { (*handle).reset(); } }

/// @brief Strike instrument `which` (0 BD, 1 SD, 2 LT, 3 MT, 4 HT, 5 RS,
/// 6 CP, 7 CH, 8 OH, 9 CR, 10 RD) at velocity 0..1.
fn mla09_trigger(handle: ptr<M09>, which: i32, velocity: f32) {
    unsafe { (*handle).trigger(which, velocity); }
}

/// @brief 1 while any voice sounds, else 0.
fn mla09_active(handle: ptr<M09>) -> i32 {
    unsafe { return (*handle).active() ? 1 : 0; }
}

/// @brief Capacity of a ROM in words (0 hi-hat, 1 crash, 2 ride, 3 open
/// hat, 4 clap), at the 32 kHz ROM clock.
fn mla09_rom_capacity(rom: i32) -> i64 {
    if rom == rom_hat() || rom == rom_open_hat() { return hat_words(); }
    if rom == rom_crash() || rom == rom_ride() { return cymbal_words(); }
    if rom == rom_clap() { return clap_words(); }
    return 0;
}

/// @brief Replace a ROM's contents: set its length (clamped to the
/// capacity; 0 or less rebuilds every built-in ROM) and clear it. Silence
/// the machine first (`mla09_reset`); call off the audio thread.
fn mla09_rom_begin(handle: ptr<M09>, rom: i32, words: i64) {
    unsafe { (*handle).rom_begin(rom, words); }
}

/// @brief Write one ROM word (-1 .. 1, at the ROM clock) after `mla09_rom_begin`.
fn mla09_rom_write(handle: ptr<M09>, rom: i32, index: i64, value: f32) {
    unsafe { (*handle).rom_write(rom, index, value); }
}

/// @brief Set one parameter (the VST3 parameter ID minus 100):
/// 0 output gain (linear), 1 accent 0..1, 2 dynamics (0 accent, 1 velocity),
/// then levels (linear) and knobs (0..1) in panel order:
/// 3 BD level, 4 BD tune, 5 BD attack, 6 BD decay,
/// 7 SD level, 8 SD tune, 9 SD tone, 10 SD snappy,
/// 11 LT level, 12 LT tune, 13 LT decay, 14 MT level, 15 MT tune, 16 MT decay,
/// 17 HT level, 18 HT tune, 19 HT decay, 20 RS level, 21 CP level,
/// 22 CH level, 23 CH decay, 24 OH level, 25 OH decay,
/// 26 CR level, 27 CR tune, 28 RD level, 29 RD tune, 30 drive,
/// 31 SD decay, 32 CR decay, 33 RD decay.
fn mla09_set(handle: ptr<M09>, index: i32, value: f32) {
    unsafe {
        let k: f32 = sclamp(value, 0.0f, 1.0f);
        let level: f32 = smax(value, 0.0f);
        if index == 0 {
            (*handle).output_target = level;
            // Glide only while something sounds.
            if !(*handle).active() { (*handle).output_gain = (*handle).output_target; }
        }
        else if index == 1 { (*handle).accent = k; }
        else if index == 2 { (*handle).dynamics = value > 0.5f ? 1 : 0; }
        else if index == 3 { (*handle).level_bd = level; }
        else if index == 4 { (*handle).bd_tune = k; (*handle).configure_knobs(); }
        else if index == 5 { (*handle).bd_attack = k; (*handle).configure_knobs(); }
        else if index == 6 { (*handle).bd_decay = k; (*handle).configure_knobs(); }
        else if index == 7 { (*handle).level_sd = level; }
        else if index == 8 { (*handle).sd_tune = k; (*handle).configure_knobs(); }
        else if index == 9 { (*handle).sd_tone = k; (*handle).configure_knobs(); }
        else if index == 10 { (*handle).snappy = k; (*handle).configure_knobs(); }
        else if index == 11 { (*handle).level_lt = level; }
        else if index == 12 { (*handle).lt_tune = k; (*handle).configure_knobs(); }
        else if index == 13 { (*handle).lt_decay = k; (*handle).configure_knobs(); }
        else if index == 14 { (*handle).level_mt = level; }
        else if index == 15 { (*handle).mt_tune = k; (*handle).configure_knobs(); }
        else if index == 16 { (*handle).mt_decay = k; (*handle).configure_knobs(); }
        else if index == 17 { (*handle).level_ht = level; }
        else if index == 18 { (*handle).ht_tune = k; (*handle).configure_knobs(); }
        else if index == 19 { (*handle).ht_decay = k; (*handle).configure_knobs(); }
        else if index == 20 { (*handle).level_rs = level; }
        else if index == 21 { (*handle).level_cp = level; }
        else if index == 22 { (*handle).level_ch = level; }
        else if index == 23 { (*handle).ch_decay = k; }
        else if index == 24 { (*handle).level_oh = level; }
        else if index == 25 { (*handle).oh_decay = k; }
        else if index == 26 { (*handle).level_cr = level; }
        else if index == 27 { (*handle).cr_tune = k; (*handle).configure_knobs(); }
        else if index == 28 { (*handle).level_rd = level; }
        else if index == 29 { (*handle).rd_tune = k; (*handle).configure_knobs(); }
        else if index == 30 { (*handle).drive = k; }
        else if index == 31 { (*handle).sd_decay = k; (*handle).configure_knobs(); }
        else if index == 32 { (*handle).cr_decay = k; (*handle).configure_knobs(); }
        else if index == 33 { (*handle).rd_decay = k; (*handle).configure_knobs(); }
    }
}

/// @brief Process one sample: stereo out (left returned, right through `out_right`).
fn mla09_process(handle: ptr<M09>, out_right: ptr<f32>) -> f32 {
    unsafe { return (*handle).process(out_right); }
}
